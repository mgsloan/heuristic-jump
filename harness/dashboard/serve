POLL = """
let token = %TOKEN%;
async function tick() {
  try {
    const fresh = await (await fetch('/version')).text();
    if (fresh === token) return;
    // Never swap under someone who is typing an answer: losing a rationale
    // half-written is exactly the friction that leaves decisions unanswered.
    const active = document.activeElement;
    if (active && active.closest && active.closest('form.answer')) return;
    for (const field of document.querySelectorAll('form.answer textarea')) {
      if (field.value.trim()) return;
    }
    const main = document.querySelector('main');
    const view = main.dataset.view;
    const loop = main.dataset.loop || '';
    const html = await (await fetch('/fragment?view=' + encodeURIComponent(view)
      + '&loop=' + encodeURIComponent(loop))).text();
    document.querySelector('main').innerHTML = html;
    token = fresh;
    document.getElementById('token').textContent = 'updated ' + new Date().toLocaleTimeString();
  } catch (error) { /* the server is restarting; the next tick retries */ }
}
setInterval(tick, 2000);
"""


def selected_loop(query: dict) -> str:
    """The loop the page is showing, defaulting to the first configured one.

    Validated against `state/phase.toml` rather than trusted, so a stale
    bookmark or a hand-edited query string cannot make the panels silently
    empty — it falls back to a loop that exists.
    """
    try:
        owners = sorted(hj.load_phase().loops)
    except SystemExit:
        return ""
    wanted = query.get("loop", [""])[0]
    if wanted in owners:
        return wanted
    return owners[0] if owners else ""


def nav(view: str, loop: str = "") -> str:
    """View tabs, and — once there is more than one loop — a loop selector.

    One page rather than one per loop: several of these panels are about how
    the loops interact rather than about either one, and two dashboards on two
    ports is the wrong shape for a page whose whole job is that one human sees
    everything.

    The selector is hidden while there is a single loop, because a control with
    one option is a control that teaches nothing.
    """
    tabs = "".join(
        f'<a class="tab{" on" if name == view else ""}"'
        f' href="/?view={name}{"&loop=" + urllib.parse.quote(loop) if loop else ""}">{esc(label)}</a>'
        for name, label in VIEWS
    )
    try:
        owners = sorted(hj.load_phase().loops)
    except SystemExit:
        owners = []
    if len(owners) < 2:
        return tabs
    picker = "".join(
        f'<a class="tab loop{" on" if name == (loop or owners[0]) else ""}"'
        f' href="/?view={view}&loop={urllib.parse.quote(name)}">{esc(name)}</a>'
        for name in owners
    )
    return f'{tabs}<span class="loops"><span class="lead">loop</span>{picker}</span>'


def page(title: str, body: str, poll: bool = True, view: str = "overview", loop: str = "") -> str:
    script = ""
    if poll:
        script = f"<script>{POLL.replace('%TOKEN%', json.dumps(version_token()))}</script>"
    try:
        phase = hj.load_phase().phase
    except SystemExit:
        phase = "?"
    return f"""<!doctype html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{esc(title)} — heuristic-jump</title>
<style>{STYLE}</style></head>
<body>
<header><h1>heuristic-jump</h1><span class="note">phase {esc(phase)}</span>
<nav>{nav(view, loop)}</nav>
<span class="note" id="token"></span></header>
<main data-view="{esc(view)}" data-loop="{esc(loop)}">{body}</main>
{script}
</body></html>"""


