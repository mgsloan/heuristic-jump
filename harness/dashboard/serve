def panel_sessions(loop: str = "") -> str:
    phase = hj.load_phase()
    rows = []
    for owner in ([loop] if loop and loop in phase.loops else sorted(phase.loops)):
        for campaign in reversed(hj.campaigns_of(owner)):
            identifier = campaign.get("campaign", "")
            path = Path(adapter("transcript-path", owner, identifier).strip() or "/nonexistent")
            link = (
                f'<a href="/transcript/{urllib.parse.quote(owner)}/{urllib.parse.quote(identifier)}">transcript</a>'
                if path.exists()
                else '<span class="empty">no transcript</span>'
            )
            record = REPO / str(campaign.get("record") or "")
            record_link = (
                f'<a href="/record/{urllib.parse.quote(owner)}/{urllib.parse.quote(identifier)}">record</a> · '
                if record.is_file()
                else ""
            )
            target_cell = target_links(campaign.get("target"))
            rows.append(
                f"<tr><td><code>{esc(identifier[:8])}</code></td><td>{esc(owner)}</td>"
                f"<td>{target_cell}</td>"
                f"<td>{esc(campaign.get('outcome') or 'open')}</td>"
                f"<td>{esc(campaign.get('commits', 0))}</td>"
