POLL = """
let token = %TOKEN%;
async function tick() {
  try {
    const fresh = await (await fetch('/version')).text();
    if (fresh === token) return;
    // Never swap under someone who is typing an answer: losing a rationale
    // half-written is exactly the friction that leaves decisions unanswered.
    const active = document.activeElement;
    if (active && active.closest && active.closest('form.answer')) return;
    for (const field of document.querySelectorAll('form.answer textarea')) {
      if (field.value.trim()) return;
    }
    const main = document.querySelector('main');
    const view = main.dataset.view;
    const loop = main.dataset.loop || '';
    const html = await (await fetch('/fragment?view=' + encodeURIComponent(view)
      + '&loop=' + encodeURIComponent(loop))).text();
    document.querySelector('main').innerHTML = html;
    token = fresh;
    document.getElementById('token').textContent = 'updated ' + new Date().toLocaleTimeString();
  } catch (error) { /* the server is restarting; the next tick retries */ }
}
setInterval(tick, 2000);
"""


def selected_loop(query: dict) -> str:
    """The loop the page is showing, defaulting to the first configured one.

    Validated against `state/phase.toml` rather than trusted, so a stale
    bookmark or a hand-edited query string cannot make the panels silently
    empty — it falls back to a loop that exists.
    """
    try:
        owners = sorted(hj.load_phase().loops)
    except SystemExit:
        return ""
    wanted = query.get("loop", [""])[0]
    if wanted in owners:
        return wanted
    return owners[0] if owners else ""


def nav(view: str, loop: str = "") -> str:
    """View tabs, and — once there is more than one loop — a loop selector.

    One page rather than one per loop: several of these panels are about how
    the loops interact rather than about either one, and two dashboards on two
    ports is the wrong shape for a page whose whole job is that one human sees
    everything.

    The selector is hidden while there is a single loop, because a control with
    one option is a control that teaches nothing.
    """
    tabs = "".join(
        f'<a class="tab{" on" if name == view else ""}"'
        f' href="/?view={name}{"&loop=" + urllib.parse.quote(loop) if loop else ""}">{esc(label)}</a>'
        for name, label in VIEWS
    )
    try:
        owners = sorted(hj.load_phase().loops)
    except SystemExit:
        owners = []
    if len(owners) < 2:
        return tabs
    picker = "".join(
        f'<a class="tab loop{" on" if name == (loop or owners[0]) else ""}"'
        f' href="/?view={view}&loop={urllib.parse.quote(name)}">{esc(name)}</a>'
        for name in owners
    )
    return f'{tabs}<span class="loops"><span class="lead">loop</span>{picker}</span>'


def page(title: str, body: str, poll: bool = True, view: str = "overview", loop: str = "") -> str:
    script = ""
    if poll:
        script = f"<script>{POLL.replace('%TOKEN%', json.dumps(version_token()))}</script>"
    try:
        phase = hj.load_phase().phase
    except SystemExit:
        phase = "?"
    return f"""<!doctype html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{esc(title)} — heuristic-jump</title>
<style>{STYLE}</style></head>
<body>
<header><h1>heuristic-jump</h1><span class="note">phase {esc(phase)}</span>
<nav>{nav(view, loop)}</nav>
<span class="note" id="token"></span></header>
<main data-view="{esc(view)}" data-loop="{esc(loop)}">{body}</main>
{script}
</body></html>"""


# --------------------------------------------------------------------------
# Answering


def answer_decision(fields: dict[str, str]) -> tuple[int, str]:
    identifier = fields.get("id", "").strip()
    rationale = fields.get("rationale", "").strip()
    status = fields.get("status", "accepted").strip()
    answer = fields.get("answer", "").strip()

    if not rationale:
        return 400, "A rationale is required. `design/loops.md` section 16: a decision with no recorded reason is one you re-litigate in three weeks."
    if status not in ("accepted", "rejected", "superseded"):
        return 400, f"Unknown status {status!r}."

    path = STATE / "decisions" / f"{identifier}.md"
    if not path.exists():
        return 404, f"No decision record at {path}."

    stamp = hj.now()
    text = path.read_text()
    # MADR's discipline: the status changes, the text does not. The answer is
    # appended rather than edited into the body.
    updated, count = re.subn(r"(?m)^status:\s*.+$", f"status: {status}", text, count=1)
    if count == 0:
        updated = f"---\nid: {identifier}\nstatus: {status}\n---\n\n" + text
    updated = updated.rstrip() + (
        f"\n\n## Answer — {stamp}\n\n"
        f"**Ruling:** {status}\n\n"
        f"{answer or '(no option text given; see the rationale)'}\n\n"
        f"**Rationale:** {rationale}\n\n"
        f"Reconciling the sites tagged `// DECISION-{identifier}: provisional` is a\n"
        f"normal campaign target, not an interrupt.\n"
    )
    path.write_text(updated)

    hj.append_jsonl(
        STATE / "interventions.jsonl",
        {
            "ts": stamp,
            "kind": "decision-answered",
            "target": identifier,
            "answer": f"{status}: {answer}" if answer else status,
            "rationale": rationale,
            "commit": hj.head_sha(),
        },
    )
    # Committed here for the reason `conformance-001` established: an answer
    # left in the working tree is a dirty tree, and a dirty tree stops the
    # next campaign from starting at all.
    hj.commit_harness_state(
        [path, STATE / "interventions.jsonl"], f"answer {identifier} ({status})"
    )
    return 303, "/"


REVIEW_KINDS = ("spec-change-reviewed", "spec-drift-reviewed")


def record_review(fields: dict[str, str]) -> tuple[int, str]:
    """Reading something *is* appending to the intervention log. There is no
    separate "reviewed" flag anywhere, for the same reason the decision status
    is derived rather than stored twice: a record that can drift from what
    happened will."""
    kind = fields.get("kind", "")
    target = fields.get("target", "").strip()
    rationale = fields.get("rationale", "").strip()
    if kind not in REVIEW_KINDS:
        return 400, f"Unknown review kind {kind!r}."
    if not target:
        return 400, "No target."
    if not rationale:
        return 400, (
            "A rationale is required. Marking something read without saying what you "
            "concluded records only that you clicked."
        )
    hj.append_jsonl(
        STATE / "interventions.jsonl",
        {
            "ts": hj.now(),
            "kind": kind,
            "target": target,
            "answer": "read",
            "rationale": rationale,
            "commit": hj.head_sha(),
        },
    )
    hj.commit_harness_state([STATE / "interventions.jsonl"], f"{kind}: {target}")
    return 303, "/"


# --------------------------------------------------------------------------
# The server


class Handler(BaseHTTPRequestHandler):
    server_version = "heuristic-jump-dashboard"

    def log_message(self, fmt, *args):
        if self.path not in ("/version", "/fragment"):
            sys.stderr.write(f"dashboard: {self.address_string()} {fmt % args}\n")

    def send(self, code: int, body: str, content_type: str = "text/html; charset=utf-8") -> None:
        payload = body.encode()
        self.send_response(code)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(payload)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(payload)

    def do_GET(self) -> None:
        parsed = urllib.parse.urlparse(self.path)
        route = parsed.path
        query = urllib.parse.parse_qs(parsed.query)
        try:
            if route == "/":
                view = query.get("view", ["overview"])[0]
                if view not in dict(VIEWS):
                    view = "overview"
                loop = selected_loop(query)
                self.send(200, page("Dashboard", fragment(view, loop), view=view, loop=loop))
            elif route == "/fragment":
                view = query.get("view", ["overview"])[0]
                self.send(
                    200,
                    fragment(view if view in dict(VIEWS) else "overview", selected_loop(query)),
                )
            elif route == "/version":
                self.send(200, version_token(), "text/plain; charset=utf-8")
            elif route.startswith("/section/"):
                _, _, doc, anchor = route.split("/", 3)
                index = hj.section_index([doc])
                section = index.get(f"{doc}#{anchor}")
                if section is None:
                    self.send(404, page("Section", empty(f"No {esc(doc)}#{esc(anchor)}.")))
                else:
                    verdict = hj.read_audit(doc).get(section.key)
                    state = verdict.state if verdict else "unjudged"
                    gaps = ""
                    if verdict and verdict.gaps:
                        gaps = "<h4>open gaps</h4><ul class='gaps'>" + "".join(
                            f"<li><code>{esc(hj.gap_id(section.key, gap.claim))}</code> "
                            f"<strong>{esc(gap.claim)}</strong><br>{esc(gap.found)}<br>"
                            f"<code>{esc(gap.where)}</code></li>"
                            for gap in verdict.gaps
                        ) + "</ul>"
                    body = (
                        f'<p class="meta"><a href="/?view=sections">&larr; sections</a> · '
                        f'<code>design/{esc(doc)}</code> · <span class="{esc(state)}">{esc(state)}</span></p>'
                        f"{gaps}<pre class=\"spec\">{esc(hj.section_text(section))}</pre>"
                    )
                    self.send(200, page(section.heading, body, poll=False))
            elif route.startswith("/diff/"):
                _, _, owner, campaign = route.split("/", 3)
                self.send(200, render_campaign_diff(owner, campaign))
            elif route.startswith("/record/"):
                _, _, owner, campaign = route.split("/", 3)
                path = STATE / "campaigns" / owner / f"{campaign}.md"
                if not path.is_file():
                    self.send(404, page("Record", empty("No such campaign record.")))
                else:
                    body = (
                        f'<p class="meta"><a href="/?view=campaigns">&larr; campaigns</a> · '
                        f'<code>{esc(campaign)}</code> · '
                        f'<a href="/transcript/{urllib.parse.quote(owner)}/{urllib.parse.quote(campaign)}">transcript</a></p>'
                        + markdownish(path.read_text())
                    )
                    self.send(200, page("Campaign record", body, poll=False))
            elif route.startswith("/transcript/"):
                _, _, owner, campaign = route.split("/", 3)
                self.send(200, render_transcript(owner, campaign))
            elif route.startswith("/raw/"):
                _, _, owner, campaign = route.split("/", 3)
                path = Path(adapter("transcript-path", owner, campaign).strip() or "/nonexistent")
                if not path.exists():
                    self.send(404, page("Transcript", empty("No such transcript.")))
                else:
                    self.send(200, path.read_text(errors="replace"), "text/plain; charset=utf-8")
            else:
                self.send(404, page("Not found", empty(f"No route {esc(route)}.")))
        except Exception as error:  # a dashboard that dies is worse than one that says so
            self.send(500, page("Error", f"<pre>{esc(repr(error))}</pre>"))

    def do_POST(self) -> None:
        route = urllib.parse.urlparse(self.path).path
        if route not in ("/answer", "/review"):
            self.send(404, page("Not found", empty("No such endpoint.")))
            return
        length = int(self.headers.get("Content-Length", "0"))
        raw = self.rfile.read(length).decode()
        fields = {k: v[0] for k, v in urllib.parse.parse_qs(raw, keep_blank_values=True).items()}
        try:
            code, message = (answer_decision if route == "/answer" else record_review)(fields)
        except Exception as error:
            self.send(500, page("Error", f"<pre>{esc(repr(error))}</pre>"))
            return
        if code == 303:
            self.send_response(303)
            self.send_header("Location", message)
            self.end_headers()
        else:
            self.send(code, page("Not written", f'<p class="empty">{esc(message)}</p><p><a href="/">back</a></p>'))


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--port", type=int, default=8787)
    parser.add_argument("--host", default="127.0.0.1")
    parser.add_argument("--no-open", action="store_true")
    args = parser.parse_args()

    # Reuse the address rather than walking to the next free port. A dashboard
    # that moves is one whose URL you cannot keep open in a tab, and the usual
    # reason the old port looks busy is a previous instance of this same
    # program that has just been killed and is sitting in TIME_WAIT.
    ThreadingHTTPServer.allow_reuse_address = True
    try:
        server = ThreadingHTTPServer((args.host, args.port), Handler)
    except OSError as error:
        holder = subprocess.run(
            ["pgrep", "-f", f"dashboard/serve --port {args.port}"],
            capture_output=True, text=True, check=False,
        ).stdout.split()
        mine = [pid for pid in holder if pid != str(os.getpid())]
        if not mine:
            print(f"dashboard: port {args.port} is held by something else — {error}", file=sys.stderr)
            return 1
        print(f"dashboard: replacing the instance already on {args.port} (pid {' '.join(mine)})")
        for pid in mine:
            subprocess.run(["kill", pid], check=False)
        for _ in range(40):
            time.sleep(0.25)
            try:
                server = ThreadingHTTPServer((args.host, args.port), Handler)
                break
            except OSError:
                continue
        else:
            print(f"dashboard: {args.port} did not free up", file=sys.stderr)
            return 1
    url = f"http://{args.host}:{args.port}/"
    print(f"dashboard: {url}   (ctrl-c to stop)")
    if not args.no_open:
        webbrowser.open(url)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\ndashboard: stopped")
    return 0


if __name__ == "__main__":
    sys.exit(main())
