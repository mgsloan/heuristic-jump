# Answering


def answer_decision(fields: dict[str, str]) -> tuple[int, str]:
    identifier = fields.get("id", "").strip()
    rationale = fields.get("rationale", "").strip()
    status = fields.get("status", "accepted").strip()
    answer = fields.get("answer", "").strip()

    if not rationale:
        return 400, "A rationale is required. `design/loops.md` section 16: a decision with no recorded reason is one you re-litigate in three weeks."
    if status not in ("accepted", "rejected", "superseded"):
        return 400, f"Unknown status {status!r}."

    path = STATE / "decisions" / f"{identifier}.md"
    if not path.exists():
        return 404, f"No decision record at {path}."

    stamp = hj.now()
    text = path.read_text()
    # MADR's discipline: the status changes, the text does not. The answer is
    # appended rather than edited into the body.
    updated, count = re.subn(r"(?m)^status:\s*.+$", f"status: {status}", text, count=1)
    if count == 0:
        updated = f"---\nid: {identifier}\nstatus: {status}\n---\n\n" + text
    updated = updated.rstrip() + (
        f"\n\n## Answer — {stamp}\n\n"
        f"**Ruling:** {status}\n\n"
        f"{answer or '(no option text given; see the rationale)'}\n\n"
        f"**Rationale:** {rationale}\n\n"
        f"Reconciling the sites tagged `// DECISION-{identifier}: provisional` is a\n"
        f"normal campaign target, not an interrupt.\n"
    )
    path.write_text(updated)

    hj.append_jsonl(
        STATE / "interventions.jsonl",
        {
            "ts": stamp,
            "kind": "decision-answered",
            "target": identifier,
            # Explicit, so the status is read rather than parsed back out of
            # the prose. `hj.ruling_of` still parses `answer` for the rows
            # written before this field existed.
            "status": status,
            "answer": f"{status}: {answer}" if answer else status,
            "rationale": rationale,
            "commit": hj.head_sha(),
        },
    )
    # Committed here for the reason `conformance-001` established: an answer
    # left in the working tree is a dirty tree, and a dirty tree stops the
    # next campaign from starting at all.
    hj.commit_harness_state(
        [path, STATE / "interventions.jsonl"], f"answer {identifier} ({status})"
    )
    return 303, "/"


REVIEW_KINDS = (
    "spec-change-reviewed",
    "spec-drift-reviewed",
    "prompt-drift-reviewed",
    "test-deletion-reviewed",
)


def record_review(fields: dict[str, str]) -> tuple[int, str]:
    """Reading something *is* appending to the intervention log. There is no
    separate "reviewed" flag anywhere, for the same reason the decision status
    is derived rather than stored twice: a record that can drift from what
    happened will."""
    kind = fields.get("kind", "")
    target = fields.get("target", "").strip()
    rationale = fields.get("rationale", "").strip()
    if kind not in REVIEW_KINDS:
        return 400, f"Unknown review kind {kind!r}."
    if not target:
        return 400, "No target."
    if not rationale:
        return 400, (
            "A rationale is required. Marking something read without saying what you "
            "concluded records only that you clicked."
        )
    hj.append_jsonl(
        STATE / "interventions.jsonl",
        {
            "ts": hj.now(),
            "kind": kind,
            "target": target,
            "answer": "read",
            "rationale": rationale,
            "commit": hj.head_sha(),
        },
    )
    hj.commit_harness_state([STATE / "interventions.jsonl"], f"{kind}: {target}")
    return 303, "/"


