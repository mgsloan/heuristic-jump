# --------------------------------------------------------------------------
# Answering


def answer_decision(fields: dict[str, str]) -> tuple[int, str]:
    identifier = fields.get("id", "").strip()
    rationale = fields.get("rationale", "").strip()
    status = fields.get("status", "accepted").strip()
    answer = fields.get("answer", "").strip()

    if not rationale:
        return 400, "A rationale is required. `design/loops.md` section 16: a decision with no recorded reason is one you re-litigate in three weeks."
    if status not in ("accepted", "rejected", "superseded"):
        return 400, f"Unknown status {status!r}."

    path = STATE / "decisions" / f"{identifier}.md"
    if not path.exists():
        return 404, f"No decision record at {path}."

    stamp = hj.now()
    text = path.read_text()
    # MADR's discipline: the status changes, the text does not. The answer is
    # appended rather than edited into the body.
    updated, count = re.subn(r"(?m)^status:\s*.+$", f"status: {status}", text, count=1)
    if count == 0:
        updated = f"---\nid: {identifier}\nstatus: {status}\n---\n\n" + text
    updated = updated.rstrip() + (
        f"\n\n## Answer — {stamp}\n\n"
        f"**Ruling:** {status}\n\n"
        f"{answer or '(no option text given; see the rationale)'}\n\n"
        f"**Rationale:** {rationale}\n\n"
        f"Reconciling the sites tagged `// DECISION-{identifier}: provisional` is a\n"
        f"normal campaign target, not an interrupt.\n"
    )
    path.write_text(updated)

    hj.append_jsonl(
        STATE / "interventions.jsonl",
        {
            "ts": stamp,
            "kind": "decision-answered",
            "target": identifier,
            "answer": f"{status}: {answer}" if answer else status,
            "rationale": rationale,
            "commit": hj.head_sha(),
        },
    )
    # Committed here for the reason `conformance-001` established: an answer
    # left in the working tree is a dirty tree, and a dirty tree stops the
    # next campaign from starting at all.
    hj.commit_harness_state(
        [path, STATE / "interventions.jsonl"], f"answer {identifier} ({status})"
    )
    return 303, "/"


REVIEW_KINDS = ("spec-change-reviewed", "spec-drift-reviewed")


def record_review(fields: dict[str, str]) -> tuple[int, str]:
    """Reading something *is* appending to the intervention log. There is no
    separate "reviewed" flag anywhere, for the same reason the decision status
    is derived rather than stored twice: a record that can drift from what
    happened will."""
    kind = fields.get("kind", "")
    target = fields.get("target", "").strip()
    rationale = fields.get("rationale", "").strip()
    if kind not in REVIEW_KINDS:
        return 400, f"Unknown review kind {kind!r}."
    if not target:
        return 400, "No target."
    if not rationale:
        return 400, (
            "A rationale is required. Marking something read without saying what you "
            "concluded records only that you clicked."
        )
    hj.append_jsonl(
        STATE / "interventions.jsonl",
        {
            "ts": hj.now(),
            "kind": kind,
            "target": target,
            "answer": "read",
            "rationale": rationale,
            "commit": hj.head_sha(),
        },
    )
    hj.commit_harness_state([STATE / "interventions.jsonl"], f"{kind}: {target}")
    return 303, "/"


# --------------------------------------------------------------------------
# The server


class Handler(BaseHTTPRequestHandler):
    server_version = "heuristic-jump-dashboard"

    def log_message(self, fmt, *args):
        if self.path not in ("/version", "/fragment"):
            sys.stderr.write(f"dashboard: {self.address_string()} {fmt % args}\n")

    def send(self, code: int, body: str, content_type: str = "text/html; charset=utf-8") -> None:
        payload = body.encode()
        self.send_response(code)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(payload)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(payload)

    def do_GET(self) -> None:
        parsed = urllib.parse.urlparse(self.path)
        route = parsed.path
        query = urllib.parse.parse_qs(parsed.query)
        try:
            if route == "/":
                view = query.get("view", ["overview"])[0]
                if view not in dict(VIEWS):
                    view = "overview"
                self.send(200, page("Dashboard", fragment(view), view=view))
            elif route == "/fragment":
                view = query.get("view", ["overview"])[0]
                self.send(200, fragment(view if view in dict(VIEWS) else "overview"))
            elif route == "/version":
                self.send(200, version_token(), "text/plain; charset=utf-8")
            elif route.startswith("/record/"):
                _, _, owner, campaign = route.split("/", 3)
                path = STATE / "campaigns" / owner / f"{campaign}.md"
                if not path.is_file():
                    self.send(404, page("Record", empty("No such campaign record.")))
                else:
                    body = (
                        f'<p class="meta"><a href="/?view=campaigns">&larr; campaigns</a> · '
                        f'<code>{esc(campaign)}</code> · '
                        f'<a href="/transcript/{urllib.parse.quote(owner)}/{urllib.parse.quote(campaign)}">transcript</a></p>'
                        + markdownish(path.read_text())
                    )
                    self.send(200, page("Campaign record", body, poll=False))
            elif route.startswith("/transcript/"):
                _, _, owner, campaign = route.split("/", 3)
                limit = int(query.get("limit", ["120"])[0])
                self.send(200, render_transcript(owner, campaign, limit))
            elif route.startswith("/raw/"):
                _, _, owner, campaign = route.split("/", 3)
                path = Path(adapter("transcript-path", owner, campaign).strip() or "/nonexistent")
                if not path.exists():
                    self.send(404, page("Transcript", empty("No such transcript.")))
                else:
                    self.send(200, path.read_text(errors="replace"), "text/plain; charset=utf-8")
            else:
                self.send(404, page("Not found", empty(f"No route {esc(route)}.")))
        except Exception as error:  # a dashboard that dies is worse than one that says so
            self.send(500, page("Error", f"<pre>{esc(repr(error))}</pre>"))

    def do_POST(self) -> None:
        route = urllib.parse.urlparse(self.path).path
        if route not in ("/answer", "/review"):
            self.send(404, page("Not found", empty("No such endpoint.")))
            return
        length = int(self.headers.get("Content-Length", "0"))
        raw = self.rfile.read(length).decode()
        fields = {k: v[0] for k, v in urllib.parse.parse_qs(raw, keep_blank_values=True).items()}
        try:
            code, message = (answer_decision if route == "/answer" else record_review)(fields)
        except Exception as error:
            self.send(500, page("Error", f"<pre>{esc(repr(error))}</pre>"))
            return
        if code == 303:
            self.send_response(303)
            self.send_header("Location", message)
            self.end_headers()
        else:
            self.send(code, page("Not written", f'<p class="empty">{esc(message)}</p><p><a href="/">back</a></p>'))


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--port", type=int, default=8787)
    parser.add_argument("--host", default="127.0.0.1")
    parser.add_argument("--no-open", action="store_true")
    args = parser.parse_args()

    server = ThreadingHTTPServer((args.host, args.port), Handler)
    url = f"http://{args.host}:{args.port}/"
    print(f"dashboard: {url}   (ctrl-c to stop)")
    if not args.no_open:
        webbrowser.open(url)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\ndashboard: stopped")
    return 0


if __name__ == "__main__":
    sys.exit(main())
