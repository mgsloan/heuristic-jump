        "<th>prompt</th><th>cli</th><th>started</th><th></th></tr></thead>"
        f"<tbody>{''.join(rows)}</tbody></table>",
        note="one campaign is one session — the campaign id is the session id, so there is nothing to correlate",
    )


def panel_interventions() -> str:
    """The log, and the three numbers `design/loops.md` section 16 says fall
    out of having it — none of which anything else in the design reports.

    They are here rather than under Cost because none of them is about money:
    they measure how much of this a human is doing, which question keeps coming
    back, and how long a loop waits on an answer."""
    rows = hj.intervention_rows()
    if not rows:
        return panel(
            "Interventions",
            empty("Nothing logged. Interventions per 100 experiments is the honest version of “close to one-shot”; nothing else in the design reports it."),
        )
    stats = hj.intervention_stats()

    def ratio(value) -> str:
        return f"{value:.1f}" if value is not None else "—"

    autonomy = "".join(
        "<tr>"
        f"<td>{esc(entry['phase'])}</td>"
        f"<td class='num'>{entry['interventions']}</td>"
        f"<td class='num'>{entry['experiments']:,}</td>"
        f"<td class='num'>{ratio(entry['per_100'])}</td>"
        "</tr>"
        for entry in stats["per_phase"]
    )

    def reading(kind: str) -> str:
        if kind in stats["recurring"]:
            return "a rule is missing from a prompt, or an exchange rate was never written down"
        if kind in hj.ROUTINE_KINDS:
            return '<span class="dim">one per event by construction — workload, not backlog</span>'
        return ""

    kinds = "".join(
        f"<tr><td>{esc(kind)}</td><td class='num'>{count}</td><td>{reading(kind)}</td></tr>"
        for kind, count in stats["by_kind"]
    )

    def hours(value) -> str:
        if value is None:
            return "—"
        return f"{value:.1f}h" if value < 48 else f"{value / 24:.1f}d"

    waiting = "".join(
        f"<tr class='live'><td><a href='#{esc(entry['id'])}'>{esc(entry['id'])}</a></td>"
        f"<td>{inline(entry['title'])}</td><td class='num warn'>{hours(entry.get('hours'))}</td></tr>"
        for entry in stats["waiting"]
    )
    answered = "".join(
        f"<tr><td>{esc(entry['id'])}</td><td>{inline(entry['title'])}</td>"
        f"<td class='num'>{hours(entry.get('hours'))}</td></tr>"
        for entry in stats["answered"]
    )

    # The reading half of "a git hook flags hand-authored commits". The hook
    # catches them as they are made and only once installed; this catches the
    # ones already in the history, and cannot be bypassed with `--no-verify`.
    unlogged = stats["unlogged_commits"]
    unlogged_block = ""
    if unlogged:
        commits = "".join(
            f"<tr><td><code>{esc(entry['commit'][:8])}</code></td>"
            f"<td>{esc(entry['ts'][:16])}</td><td>{inline(entry['subject'])}</td></tr>"
            for entry in unlogged[:20]
        )
        unlogged_block = f"""
        <article class="metrics">
          <h3>{len(unlogged)} hand-authored commit(s) with nothing in the log</h3>
          <table><thead><tr><th>commit</th><th>when</th><th>subject</th></tr></thead>
            <tbody>{commits}</tbody></table>
          <p class="note">Not a loop's, and not the harness's bookkeeping — so each is an
            intervention under one of section 16's kinds, and what is missing from each is the
            reasoning. <code>harness/hj install-hooks</code> puts the post-commit hook in place,
            which asks at the moment it is cheapest to answer.</p>
        </article>"""

    body = "".join(
        f"<tr><td>{esc(row.get('ts'))}</td><td>{esc(row.get('kind'))}</td><td>{esc(row.get('target'))}</td>"
        f"<td>{esc(row.get('answer'))}</td><td>{esc(row.get('rationale'))}</td></tr>"
        for row in reversed(rows)
    )
    return panel(
        "Interventions",
        f"""
        <article class="metrics">
          <h3>How autonomous this actually is</h3>
          <table><thead><tr><th>phase</th><th class="num">interventions</th>
            <th class="num">experiments</th><th class="num">per 100</th></tr></thead>
            <tbody>{autonomy}</tbody></table>
          <p class="note">An experiment is one gate run, which is the unit the committed/reverted/empty
            mix is composed from. This is the honest version of “close to one-shot”, and
            nothing else in the design reports it.</p>
        </article>
        <article class="metrics">
          <h3>Recurring kinds — the design backlog</h3>
          <table><thead><tr><th>kind</th><th class="num">count</th><th>what {hj.RECURRING_KIND} of them means</th></tr></thead>
            <tbody>{kinds}</tbody></table>
        </article>
        <article class="metrics">
          <h3>Time to answer</h3>
          <p class="headline"><strong>{hours(stats['median_hours'])}</strong> median
            <span class="note">the gap between an escalation appearing and being answered is time a
            loop spent idling on a provisional choice — it is the number that says whether this page
            is doing its job</span></p>
          <table><thead><tr><th>decision</th><th>question</th><th class="num">waited</th></tr></thead>
            <tbody>{waiting or ''}{answered}</tbody></table>
        </article>
        {unlogged_block}
        <details><summary>the log, {len(rows)} row(s)</summary>
        <table><thead><tr><th>when</th><th>kind</th><th>target</th><th>answer</th><th>rationale</th></tr></thead>
        <tbody>{body}</tbody></table></details>""",
        note=f"{len(rows)} logged; kinds are section 16's vocabulary, canonicalised on read",
    )


def current_campaign(loop: str = "") -> tuple[str, str] | None:
    """The campaign a transcript is still being written for, else the newest."""
    phase = hj.load_phase()
    newest = None
    for owner in ([loop] if loop and loop in phase.loops else phase.loops):
        for campaign in hj.campaigns_of(owner):
            identifier = campaign.get("campaign", "")
            if not identifier:
                continue
            newest = (owner, identifier)
            if not campaign.get("outcome"):
                return (owner, identifier)
    return newest


def panel_live(tail: int = 30, loop: str = "") -> str:
    """The last turns of the session that is running now.

    Reading a campaign while it works is the one thing `state/` cannot answer:
    the journal and the record are written at close, so until then the
    transcript is the only account of what it is doing.
    """
    current = current_campaign(loop)
    if current is None:
        return panel("Live", empty("No campaign has run yet."))
    owner, identifier = current
    path = Path(adapter("transcript-path", owner, identifier).strip() or "/nonexistent")
    if not path.exists():
        return panel("Live", empty(f"No transcript for {identifier[:8]} yet."))

    _, events = transcript_events(owner, identifier)
    running = campaign_is_running(identifier)
    state = "running" if running else "finished"
    head = (
        f'<p class="meta">campaign <code>{esc(identifier[:8])}</code> · {esc(state)} · '
        f'{len(events)} events · showing the last {min(tail, len(events))} · '
        f'<a href="/transcript/{urllib.parse.quote(owner)}/{urllib.parse.quote(identifier)}">whole transcript</a></p>'
    )
    start = max(0, len(events) - tail)
    body = "".join(
        render_event(event, index, owner, identifier)
        for index, event in enumerate(events[start:], start=start)
    )
    return panel(
        "Live",
        head + (body or empty("Nothing yet.")) + f"<script>{LAZY_SCRIPT}</script>",
        note="written as it happens; the journal is not",
    )


def campaign_is_running(identifier: str) -> bool:
    try:
        return hj.campaign_is_alive(identifier)
    except Exception:
        return False


def running_argv(*expected: str) -> bool:
    """Whether some process is running `harness/adapter <expected...>`.

    Confirmed against the process's real argv rather than by `pgrep -f`
    substring, which matches any command line that merely mentions the string —
    including the shell running this check. That has produced a false
    "running" here more than once.
    """
    result = subprocess.run(
        ["pgrep", "-f", f"adapter {' '.join(expected)}"], capture_output=True, text=True, check=False
    )
    for pid in result.stdout.split():
        try:
            argv = Path(f"/proc/{pid}/cmdline").read_bytes().decode().split("\0")
        except OSError:
            continue
        for index, argument in enumerate(argv):
            if argument.endswith("/adapter") and argv[index + 1 : index + 1 + len(expected)] == list(expected):
                return True
    return False


def live_audit_row() -> str:
    """The audit running now, as the first row.

    An audit is 40-60 turns and the only thing that moves the number, so a
    table that shows nothing while one runs is blank during the interesting
    part. Its transcript is `audit-<session>.jsonl.jsonl` — the adapter writes
    the stream beside the extracted text — so the newest of those is the one
    in flight.
    """
    if not audit_is_running():
        return ""
    root = Path(adapter("transcript-path", "x", "y").strip() or "").parent.parent
    candidates = sorted(root.glob("*/audit-*.jsonl.jsonl"), key=lambda p: p.stat().st_mtime)
    if not candidates:
        return ""
    newest = candidates[-1]
    progress = {}
    try:
        progress = json.loads(adapter("progress", str(newest)) or "{}")
    except json.JSONDecodeError:
        pass
    started = datetime.datetime.fromtimestamp(
        newest.stat().st_ctime, tz=datetime.timezone.utc
    )
    return (
        '<tr class="live">'
        '<td class="num">—</td>'
        f'<td>{esc(started.strftime("%b %d %H:%M"))} '
        f'<span class="good">running</span> '
        f'<span class="dim">{esc(elapsed(started.isoformat()))}</span></td>'
        # sections, overlap, closed, opened, persisted and the baseline are all
        # verdicts, and an audit in flight has reached none of them.
        '<td class="num dim">—</td><td class="num dim">—</td><td class="num dim">—</td>'
        '<td class="num dim">—</td><td class="num dim">—</td><td class="num dim">—</td>'
        f'<td class="num">{esc(progress.get("turns") or "—")}</td>'
        '<td class="num dim">—</td><td class="num dim">—</td>'
        "</tr>"
    )


def audit_is_running() -> bool:
    return running_argv("audit")


def campaign_state(identifier: str) -> tuple[str, str]:
    """What the campaign is doing, and the css class for saying so.

    A campaign whose process has exited is not therefore finished. `harness/
    loop` records the outcome *after* running the audit, and audits have taken
    forty to sixty turns, so there is a ten-minute window every cycle in which
    the campaign is gone and no outcome exists yet. Reporting that as "no
    process" reads as a crash; it is the normal close path.
    """
    if campaign_is_running(identifier):
        return "running", "good"
    if audit_is_running():
        return "closing · auditing", "good"
    if running_argv("campaign"):
        return "closing", "dim"
    return "no process", "warn"


