def current_campaign(loop: str = "") -> tuple[str, str] | None:
    """The campaign a transcript is still being written for, else the newest."""
    phase = hj.load_phase()
    newest = None
    for owner in ([loop] if loop and loop in phase.loops else phase.loops):
        for campaign in hj.campaigns_of(owner):
            identifier = campaign.get("campaign", "")
            if not identifier:
                continue
            newest = (owner, identifier)
            if not campaign.get("outcome"):
                return (owner, identifier)
    return newest


def panel_live(tail: int = 30, loop: str = "") -> str:
    """The last turns of the session that is running now.

    Reading a campaign while it works is the one thing `state/` cannot answer:
    the journal and the record are written at close, so until then the
    transcript is the only account of what it is doing.
    """
    current = current_campaign(loop)
    if current is None:
        return panel("Live", empty("No campaign has run yet."))
    owner, identifier = current
    path = Path(adapter("transcript-path", owner, identifier).strip() or "/nonexistent")
    if not path.exists():
        return panel("Live", empty(f"No transcript for {identifier[:8]} yet."))

    events = [json.loads(line) for line in adapter("parse-stream", str(path)).splitlines() if line.strip()]
    running = campaign_is_running(identifier)
    state = "running" if running else "finished"
    head = (
        f'<p class="meta">campaign <code>{esc(identifier[:8])}</code> · {esc(state)} · '
        f'{len(events)} events · showing the last {min(tail, len(events))} · '
        f'<a href="/transcript/{urllib.parse.quote(owner)}/{urllib.parse.quote(identifier)}">whole transcript</a></p>'
    )
    body = "".join(render_event(event) for event in events[-tail:])
    return panel("Live", head + (body or empty("Nothing yet.")), note="written as it happens; the journal is not")


def campaign_is_running(identifier: str) -> bool:
    try:
        return hj.campaign_is_alive(identifier)
    except Exception:
        return False


def running_argv(*expected: str) -> bool:
    """Whether some process is running `harness/adapter <expected...>`.

    Confirmed against the process's real argv rather than by `pgrep -f`
    substring, which matches any command line that merely mentions the string —
    including the shell running this check. That has produced a false
    "running" here more than once.
    """
    result = subprocess.run(
        ["pgrep", "-f", f"adapter {' '.join(expected)}"], capture_output=True, text=True, check=False
    )
    for pid in result.stdout.split():
        try:
            argv = Path(f"/proc/{pid}/cmdline").read_bytes().decode().split("\0")
        except OSError:
            continue
        for index, argument in enumerate(argv):
            if argument.endswith("/adapter") and argv[index + 1 : index + 1 + len(expected)] == list(expected):
                return True
    return False


def audit_is_running() -> bool:
    return running_argv("audit")


def campaign_state(identifier: str) -> tuple[str, str]:
    """What the campaign is doing, and the css class for saying so.

    A campaign whose process has exited is not therefore finished. `harness/
    loop` records the outcome *after* running the audit, and audits have taken
    forty to sixty turns, so there is a ten-minute window every cycle in which
    the campaign is gone and no outcome exists yet. Reporting that as "no
    process" reads as a crash; it is the normal close path.
    """
    if campaign_is_running(identifier):
        return "running", "good"
    if audit_is_running():
        return "closing · auditing", "good"
    if running_argv("campaign"):
        return "closing", "dim"
    return "no process", "warn"


