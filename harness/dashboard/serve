HARNESS = Path(__file__).resolve().parent.parent
REPO = HARNESS.parent


def load_hj():
    """`harness/hj` has no extension on purpose — it is a command, not a
    library — so it is loaded by path rather than imported by name. Sharing it
    matters more than the awkwardness: a dashboard that computed
    `sections clean` its own way would eventually disagree with the gate."""
    spec = importlib.util.spec_from_loader(
        "hj", importlib.machinery.SourceFileLoader("hj", str(HARNESS / "hj"))
    )
    sys.dont_write_bytecode = True  # no __pycache__ inside a directory nobody owns
    module = importlib.util.module_from_spec(spec)
    # Registered before execution because `@dataclass` resolves annotations
    # through `sys.modules[cls.__module__]`, which is not there yet otherwise.
    sys.modules["hj"] = module
    spec.loader.exec_module(module)
    return module


hj = load_hj()
STATE = hj.STATE


# --------------------------------------------------------------------------
# Reading what the loops wrote


FRONTMATTER = re.compile(r"\A---\n(?P<body>.*?)\n---\n", re.DOTALL)


def parse_decision(path: Path, answers: dict[str, dict] | None = None) -> dict:
    text = path.read_text()
    meta: dict[str, str] = {}
    match = FRONTMATTER.match(text)
    body = text
    if match:
        for line in match.group("body").splitlines():
            if ":" in line:
                key, _, value = line.partition(":")
                meta[key.strip()] = value.strip()
        body = text[match.end() :]

    sections: dict[str, str] = {}
    current = "preamble"
    collected: list[str] = []
    for line in body.splitlines():
        if line.startswith("## "):
            sections[current] = "\n".join(collected).strip()
            current = line[3:].strip().lower()
            collected = []
        else:
            collected.append(line)
    sections[current] = "\n".join(collected).strip()

    title = ""
    for line in body.splitlines():
        if line.startswith("# "):
            title = line[2:].strip()
            break

    identifier = meta.get("id") or path.stem
    return {
        "id": identifier,
        "path": str(path.relative_to(REPO)),
        # From the log, not from the frontmatter this page itself edits.
        # `design/loops.md` section 16 makes the log the mechanism rather than
        # a record of it, so a status hand-written into a record with no
        # intervention behind it does not count as an answer.
        "status": hj.decision_status(identifier, meta.get("status"), answers),
        "recorded_status": meta.get("status", "unknown"),
        # Ruled on in the file, with no rationale in the log behind it.
        "unlogged": hj.decision_unlogged(identifier, meta.get("status"), answers),
        "kind": meta.get("kind", "class-b"),
        "opened": meta.get("opened", ""),
        "campaign": meta.get("campaign", ""),
        "title": title or identifier,
        "sections": sections,
        "tagged": tagged_sites(identifier),
    }


def tagged_sites(identifier: str) -> list[str]:
    result = subprocess.run(
        ["git", "-C", str(REPO), "grep", "-n", "-F", f"DECISION-{identifier}:"],
        capture_output=True,
        text=True,
        check=False,
    )
    return [line for line in result.stdout.splitlines() if line][:40]


def decisions() -> list[dict]:
    directory = STATE / "decisions"
    if not directory.exists():
        return []
    answers = hj.decision_answers()
    return sorted(
        (parse_decision(p, answers) for p in directory.glob("*.md")), key=lambda d: d["id"]
    )


def version_token() -> str:
    """Moves when anything the page shows moves. Cheap enough to compute on a
    two-second poll: a stat of every tracked state file, the live transcript,
    and HEAD.

    The transcript is in the list because it is not under `state/` and is the
    only thing here that moves continuously. Without it the Live panel — the
    one panel whose whole purpose is to be watched while a campaign runs —
    updated only when the campaign next committed, which is minutes apart and
    is exactly the interval it exists to fill.
    """
    stamps = []
    for path in sorted(STATE.rglob("*")):
        if path.is_file():
            stamps.append(f"{path}:{path.stat().st_mtime_ns}")
    current = current_campaign()
    if current:
        live = Path(adapter("transcript-path", *current).strip() or "/nonexistent")
        if live.exists():
            stamps.append(f"{live}:{live.stat().st_size}")
    try:
        stamps.append(hj.head_sha())
    except SystemExit:
        pass
    return str(hash("|".join(stamps)))


# --------------------------------------------------------------------------
# Rendering


def esc(value) -> str:
    return html.escape(str(value if value is not None else ""))


def markdownish(text: str) -> str:
    """Not a markdown renderer. The state files are written by a model under a
    template, and the four constructs it actually uses — paragraphs, list
    items, inline code, bold — are worth the twenty lines. Anything else falls
    through as text, which is the failure mode you want."""
    out = []
    for block in re.split(r"\n\s*\n", text.strip()):
        lines = block.splitlines()
        if all(line.lstrip().startswith(("- ", "* ", "1. ")) for line in lines if line.strip()):
            items = "".join(f"<li>{inline(re.sub(r'^\s*([-*]|\d+\.)\s+', '', l))}</li>" for l in lines if l.strip())
            out.append(f"<ul>{items}</ul>")
        else:
            out.append(f"<p>{inline(block)}</p>")
    return "".join(out)


def inline(text: str) -> str:
    escaped = esc(text)
    escaped = re.sub(r"`([^`]+)`", r"<code>\1</code>", escaped)
    escaped = re.sub(r"\*\*([^*]+)\*\*", r"<strong>\1</strong>", escaped)
    return escaped


def panel(title: str, body: str, note: str = "") -> str:
    subtitle = f'<span class="note">{esc(note)}</span>' if note else ""
    return f'<section class="panel"><h2>{esc(title)}{subtitle}</h2>{body}</section>'


def empty(message: str) -> str:
    return f'<p class="empty">{esc(message)}</p>'


# --- panel 1: decisions waiting -------------------------------------------


def decision_form(decision: dict) -> str:
    return f"""
    <form class="answer" method="post" action="/answer">
      <input type="hidden" name="id" value="{esc(decision['id'])}">
      <label>Ruling
        <select name="status">
          <option value="accepted">accepted — take the option below</option>
          <option value="rejected">rejected — do not do this</option>
          <option value="superseded">superseded — the question changed</option>
        </select>
      </label>
      <label>Answer
        <textarea name="answer" rows="3" placeholder="Which option, concretely."></textarea>
      </label>
      <label>Rationale <span class="required">required</span>
        <textarea name="rationale" rows="4" required
          placeholder="Why. A decision with no recorded reason is one you re-litigate in three weeks — and the loop cannot use it, because half the point is that a later campaign reads this and applies it to a case nobody anticipated."></textarea>
      </label>
      <button type="submit">Answer and log</button>
    </form>"""


def decision_card(decision: dict) -> str:
    # Section 16's evidence table asks a Class B card for "options,
    # recommendation, the provisional choice in force, and the sites". The
    # record template has no separate recommendation, and deliberately: the
    # provisional choice *is* the loop's recommendation — section 14 calls it
    # "what a human is really ruling on when the answer arrives". Said here so
    # a reader is not looking for a field that does not exist.
    wanted = {
        "context": "context",
        "options": "options",
        "provisional choice in force": "provisional choice in force — the loop's recommendation, and what you are ruling on",
        "consequences": "consequences",
        "decision": "decision",
    }
    parts = []
    for name, label in wanted.items():
        body = decision["sections"].get(name)
        if body:
            parts.append(f'<div class="field"><h4>{esc(label)}</h4>{markdownish(body)}</div>')
    if decision["tagged"]:
        sites = "".join(f"<li><code>{esc(line)}</code></li>" for line in decision["tagged"])
        parts.append(f'<div class="field"><h4>sites running on the provisional choice</h4><ul class="sites">{sites}</ul></div>')
    else:
        parts.append('<div class="field"><h4>sites running on the provisional choice</h4><p class="empty">No <code>DECISION-</code> tag found in the tree.</p></div>')

    # Two ways the record and the log come apart, and they are different
    # problems: a stale frontmatter is cosmetic, a ruling with no logged
    # reasoning is the one section 16 says you will re-litigate in three weeks.
    if decision["unlogged"]:
        drifted = (
            f"ruled {decision['recorded_status']} in the record, with nothing in the "
            "intervention log — the ruling stands; the reasoning a later campaign would "
            "read is missing. Give it below and it is logged."
        )
    elif decision["recorded_status"] != decision["status"]:
        drifted = f"frontmatter says {decision['recorded_status']}; the log says {decision['status']}, and the log is what counts"
    else:
        drifted = ""
    meta = " · ".join(
        filter(None, [decision["kind"], decision["opened"], f"campaign {decision['campaign'][:8]}" if decision["campaign"] else "", decision["path"], drifted])
    )
    return f"""
    <article class="decision" id="{esc(decision['id'])}">
      <h3>{esc(decision['id'])} — {inline(decision['title'])}</h3>
      <p class="meta">{esc(meta)}</p>
      {''.join(parts)}
      {decision_form(decision)}
    </article>"""


def stalled_loop() -> str:
    """Which loop wrote `state/handoff.md`.

    One file, shared, because a stall stops the loop that wrote it and nothing
    else — so the writer is the loop currently over its `stall_n`. Falls back
    to the loop whose last campaign is newest, which is the right guess for a
    handoff that has already been answered but not deleted.
    """
    phase = hj.load_phase()
    over = [
        owner
        for owner, config in phase.loops.items()
        if hj.trailing_without_progress(owner) >= config.stall_n or config.status == "blocked"
    ]
    if over:
        return sorted(over)[0]
    newest, when = "", ""
    for owner in phase.loops:
        for campaign in hj.campaigns_of(owner):
            ended = campaign.get("ended") or ""
            if ended > when:
                newest, when = owner, ended
    return newest


def journal_excerpt(owner: str, entries: int = 1) -> str:
    """The last entries of a loop's journal.

    `design/loops.md` section 16's evidence table asks a stall handoff for the
    journal excerpt, and the reason is in section 4: the journal is where a
    campaign writes what it tried and why it failed, which is exactly what a
    human unblocking a stall needs and is not in the handoff's own summary.
    """
    path = STATE / "journal" / f"{owner}.md"
    if not path.is_file():
        return ""
    parts = re.split(r"(?m)^##\s", path.read_text())
    return "\n\n".join(f"## {part.strip()}" for part in parts[-entries:] if part.strip())


def handoff_card() -> str:
    path = STATE / "handoff.md"
    if not path.exists():
        return ""
    owner = stalled_loop()
    campaigns = list(reversed(hj.campaigns_of(owner)))[:5] if owner else []
    tried = "".join(
        f"<tr><td><a href='/record/{urllib.parse.quote(owner)}/{urllib.parse.quote(row.get('campaign', ''))}'>"
        f"<code>{esc(row.get('campaign', '')[:8])}</code></a></td>"
        f"<td>{target_links(row.get('target'))}</td>"
        f"<td>{esc(row.get('outcome') or 'open')}</td>"
        f"<td class='num'>{esc(row.get('commits'))}</td>"
        f"<td>{'progress' if row.get('progress') else '<span class=\"warn\">none</span>'}</td></tr>"
        for row in campaigns
    )
    record = ""
    if campaigns:
        identifier = campaigns[0].get("campaign", "")
        body = (STATE / "campaigns" / owner / f"{identifier}.md")
        if body.is_file():
            record = (
                f'<div class="field"><h4>the campaign record it stopped on</h4>'
                f'<details><summary><code>{esc(identifier[:8])}</code> — '
                f'<a href="/record/{urllib.parse.quote(owner)}/{urllib.parse.quote(identifier)}">whole record</a>'
                f'</summary>{markdownish(body.read_text())}</details></div>'
            )
    excerpt = journal_excerpt(owner)
    journal = (
        f'<div class="field"><h4>journal — what was tried, and why it failed</h4>'
        f"<details><summary>state/journal/{esc(owner)}.md, last entry</summary>"
        f"{markdownish(excerpt)}</details></div>"
        if excerpt
        else ""
    )
    return f"""
    <article class="decision stall">
      <h3>Stall handoff — {esc(owner or 'unknown loop')}</h3>
      <p class="meta">state/handoff.md — the loop stopped and asked. It will not start again until you set it back to <code>running</code> in <code>state/phase.toml</code>.</p>
      {markdownish(path.read_text())}
      <div class="field"><h4>what was tried</h4>
        <table class="campaigns"><thead><tr><th>campaign</th><th>target</th><th>outcome</th>
          <th class="num">commits</th><th>moved the number</th></tr></thead>
          <tbody>{tried or '<tr><td colspan="5">no campaigns recorded</td></tr>'}</tbody></table></div>
      {record}
      {journal}
    </article>"""


