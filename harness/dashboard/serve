def panel_sections(loop: str = "") -> str:
    """The work queue at section granularity. Its own view because it is long
    and answers a different question from the overview: not "is this going
    well" but "what exactly is left"."""
    phase = hj.load_phase()
    blocks = []
    for owner, config in sorted(phase.loops.items()):
        if loop and owner != loop:
            continue
        buckets: dict[str, list[str]] = {"gaps": [], "unjudged": [], "clean": []}
        for doc in config.docs:
            verdicts = hj.read_audit(doc)
            for section in hj.sections_of(doc):
                verdict = verdicts.get(section.key)
                state = verdict.state if verdict else "unjudged"
                detail = ""
                if verdict and verdict.gaps:
                    items = "".join(
                        f"<li><code>{esc(hj.gap_id(section.key, gap.claim))}</code> "
                        f"<strong>{esc(gap.claim)}</strong><br>{esc(gap.found)}<br>"
                        f"<code>{esc(gap.where)}</code></li>"
                        for gap in verdict.gaps
                    )
                    detail += f"<ul class='gaps'>{items}</ul>"
                if verdict and verdict.minors:
                    items = "".join(
                        f"<li>{esc(minor.claim)} — {esc(minor.note)} <code>{esc(minor.where)}</code></li>"
                        for minor in verdict.minors
                    )
                    detail += f"<ul class='minors'>{items}</ul>"
                buckets[state].append(
                    f"<tr class='{state}'><td><code>{esc(section.anchor)}</code></td>"
                    f"<td>{esc(section.heading)}</td><td class='state'>{esc(state)}</td>"
                    f"<td>{detail}</td></tr>"
                )

        header = "<thead><tr><th>anchor</th><th>section</th><th>state</th><th>gaps and minor items</th></tr></thead>"

        def table_of(state: str, rows: dict = buckets) -> str:
            return f'<table class="sections">{header}<tbody>{"".join(rows[state])}</tbody></table>'

        outstanding = (
            table_of("gaps")
            if buckets["gaps"]
            else empty("No section in scope has a gap. What is left is the unjudged list, and the minor items.")
        )
        folded = "".join(
            f'<details><summary>{len(buckets[state])} section(s) {label}</summary>{table_of(state)}</details>'
            for state, label in (("unjudged", "not reached yet"), ("clean", "clean"))
            if buckets[state]
        )
        blocks.append(f'<article class="metrics"><h3>{esc(owner)}</h3>{outstanding}{folded}</article>')
    return panel("Sections and gaps", "".join(blocks), note="gap ids are what a campaign names in its target")


def mix(row: dict) -> str:
    """`design/loops.md` section 15's health signal, in the shape it names it:
    a campaign that is mostly empty experiments is stalling regardless of what
    it spent. Rows written before the field existed read as an em dash rather
    than as three zeroes, which would be a claim."""
    experiments = row.get("experiments") or {}
    if not experiments:
        return "—"
    return (
        f"{experiments.get('committed', 0)}/"
        f"{experiments.get('reverted', 0)}/"
        f"{experiments.get('empty', 0)}"
    )


def panel_cost(loop: str = "") -> str:
    """`design/loops.md` section 15's derived number is the one that should
    drive stopping decisions: cost per unit of progress, which should *rise*
    over a run as the easy wins are exhausted. A rising curve is the economic
    form of the frontier flattening, and it usually turns up before the
    frontier visibly stalls."""
    phase = hj.load_phase()
    blocks = []
    for owner in sorted(phase.loops):
        if loop and owner != loop:
            continue
        # Merged by campaign id rather than read straight off the file: it is
        # append-only, so a re-measured campaign has more than one row and
        # summing the lines would count its spend twice.
        everything = hj.cost_rows(owner)
        if not everything:
            continue
        rows = [r for r in everything if r.get("kind") != "audit"]
        audits = [r for r in everything if r.get("kind") == "audit"]
        audit_usd = sum(r.get("usd") or 0 for r in audits)
        total = sum(r.get("usd") or 0 for r in everything)
        output = sum(r.get("output_tokens") or 0 for r in rows)
        minutes = sum(r.get("model_seconds") or 0 for r in rows) / 60
        gate_minutes = sum(r.get("gate_seconds") or 0 for r in rows) / 60

        def share(name: str) -> int:
            return sum((r.get("experiments") or {}).get(name, 0) for r in rows)

        committed, reverted, empty = share("committed"), share("reverted"), share("empty")
        progressed = [r for r in rows if r.get("progress")]
        per_progress = (total / len(progressed)) if progressed else None
        per_progress_tokens = (output / len(progressed)) if progressed else None

        body = "".join(
            "<tr>"
            f"<td><code>{esc((r.get('campaign') or '')[:8])}</code></td>"
            f"<td>{esc(r.get('target') or '—')}</td>"
            f"<td>{esc(r.get('outcome'))}</td>"
            f"<td class='num'>${(r.get('usd') or 0):.2f}</td>"
            f"<td class='num'>{(r.get('output_tokens') or 0):,}</td>"
            f"<td class='num'>{(r.get('model_seconds') or 0) / 60:.0f}m</td>"
            f"<td class='num'>{(r.get('gate_seconds') or 0) / 60:.0f}m</td>"
            f"<td class='num'>{esc(r.get('turns'))}</td>"
            f"<td class='num'>{esc(mix(r))}</td>"
            f"<td>{'yes' if r.get('progress') else 'no'}</td>"
            "</tr>"
            for r in rows
        )
        spend = [r.get("usd") or 0 for r in rows]
        running = 0.0
        cumulative = []
        for row in everything:
            running += row.get("usd") or 0
            cumulative.append(running)
        chart = line_chart(
            [("spent", "var(--series-1)", cumulative)],
            "API-equivalent spend, cumulative",
            "one point per campaign or audit",
        )
        blocks.append(f"""
        <article class="metrics">
          <h3>{esc(owner)}</h3>
          <p class="headline"><strong>{output:,}</strong> output tokens over {len(rows)} campaigns
            <span class="note">{minutes:.0f} model-minutes · {gate_minutes:.0f} of them in the gate ·
            {committed}/{reverted}/{empty} experiments committed/reverted/empty ·
            API-equivalent ${total:.2f}, of which ${audit_usd:.2f} in {len(audits)} audit session(s)</span></p>
          <p class="headline" style="font-size:16px">{('%.0f' % per_progress_tokens) if per_progress_tokens else '—'} output tokens
            <span class="note">per campaign that made progress — this is the number that says when to stop,
            and it should rise as the easy wins are exhausted</span></p>
          <p class="note"><strong>API-equivalent is not a bill.</strong> It is the CLI's valuation of the
            tokens at pay-as-you-go list prices, carried in each session's result event. On a flat
            subscription it is a usage magnitude, useful for comparing campaigns against each other and for
            what <code>--max-budget-usd</code> measures itself against — not for what you are charged.</p>
          <div class="charts">{chart}</div>
          <details><summary>per campaign</summary>
          <table><thead><tr><th>campaign</th><th>target</th><th>outcome</th><th class="num">API-eq $</th>
            <th class="num">output</th><th class="num">model</th><th class="num">gate</th>
            <th class="num">turns</th><th class="num" title="committed / reverted / empty">c/r/e</th>
            <th>progress</th></tr></thead><tbody>{body}</tbody></table></details>
        </article>""")

    if not blocks:
        return panel(
            "Cost",
            empty(
                "No campaign has closed yet. Rows are written by `harness/hj cost`, "
                "which the loop runs at each close."
            ),
        )
    return panel("Cost", "".join(blocks), note="per campaign, because the campaign is the unit of decision")


