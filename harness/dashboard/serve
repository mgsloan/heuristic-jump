def adapter(*args: str) -> str:
    """Everything vendor-specific goes through `harness/adapter`
    (`design/loops.md` section 17): the transcript layout and the stream's
    record shapes are one CLI's product surface, and this page should not be
    the third place that knows them."""
    result = subprocess.run(
        [str(HARNESS / "adapter"), *args], capture_output=True, text=True, check=False
    )
    return result.stdout if result.returncode == 0 else ""


def render_transcript(owner: str, campaign: str, limit: int) -> str:
    path = Path(adapter("transcript-path", owner, campaign).strip() or "/nonexistent")
    if not path.exists():
        return page("Transcript", empty(f"No transcript at {esc(path)}."))

    events = []
    for line in adapter("parse-stream", str(path)).splitlines():
        if line.strip():
            events.append(json.loads(line))

    parts = []
    for event in events[:limit]:
        parts.append(render_event(event))

    more = ""
    if len(events) > limit:
        more = (
            f'<p><a href="/transcript/{urllib.parse.quote(owner)}/{urllib.parse.quote(campaign)}'
            f'?limit={limit * 4}">show more</a> · '
            f'<a href="/raw/{urllib.parse.quote(owner)}/{urllib.parse.quote(campaign)}">raw</a></p>'
        )

    header = (
        f'<p class="meta"><a href="/">&larr; dashboard</a> · {esc(owner)} · <code>{esc(campaign)}</code> · '
        f'{len(events)} events · <a href="/raw/{urllib.parse.quote(owner)}/{urllib.parse.quote(campaign)}">raw</a></p>'
    )
    return page("Transcript", header + "".join(parts) + more, poll=False)


GATE_LINE = re.compile(r"^(GATE (?:PASSED|FAILED).*|--- \d+\..*|scope: .*|audit: .*|metrics: .*)$", re.MULTILINE)


def truncate(text: str, keep: int = 1200) -> tuple[str, bool]:
    return (text[:keep], True) if len(text) > keep else (text, False)


def render_event(event: dict) -> str:
    kind = event.get("kind")
    if kind == "text":
        return f'<div class="turn text">{markdownish(event.get("text", ""))}</div>'
    if kind == "thinking":
        body, _ = truncate(event.get("text", ""), 4000)
        return f'<details class="turn thinking"><summary>thinking</summary><pre>{esc(body)}</pre></details>'
    if kind == "tool":
        name = event.get("name", "?")
        if event.get("diff"):
            body = render_diff(event["diff"])
        else:
            body = f'<pre>{esc(json.dumps(event.get("input", {}), indent=2)[:4000])}</pre>'
        return (
            f'<details class="turn tool"><summary><span class="tool-name">{esc(name)}</span> '
            f'<code>{esc(str(event.get("summary", ""))[:160])}</code></summary>{body}</details>'
        )
    if kind == "tool_result":
        return render_result(event.get("text", ""))
    if kind == "result":
        # Verbatim: the last two lines are the TARGET / OUTCOME contract the
        # runner reads, and reflowing them hides whether they were actually on
        # their own lines.
        return f'<div class="turn result"><h4>result</h4><pre>{esc(event.get("text", ""))}</pre></div>'
    return ""


def render_diff(diff: dict) -> str:
    lines = [f'<span class="del">-{esc(line)}</span>' for line in str(diff.get("old", "")).splitlines()]
    lines += [f'<span class="add">+{esc(line)}</span>' for line in str(diff.get("new", "")).splitlines()]
    return f'<pre class="diff">{"<br>".join(lines)}</pre>'


def render_result(text: str) -> str:
    # The gate's verdict and a metrics row are the decision points the rest of
    # the turn is reasoning about, so they come out of the fold.
    highlights = GATE_LINE.findall(text)
    banner = ""
    if highlights:
        css = "bad" if any(line.startswith("GATE FAILED") for line in highlights) else "good"
        banner = f'<pre class="highlight {css}">{esc(chr(10).join(highlights[:20]))}</pre>'

    body, truncated = truncate(text)
    tail = '<p class="note">truncated</p>' if truncated else ""
    return (
        f'{banner}<details class="turn result-block"><summary>tool result '
        f'({len(text)} bytes)</summary><pre>{esc(body)}</pre>{tail}</details>'
    )


