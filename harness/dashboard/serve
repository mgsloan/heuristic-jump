# --------------------------------------------------------------------------
# The transcript view


def adapter(*args: str) -> str:
    """Everything vendor-specific goes through `harness/adapter`
    (`design/loops.md` section 17): the transcript layout and the stream's
    record shapes are one CLI's product surface, and this page should not be
    the third place that knows them."""
    result = subprocess.run(
        [str(HARNESS / "adapter"), *args], capture_output=True, text=True, check=False
    )
    return result.stdout if result.returncode == 0 else ""


# Land at the newest event rather than the oldest. `scrollRestoration` is
# turned off first because otherwise the browser puts back the offset from
# last visit on a reload, which on a transcript that has grown since is a
# position part-way up rather than either end.
TAIL_SCRIPT = """
history.scrollRestoration = 'manual';
const bottom = () => window.scrollTo(0, document.body.scrollHeight);
bottom();
addEventListener('load', bottom);
"""

# Both halves of section 16's "lazy loading, and truncation of large tool
# results with expand-on-demand". Nothing is fetched until it is clicked, and
# loading an earlier window keeps the reading position: prepending above the
# viewport would otherwise jump the page by the height of what arrived.
LAZY_SCRIPT = """
addEventListener('click', async (event) => {
  const button = event.target.closest('button.load, button.rest');
  if (!button) return;
  const label = button.textContent;
  button.textContent = 'loading…';
  button.disabled = true;
  try {
    if (button.classList.contains('rest')) {
      const rest = await (await fetch(button.dataset.src)).text();
      const block = button.closest('details').querySelector('pre');
      block.textContent += rest;
      button.closest('p').remove();
      return;
    }
    const before = document.body.scrollHeight;
    const html = await (await fetch(button.dataset.src + '?end=' + button.dataset.end)).text();
    const holder = button.closest('p');
    holder.insertAdjacentHTML('afterend', html);
    holder.remove();
    window.scrollBy(0, document.body.scrollHeight - before);
  } catch (error) {
    button.textContent = label + ' — failed, click to retry';
    button.disabled = false;
  }
});
"""


# How many events a transcript view renders at once. `design/loops.md`
# section 16 asks for lazy loading by name, and the reason is concrete: a
# campaign that read fifty files inlines every one of them, and at 2 MB a
# transcript dumped into a tab is worse than useless. 150 is about one
# screenful of turns.
WINDOW = 150


def transcript_events(owner: str, campaign: str) -> tuple[Path, list[dict]]:
    path = Path(adapter("transcript-path", owner, campaign).strip() or "/nonexistent")
    if not path.exists():
        return path, []
    events = []
    for line in adapter("parse-stream", str(path)).splitlines():
        if line.strip():
            events.append(json.loads(line))
    return path, events


def earlier_button(owner: str, campaign: str, end: int) -> str:
    """Fetches the previous window and prepends it. Nothing loads until it is
    asked for, which is the whole point — the alternative is a tab that
    freezes on the transcripts most worth reading."""
    if end <= 0:
        return ""
    return (
        f'<p class="earlier"><button class="load" data-end="{end}" '
        f'data-src="/transcript-part/{urllib.parse.quote(owner)}/{urllib.parse.quote(campaign)}">'
        f"load the {min(WINDOW, end)} events before this</button> "
        f'<span class="note">{end} earlier event(s) not loaded</span></p>'
    )


def rendered_prompt(owner: str, campaign: str) -> str:
    """The prompt this campaign was given, as the first thing on its page.

    `design/loops.md` §16 reads a turn as prompt, thinking, tool calls,
    results, text. The stream carries the last four and never the first — the
    vendor does not echo it — so until `campaign-open` began keeping the
    rendered file, every transcript here started mid-conversation. The session
    row's `prompt_sha` says which prompt and never what it said, and what a
    reader usually wants is the spliced part: which gaps this campaign was
    handed, and what the digest above them claimed.

    Collapsed, because it is long and it is context rather than the story.
    """
    path = Path(adapter("prompt-path", owner, campaign).strip() or "/nonexistent")
    if not path.exists():
        return (
            '<p class="note">The rendered prompt was not kept for this campaign. '
            "Campaigns opened before it was retained have only their <code>prompt_sha</code>.</p>"
        )
    text = path.read_text(errors="replace")
    return (
        f'<details class="turn prompt"><summary>prompt ({len(text):,} bytes)</summary>'
        f"<pre>{esc(text)}</pre></details>"
    )


def render_transcript(owner: str, campaign: str) -> str:
    path, events = transcript_events(owner, campaign)
    if not events:
        return page("Transcript", empty(f"No transcript at {esc(path)}."))

    start = max(0, len(events) - WINDOW)
    parts = [
        render_event(event, index, owner, campaign)
        for index, event in enumerate(events[start:], start=start)
    ]

    header = (
        f'<p class="meta"><a href="/">&larr; dashboard</a> · {esc(owner)} · <code>{esc(campaign)}</code> · '
        f'{len(events)} events, showing the last {len(parts)} · '
        f'<a href="/raw/{urllib.parse.quote(owner)}/{urllib.parse.quote(campaign)}">raw</a></p>'
    )
    return page(
        "Transcript",
        header
        # Above the window rather than inside it: the prompt is turn zero and
        # the window loads backwards from the end, so an event-stream position
        # would put it behind however many "load earlier" clicks the campaign
        # was long.
        + rendered_prompt(owner, campaign)
        + '<div id="events">'
        + earlier_button(owner, campaign, start)
        + "".join(parts)
        + "</div>"
        + f"<script>{TAIL_SCRIPT}{LAZY_SCRIPT}</script>",
        poll=False,
    )


def render_transcript_part(owner: str, campaign: str, end: int) -> str:
    """One earlier window, as a fragment: the button that asked for it is
    replaced by the events plus a button for the window before that."""
    _, events = transcript_events(owner, campaign)
    end = max(0, min(end, len(events)))
    start = max(0, end - WINDOW)
    return earlier_button(owner, campaign, start) + "".join(
        render_event(event, index, owner, campaign)
        for index, event in enumerate(events[start:end], start=start)
    )


GATE_LINE = re.compile(r"^(GATE (?:PASSED|FAILED).*|--- \d+\..*|scope: .*|audit: .*|metrics: .*)$", re.MULTILINE)


def truncate(text: str, keep: int = 1200) -> tuple[str, bool]:
    return (text[:keep], True) if len(text) > keep else (text, False)


def render_event(event: dict, index: int = -1, owner: str = "", campaign: str = "") -> str:
    kind = event.get("kind")
    if kind == "text":
        return f'<div class="turn text">{markdownish(event.get("text", ""))}</div>'
    if kind == "thinking":
        body, _ = truncate(event.get("text", ""), 4000)
        return f'<details class="turn thinking"><summary>thinking</summary><pre>{esc(body)}</pre></details>'
    if kind == "tool":
        name = event.get("name", "?")
        if event.get("diff"):
            body = render_diff(event["diff"])
        else:
            body = f'<pre>{esc(json.dumps(event.get("input", {}), indent=2)[:4000])}</pre>'
        return (
            f'<details class="turn tool"><summary><span class="tool-name">{esc(name)}</span> '
            f'<code>{esc(str(event.get("summary", ""))[:160])}</code></summary>{body}</details>'
        )
    if kind == "tool_result":
        return render_result(event.get("text", ""), index, owner, campaign)
    if kind == "result":
        # Verbatim: the last two lines are the TARGET / OUTCOME contract the
        # runner reads, and reflowing them hides whether they were actually on
        # their own lines.
        return f'<div class="turn result"><h4>result</h4><pre>{esc(event.get("text", ""))}</pre></div>'
    return ""


def render_diff(diff: dict) -> str:
    lines = [f'<span class="del">-{esc(line)}</span>' for line in str(diff.get("old", "")).splitlines()]
    lines += [f'<span class="add">+{esc(line)}</span>' for line in str(diff.get("new", "")).splitlines()]
    return f'<pre class="diff">{"<br>".join(lines)}</pre>'


def render_result(text: str, index: int = -1, owner: str = "", campaign: str = "") -> str:
    # The gate's verdict and a metrics row are the decision points the rest of
    # the turn is reasoning about, so they come out of the fold.
    highlights = GATE_LINE.findall(text)
    banner = ""
    if highlights:
        css = "bad" if any(line.startswith("GATE FAILED") for line in highlights) else "good"
        banner = f'<pre class="highlight {css}">{esc(chr(10).join(highlights[:20]))}</pre>'

    body, truncated = truncate(text)
    # Expand-on-demand rather than a dead end. The rest is fetched when asked
    # for, so a fifty-file campaign does not ship fifty files to the browser to
    # show fifty summaries — which is the same reason the page is windowed.
    tail = ""
    if truncated:
        rest = (
            f' <button class="rest" data-src="/event/{urllib.parse.quote(owner)}/'
            f'{urllib.parse.quote(campaign)}/{index}">show the remaining '
            f"{len(text) - len(body):,} bytes</button>"
            if index >= 0 and owner and campaign
            else ""
        )
        tail = f'<p class="note">truncated at {len(body):,} bytes{rest}</p>'
    return (
        f'{banner}<details class="turn result-block"><summary>tool result '
        f'({len(text):,} bytes)</summary><pre>{esc(body)}</pre>{tail}</details>'
    )


