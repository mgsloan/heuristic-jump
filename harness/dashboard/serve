# The server


class Handler(BaseHTTPRequestHandler):
    server_version = "heuristic-jump-dashboard"

    def log_message(self, fmt, *args):
        if self.path not in ("/version", "/fragment"):
            sys.stderr.write(f"dashboard: {self.address_string()} {fmt % args}\n")

    def send(self, code: int, body: str, content_type: str = "text/html; charset=utf-8") -> None:
        payload = body.encode()
        self.send_response(code)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(payload)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(payload)

    def do_GET(self) -> None:
        parsed = urllib.parse.urlparse(self.path)
        route = parsed.path
        query = urllib.parse.parse_qs(parsed.query)
        try:
            if route == "/":
                view = query.get("view", ["overview"])[0]
                if view not in dict(VIEWS):
                    view = "overview"
                loop = selected_loop(query)
                self.send(200, page("Dashboard", fragment(view, loop), view=view, loop=loop))
            elif route == "/fragment":
                view = query.get("view", ["overview"])[0]
                self.send(
                    200,
                    fragment(view if view in dict(VIEWS) else "overview", selected_loop(query)),
                )
            elif route == "/version":
                self.send(200, version_token(), "text/plain; charset=utf-8")
            elif route.startswith("/section/"):
                _, _, doc, anchor = route.split("/", 3)
                index = hj.section_index([doc])
                section = index.get(f"{doc}#{anchor}")
                if section is None:
                    self.send(404, page("Section", empty(f"No {esc(doc)}#{esc(anchor)}.")))
                else:
                    verdict = hj.read_audit(doc).get(section.key)
                    state = verdict.state if verdict else "unjudged"
                    gaps = ""
                    if verdict and verdict.gaps:
                        gaps = "<h4>open gaps</h4><ul class='gaps'>" + "".join(
                            f"<li><code>{esc(hj.gap_id(section.key, gap.claim))}</code> "
                            f"<strong>{esc(gap.claim)}</strong><br>{esc(gap.found)}<br>"
                            f"<code>{esc(gap.where)}</code></li>"
                            for gap in verdict.gaps
                        ) + "</ul>"
                    body = (
                        f'<p class="meta"><a href="/?view=sections">&larr; sections</a> · '
                        f'<code>design/{esc(doc)}</code> · <span class="{esc(state)}">{esc(state)}</span></p>'
                        f"{gaps}<pre class=\"spec\">{esc(hj.section_text(section))}</pre>"
                    )
                    self.send(200, page(section.heading, body, poll=False))
            elif route.startswith("/diff/"):
                _, _, owner, campaign = route.split("/", 3)
                self.send(200, render_campaign_diff(owner, campaign))
            elif route.startswith("/record/"):
                _, _, owner, campaign = route.split("/", 3)
                path = STATE / "campaigns" / owner / f"{campaign}.md"
                if not path.is_file():
                    self.send(404, page("Record", empty("No such campaign record.")))
                else:
                    body = (
                        f'<p class="meta"><a href="/?view=campaigns">&larr; campaigns</a> · '
                        f'<code>{esc(campaign)}</code> · '
                        f'<a href="/transcript/{urllib.parse.quote(owner)}/{urllib.parse.quote(campaign)}">transcript</a></p>'
                        + markdownish(path.read_text())
                    )
                    self.send(200, page("Campaign record", body, poll=False))
            elif route.startswith("/transcript/"):
                _, _, owner, campaign = route.split("/", 3)
                self.send(200, render_transcript(owner, campaign))
            elif route.startswith("/transcript-part/"):
                _, _, owner, campaign = route.split("/", 3)
                try:
                    end = int(query.get("end", ["0"])[0])
                except ValueError:
                    end = 0
                self.send(200, render_transcript_part(owner, campaign, end))
            elif route.startswith("/event/"):
                # The tail of one truncated tool result, as text: the fold
                # above it already holds the first 1200 bytes.
                _, _, owner, campaign, index = route.split("/", 4)
                _, events = transcript_events(owner, campaign)
                try:
                    text = events[int(index)].get("text", "")
                except (ValueError, IndexError):
                    text = ""
                body, _ = truncate(text)
                self.send(200, text[len(body):], "text/plain; charset=utf-8")
            elif route.startswith("/raw/"):
                _, _, owner, campaign = route.split("/", 3)
                path = Path(adapter("transcript-path", owner, campaign).strip() or "/nonexistent")
                if not path.exists():
                    self.send(404, page("Transcript", empty("No such transcript.")))
                else:
                    self.send(200, path.read_text(errors="replace"), "text/plain; charset=utf-8")
            else:
                self.send(404, page("Not found", empty(f"No route {esc(route)}.")))
        except Exception as error:  # a dashboard that dies is worse than one that says so
            self.send(500, page("Error", f"<pre>{esc(repr(error))}</pre>"))

    def do_POST(self) -> None:
        route = urllib.parse.urlparse(self.path).path
        if route not in ("/answer", "/review"):
            self.send(404, page("Not found", empty("No such endpoint.")))
            return
        length = int(self.headers.get("Content-Length", "0"))
        raw = self.rfile.read(length).decode()
        fields = {k: v[0] for k, v in urllib.parse.parse_qs(raw, keep_blank_values=True).items()}
        try:
            code, message = (answer_decision if route == "/answer" else record_review)(fields)
        except Exception as error:
            self.send(500, page("Error", f"<pre>{esc(repr(error))}</pre>"))
            return
        if code == 303:
            self.send_response(303)
            self.send_header("Location", message)
            self.end_headers()
        else:
            self.send(code, page("Not written", f'<p class="empty">{esc(message)}</p><p><a href="/">back</a></p>'))


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--port", type=int, default=8787)
    parser.add_argument("--host", default="127.0.0.1")
    parser.add_argument("--no-open", action="store_true")
    args = parser.parse_args()

    # Reuse the address rather than walking to the next free port. A dashboard
    # that moves is one whose URL you cannot keep open in a tab, and the usual
    # reason the old port looks busy is a previous instance of this same
    # program that has just been killed and is sitting in TIME_WAIT.
    ThreadingHTTPServer.allow_reuse_address = True
    try:
        server = ThreadingHTTPServer((args.host, args.port), Handler)
    except OSError as error:
        holder = subprocess.run(
            ["pgrep", "-f", f"dashboard/serve --port {args.port}"],
            capture_output=True, text=True, check=False,
        ).stdout.split()
        mine = [pid for pid in holder if pid != str(os.getpid())]
        if not mine:
            print(f"dashboard: port {args.port} is held by something else — {error}", file=sys.stderr)
            return 1
        print(f"dashboard: replacing the instance already on {args.port} (pid {' '.join(mine)})")
        for pid in mine:
            subprocess.run(["kill", pid], check=False)
        for _ in range(40):
            time.sleep(0.25)
            try:
                server = ThreadingHTTPServer((args.host, args.port), Handler)
                break
            except OSError:
                continue
        else:
            print(f"dashboard: {args.port} did not free up", file=sys.stderr)
            return 1
    url = f"http://{args.host}:{args.port}/"
    print(f"dashboard: {url}   (ctrl-c to stop)")
    if not args.no_open:
        webbrowser.open(url)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\ndashboard: stopped")
    return 0


if __name__ == "__main__":
    sys.exit(main())
