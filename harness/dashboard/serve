def fragment(view: str = "overview", loop: str = "") -> str:
    if view == "sections":
        return panel_sections(loop)
    if view == "campaigns":
        return panel_campaign_table(loop) + panel_sessions(loop)
    if view == "interventions":
        return panel_interventions()
    if view == "live":
        return panel_live(loop=loop)
    return (
        panel_decisions()
        + panel_loops(loop)
        + panel_metrics(loop)
        + panel_cost(loop)
        + panel_campaign_table(loop)
        + panel_audit_table(loop)
    )


