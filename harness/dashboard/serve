HARNESS = Path(__file__).resolve().parent.parent
REPO = HARNESS.parent


def load_hj():
    """`harness/hj` has no extension on purpose — it is a command, not a
    library — so it is loaded by path rather than imported by name. Sharing it
    matters more than the awkwardness: a dashboard that computed
    `sections clean` its own way would eventually disagree with the gate."""
    spec = importlib.util.spec_from_loader(
        "hj", importlib.machinery.SourceFileLoader("hj", str(HARNESS / "hj"))
    )
    sys.dont_write_bytecode = True  # no __pycache__ inside a directory nobody owns
    module = importlib.util.module_from_spec(spec)
    # Registered before execution because `@dataclass` resolves annotations
    # through `sys.modules[cls.__module__]`, which is not there yet otherwise.
    sys.modules["hj"] = module
    spec.loader.exec_module(module)
    return module


hj = load_hj()
STATE = hj.STATE


# --------------------------------------------------------------------------
# Reading what the loops wrote


FRONTMATTER = re.compile(r"\A---\n(?P<body>.*?)\n---\n", re.DOTALL)


def parse_decision(path: Path) -> dict:
    text = path.read_text()
    meta: dict[str, str] = {}
    match = FRONTMATTER.match(text)
    body = text
    if match:
        for line in match.group("body").splitlines():
            if ":" in line:
                key, _, value = line.partition(":")
                meta[key.strip()] = value.strip()
        body = text[match.end() :]

    sections: dict[str, str] = {}
    current = "preamble"
    collected: list[str] = []
    for line in body.splitlines():
        if line.startswith("## "):
            sections[current] = "\n".join(collected).strip()
            current = line[3:].strip().lower()
            collected = []
        else:
            collected.append(line)
    sections[current] = "\n".join(collected).strip()

    title = ""
    for line in body.splitlines():
        if line.startswith("# "):
            title = line[2:].strip()
            break

    identifier = meta.get("id") or path.stem
    return {
        "id": identifier,
        "path": str(path.relative_to(REPO)),
        "status": meta.get("status", "unknown"),
        "kind": meta.get("kind", "class-b"),
        "opened": meta.get("opened", ""),
        "campaign": meta.get("campaign", ""),
        "title": title or identifier,
        "sections": sections,
        "tagged": tagged_sites(identifier),
    }


def tagged_sites(identifier: str) -> list[str]:
    result = subprocess.run(
        ["git", "-C", str(REPO), "grep", "-n", "-F", f"DECISION-{identifier}:"],
        capture_output=True,
        text=True,
        check=False,
    )
    return [line for line in result.stdout.splitlines() if line][:40]


def decisions() -> list[dict]:
    directory = STATE / "decisions"
    if not directory.exists():
        return []
    return sorted((parse_decision(p) for p in directory.glob("*.md")), key=lambda d: d["id"])


def version_token() -> str:
    """Moves when anything the page shows moves. Cheap enough to compute on a
    two-second poll: a stat of every tracked state file, and HEAD."""
    stamps = []
    for path in sorted(STATE.rglob("*")):
        if path.is_file():
            stamps.append(f"{path}:{path.stat().st_mtime_ns}")
    try:
        stamps.append(hj.head_sha())
    except SystemExit:
        pass
    return str(hash("|".join(stamps)))


# --------------------------------------------------------------------------
# Rendering


def esc(value) -> str:
    return html.escape(str(value if value is not None else ""))


def markdownish(text: str) -> str:
    """Not a markdown renderer. The state files are written by a model under a
    template, and the four constructs it actually uses — paragraphs, list
    items, inline code, bold — are worth the twenty lines. Anything else falls
    through as text, which is the failure mode you want."""
    out = []
    for block in re.split(r"\n\s*\n", text.strip()):
        lines = block.splitlines()
        if all(line.lstrip().startswith(("- ", "* ", "1. ")) for line in lines if line.strip()):
            items = "".join(f"<li>{inline(re.sub(r'^\s*([-*]|\d+\.)\s+', '', l))}</li>" for l in lines if l.strip())
            out.append(f"<ul>{items}</ul>")
        else:
            out.append(f"<p>{inline(block)}</p>")
    return "".join(out)


def inline(text: str) -> str:
    escaped = esc(text)
    escaped = re.sub(r"`([^`]+)`", r"<code>\1</code>", escaped)
    escaped = re.sub(r"\*\*([^*]+)\*\*", r"<strong>\1</strong>", escaped)
    return escaped


def panel(title: str, body: str, note: str = "") -> str:
    subtitle = f'<span class="note">{esc(note)}</span>' if note else ""
    return f'<section class="panel"><h2>{esc(title)}{subtitle}</h2>{body}</section>'


def empty(message: str) -> str:
    return f'<p class="empty">{esc(message)}</p>'


# --- panel 1: decisions waiting -------------------------------------------


def decision_form(decision: dict) -> str:
    return f"""
    <form class="answer" method="post" action="/answer">
      <input type="hidden" name="id" value="{esc(decision['id'])}">
      <label>Ruling
        <select name="status">
          <option value="accepted">accepted — take the option below</option>
          <option value="rejected">rejected — do not do this</option>
          <option value="superseded">superseded — the question changed</option>
        </select>
      </label>
      <label>Answer
        <textarea name="answer" rows="3" placeholder="Which option, concretely."></textarea>
      </label>
      <label>Rationale <span class="required">required</span>
        <textarea name="rationale" rows="4" required
          placeholder="Why. A decision with no recorded reason is one you re-litigate in three weeks — and the loop cannot use it, because half the point is that a later campaign reads this and applies it to a case nobody anticipated."></textarea>
      </label>
      <button type="submit">Answer and log</button>
    </form>"""


def decision_card(decision: dict) -> str:
    wanted = ["context", "options", "provisional choice in force", "consequences", "decision"]
    parts = []
    for name in wanted:
        body = decision["sections"].get(name)
        if body:
            parts.append(f'<div class="field"><h4>{esc(name)}</h4>{markdownish(body)}</div>')
    if decision["tagged"]:
        sites = "".join(f"<li><code>{esc(line)}</code></li>" for line in decision["tagged"])
        parts.append(f'<div class="field"><h4>sites running on the provisional choice</h4><ul class="sites">{sites}</ul></div>')
    else:
        parts.append('<div class="field"><h4>sites running on the provisional choice</h4><p class="empty">No <code>DECISION-</code> tag found in the tree.</p></div>')

    meta = " · ".join(
        filter(None, [decision["kind"], decision["opened"], f"campaign {decision['campaign'][:8]}" if decision["campaign"] else "", decision["path"]])
    )
    return f"""
    <article class="decision" id="{esc(decision['id'])}">
      <h3>{esc(decision['id'])} — {inline(decision['title'])}</h3>
      <p class="meta">{esc(meta)}</p>
      {''.join(parts)}
      {decision_form(decision)}
    </article>"""


def handoff_card() -> str:
    path = STATE / "handoff.md"
    if not path.exists():
        return ""
    return f"""
    <article class="decision stall">
      <h3>Stall handoff</h3>
      <p class="meta">state/handoff.md — the loop stopped and asked. It will not start again until you set it back to <code>running</code> in <code>state/phase.toml</code>.</p>
      {markdownish(path.read_text())}
    </article>"""


def review_form(kind: str, target: str, label: str) -> str:
    return f"""
    <form class="answer" method="post" action="/review">
      <input type="hidden" name="kind" value="{esc(kind)}">
      <input type="hidden" name="target" value="{esc(target)}">
      <label>Rationale <span class="required">required</span>
        <textarea name="rationale" rows="3" required
          placeholder="What you concluded on reading it. This is the record; nothing else captures that you looked."></textarea>
      </label>
      <button type="submit">{esc(label)}</button>
    </form>"""


def spec_change_card(entry: dict) -> str:
    """A Class A edit is provisional until read. Rewriting the spec toward the
    code is the one route on section 7's list the audit cannot catch by
    construction — moving the spec removes the gap from the instrument that
    would have reported it — so the changelog is the only defence and it only
    works if someone is scheduled to read it."""
    return f"""
    <article class="decision class-a" id="{esc(entry['id'])}">
      <h3>{esc(entry['id'])} — {inline(entry['heading'])}</h3>
      <p class="meta">Class A spec edit · applied already · provisional until you read it</p>
      {markdownish(entry['body'])}
      {review_form('spec-change-reviewed', entry['id'], 'Mark read')}
    </article>"""


def drift_card(campaign: dict) -> str:
    drift = campaign["spec_drift"]
    sharp = (
        "<p><strong>The document edited is the one this campaign's own target lives in.</strong></p>"
        if drift.get("touches_target_document")
        else ""
    )
    design = "".join(f"<li><code>{esc(path)}</code></li>" for path in drift.get("design", []))
    code = "".join(f"<li><code>{esc(path)}</code></li>" for path in drift.get("code", []))
    identifier = campaign.get("campaign", "")
    return f"""
    <article class="decision drift" id="drift-{esc(identifier)}">
      <h3>Campaign {esc(identifier[:8])} edited the spec and the code</h3>
      <p class="meta">target {esc(drift.get('target') or '—')} · {esc(campaign.get('outcome') or 'open')}</p>
      {sharp}
      <p>Flagged, not failed. The audit compares the code against the spec <em>as it
      currently reads</em>, so an edit that moves the spec makes a gap disappear from
      the one instrument that would have reported it. Read the changelog entry and the
      diff together.</p>
      <div class="field"><h4>design</h4><ul class="sites">{design}</ul></div>
      <div class="field"><h4>code</h4><ul class="sites">{code}</ul></div>
      {review_form('spec-drift-reviewed', identifier, 'Mark read')}
    </article>"""


def reviewed_targets(kind: str) -> set[str]:
    return {
        row.get("target")
        for row in hj.read_jsonl(STATE / "interventions.jsonl")
        if row.get("kind") == kind
    }


def panel_decisions() -> str:
    waiting = [d for d in decisions() if d["status"] in ("open", "provisional")]
    unread = [entry for entry in hj.spec_changes() if not entry["reviewed"]]
    seen = reviewed_targets("spec-drift-reviewed")
    flagged = [
        campaign
        for owner in hj.load_phase().loops
        for campaign in hj.campaigns_of(owner)
        if campaign.get("spec_drift") and campaign.get("campaign") not in seen
    ]

    cards = (
        handoff_card()
        + "".join(decision_card(d) for d in waiting)
        + "".join(drift_card(c) for c in flagged)
        + "".join(spec_change_card(e) for e in unread)
    )
    if not cards:
        cards = empty(
            "Nothing waiting. Escalations batch rather than interrupt, so this "
            "panel being empty means the loops are running on choices they were "
            "allowed to make."
        )
    return panel(
        "Waiting on you",
        cards,
        note="escalations, spec edits applied but unread, and campaigns that touched both",
    )


# --- panel 2: loop status --------------------------------------------------


def panel_loops(loop: str = "") -> str:
    phase = hj.load_phase()
    rows = []
    for owner, config in sorted(phase.loops.items()):
        if loop and owner != loop:
            continue
        campaigns = hj.campaigns_of(owner)
        closed = [c for c in campaigns if c.get("outcome")]
        trailing = hj.trailing_without_progress(owner)
        current = next((c for c in reversed(campaigns) if not c.get("outcome")), None)
        counts = hj.audit_counts(config.docs)

        if config.status != "running":
            state, css = config.status, "paused"
        elif trailing >= config.stall_n:
            state, css = "stalled", "bad"
        elif current:
            state, css = "running a campaign", "good"
        else:
            state, css = "idle", "paused"

        record = "target not written yet"
        if current:
            path = REPO / str(current.get("record", ""))
            if path.exists():
                target = re.search(r"## Target\n+(.+?)(?=\n## )", path.read_text(), re.DOTALL)
                if target:
                    text = re.sub(r"<!--.*?-->", "", target.group(1), flags=re.DOTALL).strip()
                    first = text.splitlines()[0] if text.splitlines() else ""
                    record = (first[:120] + ("…" if len(first) > 120 else "")) or "target not written yet"

        last_commit = hj.git("log", "-1", "--format=%h %s", check=False).strip()
        rows.append(f"""
        <article class="loop">
          <h3>{esc(owner)} <span class="pill {css}">{esc(state)}</span></h3>
          <table>
            <tr><th>phase</th><td>{esc(phase.phase)}</td></tr>
            <tr><th>audit</th><td>{counts['sections_clean']}/{counts['sections_total']} sections clean · {counts['sections_unjudged']} unjudged · {counts['open_gaps']} gaps · {counts['audit_minors']} minor</td></tr>
            <tr><th>campaigns</th><td>{len(campaigns)} opened, {len(closed)} closed, {trailing} in a row without progress (stops at {config.stall_n})</td></tr>
            <tr><th>current</th><td>{esc(current['campaign'][:8]) + ' — ' + esc(record) if current else 'none open'}</td></tr>
            <tr><th>last commit</th><td><code>{esc(last_commit)}</code></td></tr>
            <tr><th>may write</th><td class="paths"><details><summary>{len(config.write)} path patterns</summary>
              {'<br>'.join('<code>' + esc(p) + '</code>' for p in config.write)}</details></td></tr>
          </table>
        </article>""")
    return panel("Loop status", "".join(rows), note="a stalled loop with an unanswered question is the thing most likely to cost you a day")


# --- panel 3: metrics ------------------------------------------------------


def line_chart(
    series: list[tuple[str, str, list[float]]],
    caption: str,
    x_label: str,
    width: int = 900,
    height: int = 96,
) -> str:
    """A small multi-series line chart, inline SVG, no dependencies.

    Hues are the categorical slots in fixed order — blue, orange, aqua — never
    cycled, and validated against both surfaces for CVD rather than chosen.
    Identity is never colour alone: every series is directly labelled at its
    last point and named in the legend, which is also what discharges aqua's
    sub-3:1 contrast on the light surface.

    Two series was the cap here, on the argument that `design/loops.md` §10
    keeps the frontier to two axes because non-domination becomes free past
    that. That argument is about the frontier and does not generalise: three
    languages on a size chart are three facts, not a busy chart. The cap that
    does still hold is the palette's — a fourth series takes slot 4, and a
    ninth is not a generated hue but a reason to facet.
    """
    points = max(len(values) for _, _, values in series)
    if points < 2:
        return empty("Not enough audits yet to draw a trend.")
    top = max(max(values) for _, _, values in series) or 1
    pad_l, pad_r, pad_t, pad_b = 38, 108, 9, 13
    plot_w, plot_h = width - pad_l - pad_r, height - pad_t - pad_b

    def x(index: int) -> float:
        return pad_l + (index / (points - 1)) * plot_w

    def y(value: float) -> float:
        return pad_t + plot_h - (value / top) * plot_h

    # Four gridlines, recessive, with the value on the axis rather than on the
    # marks — a number on every point is the anti-pattern.
    grid = "".join(
        f'<line class="grid" x1="{pad_l}" y1="{y(top * f):.1f}" x2="{pad_l + plot_w}" y2="{y(top * f):.1f}"/>'
        f'<text class="tick" x="{pad_l - 6}" y="{y(top * f) + 4:.1f}" text-anchor="end">{round(top * f)}</text>'
        for f in (0, 0.5, 1)
    )
    body = ""
    for name, colour, values in series:
        path = " ".join(f"{x(i):.1f},{y(v):.1f}" for i, v in enumerate(values))
        last_x, last_y = x(len(values) - 1), y(values[-1])
        body += (
            f'<polyline class="series" style="stroke:{colour}" points="{path}"/>'
            f'<circle class="marker" cx="{last_x:.1f}" cy="{last_y:.1f}" r="4" style="fill:{colour}"/>'
            f'<text class="direct" x="{last_x + 9:.1f}" y="{last_y + 4:.1f}">{round(values[-1])} {esc(name)}</text>'
        )
    legend = (
        "".join(
            f'<span class="key"><i style="background:{colour}"></i>{esc(name)}</span>'
            for name, colour, _ in series
        )
        if len(series) > 1
        else ""
    )
    return (
        f'<figure class="chart"><svg viewBox="0 0 {width} {height}" role="img" '
        f'aria-label="{esc(caption)}">{grid}{body}</svg>'
        f'<figcaption><b>{esc(caption)}</b><span class="axis">{esc(x_label)}</span>'
        f'<span class="legend">{legend}</span></figcaption></figure>'
    )


# What a campaign wrote *about itself* rather than as work. The journal, the
# findings digest, its own record and every metrics row are bookkeeping; the
# decision records and the spec changelog are not — those are things a campaign
# produced, and reading a diff without them would hide the escalations.
BOOKKEEPING = (
    ":!state/campaigns",
    ":!state/journal",
    ":!state/findings",
    ":!state/metrics",
    ":!state/cost",
    ":!state/audit",
    ":!state/sessions.jsonl",
    ":!state/interventions.jsonl",
)


_HEADINGS: dict[str, str] = {}


def heading_of(key: str) -> str:
    """`core.md#the-trait` back to "The trait".

    An anchor is what the harness keys on and what a campaign types; it is not
    what anybody wants to read in a table.
    """
    if not _HEADINGS:
        for path in sorted(hj.DESIGN.glob("*.md")):
            for section in hj.sections_of(path.name):
                _HEADINGS[section.key] = section.heading
    return _HEADINGS.get(key, key.split("#")[-1])


def target_links(target: str | None) -> str:
    keys = [a.strip() for a in (target or "").split(",") if a.strip()]
    if not keys:
        return "—"
    return "<br>".join(
        f'<a class="target" href="/section/{urllib.parse.quote(key.split("#")[0])}/'
        f'{urllib.parse.quote(key.split("#")[-1])}">{esc(heading_of(key))}</a>'
        for key in keys
    )


def campaign_commits(identifier: str) -> list[tuple[str, str]]:
    raw = git_out("log", "--reverse", "--format=%H%x1f%s", f"--grep=campaign: {identifier}", "HEAD")
    out = []
    for line in raw.splitlines():
        if "\x1f" in line:
            sha, subject = line.split("\x1f", 1)
            out.append((sha, subject))
    return out


def git_out(*args: str) -> str:
    return subprocess.run(
        ["git", "-C", str(REPO), *args], capture_output=True, text=True, check=False
    ).stdout


def render_campaign_diff(owner: str, identifier: str) -> str:
    """The work a campaign did, per commit, with the bookkeeping cut out.

    Per commit rather than one combined range, because the harness's own
    commits land between a campaign's — a range would sweep them in, and they
    are precisely what this view exists to leave out.
    """
    commits = campaign_commits(identifier)
    if not commits:
        return page("Diff", empty(f"No commits carry `campaign: {esc(identifier)}`."), poll=False)

    blocks = []
    total_add = total_del = 0
    for sha, subject in commits:
        raw = git_out("show", "--format=", "--patch", "--no-color", sha, "--", *BOOKKEEPING)
        files, added, deleted = render_patch(raw)
        total_add += added
        total_del += deleted
        if not files:
            continue
        blocks.append(
            f'<article class="commit"><h3><code>{esc(sha[:8])}</code> {inline(subject)}'
            f'<span class="note"><span class="add">+{added}</span> '
            f'<span class="del">-{deleted}</span></span></h3>{files}</article>'
        )

    head = (
        f'<p class="meta"><a href="/?view=overview">&larr; dashboard</a> · '
        f'campaign <code>{esc(identifier[:8])}</code> · {len(commits)} commit(s) · '
        f'<span class="add">+{total_add}</span> <span class="del">-{total_del}</span> · '
        f'<a href="/record/{urllib.parse.quote(owner)}/{urllib.parse.quote(identifier)}">record</a> · '
        f'<a href="/transcript/{urllib.parse.quote(owner)}/{urllib.parse.quote(identifier)}">transcript</a>'
        f'</p><p class="note">The campaign\'s own journal, findings, record and metrics rows are '
        f'excluded — they are what it wrote <em>about</em> itself. Decision records and the spec '
        f'changelog are kept, because those are work.</p>'
    )
    return page("Diff", head + ("".join(blocks) or empty("Only bookkeeping.")), poll=False)


HUNK = re.compile(r"^@@ -(\d+)(?:,\d+)? \+(\d+)(?:,\d+)? @@(.*)$")


def render_patch(raw: str) -> tuple[str, int, int]:
    """Unified diff to a table per file, with both line numbers."""
    files: list[str] = []
    rows: list[str] = []
    name = None
    old_no = new_no = 0
    added = deleted = 0

    def flush() -> None:
        if name is not None and rows:
            files.append(
                f'<div class="file"><div class="filename"><code>{esc(name)}</code></div>'
                f'<table class="diff"><tbody>{"".join(rows)}</tbody></table></div>'
            )
        rows.clear()

    for line in raw.splitlines():
        if line.startswith("diff --git "):
            flush()
            name = line.split(" b/", 1)[-1]
            continue
        if line.startswith(("index ", "--- ", "+++ ", "new file", "deleted file", "similarity ", "rename ")):
            continue
        hunk = HUNK.match(line)
        if hunk:
            old_no, new_no = int(hunk.group(1)), int(hunk.group(2))
            rows.append(
                f'<tr class="hunk"><td class="ln"></td><td class="ln"></td>'
                f'<td class="code">{esc(hunk.group(3).strip() or "…")}</td></tr>'
            )
            continue
        if line.startswith("+"):
            added += 1
            rows.append(
                f'<tr class="ins"><td class="ln"></td><td class="ln">{new_no}</td>'
                f'<td class="code">{esc(line[1:])}</td></tr>'
            )
            new_no += 1
        elif line.startswith("-"):
            deleted += 1
            rows.append(
                f'<tr class="del-row"><td class="ln">{old_no}</td><td class="ln"></td>'
                f'<td class="code">{esc(line[1:])}</td></tr>'
            )
            old_no += 1
        elif line.startswith(" "):
            rows.append(
                f'<tr><td class="ln">{old_no}</td><td class="ln">{new_no}</td>'
                f'<td class="code">{esc(line[1:])}</td></tr>'
            )
            old_no += 1
            new_no += 1
    flush()
    return "".join(files), added, deleted


def campaign_diffstat() -> dict[str, tuple[int, int]]:
    """Lines added and deleted per campaign, from one pass over the history.

    Keyed on the `campaign:` trailer rather than on a date range, because the
    harness's own commits land between a campaign's and would otherwise be
    charged to whichever one they interrupted.
    """
    raw = subprocess.run(
        ["git", "-C", str(REPO), "log", "--numstat", "--format=%x00%B%x00"],
        capture_output=True,
        text=True,
        check=False,
    ).stdout
    stats: dict[str, tuple[int, int]] = {}
    current = None
    for block in raw.split("\0"):
        match = re.search(r"^campaign:\s*(\S+)\s*$", block, re.MULTILINE)
        if match:
            current = match.group(1)
            continue
        if current is None:
            continue
        added = deleted = 0
        for line in block.splitlines():
            parts = line.split("\t")
            if len(parts) == 3 and parts[0].isdigit() and parts[1].isdigit():
                added += int(parts[0])
                deleted += int(parts[1])
        if added or deleted:
            was = stats.get(current, (0, 0))
            stats[current] = (was[0] + added, was[1] + deleted)
        current = None
    return stats


RECORD_TARGET = re.compile(r"^##\s+Target\s*$(.*?)^##\s", re.MULTILINE | re.DOTALL)


def open_campaign_target(owner: str, identifier: str) -> str:
    """The anchors a running campaign said it took.

    `sessions.jsonl` only learns the target at close, from the campaign's
    `TARGET:` line, so for a running one the record it wrote at the start is
    the only place the target exists.
    """
    path = STATE / "campaigns" / owner / f"{identifier}.md"
    if not path.is_file():
        return ""
    section = RECORD_TARGET.search(path.read_text())
    if not section:
        return ""
    anchors = re.findall(r"`([A-Za-z0-9_.-]+\.md#[^`]+)`", section.group(1))
    seen: list[str] = []
    for anchor in anchors:
        if anchor not in seen:
            seen.append(anchor)
    return ", ".join(seen)


def elapsed(since: str) -> str:
    try:
        started = datetime.datetime.fromisoformat(since)
    except ValueError:
        return "—"
    delta = datetime.datetime.now(started.tzinfo) - started
    minutes = int(delta.total_seconds() // 60)
    return f"{minutes // 60}h{minutes % 60:02d}m" if minutes >= 60 else f"{minutes}m"


def live_campaign_row(opened: dict, closed: dict, diffs: dict) -> str:
    """The campaign running right now, as the first row of the ledger.

    Without it the page looks idle for the twenty-odd minutes a campaign
    takes, which is exactly the window in which someone is most likely to be
    watching it.

    Cost is deliberately absent rather than estimated: the numbers that make
    it up only exist in the terminal `result` event. Turns and cache reads
    are real — `harness/adapter progress` says why they can be trusted and
    output tokens cannot.
    """
    running = [key for key in opened if key not in closed]
    if not running:
        return ""
    identifier = running[-1]
    row = opened[identifier]
    owner = row.get("loop") or next(iter(hj.load_phase().loops), "core")
    state, state_css = campaign_state(identifier)
    progress = {}
    path = Path(adapter("transcript-path", owner, identifier).strip() or "/nonexistent")
    if path.exists():
        try:
            progress = json.loads(adapter("progress", str(path)) or "{}")
        except json.JSONDecodeError:
            progress = {}
    added, deleted = diffs.get(identifier, (0, 0))
    commits = len(campaign_commits(identifier))
    target = open_campaign_target(owner, identifier)
    shown = target_links(target) if target else '<span class="dim">still choosing</span>'
    quoted = urllib.parse.quote(identifier)
    quoted_owner = urllib.parse.quote(owner)

    def diff_cell(text: str, css: str) -> str:
        if not commits:
            return f'<td class="num dim">{text}</td>'
        return f'<td class="num {css}"><a href="/diff/{quoted_owner}/{quoted}">{text}</a></td>'

    return (
        '<tr class="live">'
        f'<td><a href="/record/{quoted_owner}/{quoted}"><code>{esc(identifier[:8])}</code></a></td>'
        f"<td>{shown}</td>"
        f'<td class="num"><span class="{state_css}">{esc(state)}</span> '
        f'<span class="dim">{esc(elapsed(row.get("started") or ""))}</span></td>'
        f'<td class="num">{commits}</td>'
        + diff_cell(f"+{added:,}", "add")
        + diff_cell(f"-{deleted:,}", "del")
        + '<td class="num dim">—</td>'
        '<td class="num dim">—</td>'
        f'<td class="num">{(progress.get("cache_read_tokens") or 0):,}</td>'
        '<td class="num dim">—</td>'
        f'<td class="num">{esc(progress.get("turns") or "—")}</td>'
        '<td class="num dim">—</td>'
        "</tr>"
    )


def panel_campaign_table(loop: str = "") -> str:
    """What each campaign cost and what it moved, on one line each."""
    phase = hj.load_phase()
    diffs = campaign_diffstat()
    cost = {}
    for owner in phase.loops:
        for row in hj.read_jsonl(hj.cost_path(owner)):
            if row.get("kind") != "audit" and row.get("campaign"):
                cost[row["campaign"]] = row

    opened: dict[str, dict] = {}
    closed: dict[str, dict] = {}
    for row in hj.read_jsonl(hj.sessions_path()):
        if loop and row.get("loop") and row["loop"] != loop:
            continue
        (closed if row.get("outcome") else opened).setdefault(row["campaign"], {}).update(row)

    rows = []
    live = live_campaign_row(opened, closed, diffs)
    if live:
        rows.append(live)
    for identifier, close in reversed(list(closed.items())):
        open_row = opened.get(identifier, {})
        money = cost.get(identifier, {})
        added, deleted = diffs.get(identifier, (0, 0))
        targets = [a.strip() for a in (close.get("target") or "").split(",") if a.strip()]
        d_clean = (close.get("sections_clean") or 0) - (open_row.get("sections_clean") or 0)
        d_gaps = (close.get("open_gaps") or 0) - (open_row.get("open_gaps") or 0)

        shown = target_links(close.get("target"))
        # The owner comes off the row rather than a constant: these links
        # were hardcoded to one loop, which was invisible while there was
        # only one and wrong for every row the moment there were two.
        quoted_owner = urllib.parse.quote(close.get("loop") or open_row.get("loop") or "core")

        def signed(value: int, good_when_positive: bool = True) -> str:
            if value == 0:
                return '<span class="dim">0</span>'
            good = (value > 0) == good_when_positive
            return f'<span class="{"up" if good else "down"}">{value:+}</span>'

        rows.append(
            "<tr>"
            f'<td><a href="/record/{quoted_owner}/{urllib.parse.quote(identifier)}"><code>{esc(identifier[:8])}</code></a></td>'
            f"<td>{shown}</td>"
            f'<td class="num">{esc(close.get("outcome"))}</td>'
            f'<td class="num">{esc(close.get("commits"))}</td>'
            f'<td class="num add"><a href="/diff/{quoted_owner}/{urllib.parse.quote(identifier)}">+{added:,}</a></td>'
            f'<td class="num del"><a href="/diff/{quoted_owner}/{urllib.parse.quote(identifier)}">-{deleted:,}</a></td>'
            f'<td class="num">{signed(d_clean)}</td>'
            f'<td class="num">{signed(d_gaps, good_when_positive=False)}</td>'
            f'<td class="num">{(money.get("cache_read_tokens") or 0):,}</td>'
            f'<td class="num">{(money.get("output_tokens") or 0):,}</td>'
            f'<td class="num">{esc(money.get("turns"))}</td>'
            f'<td class="num">${(money.get("usd") or 0):.2f}</td>'
            "</tr>"
        )
    if not rows:
        return panel("Campaigns", empty("No campaign has run yet."))
    return panel(
        "Campaigns",
        '<table class="campaigns"><thead><tr><th>id</th><th>target</th><th class="num">outcome</th>'
        '<th class="num">commits</th><th class="num">+</th><th class="num">−</th>'
        '<th class="num">Δclean</th><th class="num">Δgaps</th><th class="num">cache read</th>'
        '<th class="num">output</th><th class="num">turns</th><th class="num">API-eq</th></tr></thead>'
        f"<tbody>{''.join(rows)}</tbody></table>",
        note="Δgaps rises when an audit finds more than the campaign closed — discovery, not "
        "regression. Cache read is its own column because it is what a campaign actually costs — "
        "about 141 tokens read for every one written. The running campaign is the first row, with "
        "only the figures that can be derived mid-flight: output and cost need the session's final "
        "event and are left blank rather than guessed",
    )


def panel_audit_table(loop: str = "") -> str:
    """One row per audit: what it looked at, what it moved, what it cost.

    The audit is the instrument the whole loop is scored by, and it ran five
    times before anything showed it on this page — so a rotation that kept
    re-reading the same seven sections, or a run whose gap identities all
    churned, was invisible.

    Two columns exist to make specific silent failures loud:

    `persisted` is gaps that were open before this audit and still are, over
    the sections this audit actually looked at. It is 0 on every run and that
    is structural rather than suspicious: `hj audit-plan` takes the sections
    the last campaign touched plus the `rotation` least-recently-audited
    ones, so consecutive audits deliberately barely overlap — through the
    first sweep of 34 sections at most one section per audit had been seen
    before, and a gap cannot persist across audits that never look at it
    twice. The number only becomes informative on the second sweep, and the
    `overlap` column is here so it is obvious which regime you are in.

    `diffed from` is the commit the auditor was handed a diffstat against.
    That is the *previous* row's `commit`, not this row's: the field records
    HEAD as each audit ran, and `hj render-auditor` reads the newest one
    already on disk. Where this reads "none" the auditor was told nothing had
    a baseline and re-read a tree it had no reason to suspect.
    """
    phase = hj.load_phase()
    audits = (
        hj.audits_for(phase.loops[loop].docs)
        if loop and loop in phase.loops
        else list(hj.read_jsonl(hj.GAP_LOG))
    )
    if not audits:
        return panel("Audits", empty("No audit has run for this loop yet."))

    cost = [
        row
        for owner in ([loop] if loop and loop in phase.loops else phase.loops)
        for row in hj.read_jsonl(hj.cost_path(owner))
        if row.get("kind") == "audit"
    ]

    def when(value: str) -> datetime.datetime | None:
        try:
            return datetime.datetime.fromisoformat(value)
        except (TypeError, ValueError):
            return None

    def money_for(stamp: str) -> dict:
        """Nearest in time rather than equal: the two rows are appended by
        separate steps and have been observed a second apart."""
        target = when(stamp)
        if target is None:
            return {}
        best, best_gap = {}, None
        for row in cost:
            other = when(row.get("ts") or "")
            if other is None:
                continue
            gap = abs((other - target).total_seconds())
            if best_gap is None or gap < best_gap:
                best, best_gap = row, gap
        return best if best_gap is not None and best_gap <= 120 else {}

    # How much of each audit's slice it had already seen, oldest first, so the
    # `persisted` column can be read in the right regime.
    seen: set[str] = set()
    overlap: list[int] = []
    for audit in audits:
        slice_ = set(audit.get("sections_audited") or [])
        overlap.append(len(slice_ & seen))
        seen |= slice_

    rows = []
    for index, audit in enumerate(reversed(audits), start=1):
        money = money_for(audit.get("ts") or "")
        stamp = when(audit.get("ts") or "")
        closed, opened = len(audit.get("closed") or []), len(audit.get("opened") or [])
        persisted = audit.get("persisted")
        position = len(audits) - index
        since = next(
            (audits[earlier].get("commit") for earlier in range(position - 1, -1, -1) if audits[earlier].get("commit")),
            None,
        )
        rows.append(
            "<tr>"
            f'<td class="num">{len(audits) - index + 1}</td>'
            f'<td>{esc(stamp.strftime("%b %d %H:%M") if stamp else audit.get("ts"))}</td>'
            f'<td class="num">{len(audit.get("sections_audited") or [])}</td>'
            f'<td class="num dim">{overlap[position]}</td>'
            f'<td class="num up">{closed}</td>'
            f'<td class="num down">{opened}</td>'
            + (
                f'<td class="num">{persisted}</td>'
                if persisted
                else f'<td class="num warn">{esc(persisted)}</td>'
            )
            + (
                f'<td class="num"><code>{esc(since[:8])}</code></td>'
                if since
                else '<td class="num warn">none</td>'
            )
            + f'<td class="num">{esc(money.get("turns") or "—")}</td>'
            f'<td class="num">{(money.get("output_tokens") or 0):,}</td>'
            f'<td class="num">${(money.get("usd") or 0):.2f}</td>'
            "</tr>"
        )

    spent = sum(row.get("usd") or 0 for row in cost)
    blind = sum(1 for position in range(len(audits)) if not any(audits[e].get("commit") for e in range(position)))
    covered = len(seen)
    note = (
        f"{len(audits)} audits, ${spent:.2f} total, {covered} distinct sections reached. "
        "Each audit takes the sections the last campaign targeted plus the `rotation` "
        "least-recently-audited ones, so `overlap` — how many it had seen before — is near "
        "zero through the first sweep, and `persisted` cannot be anything but zero while it is"
    )
    if blind:
        note += (
            f". {blind} ran with no diffstat baseline: `hj render-auditor` keys on a `commit` "
            "field these rows predate, so those audits were told everything was new"
        )
    return panel(
        "Audits",
        '<table class="campaigns"><thead><tr><th class="num">#</th><th>when</th>'
        '<th class="num">sections</th><th class="num">overlap</th><th class="num">closed</th>'
        '<th class="num">opened</th><th class="num">persisted</th><th class="num">diffed from</th>'
        '<th class="num">turns</th><th class="num">output</th><th class="num">API-eq</th></tr></thead>'
        f"<tbody>{''.join(rows)}</tbody></table>",
        note=note,
    )


def size_chart() -> str:
    """How much code and prose exist, one point per campaign close.

    It belongs beside the gap and section charts rather than in a panel of its
    own: those two say how much of the spec is satisfied, and this says how
    much was written to satisfy it. Read apart they are easy to misread in
    opposite directions — sections clean moving slowly looks like nothing
    happening, and lines growing fast looks like progress.

    Counted at close rather than continuously, because a tree is only
    meaningful once it is green; mid-campaign the count includes an experiment
    that may be reverted.

    `reference/` is left out. It is 15,000 lines of generated LSP
    specification, which would be four fifths of the markdown and would never
    move: the chart would be a flat line with one step where the vendoring
    landed. `vendor/` is counted, because it is ours to edit and the rope
    newtype sweep is real work.
    """
    points: list[tuple[str, dict]] = []
    for row in hj.read_jsonl(hj.sessions_path()):
        counts = row.get("lines")
        if counts:
            points.append((row.get("ended") or "", counts))
    points.sort(key=lambda pair: pair[0])
    if len(points) < 2:
        return ""

    series = [
        ("rust", "var(--series-1)", [float(counts.get("rust") or 0) for _, counts in points]),
        ("markdown", "var(--series-2)", [float(counts.get("markdown") or 0) for _, counts in points]),
        ("python", "var(--series-3)", [float(counts.get("python") or 0) for _, counts in points]),
    ]
    total = sum(points[-1][1].get(kind, 0) for kind in ("rust", "markdown", "python"))
    return line_chart(
        series,
        f"Tracked lines by language, {total:,} total",
        "one point per campaign close · excludes generated `reference/`",
    )


def audit_series(docs: list[str]) -> tuple[list[float], list[float]]:
    """Cumulative found and closed, one point per audit, for one loop's
    documents. Unscoped it drew the same curve under every loop."""
    found: set[str] = set()
    closed: set[str] = set()
    found_at, closed_at = [], []
    for row in hj.audits_for(docs):
        found.update(row.get("opened", []))
        found.update(row.get("closed", []))
        closed.update(row.get("closed", []))
        closed.difference_update(row.get("opened", []))
        found_at.append(len(found))
        closed_at.append(len(closed))
    return found_at, closed_at


def sparkline(values: list[float], width: int = 320, height: int = 40) -> str:
    if len(values) < 2:
        return '<p class="empty">Not enough rows to draw a trend yet.</p>'
    low, high = min(values), max(values)
    span = (high - low) or 1
    step = width / (len(values) - 1)
    points = " ".join(
        f"{index * step:.1f},{height - ((value - low) / span) * (height - 4) - 2:.1f}"
        for index, value in enumerate(values)
    )
    return f'<svg class="spark" viewBox="0 0 {width} {height}" preserveAspectRatio="none"><polyline points="{points}"/></svg>'


def panel_metrics(loop: str = "") -> str:
    phase = hj.load_phase()
    blocks = []
    for owner, config in sorted(phase.loops.items()):
        if loop and owner != loop:
            continue
        rows = hj.read_jsonl(hj.metrics_path(owner))
        clean = [row.get("sections_clean", 0) for row in rows]
        counts = hj.audit_counts(config.docs)
        found_at, closed_at = audit_series(config.docs)
        charts = line_chart(
            [("found", "var(--series-1)", found_at), ("closed", "var(--series-2)", closed_at)],
            "Gaps found and gaps closed, cumulative",
            "one point per audit",
        ) + line_chart(
            [("clean", "var(--series-1)", clean)],
            f"Sections clean, of {counts['sections_total']}",
            "one point per commit",
        ) + size_chart()
        ledger = hj.gap_ledger(config.docs)
        # Gaps closed leads. Sections clean cannot move until every claim in a
        # section lands, and the sections are large, so early on it reads as
        # nothing happening while a great deal happens underneath.
        headline = (
            f'<p class="headline"><strong>{ledger["gaps_closed"]}</strong> gaps closed'
            f' <span class="note">of {ledger["gaps_found"]} found · {ledger["gaps_open"]} open</span></p>'
            f'<p class="headline" style="font-size:16px">{counts["sections_clean"]} / {counts["sections_total"]} sections clean'
            f' <span class="note">the phase-gate number; it lags, because a section goes clean only when'
            f' every claim in it lands</span></p>'
        )

        # The rows that are not clean are the work queue and stay in view; the
        # clean ones are the score and go behind a fold. A thirty-row table
        # above the sessions panel would invert section 16's ordering, which
        # is by how often a panel should change what you do.
        buckets: dict[str, list[str]] = {"gaps": [], "unjudged": [], "clean": []}
        for doc in config.docs:
            verdicts = hj.read_audit(doc)
            for section in hj.sections_of(doc):
                verdict = verdicts.get(section.key)
                state = verdict.state if verdict else "unjudged"
                detail = ""
                if verdict and verdict.gaps:
                    items = "".join(
                        f"<li><strong>{esc(gap.claim)}</strong><br>{esc(gap.found)}<br><code>{esc(gap.where)}</code></li>"
                        for gap in verdict.gaps
                    )
                    detail += f"<ul class='gaps'>{items}</ul>"
                if verdict and verdict.minors:
                    items = "".join(
                        f"<li>{esc(minor.claim)} — {esc(minor.note)} <code>{esc(minor.where)}</code></li>"
                        for minor in verdict.minors
                    )
                    detail += f"<ul class='minors'>{items}</ul>"
                row = (
                    f"<tr class='{state}'><td><code>{esc(section.anchor)}</code></td>"
                    f"<td>{esc(section.heading)}</td><td class='state'>{esc(state)}</td>"
                    f"<td>{detail}</td></tr>"
                )
                buckets[state].append(row)

        header = "<thead><tr><th>anchor</th><th>section</th><th>state</th><th>gaps and minor items</th></tr></thead>"

        def table_of(state: str) -> str:
            return f'<table class="sections">{header}<tbody>{"".join(buckets[state])}</tbody></table>'

        outstanding = (
            table_of("gaps")
            if buckets["gaps"]
            else empty(
                "No section in scope has a gap. What is left is the unjudged list, "
                "and the minor items, which are a human's to rule on."
            )
        )
        folded = "".join(
            f'<details><summary>{len(buckets[state])} section(s) {label}</summary>{table_of(state)}</details>'
            for state, label in (("unjudged", "not reached yet"), ("clean", "clean"))
            if buckets[state]
        )
        settled = folded

        blocks.append(f"""
        <article class="metrics">
          <h3>{esc(owner)}</h3>
          {headline}
          <div class="charts">{charts}</div>
          <p class="note">{len(rows)} metrics row(s). The history is a cache — replay is deterministic, so any row can be recomputed from its commit.</p>
        </article>""")

    note = "the frontier chart is a phase 2a object; there is nothing to plot until there is a corpus"
    return panel("Metrics", "".join(blocks), note=note)


