def spec_change_card(entry: dict) -> str:
    """A Class A edit is provisional until read. Rewriting the spec toward the
    code is the one route on section 7's list the audit cannot catch by
    construction — moving the spec removes the gap from the instrument that
    would have reported it — so the changelog is the only defence and it only
    works if someone is scheduled to read it."""
    return f"""
    <article class="decision class-a" id="{esc(entry['id'])}">
      <h3>{esc(entry['id'])} — {inline(entry['heading'])}</h3>
      <p class="meta">Class A spec edit · applied already · provisional until you read it</p>
      {markdownish(entry['body'])}
      {review_form('spec-change-reviewed', entry['id'], 'Mark read')}
    </article>"""


def drift_card(campaign: dict) -> str:
    drift = campaign["spec_drift"]
    sharp = (
        "<p><strong>The document edited is the one this campaign's own target lives in.</strong></p>"
        if drift.get("touches_target_document")
        else ""
    )
    design = "".join(f"<li><code>{esc(path)}</code></li>" for path in drift.get("design", []))
    code = "".join(f"<li><code>{esc(path)}</code></li>" for path in drift.get("code", []))
    identifier = campaign.get("campaign", "")
    return f"""
    <article class="decision drift" id="drift-{esc(identifier)}">
      <h3>Campaign {esc(identifier[:8])} edited the spec and the code</h3>
      <p class="meta">target {esc(drift.get('target') or '—')} · {esc(campaign.get('outcome') or 'open')}</p>
      {sharp}
      <p>Flagged, not failed. The audit compares the code against the spec <em>as it
      currently reads</em>, so an edit that moves the spec makes a gap disappear from
      the one instrument that would have reported it. Read the changelog entry and the
      diff together.</p>
      <div class="field"><h4>design</h4><ul class="sites">{design}</ul></div>
      <div class="field"><h4>code</h4><ul class="sites">{code}</ul></div>
      {review_form('spec-drift-reviewed', identifier, 'Mark read')}
    </article>"""


def prompt_drift_card(campaign: dict) -> str:
    """`design/loops.md` §16: a prompt revision is the one intervention that
    cannot be replayed, because it changes the generator of campaigns rather
    than a campaign. `harness-009` asks whether visibility is enough here; this
    is the visibility."""
    drift = campaign["prompt_drift"]
    sharp = (
        "<p><strong>The file edited is the template this campaign's own prompt was "
        f"rendered from ({esc(drift.get('own') or '')}).</strong></p>"
        if drift.get("touches_own_prompt")
        else ""
    )
    prompts = "".join(f"<li><code>{esc(path)}</code></li>" for path in drift.get("prompts", []))
    identifier = campaign.get("campaign", "")
    return f"""
    <article class="decision drift" id="prompt-{esc(identifier)}">
      <h3>Campaign {esc(identifier[:8])} edited a prompt</h3>
      <p class="meta">target {esc(campaign.get('target') or '—')} · {esc(campaign.get('outcome') or 'open')} · harness-009</p>
      {sharp}
      <p>Flagged, not failed. A prompt revision changes the <em>generator</em> of
      campaigns, so the metrics either side of it are not strictly comparable and the
      change cannot be replayed. Read it as an intervention that arrived as a commit.</p>
      <div class="field"><h4>prompts</h4><ul class="sites">{prompts}</ul></div>
      {review_form('prompt-drift-reviewed', identifier, 'Mark read')}
    </article>"""


def deletion_card(owner: str, row: dict) -> str:
    """`design/loops.md` §7: "test *deletions* are flagged for review
    regardless of count". Regardless of count is the whole of it — the ratchet
    catches the count falling, and one test deleted while another is added
    leaves it flat with a name gone. The gate prints this too, into a
    transcript nobody opens twice; this is the half that is a review."""
    commit = row.get("commit", "")
    names = "".join(f"<li><code>{esc(name)}</code></li>" for name in row.get("tests_removed", []))
    return f"""
    <article class="decision drift" id="deleted-{esc(commit[:12])}">
      <h3>{len(row.get('tests_removed', []))} test(s) deleted by {esc(owner)}</h3>
      <p class="meta">commit {esc(commit[:12])} · campaign {esc((row.get('campaign') or '—')[:8])}</p>
      <p>Flagged, not failed. A rename is legitimate and a replacement may be
      stronger than what it replaced — but the count ratchet cannot tell either
      of those from a test that was in the way, because all three leave the
      number where it was.</p>
      <div class="field"><h4>removed</h4><ul class="sites">{names}</ul></div>
      {review_form('test-deletion-reviewed', commit, 'Mark read')}
    </article>"""


def reviewed_targets(kind: str) -> set[str]:
    return {
        row.get("target")
        for row in hj.read_jsonl(STATE / "interventions.jsonl")
        if row.get("kind") == kind
    }


def panel_decisions() -> str:
    waiting = [
        d for d in decisions() if d["status"] in ("open", "provisional") or d["unlogged"]
    ]
    unread = [entry for entry in hj.spec_changes() if not entry["reviewed"]]
    seen = reviewed_targets("spec-drift-reviewed")
    flagged = [
        campaign
        for owner in hj.load_phase().loops
        for campaign in hj.campaigns_of(owner)
        if campaign.get("spec_drift") and campaign.get("campaign") not in seen
    ]

    read_prompts = reviewed_targets("prompt-drift-reviewed")
    prompt_flagged = [
        campaign
        for owner in hj.load_phase().loops
        for campaign in hj.campaigns_of(owner)
        if campaign.get("prompt_drift") and campaign.get("campaign") not in read_prompts
    ]

    read_deletions = reviewed_targets("test-deletion-reviewed")
    deletions = [
        (owner, row)
        for owner in hj.load_phase().loops
        for row in hj.read_jsonl(hj.metrics_path(owner))
        if row.get("tests_removed") and row.get("commit") not in read_deletions
    ]

    cards = (
        handoff_card()
        + "".join(decision_card(d) for d in waiting)
        + "".join(drift_card(c) for c in flagged)
        + "".join(prompt_drift_card(c) for c in prompt_flagged)
        + "".join(deletion_card(owner, row) for owner, row in deletions)
        + "".join(spec_change_card(e) for e in unread)
    )
    if not cards:
        cards = empty(
            "Nothing waiting. Escalations batch rather than interrupt, so this "
            "panel being empty means the loops are running on choices they were "
            "allowed to make."
        )
    # `design/loops.md` §6's batch trigger, on the panel a batch is answered
    # from. The count is records waiting on a human rather than the cards here,
    # which also carry spec edits and flagged campaigns — the threshold in
    # `state/phase.toml` is about escalations and nothing else.
    due, reason = hj.batch_is_due(len(hj.waiting_decisions()), hj.load_phase().escalation_batch)
    trigger = f"batch DUE — {reason}" if due else f"batch not due — {reason}"
    return panel(
        "Waiting on you",
        cards,
        note=(
            "escalations, spec edits applied but unread, campaigns that touched both,"
            f" and deleted tests · {trigger}"
        ),
    )


# --- panel 2: loop status --------------------------------------------------


def record_section(owner: str, identifier: str, name: str) -> str:
    """One `## <name>` section of a campaign record, template comments removed.

    The record is where a running campaign's own account lives — the session
    row learns its target only at close — so this is the only source for what
    the campaign currently believes.
    """
    path = STATE / "campaigns" / owner / f"{identifier}.md"
    if not path.is_file():
        return ""
    found = re.search(rf"^##\s+{re.escape(name)}\s*$(.*?)(?=^##\s|\Z)", path.read_text(), re.MULTILINE | re.DOTALL)
    if not found:
        return ""
    return re.sub(r"<!--.*?-->", "", found.group(1), flags=re.DOTALL).strip()


def clipped(text: str, keep: int = 240) -> str:
    if not text:
        return ""
    flat = " ".join(text.split())
    return flat[:keep] + ("…" if len(flat) > keep else "")


def live_experiments(owner: str, identifier: str) -> dict | None:
    """The committed / reverted / empty mix of a campaign that is still going.

    `design/loops.md` section 16 asks the loop panel for "experiments so far",
    and the cost row that carries the finished mix is written at close — which
    is exactly too late to notice a campaign thrashing. The counters come off
    the stream through `harness/adapter progress`, and the committed side off
    git, which is the same split `hj.experiment_mix` already makes.
    """
    path = Path(adapter("transcript-path", owner, identifier).strip() or "/nonexistent")
    if not path.exists():
        return None
    try:
        numbers = json.loads(adapter("progress", str(path)) or "{}")
    except json.JSONDecodeError:
        return None
    if not numbers:
        return None
    return hj.experiment_mix({"commits": len(campaign_commits(identifier))}, numbers)


def loop_state(phase, owner: str, config, trailing: int, current: dict | None) -> tuple[str, str]:
    """Section 16's four: running, stalled, blocked, budget exhausted.

    Budget exhaustion is not a status anybody writes down. `harness/loop`
    checks the ceilings between campaigns and exits; `state/phase.toml` still
    says `running`, so the page read that as `idle` — a loop that has stopped
    for the one reason a human can fix in ten seconds looked like a loop
    between campaigns.
    """
    if config.status != "running":
        return config.status, "bad" if config.status == "blocked" else "paused"
    exhausted = [
        entry
        for entry in hj.budget_scopes(phase, owner)
        if entry["ceiling"] is not None
        and entry["spent"] is not None
        and entry["spent"] >= entry["ceiling"]
    ]
    if exhausted:
        return f"budget exhausted ({exhausted[0]['scope']})", "bad"
    if trailing >= config.stall_n:
        return "stalled", "bad"
    if current:
        return "running a campaign", "good"
    return "idle", "paused"


def panel_loops(loop: str = "") -> str:
    phase = hj.load_phase()
    rows = []
    for owner, config in sorted(phase.loops.items()):
        if loop and owner != loop:
            continue
        campaigns = hj.campaigns_of(owner)
        closed = [c for c in campaigns if c.get("outcome")]
        trailing = hj.trailing_without_progress(owner)
        current = next((c for c in reversed(campaigns) if not c.get("outcome")), None)
        counts = hj.audit_counts(config.docs)
        state, css = loop_state(phase, owner, config, trailing, current)

        target = hypothesis = experiments = ""
        if current:
            identifier = current.get("campaign", "")
            written = record_section(owner, identifier, "Target")
            first = next((line for line in written.splitlines() if line.strip()), "")
            target = clipped(first, 140) or "target not written yet"
            hypothesis = clipped(record_section(owner, identifier, "Hypothesis"))
            mix = live_experiments(owner, identifier)
            if mix:
                experiments = (
                    f"{mix['committed']} committed · {mix['reverted']} reverted · "
                    f"{mix['empty']} empty, over {mix['gate_runs']} gate run(s)"
                )
        if not experiments:
            # The last campaign's, so the row says something between campaigns.
            finished = next(
                (row for row in reversed(hj.cost_rows(owner)) if (row.get("experiments") or {}).get("gate_runs")),
                None,
            )
            if finished:
                mix = finished["experiments"]
                experiments = (
                    f'<span class="dim">last campaign: {mix["committed"]}c / {mix["reverted"]}r / '
                    f'{mix["empty"]}e over {mix["gate_runs"]} gate run(s)</span>'
                )

        # This loop's own last commit, not the tree's. The harness commits its
        # bookkeeping between campaigns and workers merge into one branch, so
        # `log -1` is usually somebody else's row.
        last_commit = git_out("log", "-1", "--format=%h %s", f"--grep=loop: {owner}").strip()
        rows.append(f"""
        <article class="loop">
          <h3>{esc(owner)} <span class="pill {css}">{esc(state)}</span></h3>
          <table>
            <tr><th>phase</th><td>{esc(phase.phase)}</td></tr>
            <tr><th>audit</th><td>{counts['sections_clean']}/{counts['sections_total']} sections clean · {counts['sections_unjudged']} unjudged · {counts['open_gaps']} gaps · {counts['audit_minors']} minor</td></tr>
            <tr><th>campaigns</th><td>{len(campaigns)} opened, {len(closed)} closed, {trailing} in a row without progress (stops at {config.stall_n})</td></tr>
            <tr><th>current</th><td>{esc(current['campaign'][:8]) + ' — ' + esc(target) if current else 'none open'}</td></tr>
            {f'<tr><th>hypothesis</th><td>{esc(hypothesis)}</td></tr>' if hypothesis else ''}
            <tr><th>experiments</th><td>{experiments or '<span class="dim">none yet</span>'}</td></tr>
            <tr><th>last commit</th><td><code>{esc(last_commit) or '<span class="dim">none</span>'}</code></td></tr>
            <tr><th>may write</th><td class="paths"><details><summary>{len(config.write)} path patterns</summary>
              {'<br>'.join('<code>' + esc(p) + '</code>' for p in config.write)}</details></td></tr>
          </table>
        </article>""")
    return panel("Loop status", "".join(rows), note="a stalled loop with an unanswered question is the thing most likely to cost you a day")


