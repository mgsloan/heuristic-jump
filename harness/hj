    )


def _selftest_adapter_cost(events: list[dict]) -> dict:
    """Run the real `adapter cost` over a synthetic stream.

    Through the adapter rather than around it: the point of the check is that
    the file which owns the vendor's shapes still reads them the way the row
    spec needs, and a reimplementation here would agree with itself forever.

    The adapter beside *this* file, not `HARNESS / "adapter"`. `HARNESS` is
    derived from `HJ_REPO`, which is the tree being checked — so a pinned `hj`
    running the gate for another loop would test that loop's adapter instead
    of its own. Found by running this against the core worktrees before
    merging: two checks failed with `KeyError: 'gate_runs'`, which is what
    three workers' gates would have done on their next run.
    """
    adapter = Path(__file__).resolve().parent / "adapter"
    with tempfile.NamedTemporaryFile("w", suffix=".jsonl", delete=False) as handle:
        for event in events:
            handle.write(json.dumps(event) + "\n")
        path = handle.name
    try:
        result = subprocess.run(
            [str(adapter), "cost", path], capture_output=True, text=True, check=False
        )
        return json.loads(result.stdout.strip() or "{}")
    finally:
        os.unlink(path)


def cmd_selftest(args: argparse.Namespace) -> int:
    cases = selftest_cases()
    failed = []
    for name, case in cases:
        try:
            case()
        except AssertionError as error:
            failed.append((name, str(error) or "assertion failed"))
        except Exception as error:  # noqa: BLE001 - a check that errors is a check that failed
            failed.append((name, f"{type(error).__name__}: {error}"))
    for name, reason in failed:
        print(f"selftest: FAILED  {name.replace('_', ' ')}\n          {reason}", file=sys.stderr)
    if failed:
        print(f"selftest: {len(failed)} of {len(cases)} checks failed", file=sys.stderr)
        return 1
    print(f"selftest: {len(cases)} checks passed")
    return 0


def cmd_intervene(args: argparse.Namespace) -> int:
    """`design/loops.md` section 16: the log is the mechanism, not a record of
    it. Answering a decision means appending here.

    The kind is checked against section 16's vocabulary, because "recurring
    kinds are a design backlog" is a count and a typo splits one. `--new-kind`
    is the way past it: the list is closed against slips, not against events
    the design did not anticipate.
    """
    if not args.rationale.strip():
        die("rationale is required; a decision with no recorded reason gets re-litigated")
    kind = canonical_kind(args.kind.strip())
    if kind not in KNOWN_KINDS and not args.new_kind:
        near = [known for known in KNOWN_KINDS if known.startswith(kind.split("-")[0])]
        die(
            f"unknown intervention kind {kind!r}.\n"
            + (f"    did you mean: {', '.join(near)}?\n" if near else "")
            + "    known kinds: "
            + ", ".join(KNOWN_KINDS)
            + "\n    pass --new-kind if this really is a kind nobody has logged before."
        )
    append_jsonl(
        INTERVENTIONS,
        {
            "ts": now(),
            "kind": kind,
            # Recorded rather than attributed later. `phase_at` can only guess
            # from whichever campaign was running, and an intervention made
            # between phases is exactly when that guess is wrong.
            "phase": load_phase().phase,
            "target": args.target,
            "answer": args.answer,
            "rationale": args.rationale,
            "commit": head_sha(),
        },
    )
    commit_harness_state([INTERVENTIONS], f"{kind} on {args.target}")
    print(f"logged: {kind} on {args.target}")
    return 0


def cmd_install_hooks(args: argparse.Namespace) -> int:
    """Symlink the git hooks into the common git directory.

    Explicit rather than automatic, and a symlink rather than `core.hooksPath`:
    setting that would redirect *every* hook, so a hook someone else installed
    would silently stop running. It goes in the common directory, which is
    shared by every worktree — one install covers the fleet.
    """
    common = Path(git("rev-parse", "--git-common-dir").strip())
    if not common.is_absolute():
        common = (REPO / common).resolve()
    for source in sorted((Path(__file__).resolve().parent / "hooks").glob("*")):
        if source.name not in ("post-commit",):
            continue
        target = common / "hooks" / source.name
        target.parent.mkdir(parents=True, exist_ok=True)
        if target.is_symlink() and target.resolve() == source:
            print(f"install-hooks: {target} already points here")
            continue
        if target.exists() or target.is_symlink():
            print(f"install-hooks: {target} exists and is not ours; left alone", file=sys.stderr)
            continue
        target.symlink_to(source)
        print(f"install-hooks: {target} -> {source}")
    return 0


def cmd_interventions(args: argparse.Namespace) -> int:
    """What the log says about how autonomous this actually is."""
    stats = intervention_stats()
    print(f"interventions: {stats['total']} logged")
    print()
    print("  per 100 experiments, by phase")
    for entry in stats["per_phase"]:
        ratio = f"{entry['per_100']:.1f}" if entry["per_100"] is not None else "—"
        print(
            f"    {entry['phase']:<4}  {entry['interventions']:>4} interventions  "
            f"{entry['experiments']:>5} experiments  {ratio:>6} per 100"
        )
    print()
    print(f"  by kind (>= {RECURRING_KIND}, excluding the one-per-event kinds, is a design backlog item)")
    for kind, count in stats["by_kind"]:
        if kind in stats["recurring"]:
            flag = "  <- recurring; a rule is missing somewhere"
        elif kind in ROUTINE_KINDS:
            flag = "  (one per event)"
        else:
            flag = ""
        print(f"    {count:>4}  {kind}{flag}")
    print()
    median = stats["median_hours"]
    print(f"  time to answer: median {median:.1f}h" if median is not None else "  time to answer: —")
    for entry in stats["answered"][:5]:
        if entry.get("hours") is not None:
            print(f"    {entry['hours']:>7.1f}h  {entry['id']}")
    unlogged = stats["unlogged_commits"]
    if unlogged:
        print()
        print(f"  {len(unlogged)} hand-authored commit(s) with nothing in the log")
        for entry in unlogged[:10]:
            print(f"    {entry['commit'][:8]}  {entry['ts'][:16]}  {entry['subject'][:60]}")
    if stats["waiting"]:
        print()
        print("  waiting now — a loop is running on a provisional choice for each of these")
        for entry in stats["waiting"]:
            hours = entry.get("hours")
            print(f"    {hours:>7.1f}h  {entry['id']}  {entry['title'][:60]}" if hours is not None
                  else f"          ?  {entry['id']}")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(prog="hj", description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("sections", help="list a design document's sections and their anchors")
    p.add_argument("doc", nargs="+")
    p.set_defaults(run=cmd_sections)

    p = sub.add_parser("section-text", help="print one section's body, for splicing into a prompt")
    p.add_argument("key", help="e.g. core.md#7-measurement")
    p.set_defaults(run=cmd_section_text)

    p = sub.add_parser("baseline-take", help="freeze the section denominator for this phase")
    p.add_argument("--force", action="store_true", help="re-take mid-phase; makes the metrics history discontinuous")
    p.set_defaults(run=cmd_baseline_take)

    p = sub.add_parser("baseline-drift", help="how the documents have moved since the baseline")
    p.set_defaults(run=cmd_baseline_drift)

    p = sub.add_parser("spec-changes", help="Class A spec edits, and which are still unread")
    p.set_defaults(run=cmd_spec_changes)

    p = sub.add_parser("audit-plan", help="which sections the next audit covers")
    p.add_argument("loop")
    p.set_defaults(run=cmd_audit_plan)

    p = sub.add_parser("audit-merge", help="merge an auditor's verdict into state/audit/")
    p.add_argument("loop")
    p.add_argument("transcript", help="file holding the auditor's output")
    p.add_argument("--partial", action="store_true", help="merge the valid sections even if some were rejected")
    p.set_defaults(run=cmd_audit_merge)

    p = sub.add_parser("check-links", help="every internal link in the design documents resolves")
    p.add_argument("doc", nargs="*")
    p.set_defaults(run=cmd_check_links)

    p = sub.add_parser("check-audit", help="gate step: every gap names an anchor that exists")
    p.set_defaults(run=cmd_check_audit)

    p = sub.add_parser("check-scope", help="gate step: only owned paths were touched")
    p.add_argument("loop")
    p.add_argument("--rev", help="check a commit instead of the working tree")
    p.set_defaults(run=cmd_check_scope)

    p = sub.add_parser("check-path", help="is one path inside this loop's owned set (for the PreToolUse hook)")
    p.add_argument("loop")
    p.add_argument("path", nargs="+")
    p.set_defaults(run=cmd_check_path)

    p = sub.add_parser("check-metrics", help="gate step: the previous iteration recorded its row")
    p.add_argument("loop")
    p.set_defaults(run=cmd_check_metrics)

    p = sub.add_parser("backfill-lines", help="line counts for already-closed campaigns")
    p.set_defaults(run=cmd_backfill_lines)

    p = sub.add_parser("progress-replay", help="recompute progress for every closed campaign")
    p.add_argument("--rule", type=int, default=PROGRESS_RULE)
    p.set_defaults(run=cmd_progress_replay)

    p = sub.add_parser("record", help="append the metrics row for HEAD")
    p.add_argument("loop")
    p.set_defaults(run=cmd_record)

    p = sub.add_parser("render-prompt", help="render a loop's prompt")
    p.add_argument("loop")
    p.add_argument("--campaign")
    p.add_argument("--out")
    p.set_defaults(run=cmd_render_prompt)

    p = sub.add_parser("render-planner", help="render the round-planning prompt")
    p.add_argument("loop")
    p.add_argument("--workers", type=int, required=True)
    p.add_argument("--out")
    p.set_defaults(run=cmd_render_planner)

    p = sub.add_parser("plan-merge", help="write the planner's assignments")
    p.add_argument("loop")
    p.add_argument("answer")
    p.add_argument("--workers", type=int, required=True)
    p.set_defaults(run=cmd_plan_merge)

    p = sub.add_parser("render-auditor", help="render the auditor's prompt for a plan")
    p.add_argument("loop")
    p.add_argument("plan", help="file holding the section keys to audit")
    p.add_argument("--out")
    p.set_defaults(run=cmd_render_auditor)

    p = sub.add_parser("crates", help="the workspace members this loop owns and the gate builds")
    p.add_argument("loop")
    p.add_argument("--lintable", action="store_true", help="exclude vendored crates, which are tested but not linted")
    p.set_defaults(run=cmd_crates)

    p = sub.add_parser("allocate-id", help="reserve the next free decision or changelog id")
    p.add_argument("loop")
    p.add_argument("--kind", choices=("decision", "change"), required=True)
    p.set_defaults(run=cmd_allocate_id)

    p = sub.add_parser("claim", help="take targets, refusing any another worker holds")
    p.add_argument("loop")
    p.add_argument("--campaign", required=True)
    p.add_argument("target", nargs="+")
    p.set_defaults(run=cmd_claim)

    p = sub.add_parser("campaign-open", help="allocate a campaign, write its record, render its prompt")
    p.add_argument("loop")
    p.add_argument("--id", help="uuid; generated when omitted")
    p.add_argument("--prompt-out")
    p.add_argument("--worker", help="worker identity, e.g. core-2; defaults to the loop")
    p.set_defaults(run=cmd_campaign_open)

    p = sub.add_parser("campaign-close", help="close a campaign and judge whether it made progress")
    p.add_argument("loop")
    p.add_argument("--id", required=True)
    p.add_argument("--outcome", required=True, choices=OUTCOMES)
    p.add_argument("--target", default=None)
    p.set_defaults(run=cmd_campaign_close)

    p = sub.add_parser("campaign-reap", help="close campaigns whose process is gone (crash recovery)")
    p.add_argument("loop", nargs="?")
    p.set_defaults(run=cmd_campaign_reap)

    p = sub.add_parser("cost", help="join campaign records to what their sessions cost")
    p.add_argument("loop", nargs="?")
    p.add_argument(
        "--refresh",
        action="store_true",
        help="re-measure closed campaigns whose row predates a field the row spec now carries",
    )
    p.set_defaults(run=cmd_cost)

    p = sub.add_parser("prompt-prefix", help="how much of a prompt is byte-identical between campaigns")
    p.add_argument("loop", nargs="?")
    p.set_defaults(run=cmd_prompt_prefix)

    p = sub.add_parser("estimates", help="section 15's guesses against what has actually been spent")
    p.set_defaults(run=cmd_estimates)

    p = sub.add_parser("selftest", help="gate step: hj's own parsing and arithmetic still hold")
    p.set_defaults(run=cmd_selftest)

    p = sub.add_parser("budget", help="spend against each ceiling; exit 1 when one is reached")
    p.add_argument("loop", nargs="?")
    p.set_defaults(run=cmd_budget)

    p = sub.add_parser("audit-cost", help="record what an audit session cost")
    p.add_argument("loop")
    p.add_argument("transcript")
    p.set_defaults(run=cmd_audit_cost)

    p = sub.add_parser("audit-due", help="exit 0 when an audit is due")
    p.add_argument("loop")
    p.set_defaults(run=cmd_audit_due)

    p = sub.add_parser("gaps", help="gaps found, closed, and still open")
    p.add_argument("loop")
    p.set_defaults(run=cmd_gaps)

    p = sub.add_parser("stall", help="exit 1 when the loop has stalled")
    p.add_argument("loop")
    p.set_defaults(run=cmd_stall)

    p = sub.add_parser("status", help="the operator view, until there is a dashboard")
    p.set_defaults(run=cmd_status)

    p = sub.add_parser("intervene", help="append to the intervention log")
    p.add_argument("--kind", required=True, help=f"one of: {', '.join(KNOWN_KINDS)}")
    p.add_argument("--target", required=True)
    p.add_argument("--answer", default="")
    p.add_argument("--rationale", required=True)
    p.add_argument("--new-kind", action="store_true", help="accept a kind the vocabulary does not have")
    p.set_defaults(run=cmd_intervene)

    p = sub.add_parser("interventions", help="how autonomous this is, from the log")
    p.set_defaults(run=cmd_interventions)

    p = sub.add_parser("install-hooks", help="symlink the git hooks; flags hand-authored commits")
    p.set_defaults(run=cmd_install_hooks)

    args = parser.parse_args()
    return args.run(args)


if __name__ == "__main__":
    sys.exit(main())
