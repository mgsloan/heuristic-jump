    def an_unevaluated_candidate_refuses_the_whole_selection():
        # Not "skip it and rank the rest". The rest was chosen by the tuning
        # numbers, which is the model-selection-on-the-training-set §10 spends
        # its closing paragraph on — and skipping reads exactly like selecting.
        candidates = [
            {"commit": "aaa", "frontier_axes": {"top1": 0.9, "coverage": 0.5}},
            {"commit": "bbb", "frontier_axes": {"top1": 0.5, "coverage": 0.9}},
        ]
        evaluated = {"aaa": {"strata": {"A": {"tuning": 0.9, "heldout": 0.8}}}}
        chosen, missing = gate_selection(candidates, evaluated)
        assert chosen is None and missing == ["bbb"], (chosen, missing)

