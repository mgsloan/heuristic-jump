#   3 — attribution by the gap, not by the round. Rule 2 read "this campaign
#       named a section the audit looked at, and *some* gap closed
#       somewhere", so a campaign that closed none of the gaps it named was
#       credited whenever a sibling worker closed one. Rule 3 intersects the
#       ids the campaign named with the ids that closed, and where it named a
#       section rather than a gap, with the gaps that closed *in that
#       section*. Strictly a tightening: over the 50 closed campaigns it
#       moves the attributed *term* on 13 and the progress *verdict* on
#       none, because every campaign it takes the audit-side term from had
#       already scored at close. `state/decisions/harness-010.md`.
# DECISION-harness-010: provisional
PROGRESS_RULE = 3

OUTCOMES = ("confirmed", "falsified", "no-movement", "partial", "budget", "crashed", "error")


def now() -> str:
    return datetime.now(timezone.utc).isoformat(timespec="seconds")


def die(message: str) -> None:
    print(f"hj: {message}", file=sys.stderr)
    raise SystemExit(2)


# --------------------------------------------------------------------------
# Paths and globbing


def glob_to_regex(pattern: str) -> re.Pattern[str]:
    """`**` crosses directory separators, `*` and `?` do not."""
    if pattern.endswith("/"):
        pattern = pattern + "**"
    out = []
    index = 0
    while index < len(pattern):
        char = pattern[index]
        if pattern.startswith("**/", index):
            out.append("(?:.*/)?")
            index += 3
        elif pattern.startswith("**", index):
            out.append(".*")
            index += 2
        elif char == "*":
            out.append("[^/]*")
            index += 1
        elif char == "?":
            out.append("[^/]")
            index += 1
        else:
            out.append(re.escape(char))
            index += 1
    return re.compile("".join(out) + r"\Z")


def matches_any(path: str, patterns: list[str]) -> bool:
    return any(glob_to_regex(p).match(path) for p in patterns)


# --------------------------------------------------------------------------
# Desired state


@dataclass
class LoopConfig:
    owner: str
    status: str
    prompt: str
    docs: list[str]
    crates: list[str]
    write: list[str]
    stall_n: int
    rotation: int
    splice_sections: int
    detail_gaps: int
    turn_target: str
    budget_usd: float | None
    model: str | None
    language: str | None
    writes_harness: bool


@dataclass
class Budget:
    """The two scopes above the campaign. `design/loops.md` section 15.

    The per-campaign ceiling is `LoopConfig.budget_usd`, and it is the runner's
    to enforce (`--max-budget-usd`) because only the runner can stop a session
    mid-turn. These two are the harness's, checked between campaigns, which is
    the granularity available to something outside the session.

    Both are optional and both default to absent rather than to a number: an
    invented ceiling would stop a fleet on an arbitrary Tuesday, and the
    section asks for budgets that "stop and report", not for a guess.
    """

    global_usd: float | None = None
    language_usd: dict[str, float] = field(default_factory=dict)


@dataclass
class Phase:
    phase: str
    audit_every: int = 1
    # `design/loops.md` section 6: "a batch is triggered by whichever comes
    # first: the outstanding `DECISION-` count crossing a threshold, or a phase
    # gate". Absent rather than a default number, for `Budget`'s reason — a
    # guessed threshold either cries wolf or never fires, and the section names
    # no number. Absent means the phase gate is the only trigger, which is the
    # degenerate case the section already describes rather than a broken one.
    escalation_batch: int | None = None
    # `design/loops.md` section 11's standing ceiling: "an order of magnitude
    # above where anything reasonable sits, on `measure_<lang>` size and on
    # per-query work. It is a guardrail and emphatically not a ratchet:
    # crossing it does not mean the last change was wrong, it means the loop
    # has wandered somewhere no legitimate experiment goes, and it stops and
    # escalates rather than failing the gate."
    #
    # Empty rather than defaulted, for `Budget`'s and `escalation_batch`'s
    # reason, and here the section supplies the argument itself: the number is
    # only harmless because it sits an order of magnitude clear of anything
    # legitimate, and nobody knows where that is until a handler exists. A
    # guessed one either never fires or suppresses the expensive experiments
    # §11 spends its first three paragraphs protecting.
    guardrail: dict[str, int] = field(default_factory=dict)
    # §12's "held-out gap within threshold". Absent by default, and the section
    # names no number — it is the *widening* that stops the loop, and that
    # comparison needs no threshold at all. A ceiling on the absolute gap is
    # the weaker of the two signals and the one that needs a human's number.
    heldout_threshold: float | None = None
    budget: Budget = field(default_factory=Budget)
    loops: dict[str, LoopConfig] = field(default_factory=dict)


def load_phase() -> Phase:
    path = CONTROL / "state" / "phase.toml"
    if not path.exists():
        die(f"{path} does not exist; the harness has no desired state to reconcile against")
    raw = tomllib.loads(path.read_text())
    budget_table = raw.get("budget", {})
    result = Phase(
        phase=raw["phase"],
        audit_every=raw.get("audit_every", 1),
        escalation_batch=raw.get("escalation_batch"),
        heldout_threshold=(raw.get("heldout") or {}).get("gap_threshold"),
        guardrail={
            name: int(value)
            for name, value in (raw.get("guardrail") or {}).items()
            if isinstance(value, (int, float)) and not isinstance(value, bool)
        },
        budget=Budget(
            global_usd=budget_table.get("global_usd"),
            language_usd={
                language: float(ceiling)
                for language, ceiling in (budget_table.get("language") or {}).items()
            },
        ),
    )
    for owner, table in raw.get("loop", {}).items():
        result.loops[owner] = LoopConfig(
            owner=owner,
            status=table.get("status", "paused"),
            prompt=table["prompt"],
            docs=table.get("docs", []),
            crates=table.get("crates", []),
            write=table.get("write", []),
            stall_n=table.get("stall_n", 3),
            rotation=table.get("rotation", 6),
            splice_sections=table.get("splice_sections", 3),
            detail_gaps=table.get("detail_gaps", 8),
            turn_target=table.get("turn_target", "about 150"),
            budget_usd=table.get("budget_usd"),
            model=table.get("model"),
            language=table.get("language"),
            writes_harness=bool(table.get("writes_harness", False)),
        )
    return result


def denied_paths(phase: Phase, owner: str | None = None) -> list[str]:
    """What this loop may not write. `owner` omitted means every loop's denials
    together, which is what a summary wants and never what a check wants."""
    denied = list(DENIED_ALWAYS)
    if phase.phase not in WHOLE_REPOSITORY_PHASES:
        denied += PHASE_DEPENDENT_DENIALS
    config = phase.loops.get(owner) if owner else None
    if not (config and config.writes_harness):
        denied += HARNESS_PATHS
    return denied


def loop_config(owner: str) -> tuple[Phase, LoopConfig]:
    phase = load_phase()
    if owner not in phase.loops:
        die(f"no loop named {owner!r} in state/phase.toml (have: {', '.join(sorted(phase.loops))})")
    return phase, phase.loops[owner]


# --------------------------------------------------------------------------
# Design documents: the section list is parsed, never authored


# Level 2 and 3. The design documents put most of their checkable claims under
# `###`, and a denominator of ten sections for a 1700-line document is one the
# numerator can barely move — "sections clean over sections total" is only a
# useful number at a granularity where a campaign can finish one. Each body
# runs to the next heading of any level, so the sections partition the document
# rather than nesting.
HEADING = re.compile(r"^#{2,3}\s+(?P<text>\S.*?)\s*$")


def anchor_of(heading: str) -> str:
    """GitHub's slug: lowercase, drop everything but word characters, spaces
    and hyphens, then **each** space to a hyphen.

    Runs are not collapsed, which is the part that is easy to get wrong. A
    heading like `pyright, basedpyright — Python` loses the em dash and keeps
    the spaces that surrounded it, so the anchor has a double hyphen.
    Collapsing them produced anchors that did not match the document's own
    cross-references, and reported those references as dangling.
    """
    slug = heading.strip().lower()
    slug = re.sub(r"[^a-z0-9 _-]", "", slug)
    return slug.replace(" ", "-").strip("-")


@dataclass
class Section:
    doc: str
    anchor: str
    heading: str
    start: int  # line index of the heading
    end: int  # line index one past the last line of the body

    @property
    def key(self) -> str:
        return f"{self.doc}#{self.anchor}"


def doc_path(doc: str) -> Path:
    path = DESIGN / doc
    if not path.exists():
        die(f"no such design document: {doc}")
    return path


def sections_of(doc: str) -> list[Section]:
    lines = doc_path(doc).read_text().splitlines()
    found: list[Section] = []
    in_fence = False
    for index, line in enumerate(lines):
        if line.startswith("```"):
            in_fence = not in_fence
            continue
        if in_fence:
            continue
        match = HEADING.match(line)
        if match:
            heading = match.group("text")
            found.append(Section(doc, anchor_of(heading), heading, index, len(lines)))
    for earlier, later in zip(found, found[1:]):
        earlier.end = later.start
    seen: dict[str, int] = {}
    for section in found:
        count = seen.get(section.anchor, 0)
        seen[section.anchor] = count + 1
        if count:
            section.anchor = f"{section.anchor}-{count}"  # GitHub's own tie-break
    return found


def section_index(docs: list[str]) -> dict[str, Section]:
    return {s.key: s for doc in docs for s in sections_of(doc)}


ANY_HEADING = re.compile(r"^#{2,}\s+(?P<text>\S.*?)\s*$")


def anchors_of(doc: str) -> set[str]:
    """Every anchor a link or a gap may legitimately name, at any heading depth.

    Distinct from [`sections_of`], which stops at `###` because that is the
    granularity the *score* is counted at. Anchor validity is a different
    question from what the denominator is: `shim.md` links to two `####`
    headings, and treating those as dangling reported real cross-references as
    spec drift.
    """
    found: set[str] = set()
    in_fence = False
    for line in doc_path(doc).read_text().splitlines():
        if line.startswith("```"):
            in_fence = not in_fence
            continue
        if in_fence:
            continue
        match = ANY_HEADING.match(line)
        if match:
            anchor = anchor_of(match.group("text"))
            while anchor in found:
                anchor += "-1"
            found.add(anchor)
    return found


# --------------------------------------------------------------------------
# The baseline: the denominator, frozen for the phase
#
# It lives in `harness/` and not `state/` for the reason everything else in
# `harness/` does — a loop must not be able to move the thing that scores it,
# and here the score is a fraction whose denominator is parsed out of
# documents the conformance loop is allowed to edit.

BASELINE = HARNESS / "section-baseline.toml"


def read_baseline() -> dict:
    if not BASELINE.exists():
        return {}
    return tomllib.loads(BASELINE.read_text())


def baseline_anchors(doc: str) -> set[str] | None:
    """`None` when no baseline has been taken, which means "fall back to the
    documents and say so" rather than "the denominator is zero"."""
    entry = read_baseline().get("doc", {}).get(doc)
    if entry is None:
        return None
    return {f"{doc}#{anchor}" for anchor in entry.get("anchors", [])}


def baseline_drift(docs: list[str]) -> list[str]:
    lines = []
    for doc in docs:
        expected = baseline_anchors(doc)
        if expected is None:
            lines.append(f"{doc}: no baseline; the denominator is being re-derived each audit")
            continue
        live = {s.key for s in sections_of(doc)}
        for key in sorted(expected - live):
            lines.append(f"{key}: in the baseline, gone from the document — counted, and never clean")
        for key in sorted(live - expected):
            lines.append(f"{key}: added since the baseline — audited, but it does not move the score")
    return lines


def section_text(section: Section) -> str:
    lines = doc_path(section.doc).read_text().splitlines()
    body = "\n".join(lines[section.start : section.end]).rstrip()
    return f"<!-- {section.key} -->\n{body}\n"


# --------------------------------------------------------------------------
# The audit record


@dataclass
class Gap:
    claim: str
    found: str
    where: str
    # HEAD when the audit recorded it. The audit re-judges a rotation
    # slice, so a gap closed by a commit afterwards stays in the list until
    # its section comes round again — measured at seven of nine on core.md
    # (`state/decisions/core-019.md`). This is what lets the prompt say
    # which ones are worth verifying first.
    found_at: str = ""


@dataclass
class Minor:
    claim: str
    note: str
    where: str


@dataclass
class SectionVerdict:
    key: str
    state: str  # clean | gaps | unjudged
    last_audited: str | None
    gaps: list[Gap] = field(default_factory=list)
    minors: list[Minor] = field(default_factory=list)


VALID_STATES = ("clean", "gaps", "unjudged")


def audit_path(doc: str) -> Path:
    return STATE / "audit" / f"{doc.removesuffix('.md')}.toml"


def read_audit(doc: str) -> dict[str, SectionVerdict]:
    path = audit_path(doc)
    if not path.exists():
        return {}
    raw = tomllib.loads(path.read_text())
    out: dict[str, SectionVerdict] = {}
    for key, table in raw.get("section", {}).items():
        out[key] = SectionVerdict(
            key=key,
            state=table.get("state", "unjudged"),
            last_audited=table.get("last_audited"),
            gaps=[Gap(g.get("claim", ""), g.get("found", ""), g.get("where", ""), g.get("found_at", "")) for g in table.get("gap", [])],
            minors=[Minor(m.get("claim", ""), m.get("note", ""), m.get("where", "")) for m in table.get("minor", [])],
        )
    return out


def toml_string(value: str) -> str:
    if "\n" in value:
        escaped = value.replace("\\", "\\\\").replace('"""', '\\"\\"\\"')
        return f'"""\n{escaped}"""'
    return json.dumps(value)


def write_audit(doc: str, verdicts: dict[str, SectionVerdict], order: list[str]) -> None:
    lines = [
        f"# Audit of design/{doc}. Written by harness/audit, never by hand.",
        "# `design/loops.md` section 3. The section list is parsed out of the",
        "# document, so it follows the document rather than drifting from it.",
        "",
    ]
    for key in order:
        verdict = verdicts[key]
        lines.append(f"[section.{toml_string(key)}]")
        lines.append(f"state = {toml_string(verdict.state)}")
        if verdict.last_audited:
            lines.append(f"last_audited = {toml_string(verdict.last_audited)}")
        for gap in verdict.gaps:
            lines.append("")
            lines.append(f"  [[section.{toml_string(key)}.gap]]")
            lines.append(f"  claim = {toml_string(gap.claim)}")
            lines.append(f"  found = {toml_string(gap.found)}")
            lines.append(f"  where = {toml_string(gap.where)}")
            if gap.found_at:
                lines.append(f"  found_at = {toml_string(gap.found_at)}")
        for minor in verdict.minors:
            lines.append("")
            lines.append(f"  [[section.{toml_string(key)}.minor]]")
            lines.append(f"  claim = {toml_string(minor.claim)}")
            lines.append(f"  note = {toml_string(minor.note)}")
            lines.append(f"  where = {toml_string(minor.where)}")
        lines.append("")
    path = audit_path(doc)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text("\n".join(lines))


def gap_id(section_key: str, claim: str) -> str:
    """A gap's identity is its section and its claim.

    Not `found` or `where`, which move as the code moves — the same unmet
    claim reported against a different file is the same gap. `design/loops.md`
    section 5: comparing successive audits by gap identity rather than by
    total is what makes the difference visible, because a list that is the
    previous list minus what was fixed is progress, while a different list of
    the same length is variance.
    """
    normalised = re.sub(r"\s+", " ", claim.strip().lower())
    return hashlib.sha256(f"{section_key}|{normalised}".encode()).hexdigest()[:10]


GAP_LOG = STATE / "audit" / "gap-log.jsonl"


def open_gap_ids(docs: list[str]) -> dict[str, tuple[str, str]]:
    out: dict[str, tuple[str, str]] = {}
    for doc in docs:
        known = {s.key for s in sections_of(doc)}
        for key, verdict in read_audit(doc).items():
            if key in known:
                for gap in verdict.gaps:
                    out[gap_id(key, gap.claim)] = (key, gap.claim)
    return out


def audits_for(docs: list[str]) -> list[dict]:
    """The gap-log rows belonging to a document set.

    Gap ids are opaque — `sha256(section|claim)` — so a closed one cannot be
    traced back to its document. What can is the row: an audit covers one
    loop's documents, so a row whose `sections_audited` names any of these
    documents is that loop's, and no row mixes two loops.
    """
    prefixes = tuple(f"{doc}#" for doc in docs)
    return [
        row
        for row in read_jsonl(GAP_LOG)
        if any(key.startswith(prefixes) for key in row.get("sections_audited", []))
    ]


def gap_ledger(docs: list[str]) -> dict[str, int]:
    """Found, closed, still open — cumulative across every audit so far.

    Scoped to `docs`, which it previously took and used only for the open
    count: found and closed came from every row in the log, so a second loop
    reported the first one's totals as its own.
    """
    found: set[str] = set()
    closed: set[str] = set()
    for row in audits_for(docs):
        found.update(row.get("opened", []))
        # A gap can be closed without ever having been *opened* in this log:
        # the audits before the log existed left no identities behind, so the
        # first time one of their gaps is seen here is when it disappears.
        # Counting only `opened` made "closed of found" report 15 closed of 41
        # found while 41 were still open.
        found.update(row.get("closed", []))
        closed.update(row.get("closed", []))
        closed.difference_update(row.get("opened", []))  # reopened is not closed
    still_open = open_gap_ids(docs)
    found.update(still_open)
    closed.difference_update(still_open)
    return {"gaps_found": len(found), "gaps_closed": len(closed), "gaps_open": len(still_open)}


def audit_counts(docs: list[str]) -> dict[str, int]:
    """The conformance loop's number.

    Counted against the *baseline* rather than the documents as they read
    now, because the section list is parsed from headings in documents the
    loop may edit: re-deriving the denominator each audit would let it merge
    two dirty sections into one clean one and move the score without touching
    a line of code (`design/loops.md` section 7).

    A baseline section that no longer exists is counted and is never clean.
    A section added since the baseline is audited — it is real work — but
    does not move the score this phase.
    """
    clean = total = gaps = minors = unjudged = missing = added = 0
    for doc in docs:
        expected = baseline_anchors(doc)
        live = {s.key for s in sections_of(doc)}
        verdicts = read_audit(doc)
        scored = expected if expected is not None else live
        total += len(scored)
        added += len(live - scored)
        for key in scored:
            if key not in live:
                missing += 1
                continue
            verdict = verdicts.get(key)
            if verdict is None or verdict.state == "unjudged":
                unjudged += 1
                continue
            if verdict.state == "clean":
                clean += 1
        for key, verdict in verdicts.items():
            if key in live:
                gaps += len(verdict.gaps)
                minors += len(verdict.minors)
    return {
        "sections_clean": clean,
        "sections_total": total,
        "sections_unjudged": unjudged,
        "sections_missing": missing,
        "sections_added": added,
        "open_gaps": gaps,
        "audit_minors": minors,
    }


def open_gaps(docs: list[str]) -> list[tuple[str, Gap]]:
    out: list[tuple[str, Gap]] = []
    for doc in docs:
        known = {s.key for s in sections_of(doc)}
        for key, verdict in read_audit(doc).items():
            if key in known:
                out.extend((key, gap) for gap in verdict.gaps)
    return out


# --------------------------------------------------------------------------
# Git


def git(*args: str, check: bool = True) -> str:
    result = subprocess.run(
        ["git", "-C", str(REPO), *args], capture_output=True, text=True, check=False
    )
    if check and result.returncode != 0:
        die(f"git {' '.join(args)} failed: {result.stderr.strip()}")
    return result.stdout


def head_sha() -> str:
    return git("rev-parse", "HEAD").strip()


def trailers_of(rev: str) -> dict[str, str]:
    body = git("log", "-1", "--format=%B", rev)
    parsed = subprocess.run(
        ["git", "interpret-trailers", "--parse"],
        input=body,
        capture_output=True,
        text=True,
        check=False,
    ).stdout
    out: dict[str, str] = {}
    for line in parsed.splitlines():
        if ":" in line:
            name, _, value = line.partition(":")
            out[name.strip().lower()] = value.strip()
    return out


def working_tree_paths() -> list[str]:
    """Everything the next commit could contain: staged, unstaged, untracked.

    Minus the sandbox's masks, which are not files anybody wrote. Layer 3
    (`state/decisions/harness-002.md`) hides `~/.bashrc`, `.gitconfig`,
    `.mcp.json`, `.claude/skills/` and eighteen others by bind-mounting
    `/dev/null` over them, and inside the sandbox those mounts are visible in
    the project root — so `git status` reports twenty-two untracked paths that
    exist in no checkout and that every campaign would be told to revert. It
    turned the gate red for every loop the moment the sandbox was switched on.

    Filtering on the device node rather than on a name list, because the list
    belongs to whoever wrote the sandbox and would go stale silently. Nothing
    is hidden by this: creating a character device needs `mknod` privileges a
    campaign does not have, so a path that is one was not written by the work
    being judged.
    """
    raw = git("status", "--porcelain=v1", "-z", "--untracked-files=all")
    fields = raw.split("\0")
    paths: list[str] = []
    index = 0
    while index < len(fields):
        entry = fields[index]
        index += 1
        if not entry:
            continue
        status, path = entry[:2], entry[3:]
        paths.append(path)
        if "R" in status or "C" in status:
            if index < len(fields):
                paths.append(fields[index])
                index += 1
    return sorted({path for path in set(paths) if not is_sandbox_mask(path)})


def is_sandbox_mask(path: str) -> bool:
    try:
        return stat.S_ISCHR((REPO / path).lstat().st_mode)
    except OSError:
        return False


def commit_paths(rev: str) -> list[str]:
    raw = git("show", "--name-only", "--pretty=format:", "-z", rev)
    return sorted({p for p in raw.split("\0") if p})


# What §4 puts in front of an iteration before it picks a target, and §15's
# token lever puts last: "constitution, then prompt, then audit state, then the
# journal tail and recent commits". Bounded, because both grow without limit
# and the whole point is that a campaign does not spend turns retrieving them.
JOURNAL_TAIL_ENTRIES = 2
JOURNAL_TAIL_CHARS = 9000
RECENT_COMMITS = 10

JOURNAL_ENTRY = re.compile(r"^## ", re.MULTILINE)


def journal_tail(text: str, entries: int = JOURNAL_TAIL_ENTRIES, chars: int = JOURNAL_TAIL_CHARS) -> str:
    """The last few entries of a journal, oldest of them first.

    Entries are `## ` headings — the shape every entry in `state/journal/` has
    — and the character cap is the backstop for a file that has none, where
    "the last two entries" would be the whole thing. Truncation takes the end
    rather than the start: this is the tail on purpose.
    """
    starts = [match.start() for match in JOURNAL_ENTRY.finditer(text)]
    tail = text[starts[-entries] :] if len(starts) >= entries else text
    tail = tail.strip()
    if len(tail) > chars:
        tail = "...\n" + tail[-chars:]
    return tail


COMMIT_FIELD = "\x1f"
COMMIT_RECORD = "\x1e"
COMMIT_FORMAT = COMMIT_FIELD.join(
    [
        "%h",
        "%s",
        "%(trailers:key=loop,valueonly=true,separator=%x2c)",
        "%(trailers:key=audit,valueonly=true,separator=%x2c)",
        "%(trailers:key=tests,valueonly=true,separator=%x2c)",
    ]
) + COMMIT_RECORD


def format_commit_lines(raw: str, limit: int = RECENT_COMMITS) -> list[str]:
    """The last N commit messages, as §4 asks for them, minus the ones that
    are not messages: `hj` writes a row and commits it after every experiment,
    and those carry no `loop:` trailer precisely so that nothing which counts
    can see them."""
    lines: list[str] = []
    for record in raw.split(COMMIT_RECORD):
        record = record.strip("\n")
        if not record:
            continue
        fields = record.split(COMMIT_FIELD)
        if len(fields) < 5:
            continue
        sha, subject, owner, audit, tests = (field.strip() for field in fields[:5])
        if not owner:
            continue
        lines.append(f"- `{sha}` [{owner}] {subject}")
        detail = "; ".join(part for part in (audit, f"tests {tests}" if tests else "") if part)
        if detail:
            lines.append(f"      {detail}")
        if sum(1 for line in lines if line.startswith("- ")) >= limit:
            break
    return lines


def commits_for_campaign(campaign_id: str) -> list[str]:
    raw = git("log", "--format=%H", f"--grep=campaign: {campaign_id}", "HEAD")
    return [line for line in raw.splitlines() if line]


# --------------------------------------------------------------------------
# The append-only records


def append_jsonl(path: Path, row: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a") as handle:
        handle.write(json.dumps(row, sort_keys=True) + "\n")


def commit_in(root: Path, paths: list[Path], message: str) -> None:
    relative = [str(path.relative_to(root)) for path in paths if path.exists()]
    if not relative:
        return
    subprocess.run(["git", "-C", str(root), "add", "--", *relative], capture_output=True, check=False)
    result = subprocess.run(
        ["git", "-C", str(root), "commit", "-m", f"harness: {message}", "--", *relative],
        capture_output=True,
        text=True,
        check=False,
    )
    if result.returncode != 0 and "nothing to commit" not in result.stdout:
        print(f"hj: could not commit in {root}: {result.stdout.strip()}", file=sys.stderr)


def commit_harness_state(paths: list[Path], message: str) -> None:
    """The harness commits the rows it writes, as it writes them.

    Reported by the first campaign as `conformance-001`, and it was right: the
    harness appends to `state/sessions.jsonl` when it opens a campaign, that
    file is denied to every loop, and the pre-commit scope check inspects the
    working tree — so the gate was red before the loop wrote a byte, and
    nothing the loop was permitted to do could make it green.

    Of the three options it laid out, this is the one that keeps the deny list
    absolute. Excluding harness files from the pre-commit check would have put
    a carve-out in the one check whose value is that any appearance of a denied
    path is a violation; taking the verdict only post-hoc would mean a scope
    error costs a history rewrite instead of a `git restore`.

    The commits carry no `loop:` or `campaign:` trailer, so they are invisible
    to `commits_for_campaign`, to `check-metrics`, and to the cost join — the
    history stays one commit per experiment as far as anything that counts is
    concerned. Path-limited, so a campaign's uncommitted work is never swept
    in.
    """
    # A path in the integration checkout is committed there, not here: with
    # workers, `sessions.jsonl` lives outside the worktree so that an open
    # campaign is visible to the fleet.
    outside = [path for path in paths if path.exists() and not path.is_relative_to(REPO)]
    for path in outside:
        commit_in(CONTROL, [path], message)
    relative = [
        str(path.relative_to(REPO))
        for path in paths
        if path.exists() and path.is_relative_to(REPO)
    ]
    if not relative:
        return
    status = git("status", "--porcelain", "--", *relative).strip()
    if not status:
        return
    git("add", "--", *relative)
    result = subprocess.run(
        ["git", "-C", str(REPO), "commit", "-m", f"harness: {message}", "--", *relative],
        capture_output=True,
        text=True,
        check=False,
    )
    if result.returncode != 0:
        print(f"hj: could not commit harness state: {result.stdout.strip()} {result.stderr.strip()}", file=sys.stderr)


def read_jsonl(path: Path) -> list[dict]:
    if not path.exists():
        return []
    rows = []
    for line in path.read_text().splitlines():
        line = line.strip()
        if line:
            rows.append(json.loads(line))
    return rows


def sessions_path() -> Path:
    """One file for the whole fleet, in the integration checkout.

    A campaign's *record* is its own work and belongs on its branch. Its
    session row is not: it is how everything else — the dashboard, the stall
    count, the audit cadence, another worker — knows a campaign exists. Kept
    per branch, three workers each appended to their own copy and none of them
    was visible anywhere until the campaign closed and merged, which is
    exactly the window worth watching.

    Concurrent appends are safe as written: each row is a single `write` of
    well under `PIPE_BUF` to a file opened `O_APPEND`, which Linux does not
    interleave. `.gitattributes` union-merges it for the case where a branch
    carries one anyway.
    """
    return CONTROL / "state" / "sessions.jsonl"


def session_rows() -> list[dict]:
    """Every session row this tree can see.

    The fleet's file, plus a worktree-local one when they differ. The local
    one exists only for campaigns opened before the file moved, and for a
    branch that carried a merged copy; reading both means a campaign that
    opened under the old layout can still close.
    """
    rows = read_jsonl(sessions_path())
    local = STATE / "sessions.jsonl"
    if local.resolve() != sessions_path().resolve():
        rows += read_jsonl(local)
    return sorted(rows, key=lambda row: row.get("started") or row.get("ended") or "")


def campaigns_of(owner: str) -> list[dict]:
    """Latest row per campaign id, oldest campaign first."""
    latest: dict[str, dict] = {}
    for row in session_rows():
        if row.get("loop") == owner:
            merged = latest.setdefault(row["campaign"], {})
            merged.update(row)
    return list(latest.values())


def metrics_path(owner: str) -> Path:
    return STATE / "metrics" / f"{owner}.jsonl"


# --------------------------------------------------------------------------
# Decisions, and the log that answers them


# In the integration checkout, never the worker's: an intervention logged
# on a branch is invisible to the dashboard and to every other worker
# until it merges, which is the whole class of bug that moved
# `phase.toml`, `sessions.jsonl` and `assignments/` here too.
INTERVENTIONS = CONTROL / "state" / "interventions.jsonl"

DECISION_RULINGS = ("accepted", "rejected", "superseded")


def decision_answers() -> dict[str, dict]:
    """The newest logged answer per decision id.

    `design/loops.md` section 16: answering a decision *means* appending to
    `state/interventions.jsonl`, and "the harness derives the decision's status
    from the log rather than from someone remembering to write both". Both
    halves are written today — the dashboard edits the record's frontmatter and
    appends a row in one action — so what this changes is which of the two is
    authoritative when they disagree. A record hand-edited to `accepted` with
    nothing in the log is the drift the section is guarding against, and it now
    reads as still waiting.
    """
    answers: dict[str, dict] = {}
    for row in read_jsonl(INTERVENTIONS):
        if row.get("kind") != "decision-answered":
            continue
        target = (row.get("target") or "").strip()
        if target:
            answers[target] = row
    return answers


def ruling_of(row: dict) -> str:
    """Which way a logged answer went.

    `status` when the row carries one; otherwise the leading word of `answer`,
    which is the shape every row written so far has (`accepted: Option A`).
    Neither parses to `answered`, which is deliberately not one of the three
    rulings: a logged answer whose text cannot be read is still an answer, and
    reporting it as open would put a settled question back in front of a human.
    """
    explicit = str(row.get("status") or "").strip().lower()
    if explicit in DECISION_RULINGS:
        return explicit
    head = str(row.get("answer") or "").strip().split(":", 1)[0].strip().lower()
    return head if head in DECISION_RULINGS else "answered"


# `design/loops.md` section 16 names the full set of intervention kinds. It is
# a closed vocabulary rather than free text because the section asks the log to
# answer "which kinds recur", and that only works if one event lands under one
# name. It already had not: `prompt-revised` and `prompt-revision` are the same
# intervention spelled two ways, which reported a kind that had happened eight
# times as one that had happened seven and one that had happened once — the
# exact reading the section calls a design backlog, silently split.
INTERVENTION_KINDS = (
    "decision-answered",
    "behaviour-change-approved",
    "behaviour-change-refused",
    "frontier-point-selected",
    "stall-unblocked",
    "budget-raised",
    "ratchet-exception-granted",
    "spec-edited-by-hand",
    "loop-killed",
    "loop-restarted",
    "audit-overruled",
    "prompt-revised",
    "harness-changed",
)

# Kinds the log already carries that section 16's list does not name. Kept as
# they are rather than folded into `harness-changed`: rewriting a logged kind
# rewrites the record, and each of these says something the general name does
# not. `spec-change-reviewed` and `spec-drift-reviewed` are the dashboard's own
# and are how a Class A edit stops being provisional.
KINDS_IN_USE = (
    "spec-change-reviewed",
    "spec-drift-reviewed",
    "docs-scope-changed",
    "rotation-changed",
    "audit-cadence-changed",
    "harness-command-run-mid-campaign",
    # One per deleted test, from the dashboard. `design/loops.md` §7 asks for
    # deletions to be flagged for review regardless of count, and a review
    # that leaves no trace is indistinguishable from nobody looking.
    "test-deletion-reviewed",
    # `design/loops.md` §13, "Branches exist for one commit at a time": a
    # rebase that turns the gate red is escalated as a blocked item rather
    # than repaired locally. `harness/loop`'s `blocked` is the only caller and
    # it was logging a kind this vocabulary did not name, so `cmd_intervene`
    # died on every one of them and the call site's `|| true` swallowed it —
    # for long enough that the five rows already in the log all predate the
    # vocabulary being closed. The escalation reached the worker's own log
    # file and nothing else, which is the failure mode §13 describes: the
    # branch keeps accumulating while nobody is told.
    "merge-blocked",
)

KNOWN_KINDS = INTERVENTION_KINDS + KINDS_IN_USE

# One kind, two spellings, canonicalised when the log is read and never on
# disk. The rows are the record of what happened and are not edited after the
# fact; what is being fixed is the count, not the history.
KIND_ALIASES = {"prompt-revision": "prompt-revised"}


def canonical_kind(kind: str) -> str:
    return KIND_ALIASES.get(kind, kind)


# Only a bare literal. `--kind "$computed"` is not checkable from here and is
# skipped rather than guessed at, and the angle-bracket placeholder in the
# post-commit hook's help text is not a kind.
SHELL_KIND = re.compile(r"--kind[ \t]+([a-z][a-z0-9-]*)")


def intervention_kinds_in(script: str) -> list[str]:
    return sorted({match.group(1) for match in SHELL_KIND.finditer(script)})


def harness_scripts() -> list[tuple[str, str]]:
    """The scripts beside this file, as (name, text).

    Reaches through `HJ_REPO`, so it reads whichever tree is being judged
    rather than the reviewed copy this file may have been run from. That is
    deliberate and it is the only way the checks built on it catch anything:
    the bug they exist for is a shell script changing while `hj` does not, and
    in that case the tree's own `hj` is never run. Unreadable and missing files
    are skipped — a branch that predates a script did not break it.
    """
    found = []
    for root in (HARNESS, HARNESS / "hooks"):
        if not root.is_dir():
            continue
        for path in sorted(root.iterdir()):
            if not path.is_file() or path.name == "hj":
                continue
            try:
                found.append((str(path.relative_to(HARNESS)), path.read_text()))
            except (OSError, UnicodeDecodeError):
                continue
    return found


def shell_intervention_kinds() -> dict[str, list[str]]:
    """Every intervention kind the scripts beside this file log, by file.

    The vocabulary above is enforced in `cmd_intervene` at runtime, and its
    callers are shell scripts that cannot import it. `harness/loop` logged
    `merge-blocked` for as long as that kind was missing here, and because the
    call site ends in `|| true` the only symptom was an escalation that never
    arrived. This is the seam that had no check.
    """
    return {name: kinds for name, text in harness_scripts() if (kinds := intervention_kinds_in(text))}


# `"$hj" <subcommand>`, which is how every shell script here invokes this file.
SHELL_HJ_CALL = re.compile(r'"\$hj"\s+([a-z][a-z-]*)')


def hj_subcommands(source: str) -> set[str]:
    return set(re.findall(r'sub\.add_parser\(\s*"([a-z][a-z-]*)"', source))


def shell_hj_calls() -> dict[str, list[str]]:
    """Every `hj` subcommand the scripts beside this file invoke, by file.

    The same seam as `shell_intervention_kinds` and the same failure: a shell
    script naming something this file does not have fails at run time, inside a
    runner whose output nobody reads until a campaign is already lost.
    """
    return {
        name: sorted(set(SHELL_HJ_CALL.findall(text)))
        for name, text in harness_scripts()
        if SHELL_HJ_CALL.search(text)
    }


def decision_status(identifier: str, recorded: str | None, answers: dict[str, dict] | None = None) -> str:
    """The status the harness believes, which is the log's when there is one.

    `answers` is passed in by callers that read every record, so the log is
    parsed once rather than once per decision.
    """
    if answers is None:
        answers = decision_answers()
    answered = answers.get(identifier)
    if answered:
        return ruling_of(answered)
    return str(recorded or "unknown").strip()


def decision_unlogged(identifier: str, recorded: str | None, answers: dict[str, dict] | None = None) -> bool:
    """A record that claims a ruling with nothing in the log behind it.

    The ruling still stands — overruling a human because they edited a file
    instead of clicking a button would be absurd, and it would put a settled
    question back in the queue. What is missing is the half section 16 says
    matters: "`rationale` is the field that matters and the one that will get
    skipped ... the loop cannot use it: half the point of a decision record is
    that a later campaign reads *why* and applies it to a case nobody
    anticipated."

    So this is a third state rather than a fourth ruling, and it is the one
    the page and the prompt both need to say out loud. `harness-001` was
    answered exactly this way while this was being written.
    """
    if answers is None:
        answers = decision_answers()
    return identifier not in answers and str(recorded or "").strip() in DECISION_RULINGS


def when(stamp: str | None) -> datetime | None:
    try:
        return datetime.fromisoformat(str(stamp))
    except (TypeError, ValueError):
        return None


def hours_between(start: str | None, end: str | None) -> float | None:
    first, second = when(start), when(end)
    if first is None or second is None:
        return None
    return (second - first).total_seconds() / 3600


def phase_timeline() -> list[tuple[str, str]]:
    """When each phase started, as far as the session log can say.

    An intervention row carries no phase of its own — nothing asked it to
    until now — so one is attributed from the campaign that was running when
    it was logged. `state/phase.toml` holds only the current phase, and the
    audit rows' fallback of "everything unlabelled is the current phase" is
    the thing the journal already flags as wrong the day a phase changes.
    """
    timeline: list[tuple[str, str]] = []
    for row in session_rows():
        started, phase = row.get("started") or "", row.get("phase") or ""
        if started and phase and (not timeline or timeline[-1][1] != phase):
            timeline.append((started, phase))
    return timeline


def phase_at(stamp: str, timeline: list[tuple[str, str]], fallback: str) -> str:
    found = fallback
    for started, phase in timeline:
        if started <= stamp:
            found = phase
    return found


def intervention_rows() -> list[dict]:
    """The log, with kinds canonicalised and a phase attributed to each row."""
    phase = load_phase()
    timeline = phase_timeline()
    rows = []
    for row in read_jsonl(INTERVENTIONS):
        entry = dict(row)
        entry["kind"] = canonical_kind(str(row.get("kind") or ""))
        entry["phase"] = row.get("phase") or phase_at(str(row.get("ts") or ""), timeline, phase.phase)
        rows.append(entry)
    return rows


def hand_authored_commits(limit: int = 200) -> list[dict]:
    """Commits that are nobody's campaign and not the harness's bookkeeping.

    `design/loops.md` section 16: "Out-of-band interventions cannot all be
    caught, but the two common ones can — a git hook flags hand-authored
    commits, and the harness logs its own kills." This is the reading half.
    Every such commit is an intervention under one of the section's own kinds:
    a hand edit to a design document is `spec-edited-by-hand`, a change under
    `harness/` is `harness-changed`. What is missing from each is the
    reasoning, which is the field the section says will get skipped.

    A commit counts as logged when its sha appears in the log. Rows written
    through the dashboard carry the sha of the commit *before* the one they
    cause, which is a `harness:` commit and excluded here anyway, so there is
    no need to guess at a time window.
    """
    raw = git(
        "log",
        f"-{limit}",
        "--no-merges",
        "--format=%H%x1f%s%x1f%(trailers:key=loop,valueonly)%x1f%cI",
    )
    logged = {row.get("commit") for row in read_jsonl(INTERVENTIONS)}
    found = []
    for line in raw.splitlines():
        parts = line.split("\x1f")
        if len(parts) != 4:
            continue
        sha, subject, loop, stamp = (part.strip() for part in parts)
        if loop or subject.startswith("harness: "):
            continue
        found.append({"commit": sha, "subject": subject, "ts": stamp, "logged": sha in logged})
    return found


RECURRING_KIND = 3

# Kinds that recur by construction, and whose count is therefore a workload
# figure rather than a design backlog item: every escalation gets exactly one
# answer, and every Class A edit gets exactly one reading. Section 16's
# examples are all of the other shape — "fifteen variations of *is this trade
# worth it*" — where the repetition is of the same question, not of the same
# event type. Flagging the routine three would make the flag mean nothing,
# which is how a signal gets ignored; their counts are still reported.
ROUTINE_KINDS = (
    "decision-answered",
    "spec-change-reviewed",
    "spec-drift-reviewed",
    "test-deletion-reviewed",
)


def intervention_stats() -> dict:
    """The three things `design/loops.md` section 16 says fall out of having
    the log, and which nothing else in the design reports.

    * **Interventions per 100 experiments, per phase** — "the honest version of
      close to one-shot". An experiment is a gate run, which is the same unit
      section 15's committed/reverted/empty mix is composed from, so the two
      numbers are about the same denominator.
    * **Recurring kinds are a design backlog.** Answering the same question
      repeatedly means a rule is missing from a prompt or an exchange rate was
      never written down. Three is the threshold, matching the standard the
      rules file already uses: one is an observation, three is evidence.
    * **Time to answer** — the gap between an escalation appearing and being
      answered "is time a loop spent idling on a provisional choice, and it is
      the number that says whether the dashboard is doing its job".

    Interventions per phase are counted, not the loops': a human answering a
    core escalation and a human revising the harness prompt are the same cost
    to the same person.
    """
    phase = load_phase()
    rows = intervention_rows()

    experiments: dict[str, int] = {}
    for owner in phase.loops:
        for row in cost_rows(owner):
            if row.get("kind") == "audit":
                continue
            runs = (row.get("experiments") or {}).get("gate_runs") or 0
            experiments[row.get("phase") or phase.phase] = (
                experiments.get(row.get("phase") or phase.phase, 0) + runs
            )

    counted: dict[str, int] = {}
    for row in rows:
        counted[row["phase"]] = counted.get(row["phase"], 0) + 1

    per_phase = []
    for name in sorted(set(counted) | set(experiments)):
        runs = experiments.get(name, 0)
        count = counted.get(name, 0)
        per_phase.append(
            {
                "phase": name,
                "interventions": count,
                "experiments": runs,
                "per_100": (count / runs * 100) if runs else None,
            }
        )

    by_kind: dict[str, int] = {}
    for row in rows:
        by_kind[row["kind"]] = by_kind.get(row["kind"], 0) + 1

    answers = decision_answers()
    answered, waiting = [], []
    stamp = now()
    for path in sorted((STATE / "decisions").glob("*.md")):
        text = path.read_text()
        opened = re.search(r"^opened:\s*(.+)$", text, re.MULTILINE)
        recorded = re.search(r"^status:\s*(.+)$", text, re.MULTILINE)
        title = re.search(r"^#\s+(.+)$", text, re.MULTILINE)
        entry = {
            "id": path.stem,
            "title": title.group(1).strip() if title else path.stem,
            "opened": opened.group(1).strip() if opened else "",
        }
        row = answers.get(path.stem)
        if row:
            entry["answered"] = row.get("ts") or ""
            entry["hours"] = hours_between(entry["opened"], entry["answered"])
            answered.append(entry)
        elif decision_status(path.stem, recorded.group(1) if recorded else "", answers) in (
            "open",
            "provisional",
        ):
            entry["hours"] = hours_between(entry["opened"], stamp)
            waiting.append(entry)

    measured = sorted(entry["hours"] for entry in answered if entry["hours"] is not None)
    hand = hand_authored_commits()
    return {
        "hand_authored": hand,
        "unlogged_commits": [entry for entry in hand if not entry["logged"]],
        "per_phase": per_phase,
        "by_kind": sorted(by_kind.items(), key=lambda pair: (-pair[1], pair[0])),
        "recurring": [
            kind
            for kind, count in by_kind.items()
            if count >= RECURRING_KIND and kind not in ROUTINE_KINDS
        ],
        "answered": sorted(answered, key=lambda entry: entry.get("hours") or 0, reverse=True),
        "waiting": sorted(waiting, key=lambda entry: entry.get("hours") or 0, reverse=True),
        "median_hours": measured[len(measured) // 2] if measured else None,
        "total": len(rows),
    }


# --------------------------------------------------------------------------
# Cheap measurements that go in every metrics row


_METADATA: dict | None = None


def cargo_metadata() -> dict:
    """`cargo metadata --no-deps`, once per process.

    Four callers want different slices of the same answer — the member names,
    which of them are vendored, a package's binary targets, and whether
    `heuristic_jump` declares a per-language feature — and the subprocess costs
    about a tenth of a second, which `record` was paying twice per row before
    any of them existed. An empty table stands for "there is no workspace
    here", which is the state the gate has to be usable in.
    """
    global _METADATA
    if _METADATA is None:
        _METADATA = {}
        if (REPO / "Cargo.toml").exists():
            result = subprocess.run(
                ["cargo", "metadata", "--no-deps", "--format-version", "1"],
                cwd=REPO,
                capture_output=True,
                text=True,
                check=False,
            )
            if result.returncode == 0:
                try:
                    _METADATA = json.loads(result.stdout)
                except json.JSONDecodeError:
                    _METADATA = {}
    return _METADATA


def workspace_members() -> set[str]:
    return {package["name"] for package in cargo_metadata().get("packages", [])}


def vendored_members() -> set[str]:
    return {
        package["name"]
        for package in cargo_metadata().get("packages", [])
        if f"{os.sep}vendor{os.sep}" in package["manifest_path"]
    }


def owned_members(config: LoopConfig) -> list[str]:
    """The ownership table names crates that may not exist yet; the gate
    builds the intersection with what the workspace actually has."""
    members = workspace_members()
    return sorted({m for m in members if matches_any(m, config.crates)})


NON_SOURCE_DIRECTORIES = ("tests", "target")


def parse_tokei_rust(output: str) -> int | None:
    """Rust code lines out of `tokei --output json`.

    Two shapes, because the field moved: tokei 10 wraps every language in
    `inner`, tokei 12 and later put them at the top level. Anything else — a
    future rename, an error on stderr, a language table with no Rust in it —
    returns None, and the caller falls back rather than recording a zero that
    would read as "the crate was deleted".
    """
    try:
        table = json.loads(output)
    except json.JSONDecodeError:
        return None
    if not isinstance(table, dict):
        return None
    if isinstance(table.get("inner"), dict):
        table = table["inner"]
    rust = table.get("Rust")
    if not isinstance(rust, dict):
        return None
    code = rust.get("code")
    return code if isinstance(code, int) else None


def counted_lines(crate: Path) -> int:
    """The fallback counter: non-blank lines of non-test Rust.

    Comments are in it, which `tokei` excludes, so the two numbers are not the
    same measurement — which is why the row records `loc_counter` beside them.
    """
    total = 0
    for source in crate.rglob("*.rs"):
        relative = source.relative_to(crate).parts
        if any(part in NON_SOURCE_DIRECTORIES for part in relative):
            continue
        total += sum(1 for line in source.read_text(errors="replace").splitlines() if line.strip())
    return total


def loc_per_crate() -> tuple[dict[str, int], str]:
    """Non-test Rust only, per crate, and which counter produced it.

    `tokei` is what `design/loops.md` section 11 specifies; the line count is
    what runs when it is not installed, and it was the only thing this function
    ever did. The two disagree by the comment lines, so a machine that installs
    `tokei` puts a step in the series — hence the counter name in the row: the
    discontinuity is then visible instead of looking like the loop deleted a
    thousand lines. LOC is reported and never gated, so neither number is
    load-bearing; being able to tell them apart is.
    """
    roots = [REPO / "crates", REPO / "vendor"]
    have_tokei = shutil.which("tokei") is not None
    excludes = [argument for directory in NON_SOURCE_DIRECTORIES for argument in ("-e", directory)]
    counts: dict[str, int] = {}
    counters: set[str] = set()
    for root in roots:
        if not root.exists():
            continue
        for crate in sorted(p for p in root.iterdir() if p.is_dir()):
            total: int | None = None
            if have_tokei:
                result = subprocess.run(
                    ["tokei", "--output", "json", *excludes, str(crate)],
                    capture_output=True,
                    text=True,
                    check=False,
                )
                if result.returncode == 0:
                    total = parse_tokei_rust(result.stdout)
            counters.add("tokei" if total is not None else "lines")
            if total is None:
                total = counted_lines(crate)
            if total:
                counts[crate.name] = total
    return counts, "mixed" if len(counters) > 1 else (counters.pop() if counters else "lines")


def test_count(members: list[str]) -> int | None:
    if not members:
        return None
    args = ["cargo", "nextest", "list", "--message-format", "json"]
    for member in members:
        args += ["-p", member]
    result = subprocess.run(args, cwd=REPO, capture_output=True, text=True, check=False)
    if result.returncode != 0:
        return None
    try:
        listing = json.loads(result.stdout)
    except json.JSONDecodeError:
        return None
    return sum(len(suite.get("testcases", {})) for suite in listing.get("rust-suites", {}).values())


# --------------------------------------------------------------------------
# Binary size: a proxy in every row, the link delta at phase gates
#
# `design/loops.md` §11 makes it two numbers and they are not interchangeable.
# The proxy is the stripped release size of `measure_<lang>`, which a loop can
# compute in isolation — that is what `core.md` §7's crate split is for — and
# which therefore goes in every row. The authoritative number is the
# per-language link delta against `heuristic_jump`, which needs the whole
# workspace built twice and belongs at a gate.
#
# §10's "`measure_<lang>` size covers the size gap" adds the three caveats that
# shape the code below: the constant moves when `shared` or `measure_core`
# does, so the ratchet re-baselines at those commits rather than blaming
# whoever iterated next; the grammar dominates and has to be reported
# separately, which `cargo bloat --crates` does approximately; and the link
# delta stays authoritative when the two disagree.


def binary_targets(package: str) -> list[str]:
    """The `[[bin]]` names, which are not the package name here: `core.md` §9
    renames every artifact to its hyphenated form, so `measure_rust` builds
    `measure-rust`. Reading them out of the manifest rather than transliterating
    the package name means a crate that renames its binary again is followed
    rather than silently unmeasured."""
    for entry in cargo_metadata().get("packages", []):
        if entry.get("name") == package:
            return [
                target["name"]
                for target in entry.get("targets", [])
                if "bin" in target.get("kind", [])
            ]
    return []


def stripped_size(binary: Path) -> int | None:
    """The stripped size, measured on a copy.

    §11 says *stripped* and the word is load-bearing: the workspace release
    profile sets `debug = "limited"`, so the artifact on disk is about five
    times the number the section means — 26.3 MB against 5.4 MB for
    `measure-rust` when this was written. Stripping in place would also make
    the next `cargo build` relink, so the copy is not a nicety.

    No `strip` on PATH records nothing rather than the unstripped number. This
    metric is ratcheted in phase 3 and a series that silently mixed the two
    measurements would compare a stripped row against an unstripped one and
    stop the loop over a missing tool. `loc` can afford `loc_counter` because
    it is never gated; this cannot.
    """
    tool = shutil.which("strip") or shutil.which("llvm-strip")
    if tool is None or not binary.exists():
        return None
    with tempfile.TemporaryDirectory() as directory:
        copy = Path(directory) / binary.name
        shutil.copy2(binary, copy)
        result = subprocess.run([tool, str(copy)], capture_output=True, text=True, check=False)
        if result.returncode != 0:
            return None
        return copy.stat().st_size


def parse_bloat_crates(output: str) -> dict[str, int] | None:
    """Per-crate byte attribution out of `cargo bloat --crates --message-format json`.

    JSON rather than the text table, whose sizes are rendered as `1.1MiB` and
    have already lost the precision a delta needs.

    The shape is read defensively — a list of `{name, size}` under `crates` —
    and anything else returns None, for `parse_tokei_rust`'s reason. cargo-bloat
    is not a pinned dependency; it is an optional tool that may not be installed
    and whose output nobody here controls, so a shape we do not recognise
    records nothing rather than a number that is wrong invisibly. The attribution
    is approximate even when it parses — symbols blur across inlining and
    generics — which is why §10 keeps it beside the exact whole-binary number
    instead of replacing it.
    """
    try:
        table = json.loads(output)
    except json.JSONDecodeError:
        return None
    if not isinstance(table, dict):
        return None
    crates = table.get("crates")
    if not isinstance(crates, list):
        return None
    attributed: dict[str, int] = {}
    for entry in crates:
        if not isinstance(entry, dict):
            continue
        name, size = entry.get("name"), entry.get("size")
        if isinstance(name, str) and isinstance(size, int) and not isinstance(size, bool):
            attributed[name] = size
    return attributed or None


def bloat_crates(package: str, binary: str) -> dict[str, int] | None:
    if shutil.which("cargo-bloat") is None:
        return None
    result = subprocess.run(
        [
            "cargo",
            "bloat",
            "--release",
            "--crates",
            "--message-format",
            "json",
            "-p",
            package,
            "--bin",
            binary,
        ],
        cwd=REPO,
        capture_output=True,
        text=True,
        check=False,
    )
    return parse_bloat_crates(result.stdout) if result.returncode == 0 else None


def binary_size(package: str) -> dict | None:
    """§11's per-iteration proxy for one `measure_<lang>` package.

    Both numbers §10 asks for: `stripped` is the whole binary, exact and
    coarse; `crates` is the per-crate attribution, fuzzy and the only thing
    that separates the handler from the grammar sitting next to it. A missing
    `crates` key means cargo-bloat was unavailable, not that the handler
    contributed nothing.
    """
    if package not in workspace_members():
        return None
    targets = binary_targets(package)
    if not targets:
        return None
    binary = targets[0]
    result = subprocess.run(
        ["cargo", "build", "--release", "-p", package, "--bin", binary],
        cwd=REPO,
        capture_output=True,
        text=True,
        check=False,
    )
    if result.returncode != 0:
        return None
    size = stripped_size(REPO / "target" / "release" / binary)
    if size is None:
        return None
    row: dict = {"package": package, "binary": binary, "stripped": size}
    attributed = bloat_crates(package, binary)
    if attributed:
        row["crates"] = attributed
    return row


def measure_packages(config: LoopConfig) -> list[str]:
    """The `measure_<lang>` packages whose size this loop's rows carry.

    Gated on the loop declaring a `language` rather than on it owning the
    crate, and the distinction costs the conformance loop its number
    deliberately. §11's bullet says "the stripped release size of
    `measure_<lang>`" under the heading **Per-language billing**, and the
    number exists so a tuning loop can watch its own handler grow. A release
    build with `lto = "thin"` and `codegen-units = 1` is minutes of machine
    time per row; spending it on a loop that has no language, no frontier and
    nothing that reads the series buys nothing. `hj size <loop>` measures on
    demand for anyone who wants it anyway.
    """
    if not config.language:
        return []
    package = f"measure_{config.language}"
    return [package] if package in workspace_members() else []


# The crates whose size sits inside `measure_<lang>` as a constant the language
# loop did not choose: `measure_core`'s LSP client, JSON handling and CLI, and
# everything `shared` carries. §10 — "the constant moves when the conformance
# loop changes `shared` or `measure_core`" — makes a commit to either the point
# at which the ratchet starts over, so that a language loop is not failed for a
# step somebody else's diff put in its series.
SIZE_CONSTANT_PATHS = ["crates/shared", "crates/measure_core"]


def size_rebaseline_commit() -> str | None:
    return git("log", "-1", "--format=%H", "--", *SIZE_CONSTANT_PATHS, check=False).strip() or None


def rows_since(rows: list[dict], commit: str | None) -> list[dict]:
    """The rows recorded at or after `commit`, by reachability rather than by
    position in the file. The metrics file is append-ordered, but a worker's
    branch merges out of order often enough that "everything after the line
    mentioning this sha" is not the same set."""
    if commit is None:
        return rows
    reachable = set(git("rev-list", f"{commit}..HEAD", check=False).split())
    reachable.add(commit)
    return [row for row in rows if row.get("commit") in reachable]


def size_baseline(owner: str, package: str) -> int | None:
    """The size this loop may not exceed, out of its own history.

    Lowest rather than highest, which inverts `highest_recorded`: the direction
    is the other way round, since §11's phase-3 ratchet says neither number may
    increase at all. Re-baselined at `size_rebaseline_commit`, and there is no
    floor file for it — `harness/ratchets.toml` holds floors under metrics that
    should rise, and a ceiling written by hand under one that should fall would
    be a licence to grow rather than a guard against shrinking dishonestly.
    """
    sizes = [
        row["binary"]["stripped"]
        for row in rows_since(read_jsonl(metrics_path(owner)), size_rebaseline_commit())
        if isinstance(row.get("binary"), dict)
        and isinstance(row["binary"].get("stripped"), int)
        and row["binary"].get("package") == package
    ]
    return min(sizes) if sizes else None


# §11's second number, and the authoritative one: "Binary size is measured as a
# delta: build with and without each `lang_*` linked. Each language then has its
# own line item rather than a workspace aggregate nobody can influence."
#
# Building `heuristic_jump` *without* a language is only possible if the
# dependency is optional and a feature gates it, so the convention has to be
# named somewhere and this is it. `lang-rust` rather than `rust`, because a
# bare feature called `rust` on a Rust crate reads as something about the
# toolchain.
SHIPPED_PACKAGE = "heuristic_jump"


def language_feature(language: str) -> str:
    return f"lang-{language}"


def language_packages() -> list[str]:
    return sorted(name for name in workspace_members() if name.startswith("lang_"))


def declared_features(package: str) -> dict[str, list[str]]:
    for entry in cargo_metadata().get("packages", []):
        if entry.get("name") == package:
            features = entry.get("features")
            return features if isinstance(features, dict) else {}
    return {}


def build_shipped(features: list[str] | None) -> int | None:
    """The stripped size of `heuristic-jump`, built with `features` in place of
    its defaults. `None` means the default set, which is the whole of it."""
    targets = binary_targets(SHIPPED_PACKAGE)
    if not targets:
        return None
    arguments = ["cargo", "build", "--release", "-p", SHIPPED_PACKAGE, "--bin", targets[0]]
    if features is not None:
        arguments += ["--no-default-features"]
        if features:
            arguments += ["--features", ",".join(features)]
    result = subprocess.run(arguments, cwd=REPO, capture_output=True, text=True, check=False)
    if result.returncode != 0:
        return None
    return stripped_size(REPO / "target" / "release" / targets[0])


def link_deltas() -> list[dict]:
    """One line item per language: what linking it costs the shipped binary.

    A row with `delta: None` carries `reason`, and the reason is the point. The
    measurement needs `heuristic_jump` to be buildable without the language,
    which means an optional dependency behind `lang-<x>`; today the dependency
    is unconditional, so the number cannot be taken. Saying which feature is
    missing turns "this is not measured" into a one-line manifest change for
    whoever owns that crate — where a silent zero would read as a language that
    costs nothing.
    """
    languages = [name[len("lang_") :] for name in language_packages()]
    if SHIPPED_PACKAGE not in workspace_members() or not languages:
        return []
    features = declared_features(SHIPPED_PACKAGE)
    missing = [
        language for language in languages if language_feature(language) not in features
    ]
    if missing:
        return [
            {
                "language": language,
                "feature": language_feature(language),
                "delta": None,
                "reason": (
                    f"{SHIPPED_PACKAGE} declares no `{language_feature(language)}` feature, "
                    f"so it cannot be built without lang_{language}"
                ),
            }
            for language in languages
        ]
    whole = build_shipped(None)
    if whole is None:
        return [
            {"language": language, "feature": language_feature(language), "delta": None,
             "reason": f"{SHIPPED_PACKAGE} did not build with its default features"}
            for language in languages
        ]
    rows = []
    for language in languages:
        others = [language_feature(other) for other in languages if other != language]
        without = build_shipped(others)
        rows.append(
            {
                "language": language,
                "feature": language_feature(language),
                "whole": whole,
                "without": without,
                "delta": None if without is None else whole - without,
                "reason": None if without is not None else "the build without it failed",
            }
        )
    # Leave the tree holding the artifact a reader would expect, rather than
    # whichever partial link the last iteration of the loop produced.
    build_shipped(None)
    return rows


# The phases in which size is gated. §11: "Gated only in phase 3, where the
# ratchet is hard: neither may increase at all, since phase 3 may not buy size
# with quality in the first place." Phase 7 is the second cost phase and
# `harness/gate`'s own step already pairs the two.
SIZE_RATCHET_PHASES = ("3", "7")


def check_size_ratchet(config: LoopConfig, phase: Phase) -> int:
    """§11's hard ratchet on the size proxy.

    Silent outside a cost phase, and that is the design rather than a
    convenience: §11 argues at length that a standing ratchet "would have
    applied the pressure during exactly the iterations that should be free to
    be wasteful", and that phase 3 existing to delete is most of the answer.

    The failure wording is not the test ratchet's. A test count that falls is a
    decision record the loop writes and then continues past; a size increase in
    a cost phase "requires an approved escalation, not a self-written
    justification", so the gate stays red until a human has answered.
    """
    if phase.phase not in SIZE_RATCHET_PHASES:
        return 0
    for package in measure_packages(config):
        measured = binary_size(package)
        if measured is None:
            print(f"size: {package} could not be measured; the ratchet has nothing to hold")
            continue
        baseline = size_baseline(config.owner, package)
        if baseline is None:
            print(f"size: {measured['binary']} {measured['stripped']}; no baseline yet")
            continue
        if measured["stripped"] <= baseline:
            print(f"size: {measured['binary']} {measured['stripped']}, ratchet at {baseline}")
            continue
        print(
            f"size: {measured['binary']} is {measured['stripped']} bytes stripped against a "
            f"ratchet of {baseline}. Phase {phase.phase} may not buy size with quality "
            "(design/loops.md section 11), so this may not increase at all.\n"
            "         An increase requires an *approved* escalation, not a "
            "self-written justification: open a class-b decision record and wait "
            "for it. This is the one gate failure a provisional choice does not "
            "clear.\n"
            f"         The baseline is the lowest this loop has recorded since "
            f"{(size_rebaseline_commit() or 'the start of the history')[:12]}, which is "
            "the last commit to crates/shared or crates/measure_core.",
            file=sys.stderr,
        )
        return 1
    return 0


# The ratchet baselines. `design/loops.md` §17 builds these rather than
# adopting Bencher, and its reason decides the shape: our measurements are
# deterministic, so the only threshold model that fits is the static one, and
# "a baseline file in git is *better* than a service — a ratchet change shows
# up in the commit diff, which is exactly where the question 'did the loop
# justify this regression?' gets asked."
#
# The live baseline is the highest value the loop has recorded, which needs no
# file and cannot go stale. This file is the *floor* underneath it: it survives
# a rewritten metrics history, and it is where a human sets a number the
# history has not reached yet. It lives in `harness/`, which is denied to every
# loop, so lowering one is an edit a loop cannot make.
RATCHETS = HARNESS / "ratchets.toml"


def ratchet_floor(owner: str, metric: str) -> int | None:
    if not RATCHETS.exists():
        return None
    value = (tomllib.loads(RATCHETS.read_text()).get(owner) or {}).get(metric)
    return value if isinstance(value, int) else None


def highest_recorded(recorded: list[object], floor: int | None) -> int | None:
    """Highest rather than last: a ratchet that reads only the previous row can
    be walked down one campaign at a time, each step passing because it only
    has to clear the step before it. A row that recorded nothing — the metric
    was unavailable, not zero — is not a value."""
    values = [value for value in recorded if isinstance(value, int) and not isinstance(value, bool)]
    if floor is not None:
        values.append(floor)
    return max(values) if values else None


def ratchet_baseline(owner: str, metric: str) -> int | None:
    """The highest value recorded, floored by `harness/ratchets.toml`."""
    rows = read_jsonl(metrics_path(owner))
    return highest_recorded([row.get(metric) for row in rows], ratchet_floor(owner, metric))


# What a removed test looks like in a diff. `#[test]` covers `proptest!` and
# insta snapshot tests, which expand to it; the other two are attribute macros
# that generate their own cases, so removing one removes several.
TEST_ATTRIBUTES = ("#[test]", "#[rstest", "#[test_case")
REMOVED_FUNCTION = re.compile(r"^-\s*(?:pub\s+)?(?:async\s+)?fn\s+(?P<name>[A-Za-z0-9_]+)")


def removed_tests(diff: str) -> list[str]:
    """Test declarations this diff deletes, by name.

    `design/loops.md` §7 asks for deletions to be "flagged for review
    regardless of count", which the count ratchet cannot do: deleting one test
    and adding another leaves the count flat, and that is the shape a loop
    reaches for when a test is in its way. A rename is flagged too — the
    countermeasure is a human reading it, and a rename takes one second to
    dismiss where a silent deletion takes a campaign to notice.
    """
    names: list[str] = []
    pending = 0

    def close_attributes() -> None:
        # A `#[test]` deleted while its function stays is the test being
        # switched off rather than removed, and it has no name to report.
        nonlocal pending
        names.extend(["(a #[test] attribute, function kept)"] * pending)
        pending = 0

    for line in diff.splitlines():
        if line.startswith("@@") or (line.startswith("+") and not line.startswith("+++")):
            close_attributes()
            continue
        if not line.startswith("-") or line.startswith("---"):
            continue
        stripped = line[1:].strip()
        if any(stripped.startswith(attribute) for attribute in TEST_ATTRIBUTES):
            pending += 1
            continue
        match = REMOVED_FUNCTION.match(line)
        if match:
            if pending:
                names.extend([match.group("name")] * pending)
                pending = 0
            continue
        # Anything else between the attribute and the function means they were
        # not a pair, so the count does not carry across it.
        if stripped and not stripped.startswith(("#[", "//", "/*", "*")):
            close_attributes()
    close_attributes()
    return names


def removed_tests_in(rev: str | None, paths: list[str]) -> list[str]:
    """Against the working tree by default, because that is what the gate is
    about to let through; against a commit for `record`, which runs after it."""
    if not paths:
        return []
    arguments = ["diff", "-U0"]
    arguments += [f"{rev}~", rev] if rev else ["HEAD"]
    result = subprocess.run(
        ["git", "-C", str(REPO), *arguments, "--", *paths],
        capture_output=True,
        text=True,
        check=False,
    )
    return removed_tests(result.stdout) if result.returncode == 0 else []


def crate_paths(config: LoopConfig) -> list[str]:
    return [pattern for pattern in config.write if pattern.startswith(("crates/", "vendor/"))]


def check_test_ratchet(config: LoopConfig) -> int:
    """Test count is a ratchet (`design/loops.md` §7, first row of the gaming
    table). Deletions are flagged and do not fail: the flag is for a human, and
    a legitimate rename would otherwise stop the loop dead.

    Only the test count is ratcheted, and the others are worth naming so the
    omission is a decision rather than an oversight. `sections_clean` falls
    honestly whenever a fresh audit re-judges a section it had called clean —
    ratcheting it would make the loop's number unable to correct itself.
    `provisional_decisions` rises when the loop escalates, which is the
    behaviour §6 wants. `loc` is reported and never gated (§11). Binary size is
    ratcheted too, by `check_size_ratchet`, but only in a cost phase and with a
    harder failure — the two are kept apart because their directions and their
    escape hatches differ.
    """
    for name in removed_tests_in(None, crate_paths(config)):
        print(f"metrics: FLAGGED — this diff deletes a test: {name}")
    measured = test_count(owned_members(config))
    if measured is None:
        print("metrics: no test count for this loop; the ratchet has nothing to hold")
        return 0
    baseline = ratchet_baseline(config.owner, "tests")
    if baseline is None:
        print(f"metrics: {measured} test(s); no baseline yet, so this one becomes it")
        return 0
    if measured >= baseline:
        print(f"metrics: {measured} test(s), ratchet at {baseline}")
        return 0
    print(
        f"metrics: {measured} test(s) against a ratchet of {baseline}. Tests are a "
        "ratchet (design/loops.md section 7): deleting or weakening them is the "
        "first gaming route the design names, so the count may not fall.\n"
        "         If the drop is legitimate — a test that was wrong, or one "
        "replaced by a stronger one — that is a decision record, not a gate "
        f"argument. The floor lives in harness/ratchets.toml under [{config.owner}].",
        file=sys.stderr,
    )
    return 1


def cli_version() -> str:
    """Recorded per campaign beside the prompt sha, and for the same reason
    (`design/loops.md` section 17). A prompt revision changes the *generator*
    of campaigns and nothing downstream can detect it; a CLI upgrade does the
    same thing, arrives without anybody deciding to change anything, and is
    otherwise completely invisible."""
    result = subprocess.run(
        [str(HARNESS / "adapter"), "version"], capture_output=True, text=True, check=False
    )
    return result.stdout.strip() or "unknown"


# Where a `DECISION-` tag is a *mention* rather than a site. The records and
# the design are talk about the mechanism; so are the prompt that tells a loop
# to write the tag and the template that shows its shape. Everything else is a
# site, `harness/` included — excluding the whole of it, as this list used to,
# made the count structurally zero for the one loop whose implementation is
# `harness/`, and a health metric that cannot move is not one
# (`design/loops.md` section 6).
DECISION_TAG_NOT_A_SITE = [
    ":!state",
    ":!design",
    ":!harness/prompts",
    ":!harness/decision-template.md",
]


def tag_sites(grep_output: str) -> list[tuple[str, int]]:
    """Parse `git grep -z -n`, which puts a NUL after the path and after the
    line number. `-z` rather than plain `-n` because both of the other fields
    can contain a colon — a path may, and the matched line is a tag followed
    by `: provisional`, so it always does."""
    sites = []
    for record in grep_output.splitlines():
        path, _, rest = record.partition("\0")
        number, _, _ = rest.partition("\0")
        if number.isdigit():
            sites.append((path, int(number)))
    return sites


def selftest_line_range(source: str) -> tuple[int, int]:
    """The lines `selftest_cases` occupies in this file.

    Four of its fixtures are diffs written out as string literals that carry a
    `DECISION-` tag, because what they test is the reader of that tag. They are
    talk about the mechanism in exactly the sense the prompts and the template
    are, and the only reason `DECISION_TAG_NOT_A_SITE` cannot exclude them by
    path is that they share a file with the harness loop's implementation,
    which has to stay countable or the metric is structurally zero for that
    loop. So the exclusion is by region instead, read off the source rather
    than written down, since a line number in a constant goes stale silently.
    """
    start = 0
    for number, line in enumerate(source.splitlines(), start=1):
        if line.startswith("def selftest_cases("):
            start = number
        elif start and line.startswith("def "):
            return start, number
    # An empty range rather than an open one when the marker is absent: if this
    # ever stops matching, the count is wrong by four and not by everything.
    return (start, sys.maxsize) if start else (0, 0)


def outside_selftest_region(sites: list[tuple[str, int]], source: str) -> list[tuple[str, int]]:
    first, past = selftest_line_range(source)
    return [(path, number) for path, number in sites if not (path == "harness/hj" and first <= number < past)]


def provisional_tag_sites(identifier: str | None = None) -> list[tuple[str, int]]:
    """Every site still running on a provisional choice, as (path, line).

    The one place the scope is defined, because it has two exclusions and both
    have to hold for every reader: `DECISION_TAG_NOT_A_SITE` drops the paths
    that are talk about the mechanism, and `selftest_line_range` drops this
    file's own fixtures, which are tags written to test the reader of tags.
    `tagged_sites` used to state that scope in its docstring and implement a
    different one, which listed `harness/hj` under every decision id a fixture
    happened to name — so an answered decision could never be reported
    reconciled, and the loop that raised it was sent to a file with no tag in
    it. Sharing the function is what makes the docstring true by construction.
    """
    pattern = (
        rf"DECISION-{re.escape(identifier)}: provisional"
        if identifier
        else r"DECISION-[A-Za-z0-9_-]+: provisional"
    )
    result = subprocess.run(
        ["git", "-C", str(REPO), "grep", "-z", "-n", "-E", pattern, "--", *DECISION_TAG_NOT_A_SITE],
        capture_output=True,
        text=True,
        check=False,
    )
    return outside_selftest_region(tag_sites(result.stdout), (HARNESS / "hj").read_text())


def provisional_decisions() -> int:
    """Sites still running on a provisional choice. Its count is a health
    metric — rising steadily means the loop is running ahead of its decisions
    and the work is getting speculative (`design/loops.md` section 6).
    """
    return len(provisional_tag_sites())


