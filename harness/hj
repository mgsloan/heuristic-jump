        cut = hypothesis_of(record)
        assert len(cut) <= HYPOTHESIS_CAP + 1 and cut.endswith("…"), cut
        assert not cut.endswith(" …"), "cutting mid-word would misquote it"

    def the_digest_cap_is_reported_with_the_amount_over():
