#!/usr/bin/env python3
"""The harness's structural tool. See harness/readme.md.

Everything here is mechanical: parsing section lists out of the design
documents, merging an auditor's verdict into `state/audit/`, checking a
commit's diff scope against the ownership table, rendering a prompt from
its template, and appending the rows that make `state/` a record rather
than a memory.

Nothing here makes a judgement. The judgements belong to the campaign
(what to work on) and to the auditor (whether a section is clean); this
file only decides what is *true* about files on disk.

Owned by nobody, per `design/loops.md` section 13 — a loop that could edit
this could edit the thing that scores it.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import subprocess
import sys
import tomllib
import uuid
from dataclasses import dataclass, field
from datetime import datetime, timezone
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
HARNESS = REPO / "harness"
STATE = REPO / "state"
DESIGN = REPO / "design"

# Denied to every loop in every phase, and deliberately a constant here
# rather than a row in `state/phase.toml`: the ownership table is data the
# gate reads, and a loop that could widen it could widen its own reach.
# `design/loops.md` section 13 states the prohibition; keeping the deny list
# out of configuration is what makes it unrepresentable rather than merely
# forbidden.
DENIED_ALWAYS = [
    "harness/**",
    "state/phase.toml",
    "state/audit/**",
    "state/interventions.jsonl",
    "state/sessions.jsonl",
    "CLAUDE.md",
    "clippy.toml",
    ".claude/**",
]

# The one path whose owner is a function of the phase: shared resolution code
# is writable only during whole-repository phases, when there is one writer and
# nothing running alongside (`design/loops.md` section 13). Resolved against
# `state/phase.toml` so the table has one answer at any moment, rather than
# being granted by one row and denied by another.
WHOLE_REPOSITORY_PHASES = ("3", "7")
PHASE_DEPENDENT_DENIALS = ["crates/similarity/**"]

OUTCOMES = ("confirmed", "falsified", "no-movement", "budget", "crashed", "error")


def now() -> str:
    return datetime.now(timezone.utc).isoformat(timespec="seconds")


def die(message: str) -> None:
    print(f"hj: {message}", file=sys.stderr)
    raise SystemExit(2)


# --------------------------------------------------------------------------
# Paths and globbing


def glob_to_regex(pattern: str) -> re.Pattern[str]:
    """`**` crosses directory separators, `*` and `?` do not."""
    if pattern.endswith("/"):
        pattern = pattern + "**"
    out = []
    index = 0
    while index < len(pattern):
        char = pattern[index]
        if pattern.startswith("**/", index):
            out.append("(?:.*/)?")
            index += 3
        elif pattern.startswith("**", index):
            out.append(".*")
            index += 2
        elif char == "*":
            out.append("[^/]*")
            index += 1
        elif char == "?":
            out.append("[^/]")
            index += 1
        else:
            out.append(re.escape(char))
            index += 1
    return re.compile("".join(out) + r"\Z")


def matches_any(path: str, patterns: list[str]) -> bool:
    return any(glob_to_regex(p).match(path) for p in patterns)


# --------------------------------------------------------------------------
# Desired state


@dataclass
class LoopConfig:
    owner: str
    status: str
    prompt: str
    docs: list[str]
    crates: list[str]
    write: list[str]
    stall_n: int
    rotation: int
    splice_sections: int
    budget_usd: float | None
    model: str | None
    language: str | None


@dataclass
class Phase:
    phase: str
    loops: dict[str, LoopConfig] = field(default_factory=dict)


def load_phase() -> Phase:
    path = STATE / "phase.toml"
    if not path.exists():
        die(f"{path} does not exist; the harness has no desired state to reconcile against")
    raw = tomllib.loads(path.read_text())
    result = Phase(phase=raw["phase"])
    for owner, table in raw.get("loop", {}).items():
        result.loops[owner] = LoopConfig(
            owner=owner,
            status=table.get("status", "paused"),
            prompt=table["prompt"],
            docs=table.get("docs", []),
            crates=table.get("crates", []),
            write=table.get("write", []),
            stall_n=table.get("stall_n", 3),
            rotation=table.get("rotation", 6),
            splice_sections=table.get("splice_sections", 3),
            budget_usd=table.get("budget_usd"),
            model=table.get("model"),
            language=table.get("language"),
        )
    return result


def denied_paths(phase: Phase) -> list[str]:
    if phase.phase in WHOLE_REPOSITORY_PHASES:
        return list(DENIED_ALWAYS)
    return DENIED_ALWAYS + PHASE_DEPENDENT_DENIALS


def loop_config(owner: str) -> tuple[Phase, LoopConfig]:
    phase = load_phase()
    if owner not in phase.loops:
        die(f"no loop named {owner!r} in state/phase.toml (have: {', '.join(sorted(phase.loops))})")
    return phase, phase.loops[owner]


# --------------------------------------------------------------------------
# Design documents: the section list is parsed, never authored


# Level 2 and 3. The design documents put most of their checkable claims under
# `###`, and a denominator of ten sections for a 1700-line document is one the
# numerator can barely move — "sections clean over sections total" is only a
# useful number at a granularity where a campaign can finish one. Each body
# runs to the next heading of any level, so the sections partition the document
# rather than nesting.
HEADING = re.compile(r"^#{2,3}\s+(?P<text>\S.*?)\s*$")


def anchor_of(heading: str) -> str:
    """GitHub's slug: lowercase, drop everything but word characters, spaces
    and hyphens, then spaces to hyphens."""
    slug = heading.strip().lower()
    slug = re.sub(r"[^a-z0-9 _-]", "", slug)
    return re.sub(r"\s+", "-", slug).strip("-")


@dataclass
class Section:
    doc: str
    anchor: str
    heading: str
    start: int  # line index of the heading
    end: int  # line index one past the last line of the body

    @property
    def key(self) -> str:
        return f"{self.doc}#{self.anchor}"


def doc_path(doc: str) -> Path:
    path = DESIGN / doc
    if not path.exists():
        die(f"no such design document: {doc}")
    return path


def sections_of(doc: str) -> list[Section]:
    lines = doc_path(doc).read_text().splitlines()
    found: list[Section] = []
    in_fence = False
    for index, line in enumerate(lines):
        if line.startswith("```"):
            in_fence = not in_fence
            continue
        if in_fence:
            continue
        match = HEADING.match(line)
        if match:
            heading = match.group("text")
            found.append(Section(doc, anchor_of(heading), heading, index, len(lines)))
    for earlier, later in zip(found, found[1:]):
        earlier.end = later.start
    seen: dict[str, int] = {}
    for section in found:
        count = seen.get(section.anchor, 0)
        seen[section.anchor] = count + 1
        if count:
            section.anchor = f"{section.anchor}-{count}"  # GitHub's own tie-break
    return found


def section_index(docs: list[str]) -> dict[str, Section]:
    return {s.key: s for doc in docs for s in sections_of(doc)}


# --------------------------------------------------------------------------
# The baseline: the denominator, frozen for the phase
#
# It lives in `harness/` and not `state/` for the reason everything else in
# `harness/` does — a loop must not be able to move the thing that scores it,
# and here the score is a fraction whose denominator is parsed out of
# documents the conformance loop is allowed to edit.

BASELINE = HARNESS / "section-baseline.toml"


def read_baseline() -> dict:
    if not BASELINE.exists():
        return {}
    return tomllib.loads(BASELINE.read_text())


def baseline_anchors(doc: str) -> set[str] | None:
    """`None` when no baseline has been taken, which means "fall back to the
    documents and say so" rather than "the denominator is zero"."""
    entry = read_baseline().get("doc", {}).get(doc)
    if entry is None:
        return None
    return {f"{doc}#{anchor}" for anchor in entry.get("anchors", [])}


def baseline_drift(docs: list[str]) -> list[str]:
    lines = []
    for doc in docs:
        expected = baseline_anchors(doc)
        if expected is None:
            lines.append(f"{doc}: no baseline; the denominator is being re-derived each audit")
            continue
        live = {s.key for s in sections_of(doc)}
        for key in sorted(expected - live):
            lines.append(f"{key}: in the baseline, gone from the document — counted, and never clean")
        for key in sorted(live - expected):
            lines.append(f"{key}: added since the baseline — audited, but it does not move the score")
    return lines


def section_text(section: Section) -> str:
    lines = doc_path(section.doc).read_text().splitlines()
    body = "\n".join(lines[section.start : section.end]).rstrip()
    return f"<!-- {section.key} -->\n{body}\n"


# --------------------------------------------------------------------------
# The audit record


@dataclass
class Gap:
    claim: str
    found: str
    where: str


@dataclass
class Minor:
    claim: str
    note: str
    where: str


@dataclass
class SectionVerdict:
    key: str
    state: str  # clean | gaps | unjudged
    last_audited: str | None
    gaps: list[Gap] = field(default_factory=list)
    minors: list[Minor] = field(default_factory=list)


VALID_STATES = ("clean", "gaps", "unjudged")


def audit_path(doc: str) -> Path:
    return STATE / "audit" / f"{doc.removesuffix('.md')}.toml"


def read_audit(doc: str) -> dict[str, SectionVerdict]:
    path = audit_path(doc)
    if not path.exists():
        return {}
    raw = tomllib.loads(path.read_text())
    out: dict[str, SectionVerdict] = {}
    for key, table in raw.get("section", {}).items():
        out[key] = SectionVerdict(
            key=key,
            state=table.get("state", "unjudged"),
            last_audited=table.get("last_audited"),
            gaps=[Gap(g.get("claim", ""), g.get("found", ""), g.get("where", "")) for g in table.get("gap", [])],
            minors=[Minor(m.get("claim", ""), m.get("note", ""), m.get("where", "")) for m in table.get("minor", [])],
        )
    return out


def toml_string(value: str) -> str:
    if "\n" in value:
        escaped = value.replace("\\", "\\\\").replace('"""', '\\"\\"\\"')
        return f'"""\n{escaped}"""'
    return json.dumps(value)


def write_audit(doc: str, verdicts: dict[str, SectionVerdict], order: list[str]) -> None:
    lines = [
        f"# Audit of design/{doc}. Written by harness/audit, never by hand.",
        "# `design/loops.md` section 3. The section list is parsed out of the",
        "# document, so it follows the document rather than drifting from it.",
        "",
    ]
    for key in order:
        verdict = verdicts[key]
        lines.append(f"[section.{toml_string(key)}]")
        lines.append(f"state = {toml_string(verdict.state)}")
        if verdict.last_audited:
            lines.append(f"last_audited = {toml_string(verdict.last_audited)}")
        for gap in verdict.gaps:
            lines.append("")
            lines.append(f"  [[section.{toml_string(key)}.gap]]")
            lines.append(f"  claim = {toml_string(gap.claim)}")
            lines.append(f"  found = {toml_string(gap.found)}")
            lines.append(f"  where = {toml_string(gap.where)}")
        for minor in verdict.minors:
            lines.append("")
            lines.append(f"  [[section.{toml_string(key)}.minor]]")
            lines.append(f"  claim = {toml_string(minor.claim)}")
            lines.append(f"  note = {toml_string(minor.note)}")
            lines.append(f"  where = {toml_string(minor.where)}")
        lines.append("")
    path = audit_path(doc)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text("\n".join(lines))


def audit_counts(docs: list[str]) -> dict[str, int]:
    """The conformance loop's number.

    Counted against the *baseline* rather than the documents as they read
    now, because the section list is parsed from headings in documents the
    loop may edit: re-deriving the denominator each audit would let it merge
    two dirty sections into one clean one and move the score without touching
    a line of code (`design/loops.md` section 7).

    A baseline section that no longer exists is counted and is never clean.
    A section added since the baseline is audited — it is real work — but
    does not move the score this phase.
    """
    clean = total = gaps = minors = unjudged = missing = added = 0
    for doc in docs:
        expected = baseline_anchors(doc)
        live = {s.key for s in sections_of(doc)}
        verdicts = read_audit(doc)
        scored = expected if expected is not None else live
        total += len(scored)
        added += len(live - scored)
        for key in scored:
            if key not in live:
                missing += 1
                continue
            verdict = verdicts.get(key)
            if verdict is None or verdict.state == "unjudged":
                unjudged += 1
                continue
            if verdict.state == "clean":
                clean += 1
        for key, verdict in verdicts.items():
            if key in live:
                gaps += len(verdict.gaps)
                minors += len(verdict.minors)
    return {
        "sections_clean": clean,
        "sections_total": total,
        "sections_unjudged": unjudged,
        "sections_missing": missing,
        "sections_added": added,
        "open_gaps": gaps,
        "audit_minors": minors,
    }


def open_gaps(docs: list[str]) -> list[tuple[str, Gap]]:
    out: list[tuple[str, Gap]] = []
    for doc in docs:
        known = {s.key for s in sections_of(doc)}
        for key, verdict in read_audit(doc).items():
            if key in known:
                out.extend((key, gap) for gap in verdict.gaps)
    return out


# --------------------------------------------------------------------------
# Git


def git(*args: str, check: bool = True) -> str:
    result = subprocess.run(
        ["git", "-C", str(REPO), *args], capture_output=True, text=True, check=False
    )
    if check and result.returncode != 0:
        die(f"git {' '.join(args)} failed: {result.stderr.strip()}")
    return result.stdout


def head_sha() -> str:
    return git("rev-parse", "HEAD").strip()


def trailers_of(rev: str) -> dict[str, str]:
    body = git("log", "-1", "--format=%B", rev)
    parsed = subprocess.run(
        ["git", "interpret-trailers", "--parse"],
        input=body,
        capture_output=True,
        text=True,
        check=False,
    ).stdout
    out: dict[str, str] = {}
    for line in parsed.splitlines():
        if ":" in line:
            name, _, value = line.partition(":")
            out[name.strip().lower()] = value.strip()
    return out


def working_tree_paths() -> list[str]:
    """Everything the next commit could contain: staged, unstaged, untracked."""
    raw = git("status", "--porcelain=v1", "-z", "--untracked-files=all")
    fields = raw.split("\0")
    paths: list[str] = []
    index = 0
    while index < len(fields):
        entry = fields[index]
        index += 1
        if not entry:
            continue
        status, path = entry[:2], entry[3:]
        paths.append(path)
        if "R" in status or "C" in status:
            if index < len(fields):
                paths.append(fields[index])
                index += 1
    return sorted(set(paths))


def commit_paths(rev: str) -> list[str]:
    raw = git("show", "--name-only", "--pretty=format:", "-z", rev)
    return sorted({p for p in raw.split("\0") if p})


def commits_for_campaign(campaign_id: str) -> list[str]:
    raw = git("log", "--format=%H", f"--grep=campaign: {campaign_id}", "HEAD")
    return [line for line in raw.splitlines() if line]


# --------------------------------------------------------------------------
# The append-only records


def append_jsonl(path: Path, row: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a") as handle:
        handle.write(json.dumps(row, sort_keys=True) + "\n")


def commit_harness_state(paths: list[Path], message: str) -> None:
    """The harness commits the rows it writes, as it writes them.

    Reported by the first campaign as `conformance-001`, and it was right: the
    harness appends to `state/sessions.jsonl` when it opens a campaign, that
    file is denied to every loop, and the pre-commit scope check inspects the
    working tree — so the gate was red before the loop wrote a byte, and
    nothing the loop was permitted to do could make it green.

    Of the three options it laid out, this is the one that keeps the deny list
    absolute. Excluding harness files from the pre-commit check would have put
    a carve-out in the one check whose value is that any appearance of a denied
    path is a violation; taking the verdict only post-hoc would mean a scope
    error costs a history rewrite instead of a `git restore`.

    The commits carry no `loop:` or `campaign:` trailer, so they are invisible
    to `commits_for_campaign`, to `check-metrics`, and to the cost join — the
    history stays one commit per experiment as far as anything that counts is
    concerned. Path-limited, so a campaign's uncommitted work is never swept
    in.
    """
    relative = [str(path.relative_to(REPO)) for path in paths if path.exists()]
    if not relative:
        return
    status = git("status", "--porcelain", "--", *relative).strip()
    if not status:
        return
    git("add", "--", *relative)
    result = subprocess.run(
        ["git", "-C", str(REPO), "commit", "-m", f"harness: {message}", "--", *relative],
        capture_output=True,
        text=True,
        check=False,
    )
    if result.returncode != 0:
        print(f"hj: could not commit harness state: {result.stdout.strip()} {result.stderr.strip()}", file=sys.stderr)


def read_jsonl(path: Path) -> list[dict]:
    if not path.exists():
        return []
    rows = []
    for line in path.read_text().splitlines():
        line = line.strip()
        if line:
            rows.append(json.loads(line))
    return rows


def sessions_path() -> Path:
    return STATE / "sessions.jsonl"


def campaigns_of(owner: str) -> list[dict]:
    """Latest row per campaign id, oldest campaign first."""
    latest: dict[str, dict] = {}
    for row in read_jsonl(sessions_path()):
        if row.get("loop") == owner:
            merged = latest.setdefault(row["campaign"], {})
            merged.update(row)
    return list(latest.values())


def metrics_path(owner: str) -> Path:
    return STATE / "metrics" / f"{owner}.jsonl"


# --------------------------------------------------------------------------
# Cheap measurements that go in every metrics row


def workspace_members() -> set[str]:
    if not (REPO / "Cargo.toml").exists():
        return set()
    result = subprocess.run(
        ["cargo", "metadata", "--no-deps", "--format-version", "1"],
        cwd=REPO,
        capture_output=True,
        text=True,
        check=False,
    )
    if result.returncode != 0:
        return set()
    return {package["name"] for package in json.loads(result.stdout)["packages"]}


def owned_members(config: LoopConfig) -> list[str]:
    """The ownership table names crates that may not exist yet; the gate
    builds the intersection with what the workspace actually has."""
    members = workspace_members()
    return sorted({m for m in members if matches_any(m, config.crates)})


def loc_per_crate() -> dict[str, int]:
    """Non-test Rust only. `tokei` when it is installed, a line count when it
    is not — LOC is reported and never gated (`design/loops.md` section 11), so
    an approximate number is not load-bearing."""
    roots = [REPO / "crates", REPO / "vendor"]
    counts: dict[str, int] = {}
    for root in roots:
        if not root.exists():
            continue
        for crate in sorted(p for p in root.iterdir() if p.is_dir()):
            total = 0
            for source in crate.rglob("*.rs"):
                relative = source.relative_to(crate).parts
                if "tests" in relative or "target" in relative:
                    continue
                total += sum(1 for line in source.read_text(errors="replace").splitlines() if line.strip())
            if total:
                counts[crate.name] = total
    return counts


def test_count(members: list[str]) -> int | None:
    if not members:
        return None
    args = ["cargo", "nextest", "list", "--message-format", "json"]
    for member in members:
        args += ["-p", member]
    result = subprocess.run(args, cwd=REPO, capture_output=True, text=True, check=False)
    if result.returncode != 0:
        return None
    try:
        listing = json.loads(result.stdout)
    except json.JSONDecodeError:
        return None
    return sum(len(suite.get("testcases", {})) for suite in listing.get("rust-suites", {}).values())


def cli_version() -> str:
    """Recorded per campaign beside the prompt sha, and for the same reason
    (`design/loops.md` section 17). A prompt revision changes the *generator*
    of campaigns and nothing downstream can detect it; a CLI upgrade does the
    same thing, arrives without anybody deciding to change anything, and is
    otherwise completely invisible."""
    result = subprocess.run(
        [str(HARNESS / "adapter"), "version"], capture_output=True, text=True, check=False
    )
    return result.stdout.strip() or "unknown"


def provisional_decisions() -> int:
    """Sites still running on a provisional choice. Its count is a health
    metric — rising steadily means the loop is running ahead of its decisions
    and the work is getting speculative (`design/loops.md` section 6).

    Scoped to code rather than the whole tree: the decision records and the
    prompts talk *about* the tag, and counting those would make the number
    start at thirty and never mean anything.
    """
    result = subprocess.run(
        [
            "git",
            "-C",
            str(REPO),
            "grep",
            "-c",
            "-E",
            r"DECISION-[A-Za-z0-9_-]+: provisional",
            "--",
            ":!state",
            ":!design",
            ":!harness",
        ],
        capture_output=True,
        text=True,
        check=False,
    )
    total = 0
    for line in result.stdout.splitlines():
        _, _, count = line.rpartition(":")
        if count.isdigit():
            total += int(count)
    return total


# --------------------------------------------------------------------------
# Commands


def cmd_sections(args: argparse.Namespace) -> int:
    for doc in args.doc:
        for section in sections_of(doc):
            print(f"{section.key}\t{section.heading}")
    return 0


def cmd_section_text(args: argparse.Namespace) -> int:
    doc, _, anchor = args.key.partition("#")
    index = section_index([doc])
    section = index.get(f"{doc}#{anchor}")
    if section is None:
        die(f"no section {args.key}")
    print(section_text(section))
    return 0


def cmd_baseline_take(args: argparse.Namespace) -> int:
    """Freeze the denominator at the start of a phase. A human action: this
    writes into `harness/`, which every loop is denied."""
    phase = load_phase()
    existing = read_baseline()
    if existing and existing.get("phase") == phase.phase and not args.force:
        die(
            f"a baseline for phase {phase.phase} was already taken at {existing.get('taken')}. "
            "Re-taking it mid-phase makes the metrics history discontinuous; pass --force if "
            "that is what you mean, and log it as an intervention."
        )
    docs = sorted({doc for config in phase.loops.values() for doc in config.docs})
    lines = [
        "# The denominator of `sections clean / sections total`, frozen for the",
        "# phase. Written by `harness/hj baseline-take`, read by everything else.",
        "#",
        "# It is here rather than in `state/` because the section list is parsed",
        "# from headings in documents the conformance loop may edit, and a loop",
        "# that could re-derive its own denominator could merge two dirty",
        "# sections into one clean one and move the score without touching a line",
        "# of code (`design/loops.md` section 7).",
        "",
        f"phase = {toml_string(phase.phase)}",
        f"taken = {toml_string(now())}",
        f"commit = {toml_string(head_sha())}",
        "",
    ]
    for doc in docs:
        anchors = [section.anchor for section in sections_of(doc)]
        lines.append(f"[doc.{toml_string(doc)}]")
        lines.append("anchors = [")
        lines += [f"  {toml_string(anchor)}," for anchor in anchors]
        lines.append("]")
        lines.append("")
        print(f"baseline: {doc}: {len(anchors)} sections")
    BASELINE.write_text("\n".join(lines))
    print(f"baseline: written to {BASELINE.relative_to(REPO)} for phase {phase.phase}")
    return 0


def cmd_baseline_drift(args: argparse.Namespace) -> int:
    phase = load_phase()
    docs = sorted({doc for config in phase.loops.values() for doc in config.docs})
    drift = baseline_drift(docs)
    for line in drift:
        print(f"baseline: {line}")
    if not drift:
        print("baseline: the documents match the baseline")
    return 0


def cmd_audit_plan(args: argparse.Namespace) -> int:
    """Coverage by rotation, not by checklist (`design/loops.md` section 3):
    the sections the last campaign touched, plus the least recently audited
    slice of the rest."""
    _, config = loop_config(args.loop)
    targets: list[str] = []
    for campaign in campaigns_of(args.loop):
        if campaign.get("target"):
            targets.append(campaign["target"])
    recent_targets = set(targets[-1:])

    planned: list[str] = []
    for doc in config.docs:
        verdicts = read_audit(doc)
        known = sections_of(doc)
        touched = [s.key for s in known if s.key in recent_targets]

        def staleness(section: Section) -> tuple[str, str]:
            verdict = verdicts.get(section.key)
            return (verdict.last_audited or "" if verdict else "", section.anchor)

        rotation = [s.key for s in sorted(known, key=staleness) if s.key not in touched]
        planned += touched + rotation[: config.rotation]
    for key in planned:
        print(key)
    return 0


TOML_FENCE = re.compile(r"```toml\s*\n(.*?)\n```", re.DOTALL)


def cmd_audit_merge(args: argparse.Namespace) -> int:
    """Take the auditor's verdict and write it into `state/audit/`.

    The auditor cannot edit anything (`design/loops.md` section 5), so the
    file is written here, from what it reported, after validation. A verdict
    naming a section that does not exist is rejected rather than recorded —
    a hallucinated anchor would otherwise become a permanent work item.
    """
    _, config = loop_config(args.loop)
    raw = Path(args.transcript).read_text()
    blocks = TOML_FENCE.findall(raw)
    if not blocks:
        die("the auditor produced no ```toml block; nothing to merge")
    try:
        reported = tomllib.loads(blocks[-1])
    except tomllib.TOMLDecodeError as error:
        die(f"the auditor's toml block does not parse: {error}")

    index = section_index(config.docs)
    stamp = now()
    problems: list[str] = []
    fresh: dict[str, SectionVerdict] = {}
    for key, table in reported.get("section", {}).items():
        if key not in index:
            problems.append(f"unknown section {key!r}")
            continue
        state = table.get("state")
        if state not in VALID_STATES:
            problems.append(f"{key}: state {state!r} is not one of {VALID_STATES}")
            continue
        gaps = [Gap(g.get("claim", ""), g.get("found", ""), g.get("where", "")) for g in table.get("gap", [])]
        minors = [Minor(m.get("claim", ""), m.get("note", ""), m.get("where", "")) for m in table.get("minor", [])]
        if state == "gaps" and not gaps:
            problems.append(f"{key}: state is 'gaps' but no gap is listed")
            continue
        if state == "clean" and gaps:
            problems.append(f"{key}: state is 'clean' but gaps are listed")
            continue
        fresh[key] = SectionVerdict(key, state, stamp, gaps, minors)

    if problems:
        for problem in problems:
            print(f"hj audit-merge: rejected: {problem}", file=sys.stderr)
        if not args.partial:
            return 1

    for doc in config.docs:
        known = sections_of(doc)
        verdicts = read_audit(doc)
        for section in known:
            if section.key in fresh:
                verdicts[section.key] = fresh[section.key]
            elif section.key not in verdicts:
                verdicts[section.key] = SectionVerdict(section.key, "unjudged", None)
        order = [s.key for s in known]
        write_audit(doc, {k: verdicts[k] for k in order}, order)

    commit_harness_state(
        [audit_path(doc) for doc in config.docs], f"audit of {', '.join(config.docs)}"
    )
    counts = audit_counts(config.docs)
    print(
        f"audit: {counts['sections_clean']}/{counts['sections_total']} sections clean, "
        f"{counts['sections_unjudged']} unjudged, {counts['open_gaps']} open gaps, "
        f"{counts['audit_minors']} minor items"
    )
    return 0


def cmd_check_audit(args: argparse.Namespace) -> int:
    """Gate step: every open gap names a document anchor that exists."""
    phase = load_phase()
    docs = sorted({doc for config in phase.loops.values() for doc in config.docs})
    failures = 0
    for doc in docs:
        known = {s.key for s in sections_of(doc)}
        for key, verdict in read_audit(doc).items():
            if key not in known:
                print(f"audit: {key} no longer exists in design/{doc}", file=sys.stderr)
                failures += 1
    return 1 if failures else 0


def cmd_check_scope(args: argparse.Namespace) -> int:
    phase, config = loop_config(args.loop)
    denied = denied_paths(phase)
    if args.rev:
        # Forensics on an existing commit. A commit without this loop's
        # `loop:` trailer is a human's, and ownership does not apply to it —
        # the check that matters is the one on the pending commit below,
        # which has no trailer to consult and therefore always runs.
        owner = trailers_of(args.rev).get("loop")
        if owner != args.loop:
            print(f"scope: {args.rev} carries no `loop: {args.loop}` trailer; ownership does not apply")
            return 0
    paths = commit_paths(args.rev) if args.rev else working_tree_paths()
    violations = []
    for path in paths:
        if matches_any(path, denied):
            violations.append((path, "denied to every loop in this phase"))
        elif not matches_any(path, config.write):
            violations.append((path, f"outside {args.loop}'s owned paths"))
    for path, reason in violations:
        print(f"scope: {path}: {reason}", file=sys.stderr)
    if violations:
        print(
            f"scope: {len(violations)} path(s) this loop does not own. "
            "Revert them, or escalate as a decision (design/loops.md section 6).",
            file=sys.stderr,
        )
        return 1
    print(f"scope: {len(paths)} path(s), all owned by {args.loop}")
    return 0


def cmd_check_path(args: argparse.Namespace) -> int:
    """One path, for the `PreToolUse` hook. Fast feedback and **not a
    boundary**: deny rules cover Claude's file tools and not bash
    subprocesses, so anything this blocks is reachable through `sh -c`. The
    gate's diff-scope check is what actually enforces
    (`design/loops.md` section 13)."""
    phase, config = loop_config(args.loop)
    denied = denied_paths(phase)
    failed = False
    for raw in args.path:
        path = Path(raw)
        try:
            relative = str(path.resolve().relative_to(REPO))
        except ValueError:
            print(f"{raw} is outside the repository", file=sys.stderr)
            failed = True
            continue
        if matches_any(relative, denied):
            print(f"{relative} is denied to every loop in phase {phase.phase}.", file=sys.stderr)
            failed = True
        elif not matches_any(relative, config.write):
            print(
                f"{relative} is outside {args.loop}'s owned paths, so the gate would "
                "reject the commit. If you need it, that is a decision record, not a "
                "workaround.",
                file=sys.stderr,
            )
            failed = True
    return 1 if failed else 0


def cmd_check_metrics(args: argparse.Namespace) -> int:
    """Gate step: the previous iteration recorded its row.

    Checked against HEAD rather than the pending commit, because the row
    keys on a commit that does not exist until after the gate passes. A
    commit carrying this loop's `campaign:` trailer and no metrics row means
    `harness/hj record` was skipped, and the history has a hole in it.
    """
    _, config = loop_config(args.loop)
    # Walk back past the harness's own untrailered commits — its metrics rows
    # and audit verdicts land between a loop's commits, so HEAD is often not
    # the last thing the loop wrote.
    last_loop_commit = None
    for sha in git("log", "--format=%H", "-20", "HEAD").split():
        if trailers_of(sha).get("loop") == args.loop:
            last_loop_commit = sha
            break
    if last_loop_commit is None:
        print("metrics: this loop has no commit in recent history; nothing to check")
        return 0
    recorded = {row.get("commit") for row in read_jsonl(metrics_path(config.owner))}
    if last_loop_commit in recorded:
        print(f"metrics: {last_loop_commit[:12]} is recorded")
        return 0
    print(
        f"metrics: no row for {last_loop_commit[:12]}; run `harness/hj record {args.loop}`",
        file=sys.stderr,
    )
    return 1


