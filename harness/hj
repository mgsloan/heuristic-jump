    def one_servers_numbers_are_the_shared_surface_and_two_servers_are_not():
        # §10, "several servers do not mean several loops". For a language with
        # one usable server "every position is trivially unanimous, there is no
        # profile, and none of this machinery does anything" — so that server's
        # surface *is* the frontier's, and the row keeps the shape every row
        # recorded before this existed has.
        one = {"strata": {"a": {"n": 10, "judged": 8, "top1": 0.75, "coverage": 0.8}}}
        assert replay_row_fields({}, {}) == {}, "a commit nobody replayed is unchanged"
        promoted = replay_row_fields({}, {"gopls": one})
        assert frontier_axes_of(promoted) == {"top1": 0.75, "coverage": 0.8}, promoted
        promoted["strata"]["a"]["top1"] = 0.1
        assert promoted["servers"]["gopls"]["strata"]["a"]["top1"] == 0.75, (
            "promoted and not aliased: an edit to the row must not reach into "
            "the per-server entry it was copied from"
        )

    def two_servers_never_average_into_one_frontier_point():
        # The section says "never average the two", and the agreement subset it
        # does want is a join over positions that only `measure replay` can
        # compute. A row that carried a mean of two servers' strata would be
        # that average wearing a frontier point's clothes.
        one = {"strata": {"a": {"n": 10, "judged": 8, "top1": 0.75, "coverage": 0.8}}}
        other = {"strata": {"a": {"n": 10, "judged": 8, "top1": 0.55, "coverage": 0.9}}}
        two = replay_row_fields({}, {"pyright": one, "pylsp": other})
        assert frontier_axes_of(two) is None, (
            "with no agreement report there is no shared surface, and the row "
            "carries no frontier position rather than a synthesised one"
        )
        assert sorted(two["servers"]) == ["pylsp", "pyright"], two
        assert frontier_points([dict(two, commit="x")]) == [], (
            "and the point does not arrive later through the frontier either"
        )
        # With one, the agreement subset is what the frontier reads and the
        # per-server numbers stay beside it.
        both = replay_row_fields(one, {"pyright": one, "pylsp": other})
        assert frontier_axes_of(both) == {"top1": 0.75, "coverage": 0.8}, both
        assert sorted(both["servers"]) == ["pylsp", "pyright"]

    def a_check_that_reads_the_candidate_tree_is_on_the_list_that_says_so():
        # `harness-011`, made mechanical. Two campaigns lost time to a case
        # that read `HARNESS` and so asserted about whichever tree the gate was
        # judging — one of them encoding a requirement no branch could satisfy,
        # which left green-or-revert with no green to revert to.
        #
        # Reads `PINNED_HARNESS`, being an assertion about this file's own
        # contents. Gate step 3 runs the tree's own copy whenever `hj` differs,
        # which is exactly when a new read could have appeared.
        reads = candidate_tree_reads((PINNED_HARNESS / "hj").read_text())
        unlisted = [name for name in reads if name not in CANDIDATE_TREE_CHECKS]
        assert not unlisted, (
            "these read HARNESS — the tree being judged — without being on "
            f"CANDIDATE_TREE_CHECKS: {unlisted}. If that is deliberate, add the "
            "name and run `hj selftest --across-worktrees` first; if it is not, "
            "read PINNED_HARNESS instead"
        )
        stale = [name for name in CANDIDATE_TREE_CHECKS if name not in reads]
        assert not stale, (
            f"listed as reading HARNESS and no longer does: {stale}. A stale "
            "exemption is how the next one gets added without anybody noticing"
        )

    def the_per_stratum_table_renders_one_surface_per_server():
        # §16 asks the metrics panel for "the per-stratum table — one per
        # server where a language has several". The trap is the other half of
        # §10: a single server's numbers *are* the shared surface, promoted by
        # `replay_row_fields`, so the naive loop prints the same table twice
        # under two headings and reads as two measurements.
        serve = _selftest_dashboard()
        one = {"strata": {"Common": {"n": 10, "coverage": 0.8, "top1": 0.75}}}
        single = serve.stratum_table([replay_row_fields({}, {"gopls": one})])
        assert single.count("<table") == 1, "the promoted surface is one table, not two"
        assert "only server" in single, single
        other = {"strata": {"Common": {"n": 10, "coverage": 0.6, "top1": 0.55}}}
        several = serve.stratum_table([replay_row_fields(one, {"pyright": one, "pylsp": other})])
        assert several.count("<table") == 3, "the agreement surface and one per server"
        assert "where the servers differ" in several, several
        assert serve.stratum_table([]).startswith("<p class=\"empty\""), (
            "no row is an empty panel that says what would fill it, not a blank"
        )

    def a_transcript_starts_at_the_prompt_and_not_mid_conversation():
        # §16 reads a turn as prompt, thinking, tool calls, results, text. The
        # stream carries the last four; the vendor never echoes the first, and
        # `harness/loop` deletes the rendered file when the run ends — so the
        # one thing that says what a campaign was actually asked has to be
        # kept at open or it does not exist.
        assert "prompt_file_of" in inspect.getsource(cmd_campaign_open), (
            "retaining it is campaign-open's job; every caller gets it, not only the runner"
        )
        serve = _selftest_dashboard()
        assert "prompt-path" in inspect.getsource(serve.rendered_prompt), (
            "the layout is the adapter's to know (§17), here as much as for the transcript"
        )
        missing = serve.rendered_prompt("nobody", "no-such-campaign")
        assert "was not kept" in missing and "prompt_sha" in missing, (
            "campaigns that predate this have only their sha, and the page should say so "
            "rather than render an empty block"
        )

    def the_held_out_panel_shows_a_verdict_and_never_a_number():
        # §12: "the loop is shown a verdict, not the numbers … enough to know
        # something went wrong and where; not enough to hill-climb." The
        # dashboard is a file in the repository, so a loop can read it.
        serve = _selftest_dashboard()
        rendered = serve.heldout_block(_selftest_loop("lang-rust", "rust"), Phase(phase="2a"))
        assert "no held-out evaluation has run yet" in rendered, rendered
        assert not re.search(r"\d+\.\d+", rendered), (
            "a per-stratum gap printed here is the leak section 12 exists to "
            "prevent, arriving through the operator's view"
        )
        assert "declares no language" in serve.heldout_block(
            _selftest_loop("harness", None), Phase(phase="1a")
        )

    def two_loops_may_not_declare_one_language():
        # §10 rejects the per-server split — "a loop with almost no legal move"
        # — and concludes "a language is one loop". Two loops for one language
        # are two metrics files and two frontiers over one set of numbers, and
        # every command here is per loop, so each of the two looks correct
        # alone. This is the only place the pair is visible at once.
        def verdict(phase: Phase) -> tuple[int, str]:
            out, err = io.StringIO(), io.StringIO()
            with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
                code = check_one_loop_per_language(phase)
            return code, err.getvalue()

        code, _ = verdict(
            Phase(
                phase="2a",
                loops={
                    "lang-rust": _selftest_loop("lang-rust", "rust"),
                    "lang-python": _selftest_loop("lang-python", "python"),
                },
            )
        )
        assert code == 0
        code, said = verdict(
            Phase(
                phase="2a",
                loops={
                    "lang-python-pyright": _selftest_loop("lang-python-pyright", "python"),
                    "lang-python-pylsp": _selftest_loop("lang-python-pylsp", "python"),
                },
            )
        )
        assert code == 1, (
            "a per-server split arrives by declaring the same language twice, "
            "whatever the two loops are named"
        )
        assert "lang-python-pylsp and lang-python-pyright" in said, said
        assert verdict(Phase(phase="1a"))[0] == 0, (
            "phase 1a declares no language, and a check that failed there would "
            "fail every gate of every loop until one did"
        )

    def a_server_name_is_resolved_against_the_matrix_and_not_trusted():
        # A typo'd name is a new series that looks like a server nobody has
        # replayed in a while, and nothing downstream can tell the two apart.
        assert servers_for_language("go") == ["gopls"], servers_for_language("go")
        assert servers_for_language("klingon") == []
        python = servers_for_language("python")
        assert set(python) == {"pyright", "basedpyright", "pylsp"}, python
        surfaces = {None: {"report": "x"}, "pyrite": {"report": "y"}}
        problems = replay_argument_problems(surfaces, "python")
        assert len(problems) == 1 and "pyrite" in problems[0], problems
        assert "pyright" in problems[0], "the message names what it could have been"
        assert replay_argument_problems({None: {"report": "x"}}, None) == [], (
            "a loop with no language records the shared surface as it always has"
        )
        assert replay_argument_problems({"gopls": {}}, None), (
            "but a prefixed name with no language has nothing to resolve against"
        )
        assert replay_argument_problems({None: {"seconds": "12.5"}}, None) == []
        assert replay_argument_problems({None: {"seconds": "quick"}}, None), (
            "`--replay-seconds` stopped being type=float when it gained a "
            "prefix; it must not start failing halfway through building a row"
        )

    def a_commit_beaten_on_every_axis_is_off_the_frontier():
        rows = [
            {"commit": "aaa", "top1": 0.80, "coverage": 0.60},
            {"commit": "bbb", "top1": 0.90, "coverage": 0.70},
        ]
        assert [point["commit"] for point in frontier_points(rows)] == ["bbb"]

    def a_trade_between_the_two_axes_keeps_both_points():
        # The whole reason the object exists. A point that answers less but
        # gets more of what it answers right is "the record of what was
        # achievable", including by a version later abandoned.
        rows = [
            {"commit": "aaa", "top1": 0.95, "coverage": 0.40},
            {"commit": "bbb", "top1": 0.70, "coverage": 0.90},
        ]
        assert len(frontier_points(rows)) == 2

    def the_frontier_keeps_the_commit_that_first_reached_a_point():
        rows = [
            {"commit": "first", "top1": 0.9, "coverage": 0.9},
            {"commit": "later", "top1": 0.9, "coverage": 0.9},
        ]
        assert [point["commit"] for point in frontier_points(rows)] == ["first"], (
            "keeping the latest would let a run of no-op commits reassign every "
            "point on the frontier to whichever ran last"
        )

    def an_identical_row_is_not_a_frontier_advance():
        # `record` writes a row per commit, so a commit that changes no
        # behaviour carries the previous commit's numbers exactly. Reading §7's
        # "not dominated by an existing one" as strict domination would pay
        # progress for that row, and for every row after it forever.
        existing = [{"top1": 0.9, "coverage": 0.8}]
        assert not advances_frontier({"top1": 0.9, "coverage": 0.8}, existing)
        assert not advances_frontier({"top1": 0.5, "coverage": 0.5}, existing)
        assert advances_frontier({"top1": 0.9, "coverage": 0.81}, existing)
        assert advances_frontier({"top1": 0.95, "coverage": 0.1}, existing), (
            "a trade is an advance; it is a point nothing existing reaches"
        )

    def the_exchange_rate_is_derived_from_the_cost_frontier_and_never_declared():
        # §10: "the local slope of the cost-phase frontier is the empirical
        # rate — it says what a coverage point actually cost in bytes, at this
        # operating point, on this corpus."
        def row(commit, coverage, stripped):
            return {
                "commit": commit,
                "strata": {"a": {"n": 10, "coverage": coverage}},
                "binary": {"binary": "measure_rust", "stripped": stripped},
            }

        rows = [
            row("cheap", 0.50, 1_000_000),
            row("mid", 0.60, 1_200_000),
            row("dear", 0.62, 2_000_000),
            # Dominated: less coverage than `mid` for more bytes than `mid`.
            row("waste", 0.55, 1_500_000),
        ]
        points = cost_frontier(rows)
        assert [point["commit"] for point in points] == ["cheap", "mid", "dear"], points
        assert cost_frontier([{"commit": "x", "strata": {"a": {"coverage": 0.9}}}]) == [], (
            "a row with no size would sit at zero bytes and dominate every row "
            "that measured one"
        )
        rates = [rate["bytes_per_coverage_point"] for rate in exchange_rates(points)]
        assert all(
            abs(measured - wanted) < 1 for measured, wanted in zip(rates, (2e6, 4e7))
        ) and len(rates) == 2, (
            "local slopes, not one fit through the curve: the second point is "
            f"twenty times dearer than the first and a single rate hides that: {rates}"
        )
        assert exchange_rates(points[:1]) == [], "a slope needs two points"
        flat = [
            {"commit": "a", "cost_point": {"coverage": 0.5, "stripped": 10}},
            {"commit": "b", "cost_point": {"coverage": 0.5, "stripped": 20}},
        ]
        assert exchange_rates(flat) == [], "no coverage gained is not an infinite price"

    def a_row_missing_one_axis_is_not_a_point():
        assert frontier_axes_of({"top1": 0.9}) is None
        assert frontier_axes_of({"top1": 0.9, "coverage": 0.8}) == {"top1": 0.9, "coverage": 0.8}
        assert frontier_points([{"commit": "x", "coverage": 0.8}]) == [], (
            "filling a missing axis with zero would park every phase-1 row at "
            "the origin and read the first tuning commit as an advance over all"
        )

    def the_axes_stay_two_and_the_others_stay_beside():
        # §10: with four or more objectives "non-domination becomes nearly
        # free — almost every point is on the frontier and the concept stops
        # selecting anything". The failure this catches is a later campaign
        # promoting one of the reported numbers to an axis.
        assert len(FRONTIER_AXES) == 2, FRONTIER_AXES
        assert "top1" in FRONTIER_AXES and "contained" not in FRONTIER_AXES, (
            "containment rises monotonically with list length, so as an "
            "objective it is the old flaw wearing new clothes"
        )
        assert not set(FRONTIER_AXES) & set(FRONTIER_BESIDE)
        # The keys a stratum actually carries, not the concept names. Naming
        # the concept was the first draft, and every consumer then looked up
        # `latency` in a row that spells it `latency_p50_us`.
        for name in ("contained", "result_count", "latency_p50_us"):
            assert name in FRONTIER_BESIDE, name
        example = {
            "strata": {
                "a": {"n": 1, "judged": 1, "contained": 0.9, "result_count": 3.0,
                      "latency_p50_us": 900.0}
            }
        }
        for name in FRONTIER_BESIDE:
            assert stratum_mean(example, name) is not None, (
                f"{name} is printed beside the frontier and nothing writes it"
            )

    def a_stratum_mean_is_weighted_by_its_n():
        row = {"strata": {"Common": {"top1": 0.9, "n": 900}, "Rare": {"top1": 0.1, "n": 100}}}
        assert abs(stratum_mean(row, "top1") - 0.82) < 1e-9, stratum_mean(row, "top1")
        assert stratum_mean(row, "coverage") is None, "an absent number is not zero"
        assert stratum_mean({"top1": 0.5, "strata": {"A": {"top1": 0.1}}}, "top1") == 0.5, (
            "a recomputed aggregate is authoritative over the per-stratum rows"
        )

    def a_campaign_is_judged_against_the_frontier_as_it_stood_before_it():
        rows = [
            {"campaign": "old", "top1": 0.90, "coverage": 0.80},
            {"campaign": "mine", "top1": 0.90, "coverage": 0.80},
            {"campaign": "mine", "top1": 0.91, "coverage": 0.80},
