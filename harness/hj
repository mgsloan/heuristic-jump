def cmd_baseline_take(args: argparse.Namespace) -> int:
    """Freeze the denominator at the start of a phase. A human action: this
    writes into `harness/`, which every loop is denied."""
    phase = load_phase()
    existing = read_baseline()
    if existing and existing.get("phase") == phase.phase and not args.force:
        die(
            f"a baseline for phase {phase.phase} was already taken at {existing.get('taken')}. "
            "Re-taking it mid-phase makes the metrics history discontinuous; pass --force if "
            "that is what you mean, and log it as an intervention."
        )
    docs = sorted({doc for config in phase.loops.values() for doc in config.docs})
    lines = [
        "# The denominator of `sections clean / sections total`, frozen for the",
        "# phase. Written by `harness/hj baseline-take`, read by everything else.",
        "#",
        "# It is here rather than in `state/` because the section list is parsed",
        "# from headings in documents the conformance loop may edit, and a loop",
        "# that could re-derive its own denominator could merge two dirty",
        "# sections into one clean one and move the score without touching a line",
        "# of code (`design/loops.md` section 7).",
        "",
        f"phase = {toml_string(phase.phase)}",
        f"taken = {toml_string(now())}",
        f"commit = {toml_string(head_sha())}",
        "",
    ]
    for doc in docs:
        anchors = [section.anchor for section in sections_of(doc)]
        lines.append(f"[doc.{toml_string(doc)}]")
        lines.append("anchors = [")
        lines += [f"  {toml_string(anchor)}," for anchor in anchors]
        lines.append("]")
        lines.append("")
        print(f"baseline: {doc}: {len(anchors)} sections")
    BASELINE.write_text("\n".join(lines))
    print(f"baseline: written to {BASELINE.relative_to(REPO)} for phase {phase.phase}")
    return 0


