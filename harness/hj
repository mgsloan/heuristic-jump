    p = sub.add_parser("allocate-id", help="reserve the next free decision or changelog id")
    p.add_argument("loop")
    p.add_argument("--kind", choices=("decision", "change"), required=True)
    p.set_defaults(run=cmd_allocate_id)

    p = sub.add_parser("claim", help="take targets, refusing any another worker holds")
    p.add_argument("loop")
    p.add_argument("--campaign", required=True)
    p.add_argument("target", nargs="+")
    p.set_defaults(run=cmd_claim)

    p = sub.add_parser("campaign-open", help="allocate a campaign, write its record, render its prompt")
    p.add_argument("loop")
    p.add_argument("--id", help="uuid; generated when omitted")
    p.add_argument("--prompt-out")
    p.add_argument("--worker", help="worker identity, e.g. core-2; defaults to the loop")
    p.set_defaults(run=cmd_campaign_open)

    p = sub.add_parser("campaign-close", help="close a campaign and judge whether it made progress")
    p.add_argument("loop")
    p.add_argument("--id", required=True)
    p.add_argument("--outcome", required=True, choices=OUTCOMES)
    p.add_argument("--target", default=None)
    p.set_defaults(run=cmd_campaign_close)

    p = sub.add_parser("campaign-reap", help="close campaigns whose process is gone (crash recovery)")
    p.add_argument("loop", nargs="?")
    p.set_defaults(run=cmd_campaign_reap)

    p = sub.add_parser("cost", help="join campaign records to what their sessions cost")
    p.add_argument("loop", nargs="?")
    p.add_argument(
        "--refresh",
        action="store_true",
        help="re-measure closed campaigns whose row predates a field the row spec now carries",
    )
    p.set_defaults(run=cmd_cost)

    p = sub.add_parser("prompt-prefix", help="how much of a prompt is byte-identical between campaigns")
    p.add_argument("loop", nargs="?")
    p.set_defaults(run=cmd_prompt_prefix)

    p = sub.add_parser("estimates", help="section 15's guesses against what has actually been spent")
    p.set_defaults(run=cmd_estimates)

    p = sub.add_parser("selftest", help="gate step: hj's own parsing and arithmetic still hold")
    p.add_argument(
        "--across-worktrees",
        action="store_true",
        help="run these checks against every checkout; run before committing a case that reads HARNESS",
    )
    p.set_defaults(run=cmd_selftest)

    p = sub.add_parser("budget", help="spend against each ceiling; exit 1 when one is reached")
    p.add_argument("loop", nargs="?")
    p.set_defaults(run=cmd_budget)

    p = sub.add_parser(
        "queue", help="what is left for a campaign to take; exit 1 when only minor items remain"
    )
    p.add_argument("loop")
    p.set_defaults(run=cmd_queue)

    p = sub.add_parser(
        "escalations",
        help="the decision queue and whether a batch is due; exit 1 when it is (a report, not a stop)",
    )
    p.set_defaults(run=cmd_escalations)

    p = sub.add_parser("audit-cost", help="record what an audit session cost")
    p.add_argument("loop")
    p.add_argument("transcript")
    p.set_defaults(run=cmd_audit_cost)

    p = sub.add_parser("audit-due", help="exit 0 when an audit is due")
    p.add_argument("loop")
    p.set_defaults(run=cmd_audit_due)

    p = sub.add_parser("gaps", help="gaps found, closed, and still open")
    p.add_argument("loop")
    p.set_defaults(run=cmd_gaps)

    p = sub.add_parser("stall", help="exit 1 when the loop has stalled")
    p.add_argument("loop")
    p.set_defaults(run=cmd_stall)

    p = sub.add_parser("handoff", help="write state/handoff.md as the loop stops on a stall")
    p.add_argument("loop")
    p.set_defaults(run=cmd_handoff)

    p = sub.add_parser("status", help="the operator view, until there is a dashboard")
    p.set_defaults(run=cmd_status)

    p = sub.add_parser("intervene", help="append to the intervention log")
    p.add_argument("--kind", required=True, help=f"one of: {', '.join(KNOWN_KINDS)}")
    p.add_argument("--target", required=True)
    p.add_argument("--answer", default="")
    p.add_argument("--rationale", required=True)
    p.add_argument("--new-kind", action="store_true", help="accept a kind the vocabulary does not have")
    p.set_defaults(run=cmd_intervene)

    p = sub.add_parser("interventions", help="how autonomous this is, from the log")
    p.set_defaults(run=cmd_interventions)

    p = sub.add_parser("install-hooks", help="symlink the git hooks; flags hand-authored commits")
    p.set_defaults(run=cmd_install_hooks)

    args = parser.parse_args()
    return args.run(args)


