def spec_drift(campaign_id: str, target: str | None) -> dict | None:
    """Did this campaign edit the spec and the code it is judged against?

    Scoped to the campaign rather than the commit, and that matters more than
    it sounds: the iteration contract deliberately produces one commit per
    experiment with one target each, so "the spec edit and the code are in the
    same commit" is a test the loop's own working style defeats without anyone
    intending it (`design/loops.md` section 7).

    Not a gate failure. Rewriting the spec toward the code is the one gaming
    route the audit cannot catch *by construction* — moving the spec removes
    the gap from the instrument that would have reported it — so the answer is
    to make it visible to a human, not to guess at intent here.
    """
    design_edits: set[str] = set()
    code_edits: set[str] = set()
    for commit in commits_for_campaign(campaign_id):
        for path in commit_paths(commit):
            if path.startswith("design/"):
                design_edits.add(path)
            elif path.startswith(("crates/", "vendor/")):
                code_edits.add(path)
    if not (design_edits and code_edits):
        return None
    target_doc = (target or "").split("#")[0]
    return {
        "design": sorted(design_edits),
        "code": sorted(code_edits)[:20],
        "target": target,
        # The sharper case: the document edited is the one the campaign's own
        # target lives in, so the edit and the claim being scored coincide.
        "touches_target_document": bool(target_doc) and f"design/{target_doc}" in design_edits,
    }


def cmd_campaign_close(args: argparse.Namespace) -> int:
    phase, config = loop_config(args.loop)
    rows = [row for row in read_jsonl(sessions_path()) if row.get("campaign") == args.id]
    if not rows:
        die(f"no campaign {args.id} in state/sessions.jsonl")
    opened = rows[0]
    before = {k: opened.get(k, 0) for k in ("sections_clean", "open_gaps")}
    after = audit_counts(config.docs)
    commits = commits_for_campaign(args.id)
    metrics = read_jsonl(metrics_path(config.owner))
    tests_before = opened.get("tests")
    tests_after = metrics[-1].get("tests") if metrics else None

    progress = (
        after["sections_clean"] > before["sections_clean"]
        or after["open_gaps"] < before["open_gaps"]
        or (tests_before is not None and tests_after is not None and tests_after > tests_before)
    )
    drift = spec_drift(args.id, args.target)

    append_jsonl(
        sessions_path(),
        {
            "campaign": args.id,
            "loop": config.owner,
            "phase": phase.phase,
            "target": args.target,
            "ended": now(),
            "end_commit": head_sha(),
            "commits": len(commits),
            "outcome": args.outcome,
            "progress": progress,
            "spec_drift": drift,
            **after,
        },
    )
    commit_harness_state([sessions_path()], f"close campaign {args.id[:8]} ({args.outcome})")
    print(f"campaign {args.id[:8]} closed: {args.outcome}, {len(commits)} commit(s), progress={progress}")
    if drift:
        print(
            "campaign: flagged — this campaign edited design/ and code in the same run"
            + (", in the document its own target names" if drift["touches_target_document"] else "")
            + ". Not a failure; it goes to the dashboard for a human to read."
        )
    return 0


def cmd_stall(args: argparse.Namespace) -> int:
    """`design/loops.md` section 7: stall is judged per campaign, not per
    experiment. N consecutive closed campaigns with no progress stops the
    loop and asks for a human."""
    _, config = loop_config(args.loop)
    closed = [c for c in campaigns_of(config.owner) if c.get("outcome")]
    trailing = 0
    for campaign in reversed(closed):
        if campaign.get("progress"):
            break
        trailing += 1
    empty = sum(1 for c in closed[-config.stall_n :] if c.get("commits") == 0)
    print(f"stall: {trailing} campaign(s) without progress (N={config.stall_n}); {empty} of the last {config.stall_n} produced no commit")
    return 1 if trailing >= config.stall_n else 0


def cmd_status(args: argparse.Namespace) -> int:
    phase = load_phase()
    print(f"phase {phase.phase}   ({now()})")
    for owner, config in sorted(phase.loops.items()):
        counts = audit_counts(config.docs)
        campaigns = campaigns_of(owner)
        closed = [c for c in campaigns if c.get("outcome")]
        trailing = 0
        for campaign in reversed(closed):
            if campaign.get("progress"):
                break
            trailing += 1
        print()
        print(f"  {owner}  [{config.status}]")
        print(f"    docs        {', '.join(config.docs) or '(none)'}")
        print(
            f"    audit       {counts['sections_clean']}/{counts['sections_total']} clean, "
            f"{counts['sections_unjudged']} unjudged, {counts['open_gaps']} gaps, "
            f"{counts['audit_minors']} minor"
        )
        print(f"    campaigns   {len(campaigns)} opened, {len(closed)} closed, {trailing} without progress (stall N={config.stall_n})")
        for campaign in campaigns[-5:]:
            flag = "  [spec drift]" if campaign.get("spec_drift") else ""
            print(
                f"      {campaign.get('campaign', '?')[:8]}  "
                f"{(campaign.get('target') or '-'):<48.48}  {campaign.get('outcome') or 'open'}{flag}"
            )
        for line in baseline_drift(config.docs):
            print(f"    baseline    {line}")
    print()
    print(f"  provisional DECISION- tags: {provisional_decisions()}")
    decisions = sorted((STATE / "decisions").glob("*.md"))
    waiting = [p for p in decisions if re.search(r"^status:\s*open\s*$", p.read_text(), re.MULTILINE)]
    print(f"  decisions: {len(decisions)} recorded, {len(waiting)} waiting on a human")
    changes = spec_changes()
    unread = [entry for entry in changes if not entry["reviewed"]]
    print(f"  spec changes: {len(changes)} recorded, {len(unread)} not yet read by a human")
    flagged = [
        campaign
        for owner in phase.loops
        for campaign in campaigns_of(owner)
        if campaign.get("spec_drift")
    ]
    if flagged:
        print(f"  campaigns that edited design/ and code together: {len(flagged)} — read them")
    return 0


CHANGELOG_ENTRY = re.compile(r"^##\s+(?P<id>CHANGE-[A-Za-z0-9_-]+)\s+—\s+(?P<rest>.*)$", re.MULTILINE)


def spec_changes() -> list[dict]:
    """Class A spec edits, and whether anyone has read them yet.

    They are provisional until reviewed in exactly the sense a Class B
    provisional choice is: applied immediately so the loop never idles, and
    scheduled for the next batch (`design/loops.md` section 6). An edit nobody
    was scheduled to read is the one that lets the spec drift toward whatever
    was built.
    """
    path = STATE / "spec-changelog.md"
    if not path.exists():
        return []
    text = path.read_text()
    reviewed = {
        row.get("target")
        for row in read_jsonl(STATE / "interventions.jsonl")
        if row.get("kind") == "spec-change-reviewed"
    }
    entries = []
    matches = list(CHANGELOG_ENTRY.finditer(text))
    for index, match in enumerate(matches):
        end = matches[index + 1].start() if index + 1 < len(matches) else len(text)
        entries.append(
            {
                "id": match.group("id"),
                "heading": match.group("rest").strip(),
                "body": text[match.end() : end].strip(),
                "reviewed": match.group("id") in reviewed,
            }
        )
    return entries


def cmd_spec_changes(args: argparse.Namespace) -> int:
    entries = spec_changes()
    waiting = [entry for entry in entries if not entry["reviewed"]]
    for entry in entries:
        print(f"{'   ' if entry['reviewed'] else '-> '}{entry['id']}  {entry['heading']}")
    print(f"spec-changelog: {len(entries)} entry(s), {len(waiting)} not yet read by a human")
    return 0


def cmd_intervene(args: argparse.Namespace) -> int:
    """`design/loops.md` section 16: the log is the mechanism, not a record of
    it. Answering a decision means appending here."""
    if not args.rationale.strip():
        die("rationale is required; a decision with no recorded reason gets re-litigated")
    append_jsonl(
        STATE / "interventions.jsonl",
        {
            "ts": now(),
            "kind": args.kind,
            "target": args.target,
            "answer": args.answer,
            "rationale": args.rationale,
            "commit": head_sha(),
        },
    )
    commit_harness_state([STATE / "interventions.jsonl"], f"{args.kind} on {args.target}")
    print(f"logged: {args.kind} on {args.target}")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(prog="hj", description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("sections", help="list a design document's sections and their anchors")
    p.add_argument("doc", nargs="+")
    p.set_defaults(run=cmd_sections)

    p = sub.add_parser("section-text", help="print one section's body, for splicing into a prompt")
    p.add_argument("key", help="e.g. core.md#7-measurement")
    p.set_defaults(run=cmd_section_text)

    p = sub.add_parser("baseline-take", help="freeze the section denominator for this phase")
    p.add_argument("--force", action="store_true", help="re-take mid-phase; makes the metrics history discontinuous")
    p.set_defaults(run=cmd_baseline_take)

    p = sub.add_parser("baseline-drift", help="how the documents have moved since the baseline")
    p.set_defaults(run=cmd_baseline_drift)

    p = sub.add_parser("spec-changes", help="Class A spec edits, and which are still unread")
    p.set_defaults(run=cmd_spec_changes)

    p = sub.add_parser("audit-plan", help="which sections the next audit covers")
    p.add_argument("loop")
    p.set_defaults(run=cmd_audit_plan)

    p = sub.add_parser("audit-merge", help="merge an auditor's verdict into state/audit/")
    p.add_argument("loop")
    p.add_argument("transcript", help="file holding the auditor's output")
    p.add_argument("--partial", action="store_true", help="merge the valid sections even if some were rejected")
    p.set_defaults(run=cmd_audit_merge)

    p = sub.add_parser("check-audit", help="gate step: every gap names an anchor that exists")
    p.set_defaults(run=cmd_check_audit)

    p = sub.add_parser("check-scope", help="gate step: only owned paths were touched")
    p.add_argument("loop")
    p.add_argument("--rev", help="check a commit instead of the working tree")
    p.set_defaults(run=cmd_check_scope)

    p = sub.add_parser("check-path", help="is one path inside this loop's owned set (for the PreToolUse hook)")
    p.add_argument("loop")
    p.add_argument("path", nargs="+")
    p.set_defaults(run=cmd_check_path)

    p = sub.add_parser("check-metrics", help="gate step: the previous iteration recorded its row")
    p.add_argument("loop")
    p.set_defaults(run=cmd_check_metrics)

    p = sub.add_parser("record", help="append the metrics row for HEAD")
    p.add_argument("loop")
    p.set_defaults(run=cmd_record)

    p = sub.add_parser("render-prompt", help="render a loop's prompt")
    p.add_argument("loop")
    p.add_argument("--campaign")
    p.add_argument("--out")
    p.set_defaults(run=cmd_render_prompt)

    p = sub.add_parser("render-auditor", help="render the auditor's prompt for a plan")
    p.add_argument("loop")
    p.add_argument("plan", help="file holding the section keys to audit")
    p.add_argument("--out")
    p.set_defaults(run=cmd_render_auditor)

    p = sub.add_parser("crates", help="the workspace members this loop owns and the gate builds")
    p.add_argument("loop")
    p.set_defaults(run=cmd_crates)

    p = sub.add_parser("campaign-open", help="allocate a campaign, write its record, render its prompt")
    p.add_argument("loop")
    p.add_argument("--id", help="uuid; generated when omitted")
    p.add_argument("--prompt-out")
    p.set_defaults(run=cmd_campaign_open)

    p = sub.add_parser("campaign-close", help="close a campaign and judge whether it made progress")
    p.add_argument("loop")
    p.add_argument("--id", required=True)
    p.add_argument("--outcome", required=True, choices=OUTCOMES)
    p.add_argument("--target", default=None)
    p.set_defaults(run=cmd_campaign_close)

    p = sub.add_parser("stall", help="exit 1 when the loop has stalled")
    p.add_argument("loop")
    p.set_defaults(run=cmd_stall)

    p = sub.add_parser("status", help="the operator view, until there is a dashboard")
    p.set_defaults(run=cmd_status)

    p = sub.add_parser("intervene", help="append to the intervention log")
    p.add_argument("--kind", required=True)
    p.add_argument("--target", required=True)
    p.add_argument("--answer", default="")
    p.add_argument("--rationale", required=True)
    p.set_defaults(run=cmd_intervene)

    args = parser.parse_args()
    return args.run(args)


if __name__ == "__main__":
    sys.exit(main())
