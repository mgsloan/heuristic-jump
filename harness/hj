# The selftest cases that deliberately read `HARNESS` — the tree being judged —
# instead of `PINNED_HARNESS`, the reviewed copy this file sits in.
#
# `harness-011` answered that the two are not interchangeable, after two
# campaigns lost time to the difference. A case asserting how two harness files
# agree with *each other* reads `PINNED_HARNESS`: a branch carrying an older
# copy of a file it is denied is behind rather than broken, and failing it for
# that is failing a campaign for something it may not fix. A case asserting an
# invariant every live branch already satisfies reads `HARNESS`, because
# catching a campaign that introduces the defect is the whole of its value.
#
# Named rather than counted, so joining the list is a decision rather than a
# habit — and `hj selftest --across-worktrees` is what answers "would this fail
# a branch that predates it", which the record called undecidable.
CANDIDATE_TREE_CHECKS = (
    "the_reaper_is_the_only_caller_that_asks_the_process_table",
    "a_tuple_returning_helper_is_not_used_as_one_value",
    "the_digest_asymmetry_reaches_both_ends",
)


def candidate_tree_reads(source: str) -> list[str]:
    """The selftest cases that read `HARNESS`, by name, in file order."""
    first, past = selftest_line_range(source)
    found, name = [], None
    for number, line in enumerate(source.splitlines(), start=1):
        match = re.match(r"    def ([a-z0-9_]+)\(\):", line)
        if match:
            name = match.group(1)
        if first <= number < past and name and re.search(r"\(HARNESS\s*/", line):
            if name not in found:
                found.append(name)
    return found


def _selftest_dashboard():
    """The reviewed `dashboard/serve`, loaded as a module so its renderers can
    be called directly.

    `PINNED_HARNESS` rather than `HARNESS`, per `harness-011`: this asserts how
    two harness files agree with each other, and reading the candidate tree
    would fail a branch for carrying an older copy of a file it may not be the
    one to change.

    `serve` loads its own `hj` at import time and registers it as
    `sys.modules["hj"]`, so the entry is saved and put back — leaving a second
    copy of this module installed under the name the running one has is the
    kind of thing that goes wrong three checks later and looks unrelated.
    """
    previous = sys.modules.get("hj")
    source = PINNED_HARNESS / "dashboard" / "serve"
    spec = importlib.util.spec_from_loader(
        "_hj_dashboard", importlib.machinery.SourceFileLoader("_hj_dashboard", str(source))
    )
    module = importlib.util.module_from_spec(spec)
    try:
        spec.loader.exec_module(module)
    finally:
        if previous is None:
            sys.modules.pop("hj", None)
        else:
            sys.modules["hj"] = previous
    return module


def _selftest_adapter_cost(events: list[dict]) -> dict:
    """Run the real `adapter cost` over a synthetic stream.

    Through the adapter rather than around it: the point of the check is that
    the file which owns the vendor's shapes still reads them the way the row
    spec needs, and a reimplementation here would agree with itself forever.

    The adapter beside *this* file, not `HARNESS / "adapter"`. `HARNESS` is
    derived from `HJ_REPO`, which is the tree being checked — so a pinned `hj`
    running the gate for another loop would test that loop's adapter instead
    of its own. Found by running this against the core worktrees before
    merging: two checks failed with `KeyError: 'gate_runs'`, which is what
    three workers' gates would have done on their next run.
    """
    adapter = Path(__file__).resolve().parent / "adapter"
    with tempfile.NamedTemporaryFile("w", suffix=".jsonl", delete=False) as handle:
        for event in events:
            handle.write(json.dumps(event) + "\n")
        path = handle.name
    try:
        result = subprocess.run(
            [str(adapter), "cost", path], capture_output=True, text=True, check=False
        )
        return json.loads(result.stdout.strip() or "{}")
    finally:
        os.unlink(path)


def worktree_roots() -> list[Path]:
    """Every checkout a live loop branch is currently in, integration first.

    Read from git rather than from `state/phase.toml`'s `worktree`, which gives
    the stem a worker number is appended to and would have to be re-derived
    here; `git worktree list` already knows what exists.
    """
    roots = [CONTROL]
    for line in git("worktree", "list", "--porcelain", check=False).splitlines():
        if line.startswith("worktree "):
            root = Path(line.split(" ", 1)[1]).resolve()
            if root not in roots:
                roots.append(root)
    return roots


def cmd_selftest(args: argparse.Namespace) -> int:
    """`harness-011`: `--across-worktrees` is the convention made runnable.

    Gate step 3 runs *this* copy of the selftest against whichever tree
    `HJ_REPO` names, so a case that reads `HARNESS` asserts about the candidate
    rather than about itself. That is what the three surviving `HARNESS` reads
    are for — they catch a campaign introducing a defect. It is also how two
    cases came to fail every branch at once: they encoded a requirement added
    in the integration checkout, and `harness/gate` is denied to every loop, so
    no branch could satisfy it and green-or-revert had no green to revert to.

    The record's option B was "assert only what every live branch already
    satisfies", and its own stated cost is that conventions are what failed
    twice. This makes the question decidable instead: run the checks against
    every checkout and see. It is what to run before committing a selftest
    case that reads `HARNESS`.
    """
    if getattr(args, "across_worktrees", False):
        failures = 0
        for root in worktree_roots():
            environment = {**os.environ, "HJ_REPO": str(root)}
            result = subprocess.run(
                [str(PINNED_HARNESS / "hj"), "selftest"],
                capture_output=True,
                text=True,
                check=False,
                env=environment,
            )
            tail = (result.stdout + result.stderr).strip().splitlines()
            print(f"{root.name}: {tail[-1] if tail else 'no output'}")
            if result.returncode:
                failures += 1
                for line in tail[:-1]:
                    print(f"    {line}")
        if failures:
            print(
                f"selftest: the reviewed checks fail in {failures} checkout(s). A case that "
                "reads HARNESS asserts about the tree being judged, so it fails every branch "
                "that has not merged what it encodes — see state/decisions/harness-011.md.",
                file=sys.stderr,
            )
            return 1
        return 0
    cases = selftest_cases()
    failed = []
    for name, case in cases:
        try:
            case()
        except AssertionError as error:
            failed.append((name, str(error) or "assertion failed"))
        except Exception as error:  # noqa: BLE001 - a check that errors is a check that failed
            failed.append((name, f"{type(error).__name__}: {error}"))
    for name, reason in failed:
        print(f"selftest: FAILED  {name.replace('_', ' ')}\n          {reason}", file=sys.stderr)
    if failed:
        print(f"selftest: {len(failed)} of {len(cases)} checks failed", file=sys.stderr)
        return 1
    print(f"selftest: {len(cases)} checks passed")
    return 0


def cmd_intervene(args: argparse.Namespace) -> int:
    """`design/loops.md` section 16: the log is the mechanism, not a record of
    it. Answering a decision means appending here.

    The kind is checked against section 16's vocabulary, because "recurring
    kinds are a design backlog" is a count and a typo splits one. `--new-kind`
    is the way past it: the list is closed against slips, not against events
    the design did not anticipate.
    """
    if not args.rationale.strip():
        die("rationale is required; a decision with no recorded reason gets re-litigated")
    kind = canonical_kind(args.kind.strip())
    if kind not in KNOWN_KINDS and not args.new_kind:
        near = [known for known in KNOWN_KINDS if known.startswith(kind.split("-")[0])]
        die(
            f"unknown intervention kind {kind!r}.\n"
            + (f"    did you mean: {', '.join(near)}?\n" if near else "")
            + "    known kinds: "
            + ", ".join(KNOWN_KINDS)
            + "\n    pass --new-kind if this really is a kind nobody has logged before."
        )
    append_jsonl(
        INTERVENTIONS,
        {
            "ts": now(),
            "kind": kind,
            # Recorded rather than attributed later. `phase_at` can only guess
            # from whichever campaign was running, and an intervention made
            # between phases is exactly when that guess is wrong.
            "phase": load_phase().phase,
            "target": args.target,
            "answer": args.answer,
            "rationale": args.rationale,
            "commit": head_sha(),
        },
    )
    commit_harness_state([INTERVENTIONS], f"{kind} on {args.target}")
    print(f"logged: {kind} on {args.target}")
    return 0


def cmd_install_hooks(args: argparse.Namespace) -> int:
    """Symlink the git hooks into the common git directory.

    Explicit rather than automatic, and a symlink rather than `core.hooksPath`:
    setting that would redirect *every* hook, so a hook someone else installed
    would silently stop running. It goes in the common directory, which is
    shared by every worktree — one install covers the fleet.
    """
    common = Path(git("rev-parse", "--git-common-dir").strip())
    if not common.is_absolute():
        common = (REPO / common).resolve()
    for source in sorted((Path(__file__).resolve().parent / "hooks").glob("*")):
        if source.name not in ("post-commit",):
            continue
        target = common / "hooks" / source.name
        target.parent.mkdir(parents=True, exist_ok=True)
        if target.is_symlink() and target.resolve() == source:
            print(f"install-hooks: {target} already points here")
            continue
        if target.exists() or target.is_symlink():
            print(f"install-hooks: {target} exists and is not ours; left alone", file=sys.stderr)
            continue
        target.symlink_to(source)
        print(f"install-hooks: {target} -> {source}")
    return 0


def cmd_interventions(args: argparse.Namespace) -> int:
    """What the log says about how autonomous this actually is."""
    stats = intervention_stats()
    print(f"interventions: {stats['total']} logged")
    print()
    print("  per 100 experiments, by phase")
    for entry in stats["per_phase"]:
        ratio = f"{entry['per_100']:.1f}" if entry["per_100"] is not None else "—"
        print(
            f"    {entry['phase']:<4}  {entry['interventions']:>4} interventions  "
            f"{entry['experiments']:>5} experiments  {ratio:>6} per 100"
        )
    print()
    print(f"  by kind (>= {RECURRING_KIND}, excluding the one-per-event kinds, is a design backlog item)")
    for kind, count in stats["by_kind"]:
        if kind in stats["recurring"]:
            flag = "  <- recurring; a rule is missing somewhere"
        elif kind in ROUTINE_KINDS:
            flag = "  (one per event)"
        else:
            flag = ""
        print(f"    {count:>4}  {kind}{flag}")
    print()
    median = stats["median_hours"]
    print(f"  time to answer: median {median:.1f}h" if median is not None else "  time to answer: —")
    for entry in stats["answered"][:5]:
        if entry.get("hours") is not None:
            print(f"    {entry['hours']:>7.1f}h  {entry['id']}")
    unlogged = stats["unlogged_commits"]
    if unlogged:
        print()
        print(f"  {len(unlogged)} hand-authored commit(s) with nothing in the log")
        for entry in unlogged[:10]:
            print(f"    {entry['commit'][:8]}  {entry['ts'][:16]}  {entry['subject'][:60]}")
    if stats["waiting"]:
