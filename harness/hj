    p.add_argument("plan", help="file holding the section keys to audit")
    p.add_argument("--out")
    p.set_defaults(run=cmd_render_auditor)

    p = sub.add_parser("crates", help="the workspace members this loop owns and the gate builds")
    p.add_argument("loop")
    p.add_argument("--lintable", action="store_true", help="exclude vendored crates, which are tested but not linted")
