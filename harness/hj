    def every_kind_the_code_reads_is_a_kind_the_log_accepts():
        # Twice now a queue has been built whose clearing kind `cmd_intervene`
        # rejected: `merge-blocked`, then `prompt-drift-reviewed`, which had to
        # be forced through with `--new-kind` on its first use. The reader and
        # the vocabulary are written in different places and nothing made them
        # agree, so the failure is silent until someone tries to answer.
        source = (PINNED_HARNESS / "hj").read_text()
        first, past = selftest_line_range(source)
        # `kind` is also a field on the cost rows, whose values are not
        # intervention kinds and never reach `hj intervene`. Named rather than
        # pattern-matched, so a third vocabulary on the same field has to be
        # added here deliberately instead of being silently exempt.
        not_an_intervention = {"campaign", "audit"}
        read = set()
        for number, line in enumerate(source.splitlines(), start=1):
            if first <= number < past:
                continue
            read.update(re.findall(r'get\("kind"\)\s*==\s*"([a-z-]+)"', line))
        unknown = sorted(read - set(KNOWN_KINDS) - not_an_intervention)
        assert not unknown, f"read but not in KNOWN_KINDS, so `hj intervene` refuses them: {unknown}"

