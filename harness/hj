    def an_unwritten_hypothesis_is_not_invented():
        template = "## Hypothesis\n\n<!-- Why the target is in the state it is in. -->\n\n## Outcome\n"
        assert hypothesis_of(template) == "", "the template's own comment is not a hypothesis"
        assert hypothesis_of("# Campaign\n\n## Target\n\nx\n") == "", "no section, no line"

    def a_long_hypothesis_is_cut_at_a_word():
