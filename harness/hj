            {"stratum_prior": "explicitly_imported", "decision": "committed",
             "stages": [], "bytes_scanned": 10, "files_parsed": 1, "returned": 3,
             "heuristic_latency_us": 500, "stage_us": {"scan": 400}},
        ]
        with tempfile.TemporaryDirectory() as directory:
            report_path = Path(directory) / "report.json"
            records_path = Path(directory) / "records.jsonl"
            report_path.write_text(json.dumps(report))
            records_path.write_text(json.dumps(records[0]) + "\n")
            fields = replay_fields(
                replay_surfaces(
                    argparse.Namespace(
                        replay_report=[str(report_path)],
                        replay_records=[str(records_path)],
                        replay_seconds=["41.5"],
                    )
                )
            )
        assert fields["uncollected"] == 3
        assert fields["replay"]["wall_clock_seconds"] == 41.5, (
            "§9 records replay wall clock as an ordinary metric, per commit"
        )
        assert fields["replay"]["work"] == {"bytes_scanned": 10, "files_parsed": 1}
        entry = fields["strata"]["explicitly_imported"]
        assert entry["coverage"] == 0.8 and entry["top1"] == 0.75, entry
        assert entry["latency_p50_us"] == 500.0, "the cost half landed in the same stratum"
        assert entry["result_count"] == 3.0, "the price of containment, beside and not on"
        position = frontier_axes_of(fields)
        assert position == {"top1": 0.75, "coverage": 0.8}, position

    def a_row_from_a_commit_nobody_replayed_carries_no_replay_key():
        empty = argparse.Namespace(replay_report=None, replay_records=None, replay_seconds=None)
        assert replay_fields(replay_surfaces(empty)) == {}, (
