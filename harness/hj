# Desired state


@dataclass
class LoopConfig:
    owner: str
    status: str
    prompt: str
    docs: list[str]
    crates: list[str]
    write: list[str]
    stall_n: int
    rotation: int
    splice_sections: int
    detail_gaps: int
    turn_target: str
    budget_usd: float | None
    model: str | None
    language: str | None
    writes_harness: bool


@dataclass
class Budget:
    """The two scopes above the campaign. `design/loops.md` section 15.

    The per-campaign ceiling is `LoopConfig.budget_usd`, and it is the runner's
    to enforce (`--max-budget-usd`) because only the runner can stop a session
    mid-turn. These two are the harness's, checked between campaigns, which is
    the granularity available to something outside the session.

    Both are optional and both default to absent rather than to a number: an
    invented ceiling would stop a fleet on an arbitrary Tuesday, and the
    section asks for budgets that "stop and report", not for a guess.
    """

    global_usd: float | None = None
    language_usd: dict[str, float] = field(default_factory=dict)


@dataclass
class Phase:
    phase: str
    audit_every: int = 1
    # `design/loops.md` section 6: "a batch is triggered by whichever comes
    # first: the outstanding `DECISION-` count crossing a threshold, or a phase
    # gate". Absent rather than a default number, for `Budget`'s reason — a
    # guessed threshold either cries wolf or never fires, and the section names
    # no number. Absent means the phase gate is the only trigger, which is the
    # degenerate case the section already describes rather than a broken one.
    escalation_batch: int | None = None
    # `design/loops.md` section 11's standing ceiling: "an order of magnitude
    # above where anything reasonable sits, on `measure_<lang>` size and on
    # per-query work. It is a guardrail and emphatically not a ratchet:
    # crossing it does not mean the last change was wrong, it means the loop
    # has wandered somewhere no legitimate experiment goes, and it stops and
    # escalates rather than failing the gate."
    #
    # Empty rather than defaulted, for `Budget`'s and `escalation_batch`'s
    # reason, and here the section supplies the argument itself: the number is
    # only harmless because it sits an order of magnitude clear of anything
    # legitimate, and nobody knows where that is until a handler exists. A
    # guessed one either never fires or suppresses the expensive experiments
    # §11 spends its first three paragraphs protecting.
    guardrail: dict[str, int] = field(default_factory=dict)
    # §12's "held-out gap within threshold". Absent by default, and the section
    # names no number — it is the *widening* that stops the loop, and that
    # comparison needs no threshold at all. A ceiling on the absolute gap is
    # the weaker of the two signals and the one that needs a human's number.
    heldout_threshold: float | None = None
    budget: Budget = field(default_factory=Budget)
    loops: dict[str, LoopConfig] = field(default_factory=dict)


def load_phase() -> Phase:
    path = CONTROL / "state" / "phase.toml"
    if not path.exists():
        die(f"{path} does not exist; the harness has no desired state to reconcile against")
    raw = tomllib.loads(path.read_text())
    budget_table = raw.get("budget", {})
    result = Phase(
        phase=raw["phase"],
        audit_every=raw.get("audit_every", 1),
        escalation_batch=raw.get("escalation_batch"),
        heldout_threshold=(raw.get("heldout") or {}).get("gap_threshold"),
        guardrail={
            name: int(value)
            for name, value in (raw.get("guardrail") or {}).items()
            if isinstance(value, (int, float)) and not isinstance(value, bool)
        },
        budget=Budget(
            global_usd=budget_table.get("global_usd"),
            language_usd={
                language: float(ceiling)
                for language, ceiling in (budget_table.get("language") or {}).items()
            },
        ),
    )
    for owner, table in raw.get("loop", {}).items():
        result.loops[owner] = LoopConfig(
            owner=owner,
            status=table.get("status", "paused"),
            prompt=table["prompt"],
            docs=table.get("docs", []),
            crates=table.get("crates", []),
            write=table.get("write", []),
            stall_n=table.get("stall_n", 3),
            rotation=table.get("rotation", 6),
            splice_sections=table.get("splice_sections", 3),
            detail_gaps=table.get("detail_gaps", 8),
            turn_target=table.get("turn_target", "about 150"),
            budget_usd=table.get("budget_usd"),
            model=table.get("model"),
            language=table.get("language"),
            writes_harness=bool(table.get("writes_harness", False)),
        )
    return result


def denied_paths(phase: Phase, owner: str | None = None) -> list[str]:
    """What this loop may not write. `owner` omitted means every loop's denials
    together, which is what a summary wants and never what a check wants."""
    denied = list(DENIED_ALWAYS)
    if phase.phase not in WHOLE_REPOSITORY_PHASES:
        denied += PHASE_DEPENDENT_DENIALS
    config = phase.loops.get(owner) if owner else None
    if not (config and config.writes_harness):
        denied += HARNESS_PATHS
    return denied


def loop_config(owner: str) -> tuple[Phase, LoopConfig]:
    phase = load_phase()
    if owner not in phase.loops:
        die(f"no loop named {owner!r} in state/phase.toml (have: {', '.join(sorted(phase.loops))})")
    return phase, phase.loops[owner]


# --------------------------------------------------------------------------
# Design documents: the section list is parsed, never authored


# Level 2 and 3. The design documents put most of their checkable claims under
# `###`, and a denominator of ten sections for a 1700-line document is one the
# numerator can barely move — "sections clean over sections total" is only a
# useful number at a granularity where a campaign can finish one. Each body
# runs to the next heading of any level, so the sections partition the document
# rather than nesting.
HEADING = re.compile(r"^#{2,3}\s+(?P<text>\S.*?)\s*$")


def anchor_of(heading: str) -> str:
    """GitHub's slug: lowercase, drop everything but word characters, spaces
    and hyphens, then **each** space to a hyphen.

    Runs are not collapsed, which is the part that is easy to get wrong. A
    heading like `pyright, basedpyright — Python` loses the em dash and keeps
    the spaces that surrounded it, so the anchor has a double hyphen.
    Collapsing them produced anchors that did not match the document's own
    cross-references, and reported those references as dangling.
    """
    slug = heading.strip().lower()
    slug = re.sub(r"[^a-z0-9 _-]", "", slug)
    return slug.replace(" ", "-").strip("-")


@dataclass
class Section:
    doc: str
    anchor: str
    heading: str
    start: int  # line index of the heading
    end: int  # line index one past the last line of the body

    @property
    def key(self) -> str:
        return f"{self.doc}#{self.anchor}"


def doc_path(doc: str) -> Path:
    path = DESIGN / doc
    if not path.exists():
        die(f"no such design document: {doc}")
    return path


def sections_of(doc: str) -> list[Section]:
    lines = doc_path(doc).read_text().splitlines()
    found: list[Section] = []
    in_fence = False
    for index, line in enumerate(lines):
        if line.startswith("```"):
            in_fence = not in_fence
            continue
        if in_fence:
            continue
        match = HEADING.match(line)
        if match:
            heading = match.group("text")
            found.append(Section(doc, anchor_of(heading), heading, index, len(lines)))
    for earlier, later in zip(found, found[1:]):
        earlier.end = later.start
    seen: dict[str, int] = {}
    for section in found:
        count = seen.get(section.anchor, 0)
        seen[section.anchor] = count + 1
        if count:
            section.anchor = f"{section.anchor}-{count}"  # GitHub's own tie-break
    return found


def section_index(docs: list[str]) -> dict[str, Section]:
    return {s.key: s for doc in docs for s in sections_of(doc)}


ANY_HEADING = re.compile(r"^#{2,}\s+(?P<text>\S.*?)\s*$")


def anchors_of(doc: str) -> set[str]:
    """Every anchor a link or a gap may legitimately name, at any heading depth.

    Distinct from [`sections_of`], which stops at `###` because that is the
    granularity the *score* is counted at. Anchor validity is a different
    question from what the denominator is: `shim.md` links to two `####`
    headings, and treating those as dangling reported real cross-references as
    spec drift.
    """
    found: set[str] = set()
    in_fence = False
    for line in doc_path(doc).read_text().splitlines():
        if line.startswith("```"):
            in_fence = not in_fence
            continue
        if in_fence:
            continue
        match = ANY_HEADING.match(line)
        if match:
            anchor = anchor_of(match.group("text"))
            while anchor in found:
                anchor += "-1"
            found.add(anchor)
    return found


# --------------------------------------------------------------------------
# The baseline: the denominator, frozen for the phase
#
# It lives in `harness/` and not `state/` for the reason everything else in
# `harness/` does — a loop must not be able to move the thing that scores it,
# and here the score is a fraction whose denominator is parsed out of
# documents the conformance loop is allowed to edit.

BASELINE = HARNESS / "section-baseline.toml"


def read_baseline() -> dict:
    if not BASELINE.exists():
        return {}
    return tomllib.loads(BASELINE.read_text())


def baseline_anchors(doc: str) -> set[str] | None:
    """`None` when no baseline has been taken, which means "fall back to the
    documents and say so" rather than "the denominator is zero"."""
    entry = read_baseline().get("doc", {}).get(doc)
    if entry is None:
        return None
    return {f"{doc}#{anchor}" for anchor in entry.get("anchors", [])}


def baseline_drift(docs: list[str]) -> list[str]:
    lines = []
    for doc in docs:
        expected = baseline_anchors(doc)
        if expected is None:
            lines.append(f"{doc}: no baseline; the denominator is being re-derived each audit")
            continue
        live = {s.key for s in sections_of(doc)}
        for key in sorted(expected - live):
            lines.append(f"{key}: in the baseline, gone from the document — counted, and never clean")
        for key in sorted(live - expected):
            lines.append(f"{key}: added since the baseline — audited, but it does not move the score")
    return lines


def section_text(section: Section) -> str:
    lines = doc_path(section.doc).read_text().splitlines()
    body = "\n".join(lines[section.start : section.end]).rstrip()
    return f"<!-- {section.key} -->\n{body}\n"


# --------------------------------------------------------------------------
# The audit record


@dataclass
class Gap:
    claim: str
    found: str
    where: str
    # HEAD when the audit recorded it. The audit re-judges a rotation
    # slice, so a gap closed by a commit afterwards stays in the list until
    # its section comes round again — measured at seven of nine on core.md
    # (`state/decisions/core-019.md`). This is what lets the prompt say
    # which ones are worth verifying first.
    found_at: str = ""


@dataclass
class Minor:
    claim: str
    note: str
    where: str


@dataclass
class SectionVerdict:
    key: str
    state: str  # clean | gaps | unjudged
    last_audited: str | None
    gaps: list[Gap] = field(default_factory=list)
    minors: list[Minor] = field(default_factory=list)


VALID_STATES = ("clean", "gaps", "unjudged")


def audit_path(doc: str) -> Path:
    return STATE / "audit" / f"{doc.removesuffix('.md')}.toml"


def read_audit(doc: str) -> dict[str, SectionVerdict]:
    path = audit_path(doc)
    if not path.exists():
        return {}
    raw = tomllib.loads(path.read_text())
    out: dict[str, SectionVerdict] = {}
    for key, table in raw.get("section", {}).items():
        out[key] = SectionVerdict(
            key=key,
            state=table.get("state", "unjudged"),
            last_audited=table.get("last_audited"),
            gaps=[Gap(g.get("claim", ""), g.get("found", ""), g.get("where", ""), g.get("found_at", "")) for g in table.get("gap", [])],
            minors=[Minor(m.get("claim", ""), m.get("note", ""), m.get("where", "")) for m in table.get("minor", [])],
        )
    return out


def toml_string(value: str) -> str:
    if "\n" in value:
        escaped = value.replace("\\", "\\\\").replace('"""', '\\"\\"\\"')
        return f'"""\n{escaped}"""'
    return json.dumps(value)


def write_audit(doc: str, verdicts: dict[str, SectionVerdict], order: list[str]) -> None:
    lines = [
        f"# Audit of design/{doc}. Written by harness/audit, never by hand.",
        "# `design/loops.md` section 3. The section list is parsed out of the",
        "# document, so it follows the document rather than drifting from it.",
        "",
    ]
    for key in order:
        verdict = verdicts[key]
        lines.append(f"[section.{toml_string(key)}]")
        lines.append(f"state = {toml_string(verdict.state)}")
        if verdict.last_audited:
            lines.append(f"last_audited = {toml_string(verdict.last_audited)}")
        for gap in verdict.gaps:
            lines.append("")
            lines.append(f"  [[section.{toml_string(key)}.gap]]")
            lines.append(f"  claim = {toml_string(gap.claim)}")
            lines.append(f"  found = {toml_string(gap.found)}")
            lines.append(f"  where = {toml_string(gap.where)}")
            if gap.found_at:
                lines.append(f"  found_at = {toml_string(gap.found_at)}")
        for minor in verdict.minors:
            lines.append("")
            lines.append(f"  [[section.{toml_string(key)}.minor]]")
            lines.append(f"  claim = {toml_string(minor.claim)}")
            lines.append(f"  note = {toml_string(minor.note)}")
            lines.append(f"  where = {toml_string(minor.where)}")
        lines.append("")
    path = audit_path(doc)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text("\n".join(lines))


def gap_id(section_key: str, claim: str) -> str:
    """A gap's identity is its section and its claim.

    Not `found` or `where`, which move as the code moves — the same unmet
    claim reported against a different file is the same gap. `design/loops.md`
    section 5: comparing successive audits by gap identity rather than by
    total is what makes the difference visible, because a list that is the
    previous list minus what was fixed is progress, while a different list of
    the same length is variance.
    """
    normalised = re.sub(r"\s+", " ", claim.strip().lower())
    return hashlib.sha256(f"{section_key}|{normalised}".encode()).hexdigest()[:10]


GAP_LOG = STATE / "audit" / "gap-log.jsonl"


def open_gap_ids(docs: list[str]) -> dict[str, tuple[str, str]]:
    out: dict[str, tuple[str, str]] = {}
    for doc in docs:
        known = {s.key for s in sections_of(doc)}
        for key, verdict in read_audit(doc).items():
            if key in known:
                for gap in verdict.gaps:
                    out[gap_id(key, gap.claim)] = (key, gap.claim)
    return out


def campaign_was_audited(audits: list[dict], commit_times: list[str], opened_at: str) -> bool:
    """Has anything judged this campaign's work?

    `state/phase.toml` excludes a campaign that closes with no audit since it
    opened from the stall count, "otherwise the cadence itself would stop the
    loop". Two things have to be true for that exclusion to mean what it says,
    and neither was.

    **The audits must be this loop's.** The gap log is one file for both loops,
    so the last row in it is whichever loop audited most recently. Campaign
    2e588730 was judged as audited by the core loop's audit of `core.md`, while
    the harness loop's own audit had run two seconds *before* it opened — so it
    closed `confirmed` with no progress and tripped §7's "a loop that has
    decided it is finished" notice, the most alarming line the harness prints,
    over four commits nothing had looked at. Callers pass `audits_for(docs)`.

    **The audit must postdate the work, not the session.** An audit that ran
    while a campaign was still writing cannot see what it committed afterwards.
    The commits are the work; the open time is only when the session began
    reading, and it is the fallback for a campaign that committed nothing —
    where there is no work to have been judged and the old question is the
    right one.
    """
    if not audits:
        return False
    return audits[-1]["ts"] > max(commit_times, default=opened_at)


def prompts_dir(config: LoopConfig) -> Path:
    """Where a loop's prompt and its fragments are read from.

    The reviewed copy for every loop **except** the one that writes prompts.

    Reading through `HJ_REPO` means a campaign is generated from whatever
    template its own branch happens to carry, and a branch can be a long way
    back: `heuristic-jump-core-2` ran a campaign from a prompt eighty commits
    stale, missing every improvement the harness loop had landed. Nothing
    reported it, because a stale prompt renders perfectly well. That is the
    cost this fixes, and it is larger than the review gap `CHANGE-harness-012`
    named — under normal flow the loop merges at close, so the edit is on
    `main` before the next campaign renders anyway.

    The `writes_harness` loop keeps reading its own worktree, and the asymmetry
    is deliberate rather than an oversight: prompts are its deliverable, and a
    loop that could not see its own edit until it merged would be writing the
    next campaign's instructions blind, one round at a time. What stands in the
    way of that being a hole is `harness-009`'s answer — every revision to a
    live template is written to the intervention log at close — and the fact
    that the exemption is exactly one loop, named here rather than inferred.
    """
    return (HARNESS if config.writes_harness else PINNED_HARNESS) / "prompts"


def audits_for(docs: list[str]) -> list[dict]:
    """The gap-log rows belonging to a document set.

    Gap ids are opaque — `sha256(section|claim)` — so a closed one cannot be
    traced back to its document. What can is the row: an audit covers one
    loop's documents, so a row whose `sections_audited` names any of these
    documents is that loop's, and no row mixes two loops.
    """
    prefixes = tuple(f"{doc}#" for doc in docs)
    return [
        row
        for row in read_jsonl(GAP_LOG)
        if any(key.startswith(prefixes) for key in row.get("sections_audited", []))
    ]


def gap_ledger(docs: list[str]) -> dict[str, int]:
    """Found, closed, still open — cumulative across every audit so far.

    Scoped to `docs`, which it previously took and used only for the open
    count: found and closed came from every row in the log, so a second loop
    reported the first one's totals as its own.
    """
    found: set[str] = set()
    closed: set[str] = set()
    for row in audits_for(docs):
        found.update(row.get("opened", []))
        # A gap can be closed without ever having been *opened* in this log:
        # the audits before the log existed left no identities behind, so the
        # first time one of their gaps is seen here is when it disappears.
        # Counting only `opened` made "closed of found" report 15 closed of 41
        # found while 41 were still open.
        found.update(row.get("closed", []))
        closed.update(row.get("closed", []))
        closed.difference_update(row.get("opened", []))  # reopened is not closed
    still_open = open_gap_ids(docs)
    found.update(still_open)
    closed.difference_update(still_open)
    return {"gaps_found": len(found), "gaps_closed": len(closed), "gaps_open": len(still_open)}


def audit_counts(docs: list[str]) -> dict[str, int]:
    """The conformance loop's number.

    Counted against the *baseline* rather than the documents as they read
    now, because the section list is parsed from headings in documents the
    loop may edit: re-deriving the denominator each audit would let it merge
    two dirty sections into one clean one and move the score without touching
    a line of code (`design/loops.md` section 7).

    A baseline section that no longer exists is counted and is never clean.
    A section added since the baseline is audited — it is real work — but
    does not move the score this phase.
    """
    clean = total = gaps = minors = unjudged = missing = added = 0
    for doc in docs:
        expected = baseline_anchors(doc)
        live = {s.key for s in sections_of(doc)}
        verdicts = read_audit(doc)
        scored = expected if expected is not None else live
        total += len(scored)
        added += len(live - scored)
        for key in scored:
            if key not in live:
                missing += 1
                continue
            verdict = verdicts.get(key)
            if verdict is None or verdict.state == "unjudged":
                unjudged += 1
                continue
            if verdict.state == "clean":
                clean += 1
        for key, verdict in verdicts.items():
            if key in live:
                gaps += len(verdict.gaps)
                minors += len(verdict.minors)
    return {
        "sections_clean": clean,
        "sections_total": total,
        "sections_unjudged": unjudged,
        "sections_missing": missing,
        "sections_added": added,
        "open_gaps": gaps,
        "audit_minors": minors,
    }


def open_gaps(docs: list[str]) -> list[tuple[str, Gap]]:
    out: list[tuple[str, Gap]] = []
    for doc in docs:
        known = {s.key for s in sections_of(doc)}
        for key, verdict in read_audit(doc).items():
            if key in known:
                out.extend((key, gap) for gap in verdict.gaps)
    return out


