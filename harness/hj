        assert batch_is_due(3, 3)[0] is True, "crossing is inclusive; at the threshold is at it"
        assert batch_is_due(4, 3)[0] is True
        assert batch_is_due(0, 0)[0] is True, "a threshold of zero is review-every-escalation"

    def the_trigger_counts_records_and_not_tag_sites():
        # A record can be waiting with no taggable site — the choice lives in a
        # file the raising loop may not write, which is true of harness-002,
        # harness-003 and harness-007. Counting sites would leave exactly the
        # escalations a loop could not act on invisible to the trigger.
        source = inspect.getsource(cmd_escalations)
        assert "waiting_decisions()" in source
        assert "batch_is_due(len(waiting)" in source, "the threshold applies to records"

    def an_answered_decision_is_not_reported_at_a_fixture():
        # The bug this replaced: `tagged_sites` claimed `provisional_decisions`'
        # scope and did its own grep without the region filter, so every id a
        # fixture below happens to name was reported as still tagged in
        # `harness/hj` — permanently, since nothing there is ever reconciled.
        # Five answered decisions were sitting in loop prompts saying
        # "reconcile and remove the tag" against a file with no tag in it.
        source = "def selftest_cases():\n    x = 'DECISION-harness-003: provisional'\n\n\ndef after():\n    pass\n"
        sites = [("harness/hj", 2), ("harness/hj", 6), ("crates/driver/src/actor.rs", 579)]
        kept = outside_selftest_region(sites, source)
        assert ("harness/hj", 2) not in kept, "a fixture inside the selftest region is not a site"
        assert ("harness/hj", 6) in kept, "the harness loop's own implementation still counts"
        assert ("crates/driver/src/actor.rs", 579) in kept, "another file is never filtered by line"

    def the_two_readers_of_the_tag_share_one_scope():
        assert "provisional_tag_sites" in inspect.getsource(provisional_decisions)
        assert "provisional_tag_sites" in inspect.getsource(tagged_sites), (
            "tagged_sites must not grep for itself; the scope has two exclusions "
            "and a second implementation drops one of them"
        )

    def the_harness_is_code_for_drift_purposes():
        assert is_code_path("harness/hj"), "the loop building the detector is not exempt from it"
        assert is_code_path("crates/shared/src/lib.rs") and is_code_path("vendor/rope/src/rope.rs")
        assert is_code_path("Cargo.toml"), "a manifest is not the spec and not the record"

    def the_spec_and_the_record_are_not_code():
        assert not is_code_path("design/loops.md"), "the spec is the other side of the comparison"
        assert not is_code_path("state/journal/harness.md"), "every campaign writes its record"
        assert not is_code_path("state/spec-changelog/harness.md")

    def adapter_reports_nothing_without_a_result():
        assert _selftest_adapter_cost([{"type": "assistant", "message": {"content": []}}]) == {}

    def adapter_ignores_an_unfinished_gate_run():
        events = [
            {"type": "assistant", "timestamp": "2026-01-01T00:00:00.000Z", "message": {"content": [
                {"type": "tool_use", "id": "u1", "input": {"command": "harness/gate core"}}]}},
            {"type": "result", "subtype": "error_max_budget_usd", "usage": {}},
        ]
        numbers = _selftest_adapter_cost(events)
        assert numbers["gate_runs"] == 1 and numbers["gate_seconds"] == 0.0, numbers

    return [(name, case) for name, case in locals().items() if callable(case)]


def _selftest_loop(owner: str, language: str | None) -> LoopConfig:
    return LoopConfig(
        owner=owner, status="running", prompt="conformance.md", docs=[], crates=[], write=[],
        stall_n=3, rotation=6, splice_sections=3, detail_gaps=8, turn_target="about 150",
        budget_usd=None, model=None, language=language, writes_harness=False,
    )


def _selftest_adapter_cost(events: list[dict]) -> dict:
    """Run the real `adapter cost` over a synthetic stream.

    Through the adapter rather than around it: the point of the check is that
    the file which owns the vendor's shapes still reads them the way the row
    spec needs, and a reimplementation here would agree with itself forever.

    The adapter beside *this* file, not `HARNESS / "adapter"`. `HARNESS` is
    derived from `HJ_REPO`, which is the tree being checked — so a pinned `hj`
    running the gate for another loop would test that loop's adapter instead
    of its own. Found by running this against the core worktrees before
    merging: two checks failed with `KeyError: 'gate_runs'`, which is what
    three workers' gates would have done on their next run.
    """
    adapter = Path(__file__).resolve().parent / "adapter"
    with tempfile.NamedTemporaryFile("w", suffix=".jsonl", delete=False) as handle:
        for event in events:
            handle.write(json.dumps(event) + "\n")
        path = handle.name
    try:
        result = subprocess.run(
            [str(adapter), "cost", path], capture_output=True, text=True, check=False
        )
        return json.loads(result.stdout.strip() or "{}")
    finally:
        os.unlink(path)


def cmd_selftest(args: argparse.Namespace) -> int:
    cases = selftest_cases()
    failed = []
    for name, case in cases:
        try:
            case()
        except AssertionError as error:
            failed.append((name, str(error) or "assertion failed"))
        except Exception as error:  # noqa: BLE001 - a check that errors is a check that failed
            failed.append((name, f"{type(error).__name__}: {error}"))
    for name, reason in failed:
        print(f"selftest: FAILED  {name.replace('_', ' ')}\n          {reason}", file=sys.stderr)
    if failed:
        print(f"selftest: {len(failed)} of {len(cases)} checks failed", file=sys.stderr)
        return 1
    print(f"selftest: {len(cases)} checks passed")
    return 0


def cmd_intervene(args: argparse.Namespace) -> int:
    """`design/loops.md` section 16: the log is the mechanism, not a record of
    it. Answering a decision means appending here.

    The kind is checked against section 16's vocabulary, because "recurring
    kinds are a design backlog" is a count and a typo splits one. `--new-kind`
    is the way past it: the list is closed against slips, not against events
    the design did not anticipate.
    """
    if not args.rationale.strip():
        die("rationale is required; a decision with no recorded reason gets re-litigated")
    kind = canonical_kind(args.kind.strip())
    if kind not in KNOWN_KINDS and not args.new_kind:
        near = [known for known in KNOWN_KINDS if known.startswith(kind.split("-")[0])]
        die(
            f"unknown intervention kind {kind!r}.\n"
            + (f"    did you mean: {', '.join(near)}?\n" if near else "")
            + "    known kinds: "
            + ", ".join(KNOWN_KINDS)
            + "\n    pass --new-kind if this really is a kind nobody has logged before."
        )
    append_jsonl(
        INTERVENTIONS,
        {
            "ts": now(),
            "kind": kind,
            # Recorded rather than attributed later. `phase_at` can only guess
            # from whichever campaign was running, and an intervention made
            # between phases is exactly when that guess is wrong.
            "phase": load_phase().phase,
            "target": args.target,
            "answer": args.answer,
            "rationale": args.rationale,
            "commit": head_sha(),
        },
    )
    commit_harness_state([INTERVENTIONS], f"{kind} on {args.target}")
    print(f"logged: {kind} on {args.target}")
    return 0


def cmd_install_hooks(args: argparse.Namespace) -> int:
    """Symlink the git hooks into the common git directory.

    Explicit rather than automatic, and a symlink rather than `core.hooksPath`:
    setting that would redirect *every* hook, so a hook someone else installed
    would silently stop running. It goes in the common directory, which is
    shared by every worktree — one install covers the fleet.
    """
    common = Path(git("rev-parse", "--git-common-dir").strip())
    if not common.is_absolute():
        common = (REPO / common).resolve()
    for source in sorted((Path(__file__).resolve().parent / "hooks").glob("*")):
        if source.name not in ("post-commit",):
            continue
        target = common / "hooks" / source.name
        target.parent.mkdir(parents=True, exist_ok=True)
        if target.is_symlink() and target.resolve() == source:
            print(f"install-hooks: {target} already points here")
            continue
        if target.exists() or target.is_symlink():
            print(f"install-hooks: {target} exists and is not ours; left alone", file=sys.stderr)
            continue
        target.symlink_to(source)
        print(f"install-hooks: {target} -> {source}")
    return 0


def cmd_interventions(args: argparse.Namespace) -> int:
    """What the log says about how autonomous this actually is."""
    stats = intervention_stats()
    print(f"interventions: {stats['total']} logged")
    print()
    print("  per 100 experiments, by phase")
    for entry in stats["per_phase"]:
        ratio = f"{entry['per_100']:.1f}" if entry["per_100"] is not None else "—"
        print(
            f"    {entry['phase']:<4}  {entry['interventions']:>4} interventions  "
            f"{entry['experiments']:>5} experiments  {ratio:>6} per 100"
        )
    print()
    print(f"  by kind (>= {RECURRING_KIND}, excluding the one-per-event kinds, is a design backlog item)")
    for kind, count in stats["by_kind"]:
        if kind in stats["recurring"]:
            flag = "  <- recurring; a rule is missing somewhere"
        elif kind in ROUTINE_KINDS:
            flag = "  (one per event)"
        else:
            flag = ""
        print(f"    {count:>4}  {kind}{flag}")
    print()
    median = stats["median_hours"]
    print(f"  time to answer: median {median:.1f}h" if median is not None else "  time to answer: —")
    for entry in stats["answered"][:5]:
        if entry.get("hours") is not None:
            print(f"    {entry['hours']:>7.1f}h  {entry['id']}")
    unlogged = stats["unlogged_commits"]
    if unlogged:
        print()
        print(f"  {len(unlogged)} hand-authored commit(s) with nothing in the log")
        for entry in unlogged[:10]:
            print(f"    {entry['commit'][:8]}  {entry['ts'][:16]}  {entry['subject'][:60]}")
    if stats["waiting"]:
        print()
        print("  waiting now — a loop is running on a provisional choice for each of these")
        for entry in stats["waiting"]:
            hours = entry.get("hours")
            print(f"    {hours:>7.1f}h  {entry['id']}  {entry['title'][:60]}" if hours is not None
                  else f"          ?  {entry['id']}")
    return 0


