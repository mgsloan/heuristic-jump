def cmd_baseline_take(args: argparse.Namespace) -> int:
    """Freeze the denominator at the start of a phase. A human action: this
    writes into `harness/`, which every loop is denied."""
    phase = load_phase()
    existing = read_baseline()
    if existing and existing.get("phase") == phase.phase and not args.force:
        die(
            f"a baseline for phase {phase.phase} was already taken at {existing.get('taken')}. "
            "Re-taking it mid-phase makes the metrics history discontinuous; pass --force if "
            "that is what you mean, and log it as an intervention."
        )
    docs = sorted({doc for config in phase.loops.values() for doc in config.docs})
    lines = [
        "# The denominator of `sections clean / sections total`, frozen for the",
        "# phase. Written by `harness/hj baseline-take`, read by everything else.",
        "#",
        "# It is here rather than in `state/` because the section list is parsed",
        "# from headings in documents the conformance loop may edit, and a loop",
        "# that could re-derive its own denominator could merge two dirty",
        "# sections into one clean one and move the score without touching a line",
        "# of code (`design/loops.md` section 7).",
        "",
        f"phase = {toml_string(phase.phase)}",
        f"taken = {toml_string(now())}",
        f"commit = {toml_string(head_sha())}",
        "",
    ]
    for doc in docs:
        anchors = [section.anchor for section in sections_of(doc)]
        lines.append(f"[doc.{toml_string(doc)}]")
        lines.append("anchors = [")
        lines += [f"  {toml_string(anchor)}," for anchor in anchors]
        lines.append("]")
        lines.append("")
        print(f"baseline: {doc}: {len(anchors)} sections")
    BASELINE.write_text("\n".join(lines))
    print(f"baseline: written to {BASELINE.relative_to(REPO)} for phase {phase.phase}")
    return 0


def cmd_baseline_drift(args: argparse.Namespace) -> int:
    phase = load_phase()
    docs = sorted({doc for config in phase.loops.values() for doc in config.docs})
    drift = baseline_drift(docs)
    for line in drift:
        print(f"baseline: {line}")
    if not drift:
        print("baseline: the documents match the baseline")
    return 0


def cmd_audit_plan(args: argparse.Namespace) -> int:
    """Coverage by rotation, not by checklist (`design/loops.md` section 3):
    the sections the last campaign touched, plus the least recently audited
    slice of the rest."""
    _, config = loop_config(args.loop)
    targets: list[str] = []
    for campaign in campaigns_of(args.loop):
        if campaign.get("target"):
            targets.append(campaign["target"])
    # A target may name several related sections, comma-separated. All of them
    # are what the last campaign touched, so all of them are what this audit
    # has to re-examine — auditing one of a pair would report half a result.
    recent_targets = {
        anchor.strip() for target in targets[-1:] for anchor in target.split(",") if anchor.strip()
    }

    # `rotation` is a budget for the whole audit, not per document. It used to
    # be applied inside this loop, so it silently multiplied by the number of
    # documents: adding a second doc turned `rotation = 18` into 36 sections
    # plus targets. The staleness order is therefore global — the least
    # recently audited sections anywhere, which is what the setting says and
    # what stays true when a third document is added.
    touched: list[str] = []
    pool: list[tuple[tuple[str, str], str]] = []
    for doc in config.docs:
        verdicts = read_audit(doc)
        for section in sections_of(doc):
            if section.key in recent_targets:
                touched.append(section.key)
                continue
            verdict = verdicts.get(section.key)
            last_audited = verdict.last_audited or "" if verdict else ""
            pool.append(((last_audited, section.anchor), section.key))
    pool.sort()
    planned = touched + [key for _, key in pool[: config.rotation]]
    for key in planned:
        print(key)
    return 0


TOML_FENCE = re.compile(r"```toml\s*\n(.*?)\n```", re.DOTALL)


def cmd_audit_merge(args: argparse.Namespace) -> int:
    """Take the auditor's verdict and write it into `state/audit/`.

    The auditor cannot edit anything (`design/loops.md` section 5), so the
    file is written here, from what it reported, after validation. A verdict
    naming a section that does not exist is rejected rather than recorded —
    a hallucinated anchor would otherwise become a permanent work item.
    """
    _, config = loop_config(args.loop)
    raw = Path(args.transcript).read_text()
    blocks = TOML_FENCE.findall(raw)
    if not blocks:
        die("the auditor produced no ```toml block; nothing to merge")
    try:
        reported = tomllib.loads(blocks[-1])
    except tomllib.TOMLDecodeError as error:
        die(f"the auditor's toml block does not parse: {error}")

    index = section_index(config.docs)
    stamp = now()
    previous_gaps = open_gap_ids(config.docs)
    problems: list[str] = []
    fresh: dict[str, SectionVerdict] = {}
    for key, table in reported.get("section", {}).items():
        if key not in index:
            problems.append(f"unknown section {key!r}")
            continue
        state = table.get("state")
        if state not in VALID_STATES:
            problems.append(f"{key}: state {state!r} is not one of {VALID_STATES}")
            continue
        stamp_commit = head_sha()
        gaps = [
            Gap(
                g.get("claim", ""),
                g.get("found", ""),
                g.get("where", ""),
                g.get("found_at") or stamp_commit,
            )
            for g in table.get("gap", [])
        ]
        minors = [Minor(m.get("claim", ""), m.get("note", ""), m.get("where", "")) for m in table.get("minor", [])]
        if state == "gaps" and not gaps:
            problems.append(f"{key}: state is 'gaps' but no gap is listed")
            continue
        if state == "clean" and gaps:
            problems.append(f"{key}: state is 'clean' but gaps are listed")
            continue
        fresh[key] = SectionVerdict(key, state, stamp, gaps, minors)

    if problems:
        for problem in problems:
            print(f"hj audit-merge: rejected: {problem}", file=sys.stderr)
        if not args.partial:
            return 1

    for doc in config.docs:
        known = sections_of(doc)
        verdicts = read_audit(doc)
        for section in known:
            if section.key in fresh:
                verdicts[section.key] = fresh[section.key]
            elif section.key not in verdicts:
                verdicts[section.key] = SectionVerdict(section.key, "unjudged", None)
        order = [s.key for s in known]
        write_audit(doc, {k: verdicts[k] for k in order}, order)

    # Only sections this run actually looked at can have closed a gap; a gap in
    # a section the rotation did not reach is neither open nor closed, it is
    # simply unexamined.
    audited = set(fresh)
    before = {
        identifier: value
        for identifier, value in previous_gaps.items()
        if value[0] in audited
    }
    after = {
        identifier: value
        for identifier, value in open_gap_ids(config.docs).items()
        if value[0] in audited
    }
    closed = {identifier: before[identifier][0] for identifier in set(before) - set(after)}
    append_jsonl(
        GAP_LOG,
        {
            "ts": stamp,
            "commit": head_sha(),
            "sections_audited": sorted(audited),
            "opened": sorted(set(after) - set(before)),
            "closed": sorted(closed),
            # The section each closed gap was in, which `closed` cannot say: an
            # id is a hash of the section and the claim, and a gap that has
            # closed is no longer in the audit to look up. Attribution by named
            # gap needs it (`gap_attribution`), so it is recorded at the one
            # moment it is still knowable. Additive — `closed` stays as it was,
            # because rows written before this exist and are the record.
            "closed_gaps": [
                {"id": identifier, "section": closed[identifier]} for identifier in sorted(closed)
            ],
            "persisted": len(set(before) & set(after)),
        },
    )
    settled = settle_progress(config, stamp, sorted(audited), closed)
    commit_harness_state(
        [audit_path(doc) for doc in config.docs] + [GAP_LOG] + ([sessions_path()] if settled else []),
        f"audit of {', '.join(config.docs)}",
    )
    ledger = gap_ledger(config.docs)
    print(
        f"audit: {ledger['gaps_closed']} gaps closed of {ledger['gaps_found']} found, "
        f"{ledger['gaps_open']} still open"
    )
    counts = audit_counts(config.docs)
    print(
        f"audit: {counts['sections_clean']}/{counts['sections_total']} sections clean, "
        f"{counts['sections_unjudged']} unjudged, {counts['open_gaps']} open gaps, "
        f"{counts['audit_minors']} minor items"
    )
    return 0


def cmd_check_audit(args: argparse.Namespace) -> int:
    """Gate step: every open gap names a document anchor that exists."""
    phase = load_phase()
    docs = sorted({doc for config in phase.loops.values() for doc in config.docs})
    failures = 0
    for doc in docs:
        known = {f"{doc}#{anchor}" for anchor in anchors_of(doc)}
        for key, verdict in read_audit(doc).items():
            if key not in known:
                print(f"audit: {key} no longer exists in design/{doc}", file=sys.stderr)
                failures += 1
    return 1 if failures else 0


def cmd_check_links(args: argparse.Namespace) -> int:
    """Every `](#anchor)` in a design document reaches a heading in it.

    A dangling cross-reference is Class A spec drift, and the cheapest kind to
    find mechanically — which is what `design/loops.md` section 5 means by
    converting an audit finding into a permanent check.
    """
    docs = args.doc or sorted(path.name for path in DESIGN.glob("*.md"))
    failures = 0
    for doc in docs:
        known = anchors_of(doc)
        text = doc_path(doc).read_text()
        for anchor in sorted(set(re.findall(r"\]\(#([a-z0-9_-]+)\)", text))):
            if anchor not in known:
                print(f"links: design/{doc} points at #{anchor}, which is not a heading", file=sys.stderr)
                failures += 1
    if failures:
        return 1
    print(f"links: every internal link resolves, across {len(docs)} document(s)")
    return 0


def cmd_check_scope(args: argparse.Namespace) -> int:
    phase, config = loop_config(args.loop)
    denied = denied_paths(phase, args.loop)
    if args.rev:
        # Forensics on an existing commit. A commit without this loop's
        # `loop:` trailer is a human's, and ownership does not apply to it —
        # the check that matters is the one on the pending commit below,
        # which has no trailer to consult and therefore always runs.
        owner = trailers_of(args.rev).get("loop")
        if owner != args.loop:
            print(f"scope: {args.rev} carries no `loop: {args.loop}` trailer; ownership does not apply")
            return 0
    paths = commit_paths(args.rev) if args.rev else working_tree_paths()
    violations = []
    for path in paths:
        if matches_any(path, denied):
            violations.append((path, "denied to every loop in this phase"))
        elif not matches_any(path, config.write):
            violations.append((path, f"outside {args.loop}'s owned paths"))
    for path, reason in violations:
        print(f"scope: {path}: {reason}", file=sys.stderr)
    if violations:
        print(
            f"scope: {len(violations)} path(s) this loop does not own. "
            "Revert them, or escalate as a decision (design/loops.md section 6).",
            file=sys.stderr,
        )
        return 1
    print(f"scope: {len(paths)} path(s), all owned by {args.loop}")
    return 0


def last_loop_commit(owner: str, limit: int = 40) -> str | None:
    """The most recent commit this loop authored.

    Not `HEAD`: the harness commits its own rows, the dashboard commits an
    answer, and either can land between a campaign's `git commit` and its
    `harness/hj record`. `record` and `check-metrics` both need the same
    answer to the same question, and keying one on `HEAD` and the other on
    this walk-back is what made them disagree (`conformance-007`). Deriving
    both from here makes an interleaved commit harmless rather than something
    to be careful about — which matters because no amount of care helps: the
    interleaving commit may be a human answering a decision.
    """
    for sha in git("log", "--format=%H", f"-{limit}", "HEAD").split():
        if trailers_of(sha).get("loop") == owner:
            return sha
    return None


def cmd_check_path(args: argparse.Namespace) -> int:
    """One path, for the `PreToolUse` hook. Fast feedback and **not a
    boundary**: deny rules cover Claude's file tools and not bash
    subprocesses, so anything this blocks is reachable through `sh -c`. The
    gate's diff-scope check is what actually enforces
    (`design/loops.md` section 13)."""
    phase, config = loop_config(args.loop)
    denied = denied_paths(phase, args.loop)
    failed = False
    for raw in args.path:
        path = Path(raw)
        try:
            relative = str(path.resolve().relative_to(REPO))
        except ValueError:
            print(f"{raw} is outside the repository", file=sys.stderr)
            failed = True
            continue
        if matches_any(relative, denied):
            print(f"{relative} is denied to {args.loop} in phase {phase.phase}.", file=sys.stderr)
            failed = True
        elif not matches_any(relative, config.write):
            print(
                f"{relative} is outside {args.loop}'s owned paths, so the gate would "
                "reject the commit. If you need it, that is a decision record, not a "
                "workaround.",
                file=sys.stderr,
            )
            failed = True
    return 1 if failed else 0


def cmd_check_metrics(args: argparse.Namespace) -> int:
    """Gate step: the previous iteration recorded its row, and the numbers in
    it are going the right way.

    The row check is against HEAD rather than the pending commit, because the
    row keys on a commit that does not exist until after the gate passes. A
    commit carrying this loop's `campaign:` trailer and no metrics row means
    `harness/hj record` was skipped, and the history has a hole in it.

    The direction check is against the working tree, because that is what is
    about to be committed and the point is to refuse it. `design/loops.md` §7
    puts "the gate checks metric direction itself" behind the row that a
    metric regression can be snapshot-accepted; without it, the gate read the
    metrics file only to ask whether a line existed.
    """
    phase, config = loop_config(args.loop)
    target = last_loop_commit(config.owner)
    if target is None:
        print("metrics: this loop has no commit in recent history; nothing to check")
    else:
        recorded = {row.get("commit") for row in read_jsonl(metrics_path(config.owner))}
        if target not in recorded:
            print(
                f"metrics: no row for {target[:12]}; run `harness/hj record {args.loop}`",
                file=sys.stderr,
            )
            return 1
        print(f"metrics: {target[:12]} is recorded")
    # The test-count ratchet only. The size ratchet ran here too while step 5
    # of `harness/gate` hard-failed in a cost phase, since that file is denied
    # to every loop; `harness-008` is answered and step 5 now calls
    # `hj check-ratchets`, so this stops being the second route to it.
    #
    # The test ratchet stays because it is not the same mechanism: §4 scopes the
    # gate's ratchets step to §11's *size* ratchets in phase 3, and §7's test
    # count is a per-commit check that belongs with the metrics row it is
    # computed from.
    #
    # The prompt check is here for the reason the size ratchet was: `harness/gate`
    # is denied to every loop, so a check with no step of its own goes in the
    # step whose subject it shares. §15's token lever is a cost measurement,
    # and this is the step that asserts a measurement is going the right way.
    # Both, never short-circuited: two failures reported at once cost one gate
    # run instead of two.
    failed = check_test_ratchet(config)
    failed = check_prompt_prefix(config, phase) or failed
    failed = check_prompt_leaks(config, phase) or failed
    failed = check_denial_table(config) or failed
    # Not scoped to `writes_harness`, unlike the two above it. Those read a
    # document only one loop is judged on; this reads `state/phase.toml`, which
    # is denied to every loop — so every live branch satisfies it and no branch
    # can be failed for something it is forbidden to fix (`harness-011`).
    failed = check_one_loop_per_language(phase) or failed
    return 1 if failed else 0


def cmd_check_ratchets(args: argparse.Namespace) -> int:
    """`harness/gate` step 5.

    It was written before the step could call it: the step hard-failed in a
    cost phase with "the phase ratchets are not implemented", which stopped
    being true once `hj size` and the re-baselining existed, and
    `harness/gate` is denied to every loop — so this ran from `check-metrics`
    meanwhile. `harness-008` answered that, the step now calls this, and
    `check-metrics` no longer does: the size ratchet has one route again.
    """
    phase, config = loop_config(args.loop)
    if phase.phase not in SIZE_RATCHET_PHASES:
        print(f"size: not gated in phase {phase.phase} (design/loops.md section 11)")
        return 0
    return check_size_ratchet(config, phase)


# --------------------------------------------------------------------------
# §10's other dimension: "metrics still per (language, server)".
#
# A language is still one loop and one metrics file — `#several-servers-do-not-
# mean-several-loops` argues that out at length, and the earlier revision that
# gave each server its own loop produced "a loop with almost no legal move".
# What the section keeps from the split is an *evaluation* rule, and it is the
# rule that decides this row's shape:
#
# * Shared handler logic is evaluated "on the positions where *every* server
#   for that language agrees … and it is **the frontier** — one per language,
#   still 2D". That is the unprefixed surface below, and it is the only one
#   `frontier_axes_of` ever sees.
# * A `ServerProfile` is evaluated "on the positions where servers differ,
#   against that server alone", and those numbers are "*reported beside* the
#   frontier, the same treatment containment and result count get". That is
#   `servers` below.
#
# What the harness deliberately does not do is synthesise the first from the
# second. The agreement subset is a join over positions, which only
# `measure_core` can compute — it is the thing that enumerates them once per
# language precisely so the servers' answers are joinable (`positions.rs`). Two
# servers' aggregate reports merged here would be the average the section says
# never to take, and it would be an average wearing a frontier point's clothes.
# So with two servers and no agreement report the row carries no frontier
# position at all, and `record` says why.
#
# For a language with one usable server — Rust, Go — "every position is
# trivially unanimous, there is no profile, and none of this machinery does
# anything", so that server's own surface *is* the shared one and is promoted
# to it. That is the section's stated intended behaviour rather than a special
# case, and it is what keeps a single-server row identical in shape to every
# row recorded before this existed.


def servers_for_language(language: str) -> list[str]:
    """The `servers.toml` keys that serve one language, in name order.

    Empty for a language the matrix does not name, and empty when the file is
    absent — which is what a checkout without the corpus repository beside it
    looks like. Both are reported by the caller rather than treated as "no
    server named is fine", since a run that produced numbers against something
    is a run whose something has a name.
    """
    if not SERVERS.exists():
        return []
    table = tomllib.loads(SERVERS.read_text()).get("server") or {}
    return sorted(
        name
        for name, entry in table.items()
        if isinstance(entry, dict) and language in (entry.get("languages") or [])
    )


def replay_source(value: str) -> tuple[str | None, str]:
    """`--replay-report PATH`, or `--replay-report <server>=PATH`.

    A `servers.toml` key never contains `/`, and a path routinely does, so a
    path with an `=` in it is not mistaken for a prefix.
    """
    server, separator, rest = value.partition("=")
    if separator and server and "/" not in server:
        return server, rest
    return None, value


def replay_surfaces(args: argparse.Namespace) -> dict[str | None, dict]:
    """`record`'s replay arguments, grouped by the server each was run against.

    `None` is the shared surface. Three arguments per surface because
    `measure replay` writes two files — `--format json` on stdout and
    `--records <path>` beside it — and knows the duration of neither:
    `measure_core` keeps every clock out of the table it prints, so the wall
    clock is only ever known to whoever ran it.
    """
    grouped: dict[str | None, dict] = {}
    for attribute, key in (
        ("replay_report", "report"),
        ("replay_records", "records"),
        ("replay_seconds", "seconds"),
    ):
        for value in getattr(args, attribute, None) or []:
            server, rest = replay_source(str(value))
            grouped.setdefault(server, {})[key] = rest
    return grouped


def replay_argument_problems(
    surfaces: dict[str | None, dict], language: str | None
) -> list[str]:
    """What is wrong with `record`'s replay arguments, before any row is written.

    Server names are checked rather than trusted because the failure is silent
    otherwise: a typo'd name is a new series that looks like a server nobody
    has replayed in a while, and the row it lands in is indistinguishable from
    a real one. `servers.toml` is in no loop's write list — it "names the
    oracle every language loop is scored against" — which is what makes it the
    place to learn the names from rather than a second list here.

    The duration is checked in the same pass because `--replay-seconds` stopped
    being `type=float` when it gained a prefix, and an argument that used to
    fail in argparse must not start failing in the middle of `record` with the
    row half built.
    """
    problems = []
    for name, surface in sorted(surfaces.items(), key=lambda pair: pair[0] or ""):
        seconds = surface.get("seconds")
        if seconds is not None:
            try:
                float(seconds)
            except ValueError:
                where = f"{name}=" if name else ""
                problems.append(f"--replay-seconds {where}{seconds} is not a number")
    named = sorted(name for name in surfaces if name is not None)
    if not named:
        return problems
    if not language:
        return problems + [
            f"{name}: this loop declares no language, so there is no server matrix "
            "to resolve it against"
            for name in named
        ]
    known = servers_for_language(language)
    if not known:
        return problems + [
            f"{name}: servers.toml names no server for {language}" for name in named
        ]
    return problems + [
        f"{name}: not a servers.toml server for {language} ({', '.join(known)})"
        for name in named
        if name not in known
    ]


def digest_surface(surface: dict) -> dict:
    """One surface's half of §10's row, out of what `measure replay` wrote.

    Absent rather than null when nothing ran, which is the same rule `binary`
    already follows: a row from before this existed and a row from a commit
    nobody replayed are the same shape, and neither is the same shape as a row
    that measured and found nothing.
    """
    fields: dict = {}
    strata: list[dict[str, dict]] = []
    if surface.get("report"):
        report = json.loads(Path(surface["report"]).read_text())
        strata.append(report_strata(report))
        if isinstance(report.get("uncollected"), int):
            fields["uncollected"] = report["uncollected"]
    if surface.get("records"):
        digest = replay_digest(read_jsonl(Path(surface["records"])))
        strata.append(digest.pop("strata"))
        fields["replay"] = digest
    if surface.get("seconds") is not None:
        fields.setdefault("replay", {})["wall_clock_seconds"] = float(surface["seconds"])
    if strata:
        fields["strata"] = merge_strata(*strata)
    return fields


def replay_row_fields(shared: dict, named: dict[str, dict]) -> dict:
    """§10's replay half, assembled from surfaces that have already been digested.

    Separate from the digesting so that what the section actually decides —
    which surface the frontier reads — is one short function rather than
    something only a corpus run can exercise.
    """
    if not shared and len(named) == 1:
        # Deep-copied rather than aliased, so that a later edit to the row does
        # not reach into the per-server entry it was promoted from and leave
        # two fields that are supposed to be independent sharing one dict.
        shared = json.loads(json.dumps(next(iter(named.values()))))
    return dict(shared, servers=named) if named else shared


def replay_fields(surfaces: dict[str | None, dict]) -> dict:
    """The half of §10's row that a corpus run produces, when one has run."""
    return replay_row_fields(
        digest_surface(surfaces.get(None) or {}),
        {
            name: digest_surface(surface)
            for name, surface in sorted(surfaces.items(), key=lambda pair: pair[0] or "")
            if name is not None
        },
    )


def cmd_record(args: argparse.Namespace) -> int:
    phase, config = loop_config(args.loop)
    surfaces = replay_surfaces(args)
    problems = replay_argument_problems(surfaces, config.language)
    if problems:
        for problem in problems:
            print(f"metrics: {problem}", file=sys.stderr)
        print(
            "metrics: design/loops.md section 10 keeps metrics per (language, server), "
            "so a `<server>=` prefix has to name a server the matrix has. Nothing was "
            "appended.",
            file=sys.stderr,
        )
        return 1
    target = last_loop_commit(config.owner) or head_sha()
    if target in {row.get("commit") for row in read_jsonl(metrics_path(config.owner))}:
        print(f"metrics: {target[:12]} is already recorded; nothing appended")
        return 0
    members = owned_members(config)
    loc, loc_counter = loc_per_crate()
    row = {
        "commit": target,
        "ts": now(),
        "phase": phase.phase,
        "loop": config.owner,
        "campaign": trailers_of(target).get("campaign"),
        **audit_counts(config.docs),
        "loc": loc,
        "loc_counter": loc_counter,
        "tests": test_count(members),
        # Flagged rather than gated, and recorded rather than only printed:
        # the gate says it to a transcript nobody reads twice, and §7 wants
        # deletions visible "regardless of count" — which means visible to
        # whoever reads the history, not to the campaign that did it.
        "tests_removed": removed_tests_in(target, crate_paths(config))[:20],
        "provisional_decisions": provisional_decisions(),
    }
    row.update(replay_fields(surfaces))
    # The one case where a row that measured plenty still carries no frontier
    # position. Said out loud because the alternative is a series that silently
    # stops producing points, which reads exactly like a loop that stopped
    # making progress.
    if "servers" in row and "strata" not in row:
        print(
            "metrics: "
            + ", ".join(sorted(row["servers"]))
            + " were replayed and none of them is the shared surface, so this row "
            "carries no frontier position. design/loops.md section 10 puts the "
            "frontier over the positions where every server agrees and says never to "
            "average two servers, and the agreement subset is a join over positions "
            "that only `measure replay` can compute. Pass it unprefixed when it "
            "exists.",
            file=sys.stderr,
        )
    # §11's first of two numbers, and the only one a loop can compute in
    # isolation. Absent for a loop with no language rather than null, so that a
    # row from before this existed and a row that could not measure are not the
    # same shape as one that measured nothing.
    for package in measure_packages(config):
        measured = binary_size(package)
        if measured is not None:
            row["binary"] = measured
            # §11: being an order of magnitude out is "worth knowing within a
            # campaign rather than at a gate". Said here, where the number is
            # taken, and again by `harness/loop` between campaigns — which is
            # where the stop actually happens.
            ceiling = phase.guardrail.get("measure_binary_bytes")
            if ceiling is not None and measured["stripped"] > ceiling:
                print(
                    guardrail_warning(
                        f"{measured['binary']} is {measured['stripped']} bytes", ceiling
                    ),
                    file=sys.stderr,
                )
    # §11's other ceiling, said here for the same reason and from the same row.
    # It is the replay that just ran rather than the history, so a campaign
    # hears about the query it made pathological before the next one starts.
    query_ceiling = phase.guardrail.get("query_micros")
    worst = worst_stratum_query_micros(row)
    if query_ceiling is not None and worst is not None and worst[0] > query_ceiling:
        print(
            guardrail_warning(f"{worst[1]} answers at {worst[0]}us p99", query_ceiling),
            file=sys.stderr,
        )
    append_jsonl(metrics_path(config.owner), row)
    commit_harness_state([metrics_path(config.owner)], f"metrics row for {target[:8]}")
    print(json.dumps(row, sort_keys=True))
    return 0


def measurable_packages() -> list[str]:
    return sorted(
        name for name in workspace_members() if name.startswith("measure_") and binary_targets(name)
    )


def cmd_size(args: argparse.Namespace) -> int:
    """§11's proxy, on demand.

    `record` carries it for a loop that declares a language; this measures any
    `measure_<lang>` in the workspace, which is what makes the number reachable
    during a phase that has no tuning loop in it yet — and what lets a
    conformance campaign see what its change to `shared` did to the constant
    every language loop will later carry.
    """
    packages = [args.package] if args.package else measurable_packages()
    if not packages:
        print("size: no measure_<lang> package with a binary target in this workspace")
        return 0
    for package in packages:
        measured = binary_size(package)
        if measured is None:
            print(f"size: {package} could not be measured (no strip, or the build failed)")
            continue
        line = f"size: {measured['binary']} {measured['stripped']} bytes stripped"
        crates = measured.get("crates") or {}
        if crates:
            top = sorted(crates.items(), key=lambda item: -item[1])[:8]
            line += "; " + ", ".join(f"{name} {size}" for name, size in top)
        else:
            line += "; no per-crate attribution (cargo-bloat is not installed)"
        print(line)
    return 0


def cmd_link_delta(args: argparse.Namespace) -> int:
    """§11's authoritative size number, which belongs at a phase gate.

    Non-zero when a language's line item cannot be taken, because the whole
    point of per-language billing is that "each language then has its own line
    item rather than a workspace aggregate nobody can influence" — and an
    unmeasurable language is an aggregate again. It is not wired into
    `harness/gate`: that file is denied to every loop, and the number is a
    gate's rather than an iteration's, so a human runs it or `harness-008`
    settles where it goes.
    """
    rows = link_deltas()
    if not rows:
        print(f"link-delta: no lang_* crate, or no {SHIPPED_PACKAGE}, in this workspace")
        return 0
    unmeasured = 0
    for row in rows:
        if row["delta"] is None:
            unmeasured += 1
            print(f"link-delta: {row['language']}: unmeasured — {row['reason']}", file=sys.stderr)
        else:
            print(
                f"link-delta: {row['language']}: {row['delta']} bytes "
                f"({row['whole']} with, {row['without']} without)"
            )
    if unmeasured:
        print(
            "         design/loops.md section 11 measures binary size as a delta, built "
            f"with and without each lang_* linked. That needs {SHIPPED_PACKAGE} to carry "
            "one optional dependency per language behind a `lang-<x>` feature, all of "
            "them in `default`.",
            file=sys.stderr,
        )
    return 1 if unmeasured else 0


def fragment(config: LoopConfig, name: str) -> str:
    """Spliced into the prompt, so it follows the prompt's own source.

    Reading fragments from a different checkout than the template they land in
    would give a campaign a reviewed prompt with its own branch's fragments, or
    the reverse — one prompt assembled from two trees, and `template_sha` would
    name only half of it.
    """
    return (prompts_dir(config) / "fragments" / f"{name}.md").read_text().rstrip("\n")


def render(template: str, values: dict[str, str]) -> str:
    """`{{name}}` is substituted at launch, from the source file, so there is
    one copy of every rule and it is the original
    (`design/loops.md` section 14)."""
    missing: list[str] = []

    def replace(match: re.Match[str]) -> str:
        name = match.group(1).strip()
        if name not in values:
            missing.append(name)
            return match.group(0)
        return values[name]

    out = re.sub(r"\{\{([^}]+)\}\}", replace, template)
    if missing:
        die(f"prompt template has no value for: {', '.join(sorted(set(missing)))}")
    return out


# `design/loops.md` §14: "Every past campaign as one line — target,
# hypothesis, outcome." The first and the last are in the session row; the
# hypothesis is only ever in the campaign record, because it is the one part a
# campaign writes in prose. Long enough to say which idea was tried and short
# enough that forty of them are still a list rather than a document.
HYPOTHESIS_CAP = 200
HYPOTHESIS_HEADING = re.compile(r"^#{2,3}\s+Hypothesis\s*$", re.MULTILINE)
NEXT_HEADING = re.compile(r"^#{1,3}\s+\S", re.MULTILINE)
HTML_COMMENT = re.compile(r"<!--.*?-->", re.DOTALL)


def hypothesis_of(record: str) -> str:
    """The first paragraph under a campaign record's `## Hypothesis`.

    Empty when the section is missing or still holds the template's comment,
    and that is the useful answer rather than a defect: a campaign that wrote
    no hypothesis has none to report, and inventing one from its target would
    put words in its mouth that the next campaign would read as evidence.
    """
    heading = HYPOTHESIS_HEADING.search(record)
    if heading is None:
        return ""
    rest = record[heading.end() :]
    following = NEXT_HEADING.search(rest)
    body = HTML_COMMENT.sub("", rest[: following.start()] if following else rest).strip()
    if not body:
        return ""
    paragraph = " ".join(body.split("\n\n")[0].split())
    if len(paragraph) <= HYPOTHESIS_CAP:
        return paragraph
    cut = paragraph[:HYPOTHESIS_CAP].rsplit(" ", 1)[0]
    return f"{cut}…"


def campaign_hypothesis(owner: str, campaign: dict) -> str:
    """`hypothesis_of` against the record a session row points at.

    The row carries the path, so a record that moved is followed rather than
    guessed at; the fallback is the layout `campaign-open` writes, for rows
    written before the field existed.
    """
    identifier = str(campaign.get("campaign") or "")
    relative = campaign.get("record") or f"state/campaigns/{owner}/{identifier}.md"
    path = REPO / str(relative)
    if not path.is_file():
        return ""
    return hypothesis_of(path.read_text())


def judged_campaigns(owner: str) -> list[dict]:
    """Closed campaigns that actually ran.

    A crashed campaign is not evidence that the loop cannot make progress —
    it is evidence that something killed it, which is a different failure with
    a different remedy. Counting it toward the stall threshold means an
    interrupted run silently spends the loop's patience: reaping one orphan
    here took the count from 2 to 3 and would have made the next campaign
    write a handoff instead of working.

    A loop that keeps crashing still needs to surface, but as its own signal
    rather than folded into this one.
    """
    return [
        c
        for c in campaigns_of(owner)
        if c.get("outcome")
        and c.get("outcome") != "crashed"
        # A campaign that closed with no audit since it opened made no
        # *measured* progress, which is not the same as making none. Counting
        # it toward the stall threshold would let the audit cadence stop the
        # loop: with audit_every = stall_n, two unmeasured campaigns and one
        # flat one is a stall that never happened.
        and not (c.get("audited") is False and not c.get("progress"))
    ]


def tagged_sites(identifier: str) -> list[str]:
    """The files an answered decision still has to be reconciled in, spliced
    into the next prompt. `harness/` is in scope deliberately — excluding it
    made an answered harness decision reach its own loop's prompt carrying no
    sites at all — and the fixtures in this file's selftest region are not,
    which is `provisional_tag_sites`'s job to know rather than this one's."""
    files = []
    for path, _ in provisional_tag_sites(identifier):
        if path not in files:
            files.append(path)
    return files[:20]


def trailing_without_progress(owner: str) -> int:
    trailing = 0
    for campaign in reversed(judged_campaigns(owner)):
        if campaign.get("progress"):
            break
        trailing += 1
    return trailing


def assignment_block(owner: str, worker: str, campaign: str = "<your id>") -> str:
    """What a planner gave this worker, for the top of its prompt.

    Empty for a loop that runs one campaign at a time, which is every loop
    without workers — the gap list below is then the whole of the choice.
    """
    table = assignment_for(owner, worker)
    if not table:
        return ""
    targets = table.get("targets") or []
    if not targets:
        return (
            "## Your assignment this round\n\n"
            "**Nothing was assigned to you.** That is a real answer rather than an\n"
            "oversight: the planner found no target left that does not overlap\n"
            f"another worker's files. {table.get('why', '')}\n\n"
            "Pick the cheapest unjudged section instead, or close `no-movement`\n"
            "immediately — a session spent inventing work costs the same as one\n"
            "spent doing it."
        )
    lines = [
        "## Your assignment this round",
        "",
        "A planner divided this round between the workers, so that no two of you",
        "open the same file. **Work these and not the wider gap list below**, which",
        "is here for context and for the ids:",
        "",
    ]
    lines += [f"- `{target}`" for target in targets]
    if table.get("why"):
        lines += ["", f"Why these together: {table['why']}"]
    if table.get("reading"):
        lines += [
            "",
            f"Expected reading: `{table['reading']}`. If the work takes you well",
            "outside that, say so at close — the planner believed it was disjoint,",
            "and a wrong belief there is what makes two workers collide.",
        ]
    lines += [
        "",
        "**Step 4 needs a claim this round.** Extending *within* this assignment",
        "is free — it is already yours. Reaching outside it is not, because the",
        "cheap targets are the ones another worker is holding and you cannot see",
        "which. Ask first:",
        "",
        f"    harness/hj claim {owner} --campaign {campaign} '<anchor[id]>'",
        "",
        "It grants or refuses. A refusal is not a setback and costs you one turn:",
        "take a different target, or close. What it prevents is two campaigns",
        "producing one result and a merge conflict somebody then has to resolve,",
        "which costs both of them.",
    ]
    return "\n".join(lines)


# `design/loops.md` §13 and §14: the digest is "capped like the findings
# digest", and the cap is the mechanism rather than a style note — to add
# something you have to decide what no longer earns its place, which is
# synthesis rather than accumulation. Instructed since the first campaign and
# measured by nothing until now, at which point three of five digests were
# over it and the largest was 632 words.
DIGEST_WORD_CAP = 512


def digest_note(words: int) -> str:
    """What the prompt says above a worker's own digest.

    Reported to the loop rather than gated. A campaign writes its digest at
    close, after its last gate run, so a gate check would fail the *next*
    campaign for its predecessor's overrun — and the fix is a trim only the
    author's context makes well.
    """
    if words == 0:
        return "You have not written one yet. Writing it is part of your close."
    if words <= DIGEST_WORD_CAP:
        return f"It is {words} words against a cap of {DIGEST_WORD_CAP}."
    return (
        f"**It is {words} words, over the {DIGEST_WORD_CAP}-word cap by "
        f"{words - DIGEST_WORD_CAP}.** Bringing it back under is part of this close, and "
        "the cap is the mechanism rather than a formatting rule: what has to be decided "
        "to get back under it is which conclusion no longer earns its place, and nothing "
        "else in this loop forces that decision."
    )


def worker_findings(owner: str, worker: str) -> str:
    """This worker's digest, followed by its siblings'.

    The digest started shared between workers, on the argument that three
    theories of one implementation is the same synthesis done three times. The
    argument is right and the mechanism was wrong: three branches rewriting one
    capped file conflict on every merge, and "last write wins" is a thing git
    does not do — it stops and asks.

    So each worker keeps its own and reads the others'. That is honest about
    what is actually true — three workers do have three views — and it keeps
    the cross-worker learning the shared file was for, at the cost of splicing
    two more capped files.
    """
    directory = STATE / "findings"
    own = directory / f"{worker}.md"
    parts = []
    if own.exists():
        parts.append(own.read_text().strip())
    for path in sorted(directory.glob(f"{owner}-*.md")):
        if path.stem == worker:
            continue
        body = path.read_text().strip()
        if body:
            parts.append(f"### What {path.stem} concluded\n\n{body}")
    return "\n\n".join(parts)


def digest_sources(other: str, owners: set[str], files: dict[str, str]) -> list[tuple[str, str]]:
    """Which files are the `other` loop's published digest, `(name, body)`.

    A loop with workers has no loop-level digest and cannot get one: §13's
    "What is per worker and what is shared" moved the file per worker because
    three branches rewriting one capped file conflict on every merge. So
    `state/findings/core.md` stopped being written the day `core` went to
    three workers, and reading it published a fossil — a day stale against
    three current files — to every other loop in the fleet.

    The loop's digest is therefore its workers' digests when it has any, and
    its own file only when it has none. Not both: the owner file survives on
    disk after the split and is exactly the thing that should not be read.

    Pure, and takes the directory listing rather than reading it, so the
    resolution is fixtured on cases the live tree does not currently hold —
    a loop that has workers but no digest yet, a fossil beside a current
    file — instead of on whatever `state/findings/` happens to contain.
    """
    # A glob for `{other}-*` would also match a *loop* whose name starts with
    # another loop's; the phase's own owner list is what tells the two apart.
    workers = sorted(
        (name, body.strip())
        for name, body in files.items()
        if name.startswith(f"{other}-") and name not in owners and body.strip()
    )
    if workers:
        return workers
    body = files.get(other, "").strip()
    return [(other, body)] if body else []


def unjudged_sections(docs: list[str]) -> list[str]:
    """The sections a campaign may take that are not gaps.

    Two kinds, and the second is the one that is easy to lose: a section the
    audit reached and could not settle, and a section the audit has never
    reached at all. `design/loops.md` §5 makes the difference from clean
    visible on purpose, and a never-audited section is further from clean than
    an unjudged one rather than nearer.

    One definition, because it is now read twice — the prompt offers these as
    targets and `hj queue` decides on their absence whether the loop has
    anything left to do, and a queue that is empty for one reader and not for
    the other is two queues.
    """
    keys: set[str] = set()
    for doc in docs:
        verdicts = read_audit(doc)
        for section in sections_of(doc):
            verdict = verdicts.get(section.key)
            if verdict is None or verdict.state == "unjudged":
                keys.add(section.key)
    return sorted(keys)


def other_loop_findings(owners: list[str], owner: str) -> list[str]:
    """Every other *loop's* digest, for this loop's volatile tail.

    `design/loops.md` §13, "Campaigns compare notes, asymmetrically". Driven by
    the owners in `state/phase.toml` rather than by a bare glob over
    `state/findings/`, because a glob cannot tell a worker of one loop from a
    loop of its own — and the two are read differently: a sibling worker's
    digest is `worker_findings`' job, and a *different* loop's arrives here
    under the asymmetry heading, as a candidate rather than a result.

    §13's sizing — "a dozen loops, 512 words each" — is per loop, and a loop
    with N workers now spends N caps rather than one. That is the price of the
    alternative being nothing at all, and it is the same arithmetic §13 says
    stops working at phase 6, where thirty loops need a selection rule this
    phase deliberately does not guess at.

    The asymmetry §13 is named for — falsified broadcast plainly, confirmed
    published as a candidate — is not enforceable here, because it is a
    property of prose. It is carried in two places instead: the close
    instruction that tells a digest's *writer* to mark which is which, and the
    heading above this splice that tells its *reader* how the two differ.
    """
    directory = STATE / "findings"
    files = {path.stem: path.read_text() for path in sorted(directory.glob("*.md"))}
    digests = []
    for other in owners:
        if other == owner:
            continue
        sources = digest_sources(other, set(owners), files)
        if not sources:
            continue
        heading = f"### What the `{other}` loop concluded"
        if [name for name, _ in sources] == [other]:
            digests.append(f"{heading}\n\n{sources[0][1]}")
            continue
        # Named per worker rather than merged: three workers do have three
        # views (§13, "Workers"), and a reader deciding whether to test a
        # candidate wants to know that two of them agreed.
        bodies = "\n\n".join(f"#### {name}\n\n{body}" for name, body in sources)
        digests.append(
            f"{heading}\n\n`{other}` runs {len(sources)} workers, so its digest is "
            f"{len(sources)} digests and not one: the file is per worker because three "
            "branches rewriting one capped file conflict on every merge "
            '(`design/loops.md` §13, "What is per worker and what is shared"). They are '
            f"one loop's conclusions, and the asymmetry above applies to all of them.\n\n{bodies}"
        )
    return digests


def staleness_note(gap: Gap) -> str:
    """Whether the file this gap points at has moved since the audit saw it.

    The audit re-judges a rotation slice, so a gap closed by a commit
    afterwards keeps being handed out until its section comes round again. On
    `core.md` that was seven of nine (`state/decisions/core-019.md`), and
    campaigns were spending their opening turns proving gaps already closed.

    Mechanical and never a judgement: it compares `found_at` against the last
    commit touching the path in `where:`. It cannot say a gap *is* closed —
    that is the audit's job and costs what an audit costs — only which ones are
    worth one turn of checking before being taken as targets.
    """
    if not gap.found_at or not gap.where:
        return ""
    path = gap.where.split(":", 1)[0].strip()
    if not path or not (REPO / path).exists():
        return ""
    moved = git("log", "-1", "--format=%h", f"{gap.found_at}..HEAD", "--", path).strip()
    if not moved:
        return ""
    return f"  **{path} has changed since this was found ({moved}) — verify before taking it.**"


def stall_notice_for(stalled: int, stall_n: int) -> str:
    """What a campaign is told about the stall it is opening under.

    Above the threshold this is the last campaign the loop runs, and
    `design/loops.md` §7 wants an account out of it: what was being tried, what
    was tried, what is believed to be blocking, and the question. Two of those
    the harness can assemble and two only the campaign knows.

    It asks for the account in the *campaign record* rather than in
    `state/handoff.md`, which is the file §7 names. There is one writer for
    that file and it is `hj handoff`, which runs as the loop stops and
    overwrites — a stale handoff from an answered stall is worse than none,
    because the dashboard renders it as a live request. So the campaign writes
    where it already writes, and the loop quotes it.
    """
    if stalled < stall_n:
        return (
            f"Not stalled: {stalled} campaign(s) without progress, of {stall_n} that"
            " would stop this loop."
        )
    return (
        f"**This loop has stalled**: {stalled} campaigns have closed in a row with no\n"
        f"progress, and N is {stall_n}. This is the last campaign the loop will\n"
        "run before it stops and asks a human. **Do not pick a new target.**\n\n"
        "Write the account instead, in the Outcome section of your campaign record:\n"
        "what the loop was trying, what it tried, what you believe is blocking it, and\n"
        "the one question whose answer would unblock it. Then close with\n"
        "`OUTCOME: no-movement`.\n\n"
        "Put it in the record and **not** in `state/handoff.md`. The loop writes that\n"
        "file itself as it stops (`design/loops.md` §7 — the run of campaigns that\n"
        "stalled is the half only the loop can see), quoting your Outcome section\n"
        "verbatim for the half only you can. Anything written straight to\n"
        "`state/handoff.md` is overwritten and lost."
    )


def prompt_values(
    phase: Phase,
    config: LoopConfig,
    campaign_id: str,
    claimed: set[str] | None = None,
) -> dict[str, str]:
    gaps = open_gaps(config.docs)
    counts = audit_counts(config.docs)

    # Gaps a live worker is already on are removed rather than deprioritised.
    # Showing them ranked-but-taken invites exactly the duplicate work the
    # claim exists to prevent, and a worker cannot tell "someone has this" from
    # "this is unattractive" (`design/loops.md` §13, "Workers").
    taken = claimed or set()
    if taken:
        available = [pair for pair in gaps if gap_id(pair[0], pair[1].claim) not in taken]
        # Never hand out an empty list: if every open gap is claimed, the
        # unjudged sections are still work, and a campaign with nothing at all
        # would close `no-movement` and count against the stall.
        if available:
            gaps = available

    # Full detail for the gaps a campaign is most likely to take, one line for
    # the rest. The whole list was being resent every turn, and at the observed
    # 141:1 cache-read to output ratio the tail's size is the dominant cost of
    # a campaign — 34KB re-read across 79 turns, of which two gaps get used.
    # Ordered by how close their section is to going clean, which is the
    # preference the prompt already states.
    per_section: dict[str, int] = {}
    for key, _ in gaps:
        per_section[key] = per_section.get(key, 0) + 1
    ranked = sorted(gaps, key=lambda pair: (per_section[pair[0]], pair[0]))
    detailed, listed = ranked[: config.detail_gaps], ranked[config.detail_gaps :]

    gap_lines = [
        f"- {key}[{gap_id(key, gap.claim)}]\n  claim: {gap.claim}\n  found: {gap.found}\n"
        f"  where: {gap.where}" + (f"\n{staleness_note(gap)}" if staleness_note(gap) else "")
        for key, gap in detailed
    ]
    if listed:
        gap_lines.append(
            f"\nThe remaining {len(listed)}, one line each. Ask for the detail of any"
            " you take — it is in `state/audit/`, and `harness/hj section-text"
            " <anchor>` prints the section:"
        )
        gap_lines += [
            f"- {key}[{gap_id(key, gap.claim)}] {gap.claim[:110]}" for key, gap in listed
        ]
    gap_lines = gap_lines or [
        "- (none recorded; the audit has not run, or every audited section is clean)"
    ]

    index = section_index(config.docs)
    unjudged = unjudged_sections(config.docs)

    spliced_keys: list[str] = []
    for key, _ in gaps:
        if key not in spliced_keys:
            spliced_keys.append(key)
    spliced = [section_text(index[key]) for key in spliced_keys[: config.splice_sections] if key in index]

    campaign_lines = []
    for campaign in campaigns_of(config.owner):
        identifier = str(campaign.get("campaign") or "?")
        line = (
            f"- {identifier[:8]} {campaign.get('target') or '(no target recorded)'} "
            f"-> {campaign.get('outcome') or 'open'}"
        )
        why = campaign_hypothesis(config.owner, campaign)
        campaign_lines.append(f"{line}\n  why: {why}" if why else line)

    # Open records, and answered ones whose sites are still tagged. The second
    # kind matters as much as the first: `design/loops.md` section 6 makes
    # reconciling a tagged site a normal campaign target, and a campaign that
    # never learns the answer arrived will never pick it. An answered decision
    # drops off this list only once nothing in the tree still says
    # `DECISION-<id>: provisional`.
    # An open `harness-request` is the harness loop's work, not a human's.
    # These are raised by a loop that found the harness wrong and could not fix
    # it, so routing them to a queue nobody is watching is the failure
    # `design/loops.md` §13 warns about: the loop that raised it continues on a
    # workaround, and the workaround is what survives. The loop that *can* fix
    # it should find it as a target, and escalate only what is genuinely a
    # judgement call.
    requests = []
    decisions = []
    answers = decision_answers()
    for path in sorted((STATE / "decisions").glob("*.md")):
        text = path.read_text()
        status = re.search(r"^status:\s*(.+)$", text, re.MULTILINE)
        title = re.search(r"^#\s+(.+)$", text, re.MULTILINE)
        if not status:
            continue
        state = decision_status(path.stem, status.group(1), answers)
        name = title.group(1) if title else path.stem
        kind = re.search(r"^kind:\s*(.+)$", text, re.MULTILINE)
        is_request = bool(kind) and kind.group(1).strip() == "harness-request"
        if is_request and state in ("open", "provisional") and config.writes_harness:
            raiser = re.search(r"^campaign:\s*(\S+)", text, re.MULTILINE)
            requests.append(
                f"- **{path.stem}** — {name}\n"
                f"  raised by campaign {raiser.group(1)[:8] if raiser else '?'};"
                f" read `state/decisions/{path.stem}.md` for the options and what is"
                " provisionally in force."
            )
            continue
        if state in ("open", "provisional"):
            decisions.append(f"- {path.stem}: {name} [{state}]")
        elif decision_unlogged(path.stem, status.group(1), answers):
            # Answered by editing the record rather than through the page, so
            # the ruling is there and the reasoning is not. Listed because the
            # alternative is that it vanishes: an answered record with no
            # tagged site drops off this list entirely, and the loop that
            # raised it never learns the answer arrived.
            decisions.append(
                f"- {path.stem}: {name} [ANSWERED: {state} — read the record; the"
                " ruling was not logged, so the reasoning is only in the file]"
            )
        elif sites := ", ".join(tagged_sites(path.stem)):
            decisions.append(
                f"- {path.stem}: {name} [ANSWERED: {state} — reconcile and remove the tag]\n"
                f"  still tagged at: {sites}"
            )

    findings = other_loop_findings(sorted(phase.loops), config.owner)

    # A worker writes its own journal and reads the loop's when it has none of
    # its own yet: three workers each starting from an empty file would each
    # rediscover what the loop already learned, which is the cost the journal
    # exists to avoid.
    worker_name = os.environ.get("HJ_WORKER") or config.owner
    journal_path = STATE / "journal" / f"{worker_name}.md"
    if not journal_path.exists():
        journal_path = STATE / "journal" / f"{config.owner}.md"
    # This worker's own digest, not the spliced block below it: the cap is per
    # file, and a worker cannot trim a sibling's.
    digest = STATE / "findings" / f"{worker_name}.md"

    stalled = trailing_without_progress(config.owner)
    stall_notice = stall_notice_for(stalled, config.stall_n)

    return {
        "loop": config.owner,
        "owner": config.owner,
        "phase": phase.phase,
        "stall_notice": stall_notice,
        "language": config.language or "n/a",
        "campaign_id": campaign_id,
        "campaign_record": f"state/campaigns/{config.owner}/{campaign_id}.md",
        # Per worker, because append-only prose conflicts on every merge, and
        # the findings digest below is per worker for the same reason — an
        # earlier revision shared it and git stopped and asked on every round
        # (`design/loops.md` §13, "What is per worker and what is shared").
        "journal": f"state/journal/{worker_name}.md",
        # Per worker for the same reason as the journal, and found the same
        # way: `changelog_paths` already globs the directory, so a per-worker
        # file needs no reader change. Three workers appending Class A entries
        # to one file conflicted on both merges of every round — which is what
        # §13 means by partitioning shared state by owner, one level below
        # where `changelog_paths`'s own docstring had already applied it. A
        # line-level union would resolve the conflict and corrupt the result:
        # these are prose blocks, and interleaving two produces a third entry
        # neither campaign wrote.
        "changelog": f"state/spec-changelog/{worker_name}.md",
        "owned_paths": "\n".join(f"- `{p}`" for p in config.write),
        "denied_paths": "\n".join(f"- `{p}`" for p in denied_paths(phase, config.owner)),
        # A loop that may write `harness/` must not be able to run its own
        # gate. `harness/loop` exports the reviewed harness's absolute path,
        # and the command points there; `HJ_REPO` still aims it at this
        # worktree, so it checks the right code with the right rules. Without
        # this the relative path resolves inside the worktree and the whole
        # pinned-gate argument for `HARNESS_PATHS` evaporates.
        "gate_command": (
            f"{os.environ['HJ_PINNED_HARNESS']}/gate {config.owner}"
            if config.writes_harness and os.environ.get("HJ_PINNED_HARNESS")
            else f"harness/gate {config.owner}"
        ),
        "docs": ", ".join(f"`design/{d}`" for d in config.docs) or "(none)",
        "trailer_format": (HARNESS / "trailer-format.md").read_text().strip(),
        # Two blocks that differ by loop rather than by value. They are files
        # rather than string literals so the prose lives with the other prose,
        # and one template rather than one per loop so a rule improved for one
        # loop is improved for all of them — which is what `render` means by
        # there being one copy of every rule.
        "harness_note": fragment(
            config,
            "harness-writable" if config.writes_harness else "harness-denied"
        ),
        "reference_note": fragment(
            config,
            "reference-harness" if config.writes_harness else "reference-lsp"
        ),
        "decision_template": (HARNESS / "decision-template.md").read_text().strip(),
        "stall_n": str(config.stall_n),
        "turn_target": config.turn_target,
        "audit_summary": (
            f"{counts['sections_clean']}/{counts['sections_total']} sections clean, "
            f"{counts['sections_unjudged']} unjudged, {counts['open_gaps']} open gaps, "
            f"{counts['audit_minors']} minor items"
        ),
        "open_gaps": "\n".join(gap_lines),
        "assignment": assignment_block(
            config.owner, os.environ.get("HJ_WORKER") or "", campaign_id
        ),
        # Not a template value: `campaign-open` reads it back to record
        # what this campaign was handed.
        "_claimed": [gap_id(key, gap.claim) for key, gap in detailed],
        "unjudged_sections": "\n".join(f"- {key}" for key in unjudged) or "- (none)",
        "spliced_sections": "\n\n".join(spliced) or "(no open gaps, so no section is spliced)",
        "campaigns_so_far": "\n".join(campaign_lines) or "- (none; this is the first campaign)",
        "open_decisions": "\n".join(decisions) or "- (none open)",
        # The whole section, or nothing: a loop that cannot write `harness/`
        # is never routed a request, and should not be shown a heading it can
        # do nothing about.
        "harness_requests": (
            "\n" + fragment(config, "harness-requests").replace(
                "{{items}}", "\n".join(requests) or "- (none right now)"
            )
            if config.writes_harness
            else ""
        ),
        "other_findings": "\n\n".join(findings) or "(no other loop has published a digest)",
        "findings_path": f"state/findings/{worker_name}.md",
        "summary_note": digest_note(len(digest.read_text().split()) if digest.exists() else 0),
        # The two most volatile things in the prompt, and they go last for that
        # reason (§15's token lever orders it stable-to-volatile). §4 opens an
        # iteration with "read `state/journal/<owner>.md` and the last N commit
        # messages": a campaign that has to fetch them spends turns on
        # retrieval, and the one that skips them rediscovers a dead end the
        # journal already records.
        "journal_tail": journal_tail(journal_path.read_text()) if journal_path.exists() else "(nothing yet — this is the first entry)",
        "recent_commits": "\n".join(
            format_commit_lines(git("log", f"-n{RECENT_COMMITS * 6}", f"--format={COMMIT_FORMAT}", check=False))
        )
        or "- (no loop commits yet)",
        "self_summary": worker_findings(config.owner, worker_name) or "(none yet)",
    }


def cmd_render_prompt(args: argparse.Namespace) -> int:
    phase, config = loop_config(args.loop)
    template = (prompts_dir(config) / config.prompt).read_text()
    rendered = render(template, prompt_values(phase, config, args.campaign or "(unassigned)"))
    if args.out:
        Path(args.out).write_text(rendered)
    else:
        sys.stdout.write(rendered)
    return 0


ASSIGNMENT_FENCE = re.compile(r"```toml\s*\n(.*?)\n```", re.DOTALL)


def assignments_path(owner: str) -> Path:
    """In the integration checkout, like every other thing the fleet shares.

    The planner runs once per round and writes to `main`; workers read this at
    campaign open, from a worktree that branched before the plan existed. Two
    of three workers therefore got no assignment at all on the first round,
    fell back to the whole gap list, and one of them did another's work — the
    exact collision the planner exists to prevent.

    That is the fourth thing to need moving here, after `phase.toml`,
    `sessions.jsonl` and the interventions log, and they are one rule: **state
    the fleet coordinates through cannot live on a branch.** A campaign's own
    output belongs on its branch and merges; anything another worker has to
    read *now* does not.
    """
    return CONTROL / "state" / "assignments" / f"{owner}.toml"


# Two campaign ids that differ in every character, so the divergence a probe
# finds is the first place the id reaches the rendered prompt and never an
# accidental shared prefix between two real uuids.
PREFIX_PROBE = ("aaaaaaaa-0000-0000-0000-000000000000", "bbbbbbbb-1111-1111-1111-111111111111")

# The two template values that carry the campaign uuid. Every other value in a
# prompt is per loop, per phase or per audit, so it is byte-identical from one
# campaign to the next and costs nothing wherever it sits; these two end the
# cacheable prefix at the first place they appear.
PER_CAMPAIGN_VALUES = ("campaign_record", "campaign_id")

# The line dividing the instructional body from the state block, in *template*
# coordinates rather than rendered ones. It is unique in the template — the
# decision record's own frontmatter arrives through `{{decision_template}}`
# and so is not in the file — which is what lets this be checked without
# rendering a prompt, and therefore without reading any repository state.
BODY_END = "\n---\n"


def prompt_body_problems(name: str, template: str) -> list[str]:
    """`design/loops.md` §15's first token lever, as an exact check.

        Keep the prompt's fixed prefix byte-identical across iterations and
        order it stable-to-volatile ... so the cacheable prefix is as long as
        possible.

    `hj prompt-prefix` measures how far that holds and deliberately never
    fails, because when it was written the revision it argues for was an open
    question (`harness-001`, since answered in favour of moving the two ids to
    the tail). This is the part that can fail: not "the prefix is long enough",
    which is a judgement, but "no per-campaign value appears above the
    separator", which is where the length comes from and is exact.

    The second arm matters as much as the first. A campaign that cannot find
    its own record writes no record, so deleting the tail block is a worse
    failure than putting the value back in the body, and it would otherwise
    read as a perfect score.
    """
    separators = template.count(BODY_END)
    if separators != 1:
        return [
            f"{name} has {separators} state-block separators (`---` alone on a line) "
            "and needs exactly one: it is what divides the instructional body from "
            "the per-campaign tail, and every check here is relative to it"
        ]
    body = template.split(BODY_END, 1)[0]
    problems = []
    for value in PER_CAMPAIGN_VALUES:
        placeholder = "{{" + value + "}}"
        if placeholder in body:
            problems.append(
                f"{name} renders {placeholder} in the instructional body. It carries the "
                "campaign uuid, so the cacheable prefix ends there and everything after "
                "it is re-sent uncached on every campaign of every loop "
                "(design/loops.md section 15; state/decisions/harness-001.md). Refer to "
                "the `## This campaign` block in the tail instead"
            )
        elif placeholder not in template:
            problems.append(
                f"{name} renders {placeholder} nowhere. A campaign that cannot find its "
                "own record writes no record, which is worse than the prefix cost this "
                "check exists to prevent"
            )
    return problems


# The paragraph in `design/loops.md` §13 that states the bounded exception,
# found by the phrase that is the claim rather than by a line number. It names
# the files that stay denied while a loop is allowed to write `harness/`, and
# `DENIED_ALWAYS` is the same list in code.
EXCEPTION_PARAGRAPH = "stay denied to it"
ISOLATION_SECTION = "loops.md#mechanics-isolation-in-four-layers"


def documented_harness_denials(text: str) -> tuple[set[str], str]:
    """The `harness/…` paths §13's bounded-exception paragraph names, and why
    it found none when it finds none.

    Paragraph-scoped rather than section-scoped on purpose: the section also
    mentions `harness/workers`, `harness/measure` and `harness/hj` in passing,
    and a check that read the whole section would demand that every path the
    prose happens to name be denied.
    """
    paragraphs = [block for block in text.split("\n\n") if EXCEPTION_PARAGRAPH in block]
    if len(paragraphs) != 1:
        return set(), (
            f"{len(paragraphs)} paragraphs of {ISOLATION_SECTION} say "
            f"{EXCEPTION_PARAGRAPH!r} and exactly one should: it is the sentence that "
            "names what a loop writing `harness/` still may not touch"
        )
    return set(re.findall(r"`(harness/[^`\s]+)`", paragraphs[0])), ""


def check_one_loop_per_language(phase: Phase) -> int:
    """§10's "several servers do not mean several loops", as a check.

    The section argues the per-server split out and rejects it — such a loop
    "owns one file it is forbidden to grow except on corpus evidence" and is
    forbidden the one shape that would let it do anything locally, so it is "a
    loop with almost no legal move" — and concludes that "a language is one
    loop, and it reads every table for its language".

    Two loops declaring one language is that split arriving anyway, whatever
    they are named. What it produces is two metrics files, two frontiers over
    one set of numbers, and two loops contending on one crate. Nothing else
    here would notice, because every command is per loop and each of the two
    looks perfectly correct on its own — which is why the row's server
    dimension needs this beside it rather than instead of it.
    """
    owners: dict[str, list[str]] = {}
    for owner, config in sorted(phase.loops.items()):
        if config.language:
            owners.setdefault(config.language, []).append(owner)
    if not owners:
        print("loops: no loop declares a language, so no two can share one")
        return 0
    doubled = {language: names for language, names in owners.items() if len(names) > 1}
    for language, names in sorted(doubled.items()):
        print(
            f"loops: {language} is declared by {' and '.join(names)}. design/loops.md "
            "section 10 makes a language one loop that reads every server's table for "
            "it; two loops for one language are two metrics files and two frontiers "
            "over one set of numbers, and a per-server split is the shape that "
            "section rejects outright.",
            file=sys.stderr,
        )
    if not doubled:
        print(
            "loops: "
            + ", ".join(f"{language} -> {names[0]}" for language, names in sorted(owners.items()))
        )
    return 1 if doubled else 0


def check_denial_table(config: LoopConfig) -> int:
    """`DENIED_ALWAYS` and the paragraph that states it, held together.

    §13's four layers end at "the gate decides what may be in it", and this is
    the case where the gate's rule and the document's sentence are the same
    claim written twice — the shape §5 calls converting an audit finding into
    a permanent check. The sentence was wrong for as long as it took an
    auditor to read it: it said the prompts were denied while
    `harness-009` was answering that they are not.

    Scoped to `writes_harness` for `check_prompt_prefix`'s reason. Every loop
    can write `design/`, but only one is judged on this document, and a check
    that fails in the tree of whoever has not merged yet is `harness-011`.
    """
    if not config.writes_harness:
        return 0
    index = section_index(["loops.md"])
    section = index.get(ISOLATION_SECTION)
    if section is None:
        print(
            f"denials: {ISOLATION_SECTION} is gone, and it is where the deny list is "
            "stated. Renaming the heading also breaks harness/section-baseline.toml, "
            "which is the frozen denominator and is denied to every loop",
            file=sys.stderr,
        )
        return 1
    documented, problem = documented_harness_denials(section_text(section))
    if problem:
        print(f"denials: {problem}", file=sys.stderr)
        return 1
    constant = {path for path in DENIED_ALWAYS if path.startswith("harness/")}
    if documented == constant:
        print(f"denials: {len(constant)} harness path(s) denied, and the document says so")
        return 0
    for path in sorted(constant - documented):
        print(
            f"denials: DENIED_ALWAYS holds {path}, which §13's bounded-exception "
            "paragraph does not name. A file denied without being written down is a "
            "gate failure nobody can predict",
            file=sys.stderr,
        )
    for path in sorted(documented - constant):
        print(
            f"denials: §13 says {path} is denied and DENIED_ALWAYS does not. The "
            "document is the claim and the constant is the enforcement; where they "
            "disagree the loop has more reach than the spec grants it",
            file=sys.stderr,
        )
    return 1


# The gate runs `hj` as `"$hj" <subcommand>`, and those subcommands are its
# steps. Parsed rather than listed, so a step added to the gate tomorrow is
# covered the day it is added: a list of step names kept in two files is a
# list that eventually disagrees with itself, and the half that would go
# stale here is the half that enforces.
GATE_INVOCATION = re.compile(r'"\$hj"\s+([a-z][a-z0-9-]*)')


def gate_steps() -> set[str]:
    return set(GATE_INVOCATION.findall((HARNESS / "gate").read_text()))


def prompt_gate_leaks(name: str, text: str, steps: set[str]) -> list[str]:
    """Gate steps this prompt text names. `design/loops.md` §14:

        they do not describe the gate's checks — which ones run, what each
        inspects, and what makes one fail — since a loop that knows the
        checker in detail is a loop that can optimise against the checker
        rather than against the work

    A rule the loop must obey is inlined; the check that enforces it is not.
    The two are easy to run together — "do not put a per-campaign value in the
    body, `check-metrics` fails on it" — and the second clause is the leak: it
    tells a campaign which check to satisfy, where the first told it what to
    do.

    Template coordinates, deliberately, like `prompt_body_problems`. A
    campaign's journal entry and its findings digest are spliced into the
    rendered prompt and routinely name a check by name — that is a loop
    writing down what it learned, which is the thing the digest is for, and
    failing a gate over it would punish exactly the honesty §13 asks for.

    A hyphenated name is a leak wherever it appears, since nothing else spells
    `check-metrics`. A one-word name is only a leak written as `hj <name>`:
    `crates` and `selftest` are also ordinary English in a document about
    crates and tests, and a check that failed on those would fail every prompt
    in the tree for no reason anyone could act on.
    """
    problems = []
    for step in sorted(steps):
        pattern = (
            rf"(?<![\w-]){re.escape(step)}(?![\w-])"
            if "-" in step
            else rf"\bhj\s+{re.escape(step)}(?![\w-])"
        )
        if re.search(pattern, text):
            problems.append(
                f"{name} names the gate step `{step}`. §14: the prompts state the rules "
                "and not the checks, because a loop told which check to satisfy optimises "
                "against the check. Say what the rule is and leave the enforcement "
                "unnamed — the gate says which step failed when one does"
            )
    return problems


def check_prompt_leaks(config: LoopConfig, phase: Phase) -> int:
    """§14's "they do not describe the gate's checks", as an exact check.

    Every file that is spliced into a live prompt and is prose rather than
    state: the live templates whole — the leak this was written for was in a
    template's tail, below `BODY_END`, so the body alone is the wrong scope —
    plus the fragments and the two shared blocks. All of `fragments/` is live
    today; a fragment added for a prompt that no loop runs would want the same
    narrowing `live_prompt_templates` already applies to templates.

    Scoped to `writes_harness` for `check_prompt_prefix`'s reason: the pinned
    harness runs it against each loop's worktree, and only the loop that owns
    `harness/prompts/` can act on a failure.
    """
    if not config.writes_harness:
        return 0
    steps = gate_steps()
    if not steps:
        print(
            "prompt: harness/gate runs no `\"$hj\" <step>` at all, so this check has "
            "nothing to look for. Either the gate stopped calling hj or the parse is "
            "wrong; a check that can only pass is not a check",
            file=sys.stderr,
        )
        return 1
    spliced = [REPO / name for name in sorted(live_prompt_templates(phase))]
    spliced += sorted((HARNESS / "prompts" / "fragments").glob("*.md"))
    spliced += [HARNESS / "trailer-format.md", HARNESS / "decision-template.md"]
    problems = []
    for path in spliced:
        if path.exists():
            problems += prompt_gate_leaks(str(path.relative_to(REPO)), path.read_text(), steps)
    for problem in problems:
        print(f"prompt: {problem}", file=sys.stderr)
    if problems:
        return 1
    print(f"prompt: no live prompt names any of the {len(steps)} gate steps")
    return 0


def check_prompt_prefix(config: LoopConfig, phase: Phase) -> int:
    """The gate's route to `prompt_body_problems`, for the one loop that can
    break it.

    Scoped to `writes_harness`, and not because the property is that loop's
    alone — it costs every loop tokens. It is that the pinned harness runs
    this against *each* loop's own worktree (`HJ_REPO`), and a worktree that
    has not merged `main` since the prompt changed still holds the old one. A
    check on a shared file that fails in the tree of whoever has not merged
    yet is `harness-011`, and it has cost two campaigns; only the loop that
    owns `harness/prompts/` can act on the failure anyway.

    Live templates only, for `live_prompt_templates`' reason: a tuning prompt
    for a phase that has not run generates nothing, so its shape costs nobody
    anything yet.
    """
    if not config.writes_harness:
        return 0
    problems = []
    for name in sorted(live_prompt_templates(phase)):
        path = REPO / name
        if path.exists():
            problems += prompt_body_problems(name, path.read_text())
    for problem in problems:
        print(f"prompt: {problem}", file=sys.stderr)
    if problems:
        print("prompt: `harness/hj prompt-prefix` reports what it costs.", file=sys.stderr)
        return 1
    print("prompt: no per-campaign value above the separator in any live template")
    return 0


def first_divergence(left: str, right: str) -> int:
    limit = min(len(left), len(right))
    index = 0
    while index < limit and left[index] == right[index]:
        index += 1
    return index


def value_at(rendered: str, offset: int, values: dict) -> str | None:
    """Which template value produced the character at `offset`.

    The shortest value spanning it wins: a long value often contains a short
    one, and the specific answer is the useful one — "the campaign record
    path", not "the whole assignment block".
    """
    best: tuple[str, int] | None = None
    for key, value in values.items():
        if key.startswith("_") or not isinstance(value, str) or not value:
            continue
        start = rendered.find(value)
        while start != -1:
            if start <= offset < start + len(value):
                if best is None or len(value) < best[1]:
                    best = (key, len(value))
                break
            start = rendered.find(value, start + 1)
    return best[0] if best else None


def cmd_prompt_prefix(args: argparse.Namespace) -> int:
    """How much of a loop's prompt is byte-identical from one campaign to the
    next. `design/loops.md` section 15, the first token lever:

        Keep the prompt's fixed prefix byte-identical across iterations and
        order it stable-to-volatile — constitution, then prompt, then audit
        state, then the journal tail and recent commits — so the cacheable
        prefix is as long as possible.

    Cache reads dominate what a campaign costs — about 141 to 1 against output
    on the campaigns measured so far — and caching is prefix-based, so the
    first byte that differs between two campaigns ends the saving for
    everything after it. That makes this a number rather than a principle, and
    an unmeasured one is how a one-line edit quietly costs a phase real money.

    Reports and never fails: revising a prompt is `design/loops.md` section
    16's one intervention that cannot be replayed, so this hands a human a
    measurement rather than acting on it.
    """
    phase = load_phase()
    owners = [args.loop] if args.loop else sorted(phase.loops)
    for owner in owners:
        _, config = loop_config(owner)
        template = (prompts_dir(config) / config.prompt).read_text()
        left_values = prompt_values(phase, config, PREFIX_PROBE[0])
        right_values = prompt_values(phase, config, PREFIX_PROBE[1])
        left = render(template, left_values)
        right = render(template, right_values)
        offset = first_divergence(left, right)
        culprit = value_at(left, offset, left_values)
        summary = left_values.get("audit_summary") or ""
        state_at = left.find(summary) if summary else -1

        print(f"prompt-prefix: {owner}  ({config.prompt}, {len(left):,} chars rendered)")
        print(f"  cacheable prefix   {offset:,} chars ({offset / len(left) * 100:.1f}%)")
        if culprit:
            print(f"  ended by           {{{{{culprit}}}}}")
        if state_at >= 0:
            print(
                f"  state block at     {state_at:,} chars ({state_at / len(left) * 100:.1f}%)"
                " — where per-campaign values are supposed to start"
            )
            if offset < state_at:
                print(
                    f"  re-sent per campaign  {state_at - offset:,} chars of the instructional body,"
                    " because a per-campaign value appears inside it"
                )
        for problem in prompt_body_problems(f"harness/prompts/{config.prompt}", template):
            print(f"  problem            {problem}")
    return 0


def cmd_render_planner(args: argparse.Namespace) -> int:
    """The planner divides one round between the workers.

    It is a session rather than a rule because the split that matters is
    "which of these share their reading", and that is a judgement about the
    code (`design/loops.md` §13, "Workers"). A first-come claim gets
    disjointness and nothing else: it hands out the top-ranked gaps in order
    and cannot notice that two of them are the same file.
    """
    phase, config = loop_config(args.loop)
    values = prompt_values(phase, config, "(planning)")
    recent = [
        f"- {c.get('worker') or config.owner}: {c.get('target') or '(no target)'}"
        f" -> {c.get('outcome') or 'open'}"
        for c in campaigns_of(config.owner)[-args.workers * 2 :]
    ]
    rendered = render(
        (HARNESS / "prompts" / "planner.md").read_text(),
        {
            "loop": config.owner,
            "phase": phase.phase,
            "worker_count": str(args.workers),
            "open_gaps": values["open_gaps"],
            "unjudged_sections": values["unjudged_sections"],
            "recent_campaigns": "\n".join(recent) or "- (this is the first round)",
        },
    )
    if args.out:
        Path(args.out).write_text(rendered)
    else:
        sys.stdout.write(rendered)
    return 0


def cmd_plan_merge(args: argparse.Namespace) -> int:
    """Take the planner's block and write it where the workers read it."""
    text = Path(args.answer).read_text()
    match = ASSIGNMENT_FENCE.search(text)
    if not match:
        die("the planner produced no ```toml block")
    try:
        parsed = tomllib.loads(match.group(1))
    except tomllib.TOMLDecodeError as error:
        die(f"the planner's toml does not parse: {error}")
    workers = parsed.get("worker") or {}
    missing = [str(n) for n in range(1, args.workers + 1) if str(n) not in workers]
    if missing:
        die(f"the plan names no assignment for worker(s): {', '.join(missing)}")
    _, config = loop_config(args.loop)
    path = assignments_path(config.owner)
    path.parent.mkdir(parents=True, exist_ok=True)
    lines = [
        "# One round's assignments, written by `hj plan-merge` from the planner's",
        "# answer. Regenerated every round; not history.",
        f"planned = {toml_string(now())}",
        "",
    ]
    for number in sorted(workers, key=lambda k: int(k)):
        table = workers[number]
        targets = table.get("targets") or []
        lines.append(f"[worker.{number}]")
        lines.append("targets = [" + ", ".join(toml_string(x) for x in targets) + "]")
        if table.get("reading"):
            lines.append(f"reading = {toml_string(str(table['reading']))}")
        if table.get("why"):
            lines.append(f"why = {toml_string(str(table['why']))}")
        lines.append("")
        print(f"plan: worker {number}: {len(targets)} target(s)")
    path.write_text("\n".join(lines))
    commit_harness_state([path], f"plan a round for {config.owner}")
    return 0


def assignment_for(owner: str, worker: str) -> dict:
    """What this worker was assigned, or an empty assignment."""
    path = assignments_path(owner)
    if not path.exists() or not worker:
        return {}
    number = worker.rsplit("-", 1)[-1]
    try:
        parsed = tomllib.loads(path.read_text())
    except tomllib.TOMLDecodeError:
        return {}
    return (parsed.get("worker") or {}).get(number) or {}


def cmd_render_auditor(args: argparse.Namespace) -> int:
    """The auditor's prompt is rendered by the harness and never seen by the
    implementer (`design/loops.md` section 5): a loop that knows exactly how
    it is judged optimises for the judgement."""
    phase, config = loop_config(args.loop)
    index = section_index(config.docs)
    keys = [key.strip() for key in Path(args.plan).read_text().splitlines() if key.strip()]
    unknown = [key for key in keys if key not in index]
    if unknown:
        die(f"audit plan names sections that do not exist: {', '.join(unknown)}")
    # What changed since the last audit — evidence, deliberately not the last
    # audit's verdicts. `design/loops.md` section 19 names a section wrongly
    # called clean as the audit's worst failure and says successive audits by
    # *fresh* sessions are the only defence. Telling this one what the last one
    # concluded destroys that; telling it which files moved does not, and saves
    # it re-reading a tree it has no reason to suspect.
    rows = read_jsonl(GAP_LOG)
    since = next((row["commit"] for row in reversed(rows) if row.get("commit")), None)
    if since:
        changed = git("diff", "--stat", f"{since}..HEAD", "--", "crates", "vendor").strip()
        changes = changed or "Nothing under crates/ or vendor/ has changed since the last audit."
    else:
        changes = "No previous audit to compare against; everything is new to this one."

    template = (HARNESS / "prompts" / "auditor.md").read_text()
    rendered = render(
        template,
        {
            "changes_since_last_audit": changes,
            "phase": phase.phase,
            "loop": config.owner,
            "docs": ", ".join(f"`design/{d}`" for d in config.docs) or "(none)",
            "section_list": "\n".join(f"- {key}" for key in keys),
            "section_count": str(len(keys)),
            "spliced_sections": "\n\n".join(section_text(index[key]) for key in keys),
            "owned_paths": "\n".join(f"- `{p}`" for p in config.write),
        },
    )
    if args.out:
        Path(args.out).write_text(rendered)
    else:
        sys.stdout.write(rendered)
    return 0


def cmd_crates(args: argparse.Namespace) -> int:
    """The crates the gate builds: the ownership table intersected with what
    the workspace actually contains, so a table row for a crate that does not
    exist yet costs nothing.

    `--lintable` drops the vendored ones. They are built and tested — those 29
    upstream tests are the only independent check that the newtype sweep did
    not change rope's behaviour — but not linted and not format-checked:
    `deps.md` section 14 deliberately withholds the workspace lints from
    `vendor/*`, and both `clippy -D warnings` and `fmt --check` fail on
    unedited upstream text. Keyed on the manifest path rather than on crate
    names, because that is where the rule actually lives — section 14 is about
    `vendor/` as a directory.
    """
    _, config = loop_config(args.loop)
    for member in owned_members(config):
        if args.lintable and member in vendored_members():
            continue
        print(member)
    return 0


CAMPAIGN_STUB = """# Campaign {campaign_id}

- loop: {owner}
- phase: {phase}
- opened: {opened}
- commit at open: {commit}
- session: `{resume}`

## Target

<!-- One target. For a conformance loop: an open gap, or an unjudged
     section, named by its document anchor. Fill this in first. -->

## Hypothesis

<!-- Why the target is in the state it is in, and what you expect to
     change. A campaign is one hypothesis. -->

## Experiments

<!-- One line per experiment: what changed, what the gate said, committed
     or reverted. Reverts are results. -->

## Outcome

<!-- Written at close, when the shape of the result is known. If the
     hypothesis died, say why in enough detail that nobody retries it. -->
"""


def claimed_gaps(owner: str, exclude: str = "") -> set[str]:
    """Gap ids handed to a campaign that is still running.

    `design/loops.md` §13, "Workers": with several workers on one gap list the
    obvious failure is three of them opening the same highest-value gap within
    a second of each other. So the harness records what it hands out and
    removes it from the next worker's list.

    A claim ends when the campaign closes or is reaped — it is scoped to
    *live* campaigns, so a crashed worker does not sterilise its targets. It
    is advisory and nothing enforces it after the prompt is rendered; the
    backstop is the rebase.
    """
    open_rows: dict[str, dict] = {}
    for row in session_rows():
        if row.get("loop") != owner:
            continue
        open_rows.setdefault(row["campaign"], {}).update(row)
    claimed: set[str] = set()
    for campaign_id, row in open_rows.items():
        if row.get("outcome") or campaign_id == exclude:
            continue
        if not campaign_is_alive(campaign_id):
            continue
        claimed.update(row.get("claimed") or [])
    return claimed


def claims_dir(owner: str) -> Path:
    return CONTROL / "state" / "claims" / owner


def claim_targets(owner: str, campaign_id: str, targets: list[str]) -> tuple[list[str], list[str]]:
    """Take targets for a campaign, refusing any another live campaign holds.

    One file per target, created `O_EXCL`, which is the atomicity: two workers
    asking at the same instant cannot both win, without a lock or a daemon. A
    claim held by a campaign that is no longer alive is stale and taken —
    otherwise a crashed worker would sterilise its targets until a human
    noticed.

    Untracked and outside every worktree, because a claim is true for minutes
    and is nobody's history. It is the same rule as `phase.toml` and
    `sessions.jsonl`: state the fleet coordinates through cannot live on a
    branch.
    """
    directory = claims_dir(owner)
    directory.mkdir(parents=True, exist_ok=True)
    granted, refused = [], []
    for target in targets:
        path = directory / f"{hashlib.sha256(target.encode()).hexdigest()[:16]}.json"
        record = json.dumps({"campaign": campaign_id, "target": target, "at": now()})
        try:
            handle = os.open(path, os.O_CREAT | os.O_EXCL | os.O_WRONLY)
            with os.fdopen(handle, "w") as file:
                file.write(record)
            granted.append(target)
            continue
        except FileExistsError:
            pass
        try:
            held = json.loads(path.read_text())
        except (OSError, json.JSONDecodeError):
            held = {}
        holder = held.get("campaign", "")
        # A claim younger than the grace period is held whatever the process
        # table says. It is the same window the reaper needs: a campaign claims
        # its assignment before its runner appears, and a sibling asking in
        # that gap would otherwise steal a target that is about to be worked.
        try:
            age = (datetime.now(timezone.utc) - datetime.fromisoformat(held["at"])).total_seconds()
        except (KeyError, ValueError):
            age = REAP_GRACE_SECONDS + 1
        if holder == campaign_id:
            granted.append(target)
        elif holder and (age < REAP_GRACE_SECONDS or campaign_is_alive(holder)):
            refused.append(target)
        else:
            path.write_text(record)
            granted.append(target)
    return granted, refused


def release_claims(owner: str, campaign_id: str) -> int:
    directory = claims_dir(owner)
    if not directory.is_dir():
        return 0
    dropped = 0
    for path in directory.glob("*.json"):
        try:
            if json.loads(path.read_text()).get("campaign") == campaign_id:
                path.unlink()
                dropped += 1
        except (OSError, json.JSONDecodeError):
            continue
    return dropped


def cmd_allocate_id(args: argparse.Namespace) -> int:
    """Take the next free `<owner>-NNN`, atomically.

    `design/loops.md` §13 owner-prefixes these so two *loops* cannot claim one
    number. That says nothing about two *workers* of one loop, and both
    collided within an hour of the fleet starting: two campaigns wrote
    `core-001`, and two wrote `CHANGE-core-005`, each pair a different question
    under one id.

    A campaign cannot allocate this safely — it reads the directory, thinks,
    and writes, and a sibling does the same in between. So the harness does it,
    against the integration checkout, by creating the file `O_EXCL` and
    retrying on collision. The campaign is handed a number that is already
    reserved.
    """
    _, config = loop_config(args.loop)
    if args.kind == "decision":
        directory = CONTROL / "state" / "decisions"
        pattern, template = f"{config.owner}-*.md", "{owner}-{number:03d}"
    else:
        directory = CONTROL / "state" / "spec-changelog"
        pattern, template = f"{config.owner}.md", "CHANGE-{owner}-{number:03d}"
    directory.mkdir(parents=True, exist_ok=True)

    used = set()
    if args.kind == "decision":
        for path in directory.glob(pattern):
            match = re.search(rf"^{re.escape(config.owner)}-(\d+)$", path.stem)
            if match:
                used.add(int(match.group(1)))
    else:
        for path in directory.glob("*.md"):
            used.update(
                int(number)
                for number in re.findall(rf"^## CHANGE-{re.escape(config.owner)}-(\d+)", path.read_text(), re.M)
            )
    reserved = CONTROL / "state" / "reserved"
    reserved.mkdir(parents=True, exist_ok=True)
    for path in reserved.glob(f"{args.kind}-{config.owner}-*"):
        used.add(int(path.name.rsplit("-", 1)[-1]))

    # One past the highest, never the lowest free. Filling a gap would hand out
    # `core-002` after `core-019` exists, and an id whose number says nothing
    # about when it was raised is one a reader has to look up.
    number = max(used, default=0) + 1
    while True:
        marker = reserved / f"{args.kind}-{config.owner}-{number:03d}"
        try:
            os.close(os.open(marker, os.O_CREAT | os.O_EXCL | os.O_WRONLY))
            return_id = number
            break
        except FileExistsError:
            number += 1
    print(template.format(owner=config.owner, number=return_id))
    return 0


def cmd_claim(args: argparse.Namespace) -> int:
    _, config = loop_config(args.loop)
    granted, refused = claim_targets(config.owner, args.campaign, args.target)
    for target in granted:
        print(f"claim: granted {target}")
    for target in refused:
        print(f"claim: REFUSED {target} — another worker is on it", file=sys.stderr)
    if refused:
        print(
            "claim: pick something else, or close. Two workers on one target is two "
            "campaigns for one result and a merge somebody has to resolve.",
            file=sys.stderr,
        )
    return 1 if refused else 0


def cmd_campaign_open(args: argparse.Namespace) -> int:
    phase, config = loop_config(args.loop)
    # §5's terminal condition, at the one place that decides whether a campaign
    # starts. A campaign opened against an empty queue is handed a prompt with
    # no gap and no unjudged section in it, which is a campaign that closes
    # `no-movement` by construction and counts against the stall for doing
    # exactly what it was told.
    #
    # Here rather than in `harness/loop` for a mechanical reason worth knowing:
    # the reviewed selftest scans the candidate tree's scripts for `"$hj" <sub>`
    # and looks the name up in the parser list, so a new subcommand and the
    # shell line that calls it cannot land in one commit — the reviewed copy
    # predates the parser. `sibling_hj_source` fixes that from the next merge
    # onwards, and the runner's own stop, with its exit code and its logged
    # intervention, belongs in `harness/loop` once it can land there.
    if queue_is_empty(config):
        print(
            f"campaign: {config.owner} has no open gap and no unjudged section left. "
            "design/loops.md §5 makes this terminal rather than an asymptote: the gap "
            "count goes to zero and the minor count deliberately does not, and a loop "
            "chasing minor items is spending campaigns where its judgement is least "
            "reliable. A human reads the minor list and decides which are real. Run "
            f"`harness/hj queue {config.owner}` for the counts.",
            file=sys.stderr,
        )
        log_queue_exhausted(config)
        return 3
    campaign_id = args.id or str(uuid.uuid4())
    template = (prompts_dir(config) / config.prompt).read_text()
    values = prompt_values(phase, config, campaign_id, claimed_gaps(config.owner, campaign_id))
    # The assignment is claimed on the campaign's behalf, so a worker never
    # has to ask for what it was already given.
    assigned = (assignment_for(config.owner, args.worker or config.owner).get("targets") or [])
    claimed_now, _ = claim_targets(config.owner, campaign_id, list(assigned))
    rendered = render(template, values)
    prompt_sha = hashlib.sha256(rendered.encode()).hexdigest()
    constitution = constitution_sha()
    changed_from = log_constitution_change(campaign_id, phase, config.owner, constitution)
    if changed_from:
        # stderr: `harness/loop` reads this command's stdout as the campaign id.
        print(
            f"campaign: CLAUDE.md changed from {changed_from[:12]} since this loop's last "
            "campaign, and it is loaded into every session. Logged as an intervention; "
            "metrics either side of it are not strictly comparable.",
            file=sys.stderr,
        )

    version = cli_version()
    previous_version = next(
        (str(row["cli_version"]) for row in reversed(campaigns_of(config.owner)) if row.get("cli_version")),
        "",
    )
    upgrade = cli_upgrade_reason(version, previous_version, pinned_cli_version())
    if upgrade and cli_upgrade_unlogged(version, read_jsonl(INTERVENTIONS)):
        print(
            f"campaign: the CLI is {version} and {upgrade}. Logged as an intervention; "
            "metrics either side of an upgrade are not strictly comparable "
            "(design/loops.md §17).",
            file=sys.stderr,
        )
        log_cli_upgrade(campaign_id, phase, config.owner, version, upgrade)

    record = STATE / "campaigns" / config.owner / f"{campaign_id}.md"
    record.parent.mkdir(parents=True, exist_ok=True)
    if not record.exists():
        record.write_text(
            CAMPAIGN_STUB.format(
                campaign_id=campaign_id,
                owner=config.owner,
                phase=phase.phase,
                opened=now(),
                commit=head_sha(),
                # From the adapter, which is the only file that knows how the
                # runner is invoked (`design/loops.md` §17). Hardcoded here, it
                # printed `claude --resume …` under any `$HJ_RUNNER`, in the one
                # field a human uses to go and look at the campaign.
                resume=resume_command(campaign_id),
            )
        )

    append_jsonl(
        sessions_path(),
        {
            "campaign": campaign_id,
            "loop": config.owner,
            "worker": args.worker or config.owner,
            "phase": phase.phase,
            "language": config.language,
            # What this campaign was handed, so a worker starting a
            # second later is offered something else.
            "claimed": sorted(claimed_now),
            "prompt": config.prompt,
            "prompt_sha": prompt_sha,
            # The rendered sha changes every campaign, because the tail does —
            # which is what `design/loops.md` section 16 asks for, so a spliced
            # file cannot change behaviour invisibly. It is useless for asking
            # which *template* a campaign ran under, though, and that is the
            # question a prompt revision needs answered. So both.
            "template_sha": hashlib.sha256(
                (prompts_dir(config) / config.prompt).read_bytes()
            ).hexdigest(),
            # The other file that is in every session's context and that no
            # campaign can write. Recorded for the prompt sha's reason (§16):
            # a campaign's behaviour is a function of both, and the join is
            # only possible if both are on the row.
            "constitution_sha": constitution,
            "cli_version": version,
            "started": now(),
            "start_commit": head_sha(),
            "record": str(record.relative_to(REPO)),
            "tests": (read_jsonl(metrics_path(config.owner)) or [{}])[-1].get("tests"),
            **audit_counts(config.docs),
        },
    )

    commit_harness_state([record, sessions_path()], f"open campaign {campaign_id[:8]} ({config.owner})")

    # Kept beside the transcript, because the stream does not echo it and
    # `harness/loop` deletes the file it was handed as soon as the run ends.
    # §16 reads a turn as prompt, thinking, tool calls, results, text, and the
    # first of those was recoverable from nothing: `prompt_sha` says *which*
    # prompt and never what it said, and a spliced value — a gap's `found:`
    # line, a stale digest — is exactly what a transcript is read to explain.
    # Written here rather than by the runner so that every caller of
    # campaign-open retains it, including a human opening one by hand.
    kept = prompt_file_of(config.owner, campaign_id)
    if kept:
        Path(kept).parent.mkdir(parents=True, exist_ok=True)
        Path(kept).write_text(rendered)
    if args.prompt_out:
        Path(args.prompt_out).write_text(rendered)
    print(campaign_id)
    return 0


PROVISIONAL_TAG = re.compile(r"DECISION-(?P<id>[A-Za-z0-9_-]+): provisional")


def reconciled_in_diff(diff: str) -> list[str]:
    """Decision ids whose provisional tags a diff removes and does not put
    back. A tag that moves — the site was rewritten, the choice still stands —
    is removed and added in the same diff, and is not a reconciliation."""
    removed: set[str] = set()
    added: set[str] = set()
    for line in diff.splitlines():
        if line.startswith("---") or line.startswith("+++"):
            continue
        match = PROVISIONAL_TAG.search(line)
        if not match:
            continue
        if line.startswith("-"):
            removed.add(match.group("id"))
        elif line.startswith("+"):
            added.add(match.group("id"))
    return sorted(removed - added)


def decisions_reconciled(campaign_id: str) -> list[str]:
    """Provisional choices this campaign retired.

    The fourth of §7's five forms of progress, and the one that was missing:
    a campaign that takes an answered decision and reconciles the sites it was
    tagged at can move no section and add no test — §6 calls that "a normal
    campaign target" — and it was closing as no-progress and counting toward
    the stall.

    Answering is not resolving, deliberately. A record's `status` is a human's
    to change and a loop is told not to rule on its own escalation, so credit
    is given for the work in the tree rather than for a line in the record.
    """
    ids: set[str] = set()
    for commit in commits_for_campaign(campaign_id):
        diff = git("show", "--format=", "-U0", commit, check=False)
        ids.update(reconciled_in_diff(diff))
    return sorted(ids)


def is_code_path(path: str) -> bool:
    """Is this path part of what the spec is judged against?

    The complement of the spec and the record, not an allow-list of crates:
    see `spec_drift`.
    """
    return not path.startswith(("design/", "state/"))


def spec_drift(campaign_id: str, target: str | None) -> dict | None:
    """Did this campaign edit the spec and the code it is judged against?

    Scoped to the campaign rather than the commit, and that matters more than
    it sounds: the iteration contract deliberately produces one commit per
    experiment with one target each, so "the spec edit and the code are in the
    same commit" is a test the loop's own working style defeats without anyone
    intending it (`design/loops.md` section 7).

    Not a gate failure. Rewriting the spec toward the code is the one gaming
    route the audit cannot catch *by construction* — moving the spec removes
    the gap from the instrument that would have reported it — so the answer is
    to make it visible to a human, not to guess at intent here.

    **Code is anything that is not the spec and not the record**, rather than
    an allow-list of `crates/` and `vendor/`. That list silently exempted the
    one loop whose implementation is `harness/`: campaign 11b9c019 edited
    `design/loops.md` §4 and `harness/hj` in the same run, said in its own
    record that it expected to be flagged for it, and recorded `spec_drift`
    null. A detector that does not fire for the loop building the detector is
    the failure §19 calls the thinnest defence in the design.

    `state/` is excluded because it is where a campaign writes its journal,
    its record and its changelog entry — every campaign touches it, so
    counting it as code would flag all of them and the flag would mean
    nothing. `harness/` is code: it is this loop's deliverable.
    """
    design_edits: set[str] = set()
    code_edits: set[str] = set()
    for commit in commits_for_campaign(campaign_id):
        for path in commit_paths(commit):
            if path.startswith("design/"):
                design_edits.add(path)
            elif is_code_path(path):
                code_edits.add(path)
    if not (design_edits and code_edits):
        return None
    target_doc = (target or "").split("#")[0]
    return {
        "design": sorted(design_edits),
        "code": sorted(code_edits)[:20],
        "target": target,
        # The sharper case: the document edited is the one the campaign's own
        # target lives in, so the edit and the claim being scored coincide.
        "touches_target_document": bool(target_doc) and f"design/{target_doc}" in design_edits,
    }


def prompt_drift(campaign_id: str, config: LoopConfig) -> dict | None:
    """Did this campaign edit the prompt that generates it?

    Only reachable for a loop with `writes_harness`, and only because
    `DENIED_ALWAYS` stops at `harness/prompts/auditor.md` — so today the
    harness loop may rewrite `harness/prompts/conformance.md`, which is both
    its own instructions and the core loop's.

    That is not obviously wrong: two gaps have been closed exactly that way,
    §13's digest asymmetry and §4's journal tail, and `design/loops.md` §18
    gives this loop the job of writing the tuning and optimisation prompts.
    But a loop editing the text that generates it is the strongest form
    available of the thing `harness/readme.md` is about, and §16 calls a prompt
    revision the one intervention that cannot be replayed — the metrics either
    side of it are not comparable, and nothing was recording it as an
    intervention at all.

    So it is made visible rather than impossible, which is the same answer
    `spec_drift` gives to the same shape of problem for the same stated reason,
    and `harness-009` asks a human whether visible is enough here.
    """
    own = f"harness/prompts/{config.prompt}"
    edits = {
        path
        for commit in commits_for_campaign(campaign_id)
        for path in commit_paths(commit)
        if path.startswith("harness/prompts/")
    }
    if not edits:
        return None
    return {
        "prompts": sorted(edits),
        # The sharper case, and the one §16 is about: the file edited is the
        # template this campaign's own prompt was rendered from.
        "touches_own_prompt": own in edits,
        "own": own,
    }


def constitution_sha() -> str:
    """The blob sha of `CLAUDE.md` at HEAD, or empty if it is not tracked."""
    return git("rev-parse", "HEAD:CLAUDE.md", check=False).strip()


def constitution_change_unlogged(previous: str, current: str, rows: list[dict]) -> bool:
    """Whether this constitution change still needs a row.

    False when there is nothing to report and false when a sibling worker
    opening seconds earlier already reported it — three workers open against
    one `main`, so the first one to notice is the one that logs.
    """
    if not current or not previous or previous == current:
        return False
    return not any(
        row.get("kind") == "spec-edited-by-hand"
        and row.get("target") == "CLAUDE.md"
        and current[:12] in str(row.get("answer") or "")
        for row in rows
    )


CLI_PIN_SECTION = "## 7. The Claude Code CLI"
CLI_PIN = re.compile(r"\*\*(\d[\d.]*)\*\*")


def pinned_cli_version() -> str:
    """The version `design/external-dependencies.md` §7 pins, or "".

    Read from the document rather than copied into a constant here, because
    §17 asks for the pin to live "in `external-dependencies.md` with the
    language servers" and a second copy is a second answer. The document is
    also the only place that can be *changed* when a human accepts an upgrade:
    `design/` outside `loops.md` is denied to this loop, which is the right way
    round — the loop reports the drift and a human decides it.
    """
    path = REPO / "design" / "external-dependencies.md"
    if not path.exists():
        return ""
    _, _, after = path.read_text().partition(CLI_PIN_SECTION)
    match = CLI_PIN.search(after)
    return match.group(1) if match else ""


def cli_upgrade_reason(current: str, previous: str, pinned: str) -> str:
    """Why this campaign's CLI version is worth a row, or "".

    The pin comes first because it outlives the comparison against the last
    campaign: once an upgrade has been logged, every campaign after it runs
    the new version and the campaign-to-campaign check goes quiet, while the
    tree is still running something no document says it should. The previous
    campaign is the fallback for a change the pin cannot see — an upgrade
    while the document is being edited, or a document that has lost the pin.

    `cli_version` returns the whole banner ("2.1.222 (Claude Code)"), so the
    pin is matched inside it rather than against it.
    """
    if not current or current == "unknown":
        return ""
    if pinned:
        return "" if pinned in current else f"design/external-dependencies.md §7 pins {pinned}"
    if previous and previous != current:
        return f"this loop's previous campaign ran {previous}"
    return ""


def cli_upgrade_unlogged(current: str, rows: list[dict]) -> bool:
    """Whether this version still needs a row.

    Keyed on the version rather than on the transition, so it fires once and
    then stays quiet: three workers open against one `main` and the first to
    notice is the one that logs, and a mismatch that persists — the tree ahead
    of the pin until a human moves one of them — must not re-log every campaign
    of every loop.
    """
    return not any(
        canonical_kind(str(row.get("kind"))) == "cli-upgraded"
        and current in str(row.get("answer") or "")
        for row in rows
    )


def log_cli_upgrade(campaign_id: str, phase: Phase, owner: str, current: str, reason: str) -> None:
    """`design/loops.md` §17's "treat an upgrade as the intervention it is".

    The version was on every session row from the beginning and compared
    against nothing, which is the shape of a measurement that is not an
    instrument: two upgrades (2.1.220 → 2.1.221 → 2.1.222) went by against a
    pin of 2.1.220 with nothing in the log and nothing on the dashboard.

    Written by the harness, like `log_prompt_revision` and
    `log_constitution_change`, and for the same reason: nobody is present at a
    campaign open to give a rationale, and a flag with no row leaves §16's
    mechanism with no entry at all.
    """
    append_jsonl(
        INTERVENTIONS,
        {
            "ts": now(),
            "kind": "cli-upgraded",
            "phase": phase.phase,
            "target": "claude-code",
            "answer": f"campaigns are now running {current}",
            "commit": head_sha(),
            "automatic": True,
            "rationale": (
                f"Noticed at the open of campaign {campaign_id[:8]} ({owner}): {reason}. "
                "design/loops.md §17 puts the CLI in the same category as a prompt "
                "revision — it changes the generator of campaigns, arrives without "
                "anyone deciding anything, and is otherwise invisible — so metrics "
                "either side of it are not strictly comparable. Logged by the harness "
                "because nobody is present at a campaign open. A human either accepts "
                "the version by moving the pin in design/external-dependencies.md §7, "
                "or moves the tree back to it."
            ),
        },
    )


def log_constitution_change(campaign_id: str, phase: Phase, owner: str, current: str) -> str:
    """`CLAUDE.md` changing between campaigns, as an intervention row.

    `design/loops.md` §14, on why the prompts splice its precedence rather than
    its text: "Editing it is still logged as an intervention, for the same
    reason a prompt revision is: it changes every subsequent campaign and
    nothing downstream can tell." `CLAUDE.md`'s own rules-hygiene section makes
    the same claim from the other side — an edit there "is a human change,
    logged as an intervention like a prompt revision".

    `hand_authored_commits` already *reports* the commit as an intervention
    with no reasoning, and that is not the same thing: §16 calls the log the
    mechanism rather than a record of it, and a candidate on a dashboard leaves
    the log with no entry at all. This is `log_prompt_revision`'s argument
    applied to the other file that changes every campaign, and the row carries
    the commit so the dashboard's unlogged list agrees with it.

    Detected against the last campaign of *this* loop rather than the fleet,
    because that is the boundary the incomparability falls on: the campaigns
    either side of the change are this loop's.

    Returns the sha it changed from, so the caller can say so, and empty when
    there was nothing to report.
    """
    previous = next(
        (
            str(row.get("constitution_sha"))
            for row in reversed(campaigns_of(owner))
            if row.get("constitution_sha")
        ),
        "",
    )
    if not constitution_change_unlogged(previous, current, read_jsonl(INTERVENTIONS)):
        return previous if current and previous and previous != current else ""
    append_jsonl(
        INTERVENTIONS,
        {
            "ts": now(),
            # §16's vocabulary is closed and names no constitution kind. This is
            # the one it has for normative text a human changed outside the loop
            # mechanism, and `target` is what keeps "which kinds recur" readable:
            # a row naming CLAUDE.md is a different event from one naming a
            # design document, and the field says which.
            "kind": "spec-edited-by-hand",
            "phase": phase.phase,
            "target": "CLAUDE.md",
            "answer": f"CLAUDE.md is now {current[:12]}, was {previous[:12]}",
            "commit": git("log", "-1", "--format=%H", "--", "CLAUDE.md", check=False).strip(),
            "rationale": (
                f"Noticed at the open of campaign {campaign_id[:8]} ({owner}): the "
                "constitution changed since this loop's last campaign. It is loaded into "
                "every session, so like a prompt revision it changes the generator rather "
                "than a campaign, and metrics either side of it are not strictly "
                "comparable. Logged by the harness because nobody is present at a campaign "
                "open to give a reason; whoever made the edit can add a row with theirs."
            ),
        },
    )
    return previous


def live_prompt_templates(phase: Phase) -> set[str]:
    """Prompt files that some loop is currently generated from.

    Not every file under `harness/prompts/` is one. `design/loops.md` §18 gives
    the harness loop the tuning and optimisation prompts, which belong to phases
    that have not run — editing those changes no generator and is ordinary work.
    """
    return {f"harness/prompts/{loop.prompt}" for loop in phase.loops.values() if loop.prompt}


def log_prompt_revision(campaign_id: str, phase: Phase, drift: dict) -> list[str]:
    """Record a campaign's edit to a live prompt as a `prompt-revised` row.

    `harness-009` is answered: a loop may edit the prompt that generates it, and
    the edit is logged rather than prevented. Logged rather than merely flagged
    because §16 calls a prompt revision the one intervention that cannot be
    replayed — it changes the *generator* of campaigns, so metrics either side
    of it are not comparable — and the dashboard flag alone left the log, which
    §16 calls the mechanism rather than a record of it, with no entry at all.

    Written here rather than through `hj intervene` because nobody is present to
    give a rationale: this is the harness noticing, and the row says so. A human
    reading the queue can still add their own row with the reasoning.

    Only live templates. A tuning prompt for a phase that has not run changes no
    campaign that has been measured.
    """
    revised = sorted(set(drift["prompts"]) & live_prompt_templates(phase))
    if not revised:
        return []
    append_jsonl(
        INTERVENTIONS,
        {
            "ts": now(),
            "kind": "prompt-revised",
            "phase": phase.phase,
            "target": ", ".join(revised),
            "answer": "logged automatically at campaign close",
            "rationale": (
                f"Campaign {campaign_id[:8]} edited "
                + ", ".join(revised)
                + (
                    ", which is the template its own prompt was rendered from. "
                    if drift["touches_own_prompt"]
                    else ", a prompt another loop is generated from. "
                )
                + "design/loops.md §16: a prompt revision changes the generator of "
                "campaigns rather than a campaign, so metrics either side of it are "
                "not comparable and it cannot be replayed. Recorded by the harness "
                "rather than by a person — state/decisions/harness-009.md is answered "
                "'flag it and log it', so no rationale was given at the time. The diff "
                "is in the campaign's commits."
            ),
            "campaign": campaign_id,
            "automatic": True,
            "commit": head_sha(),
        },
    )
    return revised


PYTHON_SHEBANG = re.compile(rb"^#!.*python")

# `design/loops.md` section 7's better ralph heuristic, and its constant.
# Twenty commits because it has to be a *run* rather than a campaign: three
# workers interleave, so the last twenty of one loop's commits span a few
# rounds, which is the window in which "mostly test churn" is a shape rather
# than one campaign that happened to be writing tests.
TEST_CHURN_WINDOW = 20
TEST_CHURN_FLAG = 0.30


def classify_diff_path(name: str) -> str:
    """Which bucket a changed path counts in. `campaign_diffstat`'s split, and
    `loc_per_crate`'s: a path component named `tests`, which is where this
    workspace puts them — `CLAUDE.md` forbids unit tests, so there are no
    in-file `#[cfg(test)]` modules to miss."""
    if name.endswith(".rs"):
        return "rust_test" if "tests" in name.split("/") else "rust_source"
    if name.endswith(".md"):
        return "markdown"
    return "other"


def test_churn(owner: str, window: int = TEST_CHURN_WINDOW) -> dict:
    """Section 7: "flag when >=30% of recent iterations are test-only changes"
    — "the characteristic shape of a loop that has run out of real work but not
    out of budget".

    Per commit, because section 7 says *iterations* and section 4's contract
    makes one commit per experiment. Unlike the spec-drift detector, which that
    section deliberately widened to the campaign, nothing here is defeated by
    one-target commits: a commit is exactly the unit the heuristic is about.

    **Only commits that touch Rust are classifiable, and the denominator says
    so.** A markdown-only commit is neither test churn nor source work, and the
    harness loop's tests are `selftest_cases` *inside* `harness/hj`, so no path
    can distinguish them from the code they check. Reporting a denominator of
    nothing as 0% would say "healthy" about a loop this measure cannot see, so
    it reports `flagged` only when there is something to have seen.
    """
    raw = subprocess.run(
        ["git", "-C", str(REPO), "log", f"-n{window * 8}", "--numstat", "--format=%x00%B%x00"],
        capture_output=True,
        text=True,
        check=False,
    ).stdout
    credit = audit_credit(owner)
    commits: list[tuple[set[str], bool | None]] = []
    skipped = 0
    pending: str | None = None
    for block in raw.split("\0"):
        if re.search(rf"^loop:\s*{re.escape(owner)}\s*$", block, re.MULTILINE):
            # The campaign trailer is in *this* block, the message. The next
            # block is the numstat and has no trailers in it at all — reading
            # the id from there found nothing, so every commit looked unjudged
            # and the measure went permanently silent.
            trailer = re.search(r"^campaign:\s*(\S+)\s*$", block, re.MULTILINE)
            pending = trailer.group(1) if trailer else ""
            continue
        if pending is None:
            continue
        kinds = {
            classify_diff_path(parts[2])
            for line in block.splitlines()
            if len(parts := line.split("\t")) == 3 and parts[0].isdigit()
        }
        credited = credit.get(pending) if pending else None
        pending = None
        # The window counts *judged* commits, and walks past the rest. With
        # three workers a round is about eighteen commits, so a window of the
        # last twenty raw commits is always the round in flight — the one no
        # audit has reached — and the measure would report nothing, for ever.
        # Skipping backwards to the last twenty the audit has settled is what
        # makes it a trend rather than a permanent shrug.
        if credited is None:
            skipped += 1
            continue
        commits.append((kinds, credited))
        if len(commits) >= window:
            break
    return {**test_churn_ratio(commits), "unsettled": skipped}


CREDITED_TERMS = ("gap_named", "sections_clean")


def audit_credit(owner: str) -> dict[str, bool]:
    """Per campaign: did the audit credit it with moving something?

    `settled_term` is written when the audit settles a campaign, and is
    `gap_named` or `sections_clean` when it moved the number, `carried` when it
    did not. Audit-derived on purpose — the commit's own `audit:` trailer says
    what the campaign *intended*, and section 5 is explicit that the auditor
    decides whether it happened, so a padding campaign could write the trailer
    it liked. A campaign with no settled term yet is `None` rather than False.
    """
    settled: dict[str, bool] = {}
    for row in session_rows():
        if row.get("loop") != owner:
            continue
        term = row.get("settled_term")
        if term:
            settled[row["campaign"]] = term in CREDITED_TERMS
    return settled


def test_churn_ratio(commits: list[tuple[set[str], bool | None]]) -> dict:
    """The arithmetic of `test_churn`, over one (buckets, credited) per commit.

    A test-only commit from a campaign the audit credited with closing a named
    gap is **conformance work, not churn**, and leaves the numerator. That is
    what this loop is for: late in a phase the remaining gaps are increasingly
    "the claim holds and nothing asserts it", and closing one produces a
    test-only commit by construction. All three core workers crossed the flag
    at once (36%, 57%, 64%) while four of five recent test-only commits carried
    `gaps -> clean` — a flag that fires on the deliverable is one nobody keeps
    reading, which is the failure the strict reading was chosen to avoid.

    A campaign the audit has not settled yet is **unclassifiable**, and leaves
    the denominator rather than counting either way. That is the same rule this
    measure already applies to a commit it cannot see into: reporting a
    denominator of nothing as 0% would say "healthy" about work nothing has
    judged. The cost is that the number lags the audit by a round, which is
    what `progress` already does and is the price of it being audit-derived
    rather than self-reported.
    """
    judged = [(kinds, credited) for kinds, credited in commits if credited is not None]
    classifiable = [kinds for kinds, _ in judged if kinds & {"rust_test", "rust_source"}]
    # Strictly nothing else, not merely "no source". A commit that adds a test
    # and edits `design/` did other work, and for a conformance loop that other
    # work is often the deliverable — the test carries the claim the spec edit
    # settles. The loose reading measured 71% against a core loop that was
    # closing gaps at the time, which is a flag nobody would keep believing.
    test_only = [
        kinds
        for kinds, credited in judged
        if kinds == {"rust_test"} and not credited
    ]
    ratio = len(test_only) / len(classifiable) if classifiable else None
    return {
        "commits": len(commits),
        "unsettled": len(commits) - len(judged),
        "classifiable": len(classifiable),
        "test_only": len(test_only),
        "conformance": len([1 for kinds, credited in judged if kinds == {"rust_test"} and credited]),
        "ratio": ratio,
        "flagged": ratio is not None and ratio >= TEST_CHURN_FLAG,
    }


def unsupported_claims(owner: str) -> int:
    """Consecutive closes that claimed movement the repository does not show.

    Section 7's other ralph heuristic is to "cap consecutive 'done' signals so
    a loop that has decided it is finished cannot keep saying so". The cap
    itself already exists and is the stall rule — a campaign closing
    `confirmed` with no computed progress increments
    `trailing_without_progress` exactly like one closing `no-movement` — so
    this adds no second stop condition. What was missing is the *diagnosis*:
    those two shapes stop the loop identically and mean opposite things. A run
    of honest `no-movement` closes is a loop that has hit something hard; a run
    of `confirmed` closes with nothing behind them is a loop that has decided
    it is finished, and only the second is the failure section 7 names.
    """
    trailing = 0
    for campaign in reversed(judged_campaigns(owner)):
        if campaign.get("progress"):
            break
        if campaign.get("outcome") in ("confirmed", "partial"):
            trailing += 1
    return trailing


def campaign_diffstat() -> dict[str, dict[str, int]]:
    """Lines a campaign added and deleted, split by what kind of line it is.

    Keyed on the `campaign:` trailer rather than a date range, because the
    harness's own commits land between a campaign's own and would otherwise be
    charged to whichever one they interrupted. That mattered little with one
    writer and matters a great deal with three: `line_counts` snapshots the
    whole tree at close, so under workers a campaign's row carries whatever
    the other two merged around it.

    The `tests` split follows `loc_per_crate`'s: a path component named
    `tests`, which is where this workspace puts them — `CLAUDE.md` forbids
    unit tests, so there are no in-file `#[cfg(test)]` modules to miss.
    """
    raw = subprocess.run(
        ["git", "-C", str(REPO), "log", "--numstat", "--format=%x00%B%x00"],
        capture_output=True,
        text=True,
        check=False,
    ).stdout
    stats: dict[str, dict[str, int]] = {}
    current = None
    for block in raw.split("\0"):
        match = re.search(r"^campaign:\s*(\S+)\s*$", block, re.MULTILINE)
        if match:
            current = match.group(1)
            continue
        if current is None:
            continue
        row = stats.setdefault(current, {})
        for line in block.splitlines():
            parts = line.split("\t")
            if len(parts) != 3 or not parts[0].isdigit() or not parts[1].isdigit():
                continue
            added, deleted, name = int(parts[0]), int(parts[1]), parts[2]
            kind = classify_diff_path(name)
            row[f"{kind}_added"] = row.get(f"{kind}_added", 0) + added
            row[f"{kind}_deleted"] = row.get(f"{kind}_deleted", 0) + deleted
        current = None
    return stats


def line_counts() -> dict[str, int]:
    """Tracked lines by language, for the size-over-time chart.

    Tracked only, so `target/` and the transcripts never enter it. Python is
    found by shebang as well as by extension, because the harness's own tools —
    `hj`, `dashboard/serve`, `corpus` — are extensionless commands and are most
    of the Python here.

    `reference/` is excluded. It is 15,000 lines of generated LSP specification
    that would be four fifths of the markdown total and would never move, so
    including it turns a chart about how the project grows into a flat line
    with a step where the vendoring landed. `vendor/` is *not* excluded: it is
    ours to edit, and the rope newtype sweep is real work that should show.
    """
    counts = {"rust": 0, "python": 0, "markdown": 0}
    for name in git("ls-files").split("\n"):
        if not name or name.startswith("reference/"):
            continue
        path = REPO / name
        try:
            data = path.read_bytes()
        except OSError:
            continue
        if name.endswith(".rs"):
            kind = "rust"
        elif name.endswith(".py") or PYTHON_SHEBANG.match(data[:64]):
            kind = "python"
        elif name.endswith(".md"):
            kind = "markdown"
        else:
            continue
        counts[kind] += data.count(b"\n") + (1 if data and not data.endswith(b"\n") else 0)
    return counts


def line_counts_at(commit: str) -> dict[str, int]:
    """The same counts at an arbitrary commit, for backfilling closed rows.

    One `ls-tree` and one batched `cat-file` per commit rather than a read per
    file: the shebang test needs contents, and a `cat-file` per blob would be
    a couple of hundred processes per campaign.
    """
    counts = {"rust": 0, "python": 0, "markdown": 0}
    wanted: list[tuple[str, str]] = []
    for line in git("ls-tree", "-r", commit).split("\n"):
        if not line or "\t" not in line:
            continue
        meta, name = line.split("\t", 1)
        parts = meta.split()
        if len(parts) != 3 or parts[1] != "blob" or name.startswith("reference/"):
            continue
        if name.endswith((".rs", ".md", ".py")) or "/" in name:
            wanted.append((parts[2], name))
    if not wanted:
        return counts
    result = subprocess.run(
        ["git", "-C", str(REPO), "cat-file", "--batch"],
        input=("\n".join(sha for sha, _ in wanted) + "\n").encode(),
        capture_output=True,
        text=False,
        check=False,
    )
    stream, offset = result.stdout, 0
    for _, name in wanted:
        newline = stream.find(b"\n", offset)
        if newline < 0:
            break
        header = stream[offset:newline].split()
        if len(header) < 3:
            break
        size = int(header[2])
        body = stream[newline + 1 : newline + 1 + size]
        offset = newline + 1 + size + 1
        if name.endswith(".rs"):
            kind = "rust"
        elif name.endswith(".py") or PYTHON_SHEBANG.match(body[:64]):
            kind = "python"
        elif name.endswith(".md"):
            kind = "markdown"
        else:
            continue
        counts[kind] += body.count(b"\n") + (1 if body and not body.endswith(b"\n") else 0)
    return counts


def cmd_backfill_lines(args: argparse.Namespace) -> int:
    """Give already-closed campaigns their line counts, so the chart has a
    history rather than starting at whatever runs next."""
    rows = session_rows()
    have = {row["campaign"] for row in rows if row.get("lines")}
    todo = [
        row
        for row in rows
        if row.get("outcome") and row.get("end_commit") and row["campaign"] not in have
    ]
    if not todo:
        print("backfill-lines: every closed campaign already has counts")
        return 0
    for row in todo:
        counts = line_counts_at(row["end_commit"])
        append_jsonl(
            sessions_path(),
            {
                "campaign": row["campaign"],
                "loop": row.get("loop"),
                "ended": row.get("ended"),
                "outcome": row.get("outcome"),
                "lines": counts,
                "backfilled": True,
            },
        )
        print(f"  {row['campaign'][:8]}  {counts}")
    commit_harness_state([sessions_path()], f"line counts for {len(todo)} closed campaign(s)")
    print(f"backfill-lines: {len(todo)} campaign(s)")
    return 0


def replay_progress(rule: int) -> list[dict]:
    """Recompute `progress` for every closed campaign under a given rule.

    The point is the backtest. Every change to what progress means is a metric
    redefinition, and the only honest way to make one is to see which past
    campaigns it reclassifies before it decides anything live.

    Rule 1 is reconstructed rather than read: `tests_after` was never recorded
    on a close row, so it comes from the last metrics row at or before the
    close. Everything else the rows already carry.
    """
    by_campaign: dict[str, list[dict]] = {}
    for row in session_rows():
        by_campaign.setdefault(row["campaign"], []).append(row)

    metrics: dict[str, list[dict]] = {}
    for owner in load_phase().loops:
        metrics[owner] = [row for row in read_jsonl(metrics_path(owner)) if row.get("ts")]

    out = []
    for campaign_id, rows in by_campaign.items():
        opened = rows[0]
        closed = next((row for row in rows if row.get("outcome")), None)
        if closed is None:
            continue
        merged: dict = {}
        for row in rows:
            merged.update(row)
        owner = merged.get("loop") or ""
        ended = merged.get("ended") or ""
        tests_after = None
        for row in metrics.get(owner, []):
            if row["ts"] <= ended and "tests" in row:
                tests_after = row["tests"]
        tests_before = opened.get("tests")

        if rule == 1:
            verdict = bool(
                (merged.get("sections_clean", 0) > opened.get("sections_clean", 0))
                or (merged.get("open_gaps", 0) < opened.get("open_gaps", 0))
                or (
                    tests_before is not None
                    and tests_after is not None
                    and tests_after > tests_before
                )
            )
            term = (
                "sections_clean"
                if merged.get("sections_clean", 0) > opened.get("sections_clean", 0)
                else "open_gaps"
                if merged.get("open_gaps", 0) < opened.get("open_gaps", 0)
                else "tests"
                if verdict
                else "none"
            )
        elif rule == 2:
            started = opened.get("started") or ""
            # Audits that ran while this campaign was open. Rule 2 only trusts
            # an audit-derived term when the instrument actually ran.
            window = [
                audit
                for audit in read_jsonl(GAP_LOG)
                if started < (audit.get("ts") or "") <= (ended or "\uffff")
            ]
            targets = {
                anchor.strip()
                for anchor in (merged.get("target") or "").split(",")
                if anchor.strip()
            }
            # A gap this campaign named, closed by an audit that saw its work.
            # `open_gaps` falling is variance when a rotating auditor reaches
            # new sections in the same run — campaign 51628b98 cleaned thirteen
            # sections while the count went *up* by five.
            named_closed = False
            for audit in window:
                for section in audit.get("sections_audited") or []:
                    if section in targets and audit.get("closed"):
                        named_closed = True
            cleaned = merged.get("sections_clean", 0) > opened.get("sections_clean", 0)
            # Tests only count where nothing else could have: no audit ran, so
            # the work is genuinely unmeasured. §7's own gaming table calls the
            # test count a ratchet, which is a floor, not a reward.
            tests_only = (
                not window
                and tests_before is not None
                and tests_after is not None
                and tests_after > tests_before
            )
            verdict = bool(cleaned or named_closed or tests_only)
            term = (
                "sections_clean"
                if cleaned
                else "gap_named"
                if named_closed
                else "tests_unmeasured"
                if tests_only
                else "none"
            )
        elif rule in (3, 4):
            started = opened.get("started") or ""
            window = [
                audit
                for audit in read_jsonl(GAP_LOG)
                if started < (audit.get("ts") or "") <= (ended or "￿")
            ]
            # Per audit rather than over the union of the window, because rule
            # 2 was per audit: a section reached by one audit and a gap closed
            # by a later one is not that campaign's gap, and unioning first
            # would make rule 3 *looser* than the rule it tightens in exactly
            # that case. The same `gap_attribution` decides live and in replay.
            attributed = ""
            for audit in window:
                closed_then = {
                    identifier: "" for identifier in audit.get("closed") or []
                } | {
                    entry["id"]: entry.get("section") or ""
                    for entry in audit.get("closed_gaps") or []
                }
                attributed = (
                    gap_attribution(merged, closed_then, set(audit.get("sections_audited") or []))
                    or attributed
                )
            cleaned = merged.get("sections_clean", 0) > opened.get("sections_clean", 0)
            tests_only = (
                not window
                and tests_before is not None
                and tests_after is not None
                and tests_after > tests_before
            )
            # `settle_progress` ORs in what the close row already decided, and
            # rules 1 and 2 modelled only the audit-side term. That was near
            # enough while the audit-side term was loose; under rule 3 it is
            # not, and the difference is not cosmetic — the audit-side term
            # alone reports a longest no-progress run of 10 for campaigns the
            # loop scored at close and never came near stalling on. The close
            # row is read directly rather than from `merged`, which also
            # carries the settled row's answer and would make this circular.
            carried = bool(closed.get("progress"))
            # Rule 4 is rule 3 plus §7's fifth form, which rule 3 did not
            # have because nothing computed a frontier. It is a disjunct, so
            # it can only reclassify a campaign from no-progress to progress
            # — and before phase 2a no metrics row carries an axis, so it
            # reclassifies none. That is what the backtest is for and it is
            # the whole justification for bumping the rule without a sweep:
            # `hj progress-replay --rule 4` against rule 3 differs nowhere.
            advanced = rule == 4 and campaign_frontier_advance(
                [row for row in metrics.get(owner, []) if row.get("phase") == merged.get("phase")],
                campaign_id,
            )
            verdict = bool(cleaned or attributed or tests_only or carried or advanced)
            term = (
                "sections_clean"
                if cleaned
                else attributed
                if attributed
                else "tests_unmeasured"
                if tests_only
                else "carried"
                if carried
                else "frontier"
                if advanced
                else "none"
            )
        else:
            die(f"progress-replay: no rule {rule}")
        out.append(
            {
                "campaign": campaign_id,
                "loop": owner,
                "worker": merged.get("worker"),
                "ended": ended,
                "recorded": bool(merged.get("progress")),
                "replayed": verdict,
                "term": term,
                "commits": merged.get("commits"),
            }
        )
    out.sort(key=lambda row: row["ended"])
    return out


def cmd_progress_replay(args: argparse.Namespace) -> int:
    rows = replay_progress(args.rule)
    mismatched = [row for row in rows if row["recorded"] != row["replayed"]]
    counts: dict[str, int] = {}
    for row in rows:
        counts[row["term"]] = counts.get(row["term"], 0) + 1
    print(f"progress-replay: rule {args.rule}, {len(rows)} closed campaign(s)")
    for term, count in sorted(counts.items(), key=lambda pair: -pair[1]):
        print(f"  {term:16} {count}")
    longest = run = 0
    for row in rows:
        run = run + 1 if not row["replayed"] else 0
        longest = max(longest, run)
    print(f"  longest run without progress: {longest}")
    if mismatched:
        print(f"\n  {len(mismatched)} campaign(s) differ from what was recorded:")
        for row in mismatched:
            print(
                f"    {row['campaign'][:8]} {row['ended'][:19]}"
                f"  recorded={row['recorded']} replayed={row['replayed']} ({row['term']})"
            )
    elif args.rule == PROGRESS_RULE:
        print("  every verdict matches what was recorded.")
    return 1 if mismatched and args.rule == PROGRESS_RULE else 0


def earned_consolidation_credit(merged: dict, opened: dict, current: dict) -> bool:
    """Did this campaign delete code and the oracle agree nothing broke?

    Removal was unscoreable: every progress term needed something to go *up*,
    so a campaign that deleted five hundred redundant lines with the gate green
    counted as no progress and pushed the loop toward a stall. That is the one
    thing worth fixing about the incentive — and it is worth being careful that
    it is the *only* thing, because this is the building phase and adding code
    is what building looks like. `design/loops.md` §11 rejects a size ratchet
    during exploration precisely because it "would have applied the pressure
    during exactly the iterations that should be free to be wasteful", and that
    argument reaches softer pressure too.

    So this is credit for a thing done, never a penalty for a thing not done.
    Nothing here makes a campaign that adds score any worse than it did.

    All four conjuncts are needed, and each closes a way of earning the credit
    without doing the work:

    * non-test lines actually fell — deleting tests does not qualify;
    * no section that was clean stopped being clean;
    * no gap opened in a section this campaign named;
    * the test count did not fall, so coverage was not traded for size.
    """
    diff = merged.get("diff") or {}
    removed = diff.get("rust_source_deleted", 0) - diff.get("rust_source_added", 0)
    if removed <= 0:
        return False
    if current["sections_clean"] < opened.get("sections_clean", 0):
        return False
    before_tests, after_tests = merged.get("tests_before"), merged.get("tests_after")
    if before_tests is not None and after_tests is not None and after_tests < before_tests:
        return False
    return True


# A gap is named `anchor[id]` everywhere a campaign is asked to name one — in
# the prompt's gap list, in `hj claim`, and on the TARGET line. The id is
# `gap_id`'s ten hex characters.
GAP_REFERENCE = re.compile(r"\[([0-9a-f]{10})\]\s*$")


def named_targets(merged: dict) -> tuple[set[str], set[str], set[str]]:
    """What a campaign said it was working on: every anchor, the anchors it
    named *without* a gap id, and the gap ids.

    Two sources, because a campaign can be handed targets and can also choose
    them: `claimed` is what the planner assigned and `hj claim` granted, and
    `target` is the TARGET line it closed with. A loop that runs one campaign
    at a time has no planner, so `claimed` is empty and the TARGET line is the
    whole of it.

    The split matters for attribution. Naming `a#x[abc1234567]` is a claim
    about one gap and is judged on that gap; naming `a#x` is a claim about the
    section and is judged on any gap in it.
    """
    anchors: set[str] = set()
    loose: set[str] = set()
    ids: set[str] = set()
    for field in [merged.get("target") or ""] + list(merged.get("claimed") or []):
        for piece in str(field).split(","):
            piece = piece.strip()
            if not piece:
                continue
            reference = GAP_REFERENCE.search(piece)
            if reference:
                ids.add(reference.group(1))
                anchors.add(piece[: reference.start()].strip())
            else:
                anchors.add(piece)
                loose.add(piece)
    return anchors, loose, ids


def gap_attribution(merged: dict, closed: dict[str, str], audited: set[str]) -> str:
    """Which gap closure, if any, this campaign gets credit for.

    `design/loops.md` section 5: "attribution is by named gap rather than by
    count delta". Rule 2 implemented the *round* version of that — the
    campaign named a section the audit reached, and the round closed something
    — which credits a campaign for a sibling worker's work and was the open
    gap on that section. This is the exact version.

    `closed` maps a closed gap's id to its section. The section is what the
    gap log did not carry: an id is a hash of the section and the claim, so it
    cannot be read back out, and a gap that has closed is no longer in the
    audit to look up. Rows written before `closed_gaps` existed map to the
    empty string, and those fall back to the round-wide reading rather than
    silently scoring zero — a historical row cannot be re-attributed, and
    pretending otherwise would rewrite the record rather than the rule.
    """
    _, loose, ids = named_targets(merged)
    if ids & set(closed):
        return "gap_named"
    sections = {section for section in closed.values() if section}
    if loose & sections:
        return "gap_named"
    if ids or sections:
        return ""
    anchors, _, _ = named_targets(merged)
    return "gap_named_round" if (anchors & audited and closed) else ""


def settle_progress(
    config: LoopConfig, stamp: str, audited: list[str], closed: dict[str, str]
) -> int:
    """Re-judge campaigns that closed since the previous audit.

    A campaign's progress is settled by the instrument, and under workers the
    instrument has not run when the campaign closes: a worker reads
    `state/audit/` from its own worktree, the audit runs afterwards in the
    integration checkout, so `after` at close is the same reading as `before`
    at open. Every worker campaign would score on the one remaining term
    forever, and `trailing_without_progress` could never increment — the loop
    would have no stopping condition but money.

    So this runs at the audit, which is the first moment the answer exists. It
    appends rather than rewrites: readers merge a campaign's rows in order, so
    a later row supersedes, and the close row stays as the record of what was
    knowable at close.

    Attribution is by named gap rather than by count. `open_gaps` falling is
    variance when a rotating auditor reaches new sections in the same run —
    campaign 51628b98 cleaned thirteen sections while the count went *up* by
    five. A campaign gets credit for a gap it named closing, and gaps closed
    that nobody named get round credit and no campaign credit, which is what
    makes padding a campaign with unrelated work score worse than not.
    `gap_attribution` is where "a gap it named" is decided.
    """
    rows: dict[str, list[dict]] = {}
    for row in session_rows():
        if row.get("loop") == config.owner:
            rows.setdefault(row["campaign"], []).append(row)

    previous = [row for row in read_jsonl(GAP_LOG) if (row.get("ts") or "") < stamp]
    since = previous[-1]["ts"] if previous else ""
    current = audit_counts(config.docs)
    audited_sections = set(audited)
    settled = 0

    for campaign_id, campaign_rows in rows.items():
        merged: dict = {}
        for row in campaign_rows:
            merged.update(row)
        ended = merged.get("ended") or ""
        if not merged.get("outcome") or not (since < ended <= stamp):
            continue
        if merged.get("settled_at"):
            continue
        opened = campaign_rows[0]
        attributed = gap_attribution(merged, closed, audited_sections)
        cleaned = current["sections_clean"] > opened.get("sections_clean", 0)
        consolidated = earned_consolidation_credit(merged, opened, current)
        # Recomputed rather than left to the `merged.get("progress")` disjunct
        # below, which would carry it anyway: what would be lost is the *term*.
        # A settled row saying "carried" where the frontier is what moved makes
        # the one term §7 added last unreadable in the history, and the row
        # stamps `progress_rule` as though it had computed all five.
        advanced = campaign_advanced_the_frontier(
            config.owner, campaign_id, merged.get("phase") or ""
        )
        progress = bool(
            cleaned or attributed or consolidated or advanced or merged.get("progress")
        )
        append_jsonl(
            sessions_path(),
            {
                "campaign": campaign_id,
                "loop": config.owner,
                "settled_at": stamp,
                "progress": progress,
                "progress_rule": PROGRESS_RULE,
                "audited": True,
                "settled_term": (
                    "sections_clean"
                    if cleaned
                    else attributed
                    if attributed
                    else "consolidation"
                    if consolidated
                    else "frontier"
                    if advanced
                    else "carried"
                ),
                **current,
            },
        )
        settled += 1
    if settled:
        print(f"audit: settled progress for {settled} campaign(s)")
    return settled


def cmd_campaign_close(args: argparse.Namespace) -> int:
    phase, config = loop_config(args.loop)
    rows = [row for row in session_rows() if row.get("campaign") == args.id]
    if not rows:
        die(f"no campaign {args.id} in state/sessions.jsonl")
    opened = rows[0]
    before = {k: opened.get(k, 0) for k in ("sections_clean", "open_gaps")}
    after = audit_counts(config.docs)
    commits = commits_for_campaign(args.id)
    metrics = read_jsonl(metrics_path(config.owner))
    tests_before = opened.get("tests")
    tests_after = metrics[-1].get("tests") if metrics else None

    reconciled = decisions_reconciled(args.id)

    # All five of §7's forms. The fifth — "a frontier point being added that
    # is not dominated by an existing one" — was absent while nothing computed
    # a frontier, and its absence was not neutral: a campaign whose only
    # result was a non-dominated point scored as no progress and counted
    # toward the stall threshold, which is the one outcome §7 most wants a
    # loop to be free to reach.
    #
    # It reads the metrics history rather than a corpus, so it is answerable
    # today and answers False today: `record` writes no axis before there is
    # a tuning loop. `hj progress-replay --rule 4` against rule 3 is the
    # backtest, and it differs on nothing.
    advanced = campaign_advanced_the_frontier(config.owner, args.id, phase.phase)
    progress = (
        after["sections_clean"] > before["sections_clean"]
        or after["open_gaps"] < before["open_gaps"]
        or (tests_before is not None and tests_after is not None and tests_after > tests_before)
        or bool(reconciled)
        or advanced
    )
    drift = spec_drift(args.id, args.target)
    prompts = prompt_drift(args.id, config)
    # `audits_for`, not the whole log: an audit covers one loop's documents and
    # the log is shared, so `read_jsonl(GAP_LOG)[-1]` is whichever loop audited
    # most recently. That is how campaign 2e588730 was judged as audited by the
    # core loop's audit of core.md, two seconds after the harness loop's own
    # audit had run *before* it opened — and so closed `confirmed` with
    # `progress` false, tripping §7's "a loop that has decided it is finished"
    # notice, which is the most alarming line the harness can print, on a
    # campaign whose four commits nothing had looked at yet.
    #
    # Against the campaign's last commit rather than its start, for the same
    # reason one step further in: `state/phase.toml` excludes a campaign with
    # no audit since it opened so that the cadence cannot stop the loop, and an
    # audit that ran while the campaign was still working cannot see what it
    # committed afterwards. The commits are the work; the open time is only
    # when the session began reading.
    audited = campaign_was_audited(
        audits_for(config.docs),
        [commit_time(commit) for commit in commits],
        opened.get("started") or "",
    )

    # The last two fields of section 16's row spec. The transcript path is
    # known before the session starts and is recorded whether or not the file
    # is there — a row that points at a transcript which was dropped under the
    # retention rule is more useful than a row that points at nothing.
    transcript = transcript_of(config.owner, args.id)
    tokens = token_counts(measure_transcript(transcript))

    append_jsonl(
        sessions_path(),
        {
            "campaign": args.id,
            "loop": config.owner,
            "phase": phase.phase,
            "target": args.target,
            "ended": now(),
            "end_commit": head_sha(),
            "commits": len(commits),
            "outcome": args.outcome,
            "transcript": transcript or None,
            "tokens": tokens,
            "progress": progress,
            "decisions_reconciled": reconciled,
            "audited": audited,
            "spec_drift": drift,
            "prompt_drift": prompts,
            "lines": line_counts(),
            # This campaign's own diff, split by kind. `lines` above is a
            # whole-tree snapshot and under workers carries whatever the
            # other two merged around it; this does not.
            "diff": campaign_diffstat().get(args.id, {}),
            "loc_nontest": sum(loc_per_crate()[0].values()),
            "tests_before": tests_before,
            "tests_after": tests_after,
            "worker": opened.get("worker") or config.owner,
            # What rule computed `progress` on this row. Every later change
            # to that definition is a metric redefinition, and a chart that
            # spans one without saying so is lying quietly.
            "progress_rule": PROGRESS_RULE,
            **after,
        },
    )
    release_claims(config.owner, args.id)
    commit_harness_state([sessions_path()], f"close campaign {args.id[:8]} ({args.outcome})")
    print(f"campaign {args.id[:8]} closed: {args.outcome}, {len(commits)} commit(s), progress={progress}")
    if reconciled:
        print(f"campaign: reconciled the provisional sites of {', '.join(reconciled)}")
    if drift:
        print(
            "campaign: flagged — this campaign edited design/ and code in the same run"
            + (", in the document its own target names" if drift["touches_target_document"] else "")
            + ". Not a failure; it goes to the dashboard for a human to read."
        )
    if prompts:
        print(
            "campaign: flagged — this campaign edited "
            + ", ".join(prompts["prompts"])
            + (
                ", which is the template its own prompt was rendered from"
                if prompts["touches_own_prompt"]
                else ""
            )
            + ". design/loops.md section 16 calls a prompt revision the one "
            "intervention that cannot be replayed, so the metrics either side of "
            "it are not comparable. Not a failure; see harness-009."
        )
        # `harness-009` is answered "flag it and log it": the flag above reaches
        # the dashboard, and this reaches the log §16 calls the mechanism. The
        # commit is folded into the close rather than taken separately, so a
        # campaign that revised a prompt and a campaign that did not leave the
        # same number of commits behind.
        revised = log_prompt_revision(args.id, phase, prompts)
        if revised:
            commit_harness_state([INTERVENTIONS], f"prompt-revised by {args.id[:8]}")
            print(f"campaign: logged a prompt-revised intervention for {', '.join(revised)}")
    return 0


def campaign_is_alive(campaign_id: str, rows: list[dict] | None = None) -> bool:
    """Is this campaign still running, as far as anyone outside it can tell?

    Answered from `sessions.jsonl`, **never from the process table**, because
    the process table is not shared. Campaigns run under the OS sandbox
    (`design/loops.md` section 13, layer 3), which puts each in its own PID
    namespace: from inside a campaign, `pgrep` and `/proc` cannot see a sibling
    campaign's runner at all. The previous implementation asked exactly that,
    so from inside any campaign every live sibling looked dead — and since a
    stale claim is taken by design, `hj claim` granted every target another
    worker already held. The round that found this ran two campaigns to one
    result and left a thirteen-hunk merge for a person.

    `sessions.jsonl` is in the integration checkout, written by the runner from
    outside the sandbox and readable from every worktree, so it is the one
    account of who is running that all parties see the same way.

    **Uncertainty means alive**, which is the asymmetry: a claim refused in
    error costs a worker picking a different target from a list it already has;
    a claim granted in error costs a duplicate campaign and a merge. So a row
    whose timestamp will not parse is treated as running.

    The age backstop is only for what a crash leaves behind — a campaign that
    dies without its close row has no `outcome` and would otherwise hold its
    claims until someone noticed. `hj campaign-reap` is the real recovery and
    runs at every loop start; this stops a claim outliving the fleet in between.
    """
    for row in rows if rows is not None else session_rows():
        if row.get("campaign") != campaign_id:
            continue
        if row.get("outcome"):
            return False
    started = next(
        (
            row.get("started")
            for row in (rows if rows is not None else session_rows())
            if row.get("campaign") == campaign_id and row.get("started")
        ),
        None,
    )
    if started is None:
        return False
    try:
        age = (datetime.now(timezone.utc) - datetime.fromisoformat(started)).total_seconds()
    except ValueError:
        return True
    return age < CAMPAIGN_MAX_LIFETIME_SECONDS


def campaign_process_is_running(campaign_id: str) -> bool:
    """Whether the runner's process actually exists, for the reaper alone.

    Valid only where the fleet's PID namespace is — `harness/loop` startup,
    which is the one caller. Do not use this to answer "is a sibling working on
    this", which is `campaign_is_alive`: inside a campaign's sandbox this
    returns False for every live campaign in the fleet.

    `pgrep -f` matches any command line containing the string, including a
    shell that merely mentions it — a watcher looking for the loop matched
    itself and reported the loop as running. So the match is confirmed against
    the process's actual argv: some argument must *be* the adapter, followed by
    `campaign` and this id."""
    result = subprocess.run(
        ["pgrep", "-f", f"adapter campaign {campaign_id}"], capture_output=True, text=True, check=False
    )
    for pid in result.stdout.split():
        try:
            argv = Path(f"/proc/{pid}/cmdline").read_bytes().decode().split("\0")
        except OSError:
            continue
        for index, argument in enumerate(argv[:-2]):
            if argument.endswith("/adapter") and argv[index + 1 : index + 3] == ["campaign", campaign_id]:
                return True
    return False


def cmd_campaign_reap(args: argparse.Namespace) -> int:
    """Crash recovery. `design/loops.md` section 14.

    A campaign whose process is gone but whose record is still open is not a
    neutral leftover. It is invisible to stall detection — `cmd_stall` only
    counts campaigns that closed — so a loop that crashes repeatedly looks
    idle rather than broken, which is the opposite of what the stall rule
    exists to catch.

    The design puts this on the supervisor's tick. There is no supervisor at
    phase 1a, so it runs at `harness/loop` startup and on demand. It does not
    resume anything: the context is gone, the hypothesis is written down, and
    a fresh campaign can pick the thread up. Resuming from the session id
    stays a human action, which keeps the line clear — the harness keeps
    things moving, a person investigates.

    It does not revert the worktree either, which section 14 also asks of the
    supervisor. Here that would be actively wrong: with a single tree and no
    worktrees per loop, the uncommitted work at this moment belongs to
    whichever campaign is *live*, not to the dead one, and green-or-revert
    already handles the live one at its own close.
    """
    phase = load_phase()
    owners = [args.loop] if args.loop else sorted(phase.loops)
    reaped = 0
    for owner in owners:
        for campaign in campaigns_of(owner):
            if campaign.get("outcome"):
                continue
            campaign_id = campaign.get("campaign", "")
            # The process table, not `campaign_is_alive`: this is the one place
            # that wants to know whether the runner exists, and it is the one
            # caller that runs where the fleet's PID namespace is.
            if campaign_process_is_running(campaign_id):
                print(f"reap: {campaign_id[:8]} is still running; left alone")
                continue
            # A campaign is not alive between `campaign-open` returning and the
            # runner appearing in the process table. With one loop that window
            # was unreachable, since nothing else ran a reap. With several
            # workers it is reached routinely: each starts by reaping, and a
            # sibling that opened a second ago has a record and no process yet.
            # Killing it would close a campaign that then runs to completion
            # unrecorded, so a campaign younger than the grace period is left
            # alone whatever the process table says.
            started = campaign.get("started") or ""
            try:
                age = (datetime.now(timezone.utc) - datetime.fromisoformat(started)).total_seconds()
            except ValueError:
                age = REAP_GRACE_SECONDS + 1
            if age < REAP_GRACE_SECONDS:
                print(f"reap: {campaign_id[:8]} opened {age:.0f}s ago; too young to judge")
                continue
            append_jsonl(
                sessions_path(),
                {
                    "campaign": campaign_id,
                    "loop": owner,
                    "phase": campaign.get("phase", phase.phase),
                    "target": campaign.get("target"),
                    "ended": now(),
                    "end_commit": head_sha(),
                    "commits": len(commits_for_campaign(campaign_id)),
                    "outcome": "crashed",
                    "progress": False,
                    "reaped": True,
                    **audit_counts(phase.loops[owner].docs),
                },
            )
            print(f"reap: {campaign_id[:8]} had no process and no outcome; closed as crashed")
            reaped += 1
    if reaped:
        commit_harness_state([sessions_path()], f"reap {reaped} abandoned campaign(s)")
    else:
        print("reap: nothing to close")
    return 0


def transcript_of(owner: str, campaign_id: str) -> str:
    """Where the teed stream for a campaign is, asked of the adapter.

    Never composed here. `design/loops.md` section 17 puts the transcript
    layout on the vendor's side of the seam along with everything else about
    the runner, and `harness/adapter` is the one file allowed to know it.
    """
    return subprocess.run(
        [str(Path(__file__).resolve().parent / "adapter"), "transcript-path", owner, campaign_id],
        capture_output=True, text=True, check=False,
    ).stdout.strip()


def prompt_file_of(owner: str, campaign_id: str) -> str:
    """Where the rendered prompt is kept, asked of the adapter for
    `transcript_of`'s reason."""
    return subprocess.run(
        [str(Path(__file__).resolve().parent / "adapter"), "prompt-path", owner, campaign_id],
        capture_output=True, text=True, check=False,
    ).stdout.strip()


def measure_transcript(transcript: str) -> dict:
    if not transcript or not Path(transcript).exists():
        return {}
    measured = subprocess.run(
        [str(Path(__file__).resolve().parent / "adapter"), "cost", transcript],
        capture_output=True, text=True, check=False,
    ).stdout.strip()
    try:
        return json.loads(measured or "{}")
    except json.JSONDecodeError:
        return {}


def token_counts(numbers: dict) -> dict | None:
    """The `tokens` field of section 16's session row.

    Four counts rather than one, because the one that matters depends on the
    question: output is what the campaign produced and what the cost-per-gap
    ratio divides, and cache reads are what it actually spent — about 141
    tokens read for every one written.
    """
    if not numbers:
        return None
    return {
        "output": numbers.get("output_tokens"),
        "input": numbers.get("input_tokens"),
        "cache_read": numbers.get("cache_read_tokens"),
        "cache_creation": numbers.get("cache_creation_tokens"),
    }


def cost_path(owner: str) -> Path:
    return STATE / "cost" / f"{owner}.jsonl"


# What a complete campaign row carries, which is `design/loops.md` section 15's
# row spec less the fields the harness fills in from `state/sessions.jsonl`.
# `cost --refresh` re-measures exactly the rows missing one of these, so adding
# a field to the measurement and naming it here is the whole of a backfill.
COST_FIELDS = ("usd", "output_tokens", "model_seconds", "gate_seconds", "experiments")


def merge_cost_rows(rows: list[dict]) -> list[dict]:
    """Campaign rows merged by campaign id, in file order.

    Merged rather than read straight, for the same reason `campaigns_of` merges
    `state/sessions.jsonl`: the file is append-only, so re-measuring a campaign
    appends a second row for it and a naive sum then counts that campaign's
    spend twice. Nothing appended a second row until `--refresh` existed, which
    is why summing the file was correct up to now and stops being.

    File order is kept, and a merged campaign keeps the position of its first
    row, because the cumulative-spend chart reads this as a time series and an
    append-only file is already in time order.
    """
    merged: dict[str, dict] = {}
    ordered: list[dict] = []
    for row in rows:
        if row.get("kind") == "audit":
            ordered.append(row)
            continue
        key = row.get("campaign", "")
        if key in merged:
            merged[key].update(row)
            continue
        merged[key] = dict(row)
        ordered.append(merged[key])
    return ordered


def cost_rows(owner: str) -> list[dict]:
    return merge_cost_rows(read_jsonl(cost_path(owner)))


def experiment_mix(campaign: dict, numbers: dict) -> dict:
    """The committed / reverted / empty triple `design/loops.md` section 15
    keeps in the row, because "a campaign that is mostly empty experiments is
    stalling regardless of what it spent".

    An experiment is one gate run: section 4's contract is change, gate,
    commit-or-revert, so the gate is what marks the boundary. The three shares
    come from different places and only the first is exact —

    * `committed` is the campaign's commits, from git via its trailer.
    * `reverted` is revert commands seen in the stream.
    * `empty` is what is left, which is a gate run that neither committed nor
      reverted: usually a failed gate the campaign then fixed in place.

    So `empty` is a residual and inherits the error in the other two. That is
    the honest version, and it is enough for the health signal the section
    asks for — a campaign whose runs are nearly all empty is thrashing, and no
    finer definition changes that reading.
    """
    gate_runs = numbers.pop("gate_runs", 0) or 0
    committed = campaign.get("commits") or 0
    reverted = numbers.pop("reverts", 0) or 0
    return {
        "committed": committed,
        "reverted": reverted,
        "empty": max(0, gate_runs - committed - reverted),
        "gate_runs": gate_runs,
        "gate_failed": numbers.pop("gate_failed", 0) or 0,
    }


def cmd_cost(args: argparse.Namespace) -> int:
    """One row per campaign, joined on the session id.

    `design/loops.md` section 15: the campaign is the unit of accounting
    because it is the unit of *decision* — a campaign that spent its budget
    and falsified its hypothesis is a legitimate outcome, and per-iteration
    accounting would report it as a run of failures.

    No instrumentation inside the model is needed. The harness recorded which
    loop and target it launched, and the teed stream carries the numbers, so
    the join happens after the fact.
    """
    phase = load_phase()
    owners = [args.loop] if args.loop else sorted(phase.loops)
    written = 0
    backfilled = 0
    for owner in owners:
        already = {
            row.get("campaign"): row for row in cost_rows(owner) if row.get("kind") != "audit"
        }
        for campaign in campaigns_of(owner):
            campaign_id = campaign.get("campaign", "")
            if not campaign.get("outcome"):
                continue
            transcript = transcript_of(owner, campaign_id)
            # Section 16's row spec, for the campaigns that closed before the
            # two fields existed. Done here rather than in a backfill command
            # of its own because this is already the walk that measures a
            # transcript, and a second one would be a second definition of the
            # same number. Appended only when the field is actually missing:
            # the file is append-only and `campaigns_of` merges it, so an
            # unconditional append would grow it by a row per campaign per run.
            if "transcript" not in campaign or "tokens" not in campaign:
                filled = {
                    "campaign": campaign_id,
                    "loop": owner,
                    "transcript": transcript or None,
                    "tokens": token_counts(measure_transcript(transcript)),
                    "backfilled": True,
                }
                append_jsonl(sessions_path(), filled)
                backfilled += 1
            existing = already.get(campaign_id)
            if existing is not None:
                stale = any(field not in existing for field in COST_FIELDS)
                if not (args.refresh and stale):
                    continue
            numbers = measure_transcript(transcript)
            if not numbers:
                continue
            experiments = experiment_mix(campaign, numbers)
            append_jsonl(
                cost_path(owner),
                {
                    "kind": "campaign",
                    "campaign": campaign_id,
                    "loop": owner,
                    "phase": campaign.get("phase"),
                    "language": campaign.get("language"),
                    "target": campaign.get("target"),
                    "outcome": campaign.get("outcome"),
                    "commits": campaign.get("commits"),
                    "experiments": experiments,
                    "progress": campaign.get("progress"),
                    "sections_clean": campaign.get("sections_clean"),
                    "open_gaps": campaign.get("open_gaps"),
                    "prompt_sha": campaign.get("prompt_sha"),
                    "cli_version": campaign.get("cli_version"),
                    **numbers,
                },
            )
            written += 1
            print(
                f"cost: {campaign_id[:8]}  ${numbers.get('usd') or 0:.2f}  "
                f"{numbers.get('output_tokens') or 0:,} out  "
                f"{numbers.get('gate_seconds') or 0:.0f}s gate  "
                f"{experiments['committed']}c/{experiments['reverted']}r/{experiments['empty']}e"
            )
    if backfilled:
        commit_harness_state([sessions_path()], f"transcript and tokens for {backfilled} session row(s)")
        print(f"cost: filled in transcript and tokens for {backfilled} closed campaign(s)")
    if written:
        commit_harness_state([cost_path(owner) for owner in owners], f"cost rows for {written} campaign(s)")
    elif not backfilled:
        print("cost: nothing new to record")
    return 0


# The phases whose progress is measured in gaps closed. `design/loops.md`
# section 15 gives 2a a different ratio (tokens per coverage point, per
# stratum) and phase 3 another (tokens per kilobyte removed); neither has data
# until there is a corpus, so neither is computed here.
CONFORMANCE_PHASES = ("1a", "2b")


def cost_intervals(dated: list[tuple[str, int]], audits: list[dict]) -> list[dict]:
    """Tokens spent between consecutive audits, against gaps closed at each.

    Half-open on the left, closed on the right — a session that ended exactly
    at an audit's timestamp belongs to the interval that audit closes, not to
    the next one. Sessions after the last audit are in no interval yet, which
    is correct: nothing has observed what they closed.
    """
    series = []
    previous = ""
    for audit in audits:
        when = audit.get("ts") or ""
        tokens = sum(count for stamp, count in dated if previous < stamp <= when)
        closed = len(audit.get("closed", []))
        series.append(
            {
                "ts": when,
                "tokens": tokens,
                "closed": closed,
                "per_gap": (tokens / closed) if closed else None,
            }
        )
        previous = when
    return series


def cost_per_gap(owner: str, docs: list[str]) -> dict:
    """`design/loops.md` section 15's derived number for a conformance phase:
    tokens per gap closed, which "should *rise* over a run as the easy wins are
    exhausted", and which the section says should drive stopping decisions.

    Cumulative, and also per audit interval — the cumulative figure is what the
    run cost so far and the interval series is the curve that turns up. Gaps
    are only observed to close at an audit, so the audit boundaries are the
    only sampling points that exist; a campaign is attributed to the interval
    its `ended` timestamp falls in.

    All-in: audit sessions count. They close no gap themselves, but the section
    calls the auditor a fixed cost of the loop rather than a knob, and a cost
    per unit of progress that excludes the instrument understates the unit.
    """
    ended = {
        campaign.get("campaign"): campaign.get("ended") or ""
        for campaign in campaigns_of(owner)
    }
    dated: list[tuple[str, int]] = []
    for row in cost_rows(owner):
        tokens = row.get("output_tokens") or 0
        when = row.get("ts") if row.get("kind") == "audit" else ended.get(row.get("campaign"), "")
        if when:
            dated.append((when, tokens))

    series = cost_intervals(dated, audits_for(docs))
    ledger = gap_ledger(docs)
    total = sum(tokens for _, tokens in dated)
    return {
        "output_tokens": total,
        "gaps_closed": ledger["gaps_closed"],
        "per_gap": (total / ledger["gaps_closed"]) if ledger["gaps_closed"] else None,
        "series": series,
    }


# The estimate table lives in the spec and is read from it rather than copied
# here. `design/loops.md` section 15 calls the table "a set of guesses whose
# main job is to be wrong in a way that gets noticed", and a second copy in
# `harness/` would drift and be wrong quietly instead.
ESTIMATE_SECTION = "loops.md#estimates-and-replacing-them-with-measurements"
ESTIMATE_HEADER = ("Phase", "Tokens", "Model wall-clock", "Machine wall-clock")


def estimate_table() -> list[dict]:
    """Section 15's guesses, parsed out of the document.

    Returns [] when the table is not where it was, which the caller reports
    rather than papering over: a silently empty comparison is exactly the
    "estimate that is never compared against an actual" the section calls
    decoration.
    """
    doc, _, anchor = ESTIMATE_SECTION.partition("#")
    section = next((s for s in sections_of(doc) if s.anchor == anchor), None)
    if section is None:
        return []
    return parse_estimate_table(doc_path(doc).read_text().splitlines()[section.start : section.end])


def parse_estimate_table(lines: list[str]) -> list[dict]:
    rows: list[dict] = []
    header: list[str] | None = None
    for line in lines:
        if not line.startswith("|"):
            continue
        cells = [cell.strip() for cell in line.strip().strip("|").split("|")]
        if header is None:
            if tuple(cells[: len(ESTIMATE_HEADER)]) != ESTIMATE_HEADER:
                return []
            header = cells
            continue
        if set("".join(cells)) <= set("-: "):
            continue
        rows.append(dict(zip(header, cells)))
    return rows


def measured_resources() -> dict[str, dict]:
    """The three resources of section 15, by phase, from what has been recorded.

    They are kept apart because they have different drivers and different
    levers: a slow gate inflates machine wall-clock without costing a token,
    and a campaign that re-reads the design costs tokens without costing wall
    clock. Reporting one number for "cost" is what the section is warning
    against.
    """
    # An audit row written before audits recorded their phase falls to the
    # current one, the same rule `attribute_spend` uses: audits are appended as
    # they run, so the only rows this misplaces are ones from before a phase
    # change, and dropping them into a `?` bucket loses real spend from the
    # phase that incurred it.
    current = load_phase().phase
    by_phase: dict[str, dict] = {}
    for owner in cost_owners():
        for row in cost_rows(owner):
            phase = row.get("phase") or current
            actual = by_phase.setdefault(
                phase,
                {"campaigns": 0, "audits": 0, "usd": 0.0, "output_tokens": 0,
                 "model_seconds": 0.0, "machine_seconds": 0.0, "loops": set()},
            )
            actual["loops"].add(owner)
            if row.get("kind") == "audit":
                actual["audits"] += 1
            else:
                actual["campaigns"] += 1
            actual["usd"] += row.get("usd") or 0
            actual["output_tokens"] += row.get("output_tokens") or 0
            actual["model_seconds"] += row.get("model_seconds") or 0
            # The only machine wall-clock the harness measures today. Truth
            # collection is the dominant term in the table's row for it and
            # has not run, so this is the gate and nothing else — named
            # honestly rather than presented as the whole of the resource.
            actual["machine_seconds"] += row.get("gate_seconds") or 0
    return by_phase


def cmd_estimates(args: argparse.Namespace) -> int:
    """`design/loops.md` section 15: "an estimate that is never compared
    against an actual is decoration", and calibration is the first ten
    campaigns of each loop.

    The comparison is qualitative on purpose — the table's cells read
    "low–moderate" and "days" — so this puts the guess and the measurement
    side by side and leaves the judgement to the human doing the phase gate.
    What it does mechanically is the part that was missing: knowing which
    phases have enough campaigns behind them for the comparison to mean
    anything, and noticing a phase that has spent real money and has no row in
    the table at all.
    """
    estimates = estimate_table()
    if not estimates:
        print(
            f"estimates: could not find the table in {ESTIMATE_SECTION}. It is read from the "
            "document rather than copied, so a change to its shape lands here first.",
            file=sys.stderr,
        )
        return 1
    actuals = measured_resources()
    print(f"estimates: section 15's table against {sum(a['campaigns'] for a in actuals.values())} closed campaign(s)")
    print()
    for row in estimates:
        phase = row[ESTIMATE_HEADER[0]]
        print(f"  {phase}")
        print(
            f"    guess     tokens {row[ESTIMATE_HEADER[1]]} · model {row[ESTIMATE_HEADER[2]]}"
            f" · machine {row[ESTIMATE_HEADER[3]]}"
        )
        match = actuals.get(phase.split()[0]) if phase else None
        if not match:
            print("    actual    nothing recorded against this phase yet")
            continue
        campaigns = match["campaigns"]
        print(
            f"    actual    tokens {match['output_tokens']:,} out (API-eq ${match['usd']:,.2f})"
            f" · model {match['model_seconds'] / 3600:.1f}h"
            f" · machine {match['machine_seconds'] / 3600:.1f}h in the gate"
        )
        print(
            f"    from      {campaigns} campaign(s) and {match['audits']} audit(s) across "
            f"{', '.join(sorted(match['loops']))}"
            + ("" if campaigns >= CALIBRATION_CAMPAIGNS else
               f" — under the {CALIBRATION_CAMPAIGNS} the section calls calibration")
        )
    unnamed = sorted(set(actuals) - {row[ESTIMATE_HEADER[0]].split()[0] for row in estimates if row[ESTIMATE_HEADER[0]]})
    if unnamed:
        print()
        print(f"estimates: spend recorded against {', '.join(unnamed)}, which the table has no row for")
    return 0


# Section 15: "Calibration is the first ten campaigns of each loop." Below it
# the comparison is noise; the constant is here so the report says which side
# of it a phase is on rather than implying every row is equally settled.
CALIBRATION_CAMPAIGNS = 10


def cost_owners() -> list[str]:
    """Every loop that has ever spent anything, which is not the same set as
    the loops running now: a retired loop's spend still counts against the
    global ceiling."""
    directory = STATE / "cost"
    return sorted(path.stem for path in directory.glob("*.jsonl")) if directory.exists() else []


def spend(phase: Phase) -> tuple[float, dict[str, float]]:
    """API-equivalent spend: the global total, and this phase's by language.

    Global is every row of every cost file — every phase, every loop — because
    it is the backstop and a backstop that forgets last phase is not one.
    The language figure is scoped to the current phase, which is what
    `design/loops.md` section 15 means by "per phase, per language": Python's
    tuning budget is exhausted independently of Rust's *and* independently of
    what Python cost in an earlier phase.

    A campaign row carries its own language and phase. An audit row carries
    neither, so it is attributed to its loop's configured language and, absent
    a recorded phase, to the current one — audits are appended as they run, so
    the only rows this misplaces are ones written before a phase change.
    """
    return attribute_spend(phase, {owner: cost_rows(owner) for owner in cost_owners()})


def attribute_spend(phase: Phase, by_owner: dict[str, list[dict]]) -> tuple[float, dict[str, float]]:
    total = 0.0
    by_language: dict[str, float] = {}
    for owner, rows in by_owner.items():
        config = phase.loops.get(owner)
        for row in rows:
            usd = row.get("usd") or 0
            total += usd
            if row.get("kind") == "audit":
                language = config.language if config else None
                row_phase = row.get("phase") or phase.phase
            else:
                language = row.get("language")
                row_phase = row.get("phase")
            if language and row_phase == phase.phase:
                by_language[language] = by_language.get(language, 0.0) + usd
    return total, by_language


def budget_scopes(phase: Phase, owner: str | None = None) -> list[dict]:
    """One entry per ceiling that applies, innermost first.

    The per-campaign scope is reported and never enforced here: it is passed to
    the runner as `--max-budget-usd`, and a campaign stopped by it comes back
    with outcome `budget` rather than with a closing line.
    """
    total, by_language = spend(phase)
    scopes: list[dict] = []
    config = phase.loops.get(owner) if owner else None
    if config:
        scopes.append(
            {
                "scope": "campaign",
                "of": config.owner,
                "ceiling": config.budget_usd,
                "spent": None,
                "enforced_by": "the runner, per session",
            }
        )
    languages = [config.language] if config else sorted(set(by_language) | set(phase.budget.language_usd))
    for language in languages:
        if not language:
            continue
        scopes.append(
            {
                "scope": f"phase {phase.phase}, {language}",
                "of": language,
                "ceiling": phase.budget.language_usd.get(language),
                "spent": by_language.get(language, 0.0),
                "enforced_by": "the harness, between campaigns",
            }
        )
    scopes.append(
        {
            "scope": "global",
            "of": None,
            "ceiling": phase.budget.global_usd,
            "spent": total,
            "enforced_by": "the harness, between campaigns",
        }
    )
    return scopes


def queue_state(gaps: int, unjudged: int, minors: int) -> str:
    """`work`, `minors` or `empty`. `design/loops.md` §5's two lists, which
    "terminate differently": the gap count should go to zero and the minor
    count should not, so only the first two decide whether a campaign has
    something to take."""
    if gaps or unjudged:
        return "work"
    return "minors" if minors else "empty"


def queue_is_empty(config: LoopConfig) -> bool:
    """Whether this loop has anything a campaign may take.

    False for a loop whose work does not come from the audit at all: a tuning
    loop declares no documents, so every count here is zero for it and a naive
    reading would refuse to open any of its campaigns forever. The terminal
    condition belongs to the loops §5 is about, and `docs` is what says which
    those are.
    """
    if not config.docs:
        return False
    counts = audit_counts(config.docs)
    state = queue_state(counts["open_gaps"], len(unjudged_sections(config.docs)), counts["audit_minors"])
    return state != "work"


def log_queue_exhausted(config: LoopConfig) -> None:
    """The stop, in the log a human reads, not only on a terminal nobody is at.

    §5 calls this a terminal condition, and §16 makes the intervention log the
    mechanism rather than a record of it: a loop that stopped and asked, with
    nothing in the log, is a loop that looks idle.
    """
    counts = audit_counts(config.docs)
    append_jsonl(
        INTERVENTIONS,
        {
            "ts": now(),
            "kind": "loop-killed",
            "phase": load_phase().phase,
            "target": config.owner,
            "answer": "the queue is empty; only minor items remain",
            "rationale": (
                f"design/loops.md §5: {config.owner} has no open gap and no unjudged "
                f"section left, and {counts['audit_minors']} minor item(s) remain. The gap "
                "count is driven to zero and the minor count deliberately is not — chasing "
                "minors is where a model's judgement is least reliable and where a fix "
                "costs most relative to its value, so a human reads the list and decides "
                "which are real. Recorded by the harness; no rationale was given at the "
                "time because nobody was present."
            ),
            "automatic": True,
            "commit": head_sha(),
        },
    )


def cmd_queue(args: argparse.Namespace) -> int:
    """§5's terminal condition, checked between campaigns.

        **When only minor items remain, the loop stops and asks.** Chasing
        them is where a model's judgement is least reliable and where the cost
        of a fix is highest relative to its value […] That is a terminal
        condition rather than an asymptote, which matters because an asymptote
        is something a loop will happily grind against forever.

    Exit 1 means there is nothing left for a campaign to take. What a campaign
    may take is §3's queue — an open gap or an unjudged section — and minor
    items are deliberately not on it, so the count that decides this is the
    other two and the minors are only reported.

    Never fires from an empty audit: a document nobody has audited is all
    unjudged sections, which is the queue at its fullest rather than at its
    emptiest. That is the failure mode worth being careful about here, because
    it stops the loop at exactly the moment the loop has done nothing.
    """
    phase, config = loop_config(args.loop)
    del phase
    if not config.docs:
        print(f"queue: {config.owner} declares no document; its work does not come from the audit")
        return 0
    counts = audit_counts(config.docs)
    gaps, minors = counts["open_gaps"], counts["audit_minors"]
    unjudged = unjudged_sections(config.docs)
    state = queue_state(gaps, len(unjudged), minors)
    print(
        f"queue: {config.owner}  {gaps} open gap(s), {len(unjudged)} unjudged section(s), "
        f"{minors} minor item(s) not on the queue"
    )
    if state == "work":
        return 0
    if state == "minors":
        print(
            f"queue: every section is settled and {minors} minor item(s) remain. "
            "design/loops.md §5: the minor count is not driven to zero by a loop — "
            "chasing it is where a model's judgement is least reliable and where a fix "
            "costs most relative to its value. A human reads the list and decides which "
            "are real",
            file=sys.stderr,
        )
    else:
        print(
            "queue: no gap, no unjudged section and no minor item. There is nothing "
            "for a campaign to take, which is a phase-gate question rather than a "
            "target (design/loops.md §8)",
            file=sys.stderr,
        )
    return 1


def cmd_budget(args: argparse.Namespace) -> int:
    """`design/loops.md` section 15: three scopes, each of which "stops and
    reports rather than continuing quietly".

    Exit 1 means a ceiling is reached. `harness/loop` consults this before
    opening a campaign, so the stop lands between campaigns rather than inside
    one — which is also the only place a stop leaves a committed tree.
    """
    phase = load_phase()
    if args.loop:
        loop_config(args.loop)
    exhausted = []
    for entry in budget_scopes(phase, args.loop):
        ceiling, spent = entry["ceiling"], entry["spent"]
        if ceiling is None:
            state = "no ceiling set"
        elif spent is None:
            state = f"${ceiling:.2f} per campaign"
        else:
            state = f"${spent:.2f} of ${ceiling:.2f} ({spent / ceiling * 100:.0f}%)"
            if spent >= ceiling:
                state += "  — EXHAUSTED"
                exhausted.append(entry["scope"])
        spent_text = "" if spent is None or ceiling is not None else f"${spent:.2f} spent, "
        print(f"budget: {entry['scope']:<24} {spent_text}{state}   [{entry['enforced_by']}]")
    if exhausted:
        print(
            "budget: exhausted at "
            + ", ".join(exhausted)
            + ". Raise it in state/phase.toml under [budget], and log the change as an"
            " intervention (kind: budget raised).",
            file=sys.stderr,
        )
    return 1 if exhausted else 0


# --------------------------------------------------------------------------
# The metrics history's other half. `design/loops.md` §10, "The metrics
# history", and §9, "There is no replay-time target, and that is deliberate".
#
# §10's row spec names more than `record` was writing:
#
#   work counters (bytes read, files parsed, nodes visited),
#   replay wall clock, per-stratum heuristic latency percentiles and the
#   per-stage breakdown, deadline-abstention rate
#
# None of it is computed here from scratch. `measure replay --records <path>`
# writes `shared::record::QueryRecord` as JSONL, and the doc comment on its
# writer says whose job the rest is: "Digesting these into something readable
# is the harness's job, not `measure_core`'s: the same split that keeps this
# crate ignorant of `state/`." So this is that digest, and the shape it reads
# is a real type in this repository rather than a guessed one.
#
# The wall clock is not in the digest and cannot be. `measure_core`'s table
# holds no clock on purpose — "§7's command line makes the table byte-identical
# across two runs of the same corpus at the same commit, which is what makes it
# usable as a gate rather than a report" — so whoever runs the replay reports
# how long it took, and `record --replay-seconds` puts it in the row. §9 wants
# it "recorded as an ordinary metric alongside the work counters ... per
# language, per commit, from the very first run", read "as a trend, never gated
# on", and that is exactly what a field with no threshold beside it is.

# §7 puts an abstention's reason in `stages` rather than in a column of its
# own, "because `stages` is the field §7 makes the handler's account of what it
# did and a second reason column would be two vocabularies for one question".
# `shared::record::abstain_label` is where the spelling is decided.
DEADLINE_ABSTENTION = "abstain:deadline"


def percentile(values: list[float], fraction: float) -> float | None:
    """Nearest-rank, on an already-small sample.

    Not interpolated: a corpus stratum can hold a handful of queries, and an
    interpolated p99 over eleven samples reports a number no query took. §10
    reads these as a trend and says they are "not trustworthy to better than a
    factor while the loops run in parallel", so the honest estimator is the
    one that only ever returns an observation.
    """
    if not values:
        return None
    ordered = sorted(values)
    rank = max(1, math.ceil(fraction * len(ordered)))
    return ordered[min(rank, len(ordered)) - 1]


def replay_digest(records: list[dict]) -> dict:
    """§10's work counters, per-stratum latency percentiles, per-stage
    breakdown and deadline-abstention rate, from §7's per-query records.

    Grouped on `stratum_prior` rather than `stratum_final`, for the reason
    `measure_core`'s table gives for putting coverage there: the prior "is
    fixed by the reference and does not move when the implementation changes".
    A latency series grouped on the settled stratum would shift rows between
    buckets whenever the search got better at refining, and a percentile that
    moves because its denominator moved is the kind of number that survives a
    whole phase before anyone notices.

    Two of §10's three work counters. The section names "bytes read, files
    parsed, nodes visited" and `QueryRecord` carries `bytes_scanned` and
    `files_parsed` and no node count — recorded as the two that exist rather
    than as a zero for the third, so that a row cannot claim a measurement
    nothing took.
    """
    # DECISION-harness-012: provisional — whether the third counter arrives as
    # a field on `QueryRecord` or the spec drops to the two that exist. The
    # tuple below is the whole of what changes under either answer.
    strata: dict[str, dict] = {}
    counters = {"bytes_scanned": 0, "files_parsed": 0}
    deadline = 0
    for record in records:
        for name in counters:
            value = record.get(name)
            if isinstance(value, int) and not isinstance(value, bool):
                counters[name] += value
        stages = [stage for stage in (record.get("stages") or []) if isinstance(stage, str)]
        if record.get("decision") == "abstained" and DEADLINE_ABSTENTION in stages:
            deadline += 1
        name = record.get("stratum_prior")
        if not isinstance(name, str):
            continue
        bucket = strata.setdefault(
            name, {"n": 0, "latency_us": [], "stage_us": {}, "returned": []}
        )
        bucket["n"] += 1
        latency = record.get("heuristic_latency_us")
        if isinstance(latency, (int, float)) and not isinstance(latency, bool):
            bucket["latency_us"].append(float(latency))
        returned = record.get("returned")
        if isinstance(returned, int) and not isinstance(returned, bool):
            bucket["returned"].append(float(returned))
        for stage, micros in (record.get("stage_us") or {}).items():
            if isinstance(micros, (int, float)) and not isinstance(micros, bool):
                bucket["stage_us"].setdefault(stage, []).append(float(micros))

    digested = {}
    for name, bucket in sorted(strata.items()):
        entry = {"n": bucket["n"]}
        for label, fraction in (("p50", 0.5), ("p90", 0.9), ("p99", 0.99)):
            value = percentile(bucket["latency_us"], fraction)
            if value is not None:
                entry[f"latency_{label}_us"] = value
        stage_p50 = {
            stage: percentile(series, 0.5)
            for stage, series in sorted(bucket["stage_us"].items())
        }
        if stage_p50:
            entry["stage_p50_us"] = stage_p50
        # §10's "result count", which the frontier reports beside itself and
        # never on it — it is "the price of containment", and a point that
        # raised containment by lengthening lists must not read as an advance.
        # The mean rather than the distribution, which §10's row spec asks for
        # and `QueryRecord` does not carry in a form that survives a mean; the
        # per-query `returned` is in the records file for whoever needs it.
        if bucket["returned"]:
            entry["result_count"] = sum(bucket["returned"]) / len(bucket["returned"])
        digested[name] = entry

    return {
        "queries": len(records),
        "work": counters,
        # The number §10 says is "the one worth watching most", "since it is
        # the whole of the gap between what replay reports and what the shim
        # would deliver". A rate rather than a count, so that it is comparable
        # across corpus versions.
        "deadline_abstention_rate": (deadline / len(records)) if records else None,
        "strata": digested,
    }


# Coverage is committed over queries; top-1 agreement is `match_top1` over the
# three agreement counters, which "partition the judged commits exactly". Both
# formulas are `measure_core::table::Row`'s, whose own comment says a ratio is
# "computed here rather than by every consumer, because a metric with two
# definitions is two metrics" — and then serialises the counters and not the
# ratios, so a consumer has no choice. Written once here for the same reason it
# is written once there, and the raw counters go into the row beside them so
# that a redefinition can be swept rather than lost.
def report_strata(report: dict) -> dict[str, dict]:
    """`measure replay --format json`, in the shape the metrics row wants.

    `judged` is carried as its own denominator because it is not `n`: coverage
    is counted on the reference stratum and agreement on the settled one, so a
    query that refined its stratum contributes to two different rows. Weighting
    a top-1 mean by `n` would weight it by the wrong row's population.
    """
    strata = {}
    for row in report.get("strata") or []:
        name = row.get("stratum")
        if not isinstance(name, str):
            continue
        queries = row.get("queries") or 0
        judged = sum(
            row.get(key) or 0 for key in ("match_top1", "match_contained", "mismatch")
        )
        entry = {
            "n": queries,
            "judged": judged,
            **{
                key: row[key]
                for key in (
                    "queries", "committed", "abstained", "failed",
                    "match_top1", "match_contained", "mismatch",
                )
                if key in row
            },
        }
        if queries:
            entry["coverage"] = (row.get("committed") or 0) / queries
        if judged:
            entry["top1"] = (row.get("match_top1") or 0) / judged
            entry["contained"] = ((row.get("match_top1") or 0) + (row.get("match_contained") or 0)) / judged
        strata[name] = entry
    return strata


def merge_strata(*sources: dict[str, dict]) -> dict[str, dict]:
    """One `strata` map out of several, keyed by stratum name.

    The quality half comes from the report and the cost half from the records,
    and they are two files because `measure_core` writes them as two. Merged
    here rather than kept apart so that a metrics row has one place a stratum
    lives — `frontier_axes_of` and the latency percentiles read the same map.
    """
    merged: dict[str, dict] = {}
    for source in sources:
        for name, entry in source.items():
            merged.setdefault(name, {}).update(entry)
    return merged


# --------------------------------------------------------------------------
# The frontier. `design/loops.md` §10, "The frontier, and why it stays
# two-dimensional".
#
# "A commit is on the frontier if no other commit beats it on every axis. Over
# a run of a few hundred iterations that is a real, computable object, and it
# is strictly more informative than the current numbers: it is the record of
# what was *achievable*, including by versions that were later abandoned."
#
# §18 lists the frontier under what is deliberately not built, on the argument
# that "a thing that only serves tuning loops is not built before there are
# tuning loops". The same section says what ends that: "this list shortens as
# the followup is built, and it is the list rather than the argument that
# moves". The argument is untouched by building it — nothing consumes a
# frontier before 2a, and during phase 1a every function here answers "no row
# carries both axes". What it buys is that the axes are fixed *before* there
# are numbers to pick them by, which is the whole of §10's discipline: adding
# a third axis to escape a bad-looking chart is easy, and impossible to notice
# afterwards.

# The two axes, and the order they print in. §10 chooses between the three
# quality numbers by a criterion rather than by taste — "it must not be
# improvable by answering more". Top-1 agreement passes it; containment "rises
# monotonically with list length, so as an objective it is the old flaw
# wearing new clothes"; result count is "the price of containment".
FRONTIER_AXES = ("top1", "coverage")

# Reported beside the frontier and never on it. Three different reasons, worth
# keeping apart because they fail differently:
#
# * containment and result count — "a point that raises containment by
#   lengthening lists is not a frontier advance and must not read as one";
# * latency — a constraint rather than an objective, and already counted:
#   past the hard cap a query abstains, so blown latency "spends itself as
#   lost recall" and is visible on the quality axis. A third axis for it would
#   double-count it;
# * LOC — "it correlates with binary size, it is gameable by formatting, and
#   what it is really a proxy for — maintainability — is not something a
#   frontier can see".
#
# The list is the subject of a check rather than decoration. §10's stated
# reason for the discipline is that with four or more objectives
# "non-domination becomes nearly free — almost every point is on the frontier
# and the concept stops selecting anything", so the failure it guards against
# is a *later* campaign promoting one of these to an axis, which nothing else
# here would notice.
#
# These are the keys a stratum carries them under, not the concept names —
# the first draft used the concepts, and every consumer then looked up
# `latency` in a row that spells it `latency_p50_us` and printed nothing. LOC
# is missing from the list for a real reason rather than that one: it is not
# per-stratum. It rides in the row's own `loc` field, per crate, which is
# where §10 wants it reported and is already what the dashboard draws.
FRONTIER_BESIDE = ("contained", "result_count", "latency_p50_us")

# §10: "Phase 3 has no frontier of its own, because it may not move quality at
# all. It has one axis, size, and a ratchet. The frontier reappears there only
# inside an escalation, to show what a proposed exception would cost."
FRONTIER_PHASES = ("2a", "2b")

# Each axis's denominator, because they are not the same one. Coverage is
# counted on the reference stratum and agreement on the settled one
# (`core.md` §7, and `measure_core::table::Table::observe`), so a query that
# refined its stratum contributes to two different rows — and a top-1 mean
# weighted by `n` would be weighted by the wrong row's population. Falls back
# to `n` where the row does not carry the finer count, which is what a row
# written before `report_strata` existed looks like.
AXIS_DENOMINATOR = {"top1": "judged", "contained": "judged"}


def stratum_mean(row: dict, key: str, weight_key: str | None = None) -> float | None:
    """One number out of §10's per-stratum metrics row, n-weighted.

    The row spec is per stratum — "per-stratum {coverage, top1, contained,
    result-count distribution, n}" — and the frontier is over commits, so an
    axis has to be aggregated before it is one. Weighted by the stratum's `n`
    rather than a plain mean: `data-collection.md` sizes the strata an order
    of magnitude apart, and an unweighted mean lets the rarest one outvote
    everything else.

    A top-level value wins where a row carries one, so that a replay sweep
    which recomputes and writes the aggregate directly cannot disagree with
    this about which number is authoritative.
    """
    direct = row.get(key)
    if isinstance(direct, (int, float)) and not isinstance(direct, bool):
        return float(direct)
    denominator = weight_key or AXIS_DENOMINATOR.get(key, "n")
    total = weight = 0.0
    for numbers in (row.get("strata") or {}).values():
        if not isinstance(numbers, dict):
            continue
        value = numbers.get(key)
        count = numbers.get(denominator)
        if count is None:
            count = numbers.get("n", 1)
        if not isinstance(value, (int, float)) or isinstance(value, bool):
            continue
        if isinstance(count, (int, float)) and not isinstance(count, bool) and count > 0:
            total += float(value) * float(count)
            weight += float(count)
    return total / weight if weight else None


def frontier_axes_of(row: dict) -> dict[str, float] | None:
    """A row's position on the frontier's plane, or None if it is not on it.

    Both axes or neither. A point with one coordinate cannot be compared, and
    filling the missing one in with zero would park every phase-1 row at the
    origin and then read the first tuning commit as an advance over all of
    them — a hundred campaigns of free progress from one absent field.
    """
    position = {axis: stratum_mean(row, axis) for axis in FRONTIER_AXES}
    return None if any(value is None for value in position.values()) else position


def dominates(better: dict, worse: dict) -> bool:
    """Pareto domination: at least as good on every axis, strictly better on
    at least one.

    §10 phrases the frontier as "no other commit beats it on every axis",
    which read strictly would keep a point that ties on one axis and loses on
    the other. The two readings agree wherever no two commits tie; where they
    do not, the literal one keeps points that are better than nothing. The
    difference is settled in `advances_frontier` rather than here, because
    that is the reading §7 pays for and this one only reports.
    """
    return all(better[axis] >= worse[axis] for axis in FRONTIER_AXES) and any(
        better[axis] > worse[axis] for axis in FRONTIER_AXES
    )


def advances_frontier(point: dict, existing: list[dict]) -> bool:
    """§7's fifth form of progress: "a frontier point being added that is not
    dominated by an existing one".

    Stricter than `not any(dominates(other, point))` by exactly the tie, and
    the tie is the whole of it. `record` writes a row per commit, and a commit
    that changes no behaviour carries the previous commit's numbers exactly;
    under the looser reading that identical row is undominated, so every
    commit forever scores progress and §7's stall detection stops existing.
    That is the shape §7's own gaming table is about, arriving through the
    term meant to reward real work.

    So a point advances only if it is strictly better than *every* existing
    point on at least one axis.
    """
    return not any(
        all(other[axis] >= point[axis] for axis in FRONTIER_AXES) for other in existing
    )


def frontier_points(rows: list[dict]) -> list[dict]:
    """The non-dominated rows, in the order they were recorded, each carrying
    its position under `frontier_axes`.

    Ties keep the earliest commit: the frontier is "the record of what was
    achievable", and the commit that first achieved a point is the one that
    achieved it. Keeping the latest would let a run of no-op commits reassign
    every point on the frontier to whichever ran most recently, which is the
    same free-progress route `advances_frontier` closes one step earlier.
    """
    positioned = [
        (row, position)
        for row in rows
        if (position := frontier_axes_of(row)) is not None
    ]
    kept: list[tuple[dict, dict]] = []
    for row, position in positioned:
        if any(dominates(other, position) for _, other in positioned):
            continue
        if any(other == position for _, other in kept):
            continue
        kept.append((row, position))
    return [dict(row, frontier_axes=position) for row, position in kept]


# --------------------------------------------------------------------------
# The exchange rate. `design/loops.md` §10, "What this retires".
#
# "The **local slope of the cost-phase frontier is the empirical rate** — it
# says what a coverage point actually cost in bytes, at this operating point,
# on this corpus. Deriving it beats declaring it, and it can be re-derived
# whenever the operating point moves."
#
# A different object from the quality frontier above it, and deliberately not
# built on the same functions. §10 is explicit that "phase 3 has no frontier of
# its own … the frontier reappears there only inside an escalation, to show
# what a proposed exception would cost", so this plane is coverage against
# bytes and one of its axes is a minimisation. Sharing `dominates` would mean
# giving it a direction table, and a direction table is how a third axis and a
# weighting arrive later.
#
# What it must not become is a threshold. §10's whole argument is that "nobody
# has to write down what a coverage point is worth in kilobytes in the
# abstract" — the rate is derived to be *looked at* by the human ruling on an
# escalation, and a rate that decided anything by itself would be that written
# -down number arriving through the back door.


def cost_point_of(row: dict) -> tuple[float, int] | None:
    """A row's position on the cost plane: coverage, and stripped bytes.

    Both or neither, for `frontier_axes_of`'s reason. A row missing the size
    would otherwise sit at zero bytes and dominate everything that measured.
    """
    coverage = stratum_mean(row, "coverage")
    binary = row.get("binary")
    if coverage is None or not isinstance(binary, dict):
        return None
    stripped = binary.get("stripped")
    if not isinstance(stripped, int) or isinstance(stripped, bool):
        return None
    return coverage, stripped


def cost_frontier(rows: list[dict]) -> list[dict]:
    """Non-dominated on more coverage and fewer bytes, cheapest first.

    Ties on both axes keep the earliest commit, as the quality frontier does
    and for the same reason: the commit that first reached a point is the one
    that reached it.
    """
    positioned = [
        (row, point) for row in rows if (point := cost_point_of(row)) is not None
    ]
    kept: list[tuple[dict, tuple[float, int]]] = []
    for row, (coverage, size) in positioned:
        dominated = any(
            other_coverage >= coverage
            and other_size <= size
            and (other_coverage > coverage or other_size < size)
            for _, (other_coverage, other_size) in positioned
        )
        if dominated or any(other == (coverage, size) for _, other in kept):
            continue
        kept.append((row, (coverage, size)))
    kept.sort(key=lambda pair: pair[1][1])
    return [
        dict(row, cost_point={"coverage": coverage, "stripped": size})
        for row, (coverage, size) in kept
    ]


def exchange_rates(points: list[dict]) -> list[dict]:
    """The local slope between adjacent points: bytes per coverage point.

    Local rather than a fit through the whole frontier. The section says "at
    this operating point", and a single fitted rate over a curve that bends —
    which is the shape the incompressible-peak failure in §19 predicts — would
    read as one price for a surface that has several.
    """
    rates = []
    for earlier, later in zip(points, points[1:]):
        cheap, dear = earlier["cost_point"], later["cost_point"]
        gained = dear["coverage"] - cheap["coverage"]
        if gained <= 0:
            continue
        rates.append(
            {
                "from": earlier.get("commit"),
                "to": later.get("commit"),
                "coverage": gained,
                "bytes": dear["stripped"] - cheap["stripped"],
                "bytes_per_coverage_point": (dear["stripped"] - cheap["stripped"]) / gained,
            }
        )
    return rates


def cmd_exchange_rate(args: argparse.Namespace) -> int:
    """§10's empirical exchange rate, derived rather than declared.

    Not a gate step, not consulted by `harness/loop`, and exit 0 whatever it
    finds. It exists to be read by the human ruling on a phase-3 escalation,
    which is the one place §10 lets the frontier back in.
    """
    phase = load_phase()
    owners = [args.loop] if args.loop else sorted(phase.loops)
    wanted = args.phase or phase.phase
    for owner in owners:
        rows = [row for row in read_jsonl(metrics_path(owner)) if row.get("phase") == wanted]
        points = cost_frontier(rows)
        if len(points) < 2:
            print(
                f"exchange-rate: {owner}: {len(points)} point(s) on the cost plane, of "
                f"{len(rows)} row(s) in phase {wanted}. A slope needs two, and a point "
                "needs a row carrying both coverage and a stripped size — which is a "
                "replayed commit of a loop that builds a measure_<lang>."
            )
            continue
        print(
            f"exchange-rate: {owner}: {len(points)} point(s) on coverage x stripped "
            f"bytes in phase {wanted}, cheapest first"
        )
        for point in points:
            place = point["cost_point"]
            print(
                f"  {(point.get('commit') or '')[:12]}  coverage {place['coverage']:.4f}"
                f"  {place['stripped']} bytes"
            )
        for rate in exchange_rates(points):
            print(
                f"  {(rate['from'] or '')[:12]} -> {(rate['to'] or '')[:12]}  "
                f"{rate['bytes_per_coverage_point']:,.0f} bytes per coverage point"
            )
        print(
            "exchange-rate: derived and never declared (design/loops.md section 10). "
            "It is what a coverage point cost at this operating point on this corpus, "
            "for a human ruling on a phase-3 escalation to look at — not a threshold, "
            "and nothing here reads it."
        )
    return 0


def campaign_frontier_advance(rows: list[dict], campaign_id: str) -> bool:
    """§7's fifth form, for one campaign, over one phase's metrics rows.

    The baseline is the frontier as it stood *before* this campaign's first
    row rather than over the whole phase: a campaign is judged on what it
    added, and leaving its own rows in the comparison set would have every
    point dominated by itself.

    Keyed on `campaign` rather than on a commit list, because the metrics row
    already carries the campaign from the commit's trailer — which makes this
    answerable in a replay, where the working tree is whatever it is now and
    `git log` for a campaign twenty campaigns ago is not.
    """
    index = next(
        (number for number, row in enumerate(rows) if row.get("campaign") == campaign_id), None
    )
    if index is None:
        return False
    baseline = [point["frontier_axes"] for point in frontier_points(rows[:index])]
    return any(
        advances_frontier(position, baseline)
        for row in rows[index:]
        if row.get("campaign") == campaign_id
        and (position := frontier_axes_of(row)) is not None
    )


def campaign_advanced_the_frontier(owner: str, campaign_id: str, phase: str) -> bool:
    rows = [row for row in read_jsonl(metrics_path(owner)) if row.get("phase") == phase]
    return campaign_frontier_advance(rows, campaign_id)


def cmd_frontier(args: argparse.Namespace) -> int:
    """§10's frontier, computed rather than described.

    Deliberately not a gate step and not consulted by `harness/loop`. §10
    makes the frontier a reporting object and a gate's selection input, and
    the one place it decides anything on its own is §7's progress term, which
    calls `advances_frontier` directly. A command that both printed the
    frontier and enforced something against it would be the third axis
    arriving by the back door.
    """
    phase = load_phase()
    owners = [args.loop] if args.loop else sorted(phase.loops)
    wanted = args.phase or phase.phase
    if wanted not in FRONTIER_PHASES:
        print(
            f"frontier: phase {wanted} has no frontier of its own (design/loops.md "
            "section 10). "
            + (
                "Phase 3 has one axis, size, and a ratchet; the frontier reappears "
                "there only inside an escalation, to show what a proposed exception "
                "would cost."
                if wanted.startswith("3")
                else "The frontier is a phase 2a object: top-1 agreement x coverage."
            )
        )
    for owner in owners:
        rows = [row for row in read_jsonl(metrics_path(owner)) if row.get("phase") == wanted]
        points = frontier_points(rows)
        if not points:
            line = (
                f"frontier: {owner}: nothing to compare — {len(rows)} row(s) in phase "
                f"{wanted}, none carrying both of {' and '.join(FRONTIER_AXES)}"
            )
            # The one absence that is not "nobody replayed this". Distinguished
            # because the remedy is different: a row replayed against two
            # servers and no agreement report is a row whose shared surface was
            # never produced, not one whose loop stopped measuring.
            unshared = sum(1 for row in rows if row.get("servers") and "strata" not in row)
            if unshared:
                line += (
                    f"; {unshared} of them carry per-server numbers only, and the "
                    "frontier is over the positions where every server agrees"
                )
            print(line)
            continue
        print(
            f"frontier: {owner}: {len(points)} of {len(rows)} row(s) in phase {wanted} "
            f"are non-dominated on {' x '.join(FRONTIER_AXES)}"
        )
        for point in points:
            axes = point["frontier_axes"]
            beside = {
                name: value
                for name in FRONTIER_BESIDE
                if (value := stratum_mean(point, name)) is not None
            }
            line = f"  {(point.get('commit') or '')[:12]}  " + "  ".join(
                f"{axis} {axes[axis]:.4f}" for axis in FRONTIER_AXES
            )
            if beside:
                line += "   beside, never an axis: " + ", ".join(
                    f"{name} {value:g}" for name, value in beside.items()
                )
            print(line)
            # A server's own numbers get "the same treatment containment and
            # result count get" — printed under the point and never compared
            # with it, since they are measured on the positions where the
            # servers differ and no two servers' sets are the same one.
            for name, entry in sorted((point.get("servers") or {}).items()):
                numbers = [
                    f"{axis} {value:.4f}"
                    for axis in FRONTIER_AXES
                    if (value := stratum_mean(entry, axis)) is not None
                ]
                if numbers:
                    print(f"    beside, on its own positions: {name}  " + "  ".join(numbers))
    return 0


# --------------------------------------------------------------------------
# Held-out integrity. `design/loops.md` §12.
#
# The section's first two bullets are a single mechanism stated twice, and the
# second states why the first is not a convention: "the loop is given
# `--corpus` pointing at one and never the other, and a rule it is never told
# about is a rule it cannot weigh against making the number go up", then "the
# separation must be physical, not rule-based ... the boundary is that the data
# is outside the checkout entirely and the held-out path is never passed in."
#
# Both halves are exactly checkable and neither needs a corpus run, which is
# what makes this worth doing during a phase that has no tuning loop in it. The
# mistake they guard against is made once, in whichever campaign first writes a
# tuning prompt, and it is invisible afterwards: a leaked split does not fail,
# it just makes every number afterwards mean less than it says.

HELD_OUT_SPLIT = "test"
TUNING_SPLIT = "training"


def corpus_root() -> Path | None:
    selection = HARNESS / "corpus-selection.toml"
    if not selection.exists():
        return None
    root = tomllib.loads(selection.read_text()).get("corpus_root")
    return (REPO / root).resolve() if isinstance(root, str) else None


def held_out_exposure(root: Path, texts: dict[str, str]) -> list[str]:
    """Every place a text names the held-out split, as `<where>: <why>`.

    Matched on the corpus root's own directory name joined to the split — a
    bare `test` appears in every one of these files for unrelated reasons, and
    a check with that false-positive rate gets suppressed rather than fixed.
    """
    held_out = f"{root.name}/{HELD_OUT_SPLIT}"
    problems = []
    for where, text in texts.items():
        if held_out in text:
            problems.append(f"{where}: names {held_out}, which the loop must never be told about")
        elif re.search(rf"--corpus[= ]\S*/{HELD_OUT_SPLIT}\b", text):
            problems.append(f"{where}: passes --corpus at the held-out split")
    return problems


def cmd_check_heldout(args: argparse.Namespace) -> int:
    """§12's two structural claims, checked without a corpus run.

    Not a gate step. It is about the *configuration* a campaign is launched
    with rather than about a diff, so it belongs where `harness/loop` decides
    what to launch — and running it per commit would say nothing new, since
    nothing in a commit can move the corpus root.
    """
    root = corpus_root()
    if root is None:
        print("heldout: no corpus selection yet; nothing to separate")
        return 0
    problems = []
    if REPO == root or REPO in root.parents:
        problems.append(
            f"the corpus root {root} is inside the checkout {REPO}. §12: the boundary "
            "is that the data is outside the checkout entirely, because a denyRead rule "
            "does not stop `cat` in a bash subprocess"
        )
    held_out, tuning = root / HELD_OUT_SPLIT, root / TUNING_SPLIT
    if held_out.parent != tuning.parent:
        problems.append(
            f"{held_out} is not a sibling of {tuning}. §12 puts the held-out split "
            "beside the tuning one rather than inside it, so that a path handed to a "
            "loop cannot reach it by descending"
        )
    texts = {str(path.relative_to(REPO)): path.read_text() for path in sorted(
        list((HARNESS / "prompts").rglob("*.md")) + [HARNESS / "loop"]
    ) if path.exists()}
    phase_file = CONTROL / "state" / "phase.toml"
    if phase_file.exists():
        texts["state/phase.toml"] = phase_file.read_text()
    problems += held_out_exposure(root, texts)
    if problems:
        for problem in problems:
            print(f"heldout: {problem}", file=sys.stderr)
        return 1
    print(
        f"heldout: {held_out.name} is a sibling of {tuning.name} outside the checkout, "
        f"and nothing a campaign is shown names it ({len(texts)} file(s) checked)"
    )
    return 0


# The rest of §12: what the loop is shown, and what stops it.
#
# One row per phase gate, per language, in `state/heldout/<language>.jsonl`:
#
#   {"ts": ..., "phase": "2a", "language": "rust", "commit": "<candidate>",
#    "strata": {"ExplicitImport": {"tuning": 0.91, "heldout": 0.84}, ...}}
#
# Nothing here evaluates anything, and that is the third bullet rather than an
# omission: "held-out evaluation runs at phase gates, not at iterations. A
# number reported every iteration is a number that gets optimised against,
# whatever it is labelled." So the evaluation is a gate's to run and this reads
# what it left — which also means the file only grows at gates, and a loop
# consulting it between campaigns learns nothing new until one happens.
#
# `state/heldout/**` is in `DENIED_ALWAYS`. The commit is in the row because
# §10's "selecting a version at a phase gate" evaluates the surviving frontier
# points rather than HEAD; computing that frontier is §18-deferred, and this
# half does not depend on it.
HELDOUT = STATE / "heldout"


def heldout_rows(language: str) -> list[dict]:
    return read_jsonl(HELDOUT / f"{language}.jsonl")


def stratum_gaps(row: dict) -> dict[str, float]:
    """Tuning minus held-out, per stratum. `high-level.md`'s overfitting signal
    is this difference rather than either number on its own."""
    gaps = {}
    for stratum, numbers in (row.get("strata") or {}).items():
        if not isinstance(numbers, dict):
            continue
        tuning, held_out = numbers.get("tuning"), numbers.get("heldout")
        if isinstance(tuning, (int, float)) and isinstance(held_out, (int, float)):
            gaps[stratum] = float(tuning) - float(held_out)
    return gaps


def heldout_verdict(rows: list[dict], threshold: float | None) -> tuple[str, list[str]]:
    """§12's fourth bullet: "The loop is shown a verdict, not the numbers.
    'Held-out gap within threshold' / 'gap widened on `ExplicitImport`'. Enough
    to know something went wrong and where; not enough to hill-climb."

    So the return carries stratum *names* and never a value, and the tests
    assert that rather than trusting it. Widening is measured against the
    previous gate rather than against the threshold, because the two say
    different things: a gap over threshold has been wrong for a while, and a
    gap that widened is the signal §12 calls "the last several iterations were
    probably net negative".
    """
    if not rows:
        return "no held-out evaluation has run yet", []
    current = stratum_gaps(rows[-1])
    if not current:
        return "the last held-out evaluation recorded no stratum", []
    previous = stratum_gaps(rows[-2]) if len(rows) > 1 else {}
    widened = sorted(name for name, gap in current.items() if gap > previous.get(name, gap))
    over = sorted(
        name for name, gap in current.items() if threshold is not None and gap > threshold
    )
    if widened:
        return f"gap widened on {', '.join(widened)}", widened
    if over:
        return f"gap over threshold on {', '.join(over)}", []
    return "held-out gap within threshold", []


def cmd_heldout(args: argparse.Namespace) -> int:
    """The verdict, and nothing else. Exit 1 when a gap widened.

    `harness/loop` treats that the way it treats a budget: stop between
    campaigns and escalate, because §12 says a widening gap "needs a human to
    look at the diff" — which is not something the loop that produced the diff
    can do for itself.
    """
    phase = load_phase()
    languages = (
        [args.language]
        if args.language
        else sorted({path.stem for path in HELDOUT.glob("*.jsonl")})
    )
    if not languages:
        print("heldout: no held-out evaluation has run yet")
        return 0
    widened = []
    for language in languages:
        verdict, strata = heldout_verdict(heldout_rows(language), phase.heldout_threshold)
        print(f"heldout: {language}: {verdict}")
        widened += [f"{language}/{name}" for name in strata]
    if widened:
        print(
            "heldout: " + ", ".join(widened) + " widened against the previous gate. "
            "design/loops.md section 12 stops the loop here: it is the one signal that "
            "means the last several iterations were probably net negative, and it needs "
            "a human to look at the diff. The numbers are deliberately not shown — "
            "enough to know something went wrong and where, not enough to hill-climb.",
            file=sys.stderr,
        )
    return 1 if widened else 0


# --------------------------------------------------------------------------
# Selecting a version at a phase gate. `design/loops.md` §10.
#
# "**HEAD is not automatically what proceeds.** At a gate:
#
#   1. Compute the frontier over the phase's commits. Usually a handful of
#      points survive.
#   2. Evaluate *those points only* on the held-out corpus.
#   3. Pick one. Continue from it."
#
# Step 1 is the frontier above. Step 3 is here. **Step 2 is not, and cannot
# be**: it is a corpus run, which is `measure_<lang>`'s and outside every path
# this loop owns, against a corpus and a handler that phase 1a does not have.
# What is here instead is the refusal — a candidate with no held-out row makes
# the whole selection stop rather than being quietly dropped, because "the
# held-out evaluation at step 2 is not a nicety here; it is what makes step 3
# mean anything".
#
# That refusal is the load-bearing half. §10's own argument is that "selecting
# on the tuning corpus alone would be model selection on the training set, and
# the frontier makes that worse rather than better, because it explicitly
# searches the whole history for the best-looking point". A selection command
# that ranked whatever it happened to have evaluated would do exactly that, on
# a smaller set, and read as though it had not.


def heldout_score(row: dict) -> float | None:
    """A candidate's held-out number, aggregated the way an axis is.

    One number and not two: §12's row carries `{tuning, heldout}` per stratum,
    and the axis §10 selects on is top-1 agreement — the one quality number
    that "must not be improvable by answering more". Coverage is the frontier's
    other axis, but it is a property of the candidate rather than of the split
    and is already read from the metrics row at step 1.
    """
    return stratum_mean(row, "heldout")


def gate_selection(
    candidates: list[dict], evaluated: dict[str, dict]
) -> tuple[dict | None, list[str]]:
    """§10's step 3, and the refusal that makes it mean anything.

    Returns the chosen candidate and the candidate commits step 2 has not
    evaluated. Any unevaluated candidate refuses the whole selection rather
    than being skipped: skipping would rank the remainder, and the remainder
    was chosen by the tuning numbers alone.

    Ties break on the earlier commit — `sorted` is stable and the candidates
    arrive in record order — and deliberately not on a tuning number. Using
    one would be a small dose of the thing step 2 exists to stop, and it would
    be the invisible kind, since it only ever decides cases where held-out has
    already said the candidates are the same.
    """
    missing = [
        candidate.get("commit") or ""
        for candidate in candidates
        if heldout_score(evaluated.get(candidate.get("commit") or "") or {}) is None
    ]
    if missing or not candidates:
        return None, missing
    ranked = sorted(
        candidates,
        key=lambda candidate: -(heldout_score(evaluated[candidate["commit"]]) or 0.0),
    )
    return ranked[0], []


def gate_verdict_rows(
    evaluations: list[dict], candidates: list[dict], chosen: str
) -> list[dict]:
    """What §12's widening test compares at a gate: the previous gate's row,
    then the chosen one.

    Not the previous *row*. The other candidates of this gate sit between them
    in the file, so the naive reading compares the selected version against a
    sibling it was selected over — which reports a widening every time the
    frontier had more than one point on it, on the gates where selection was
    doing the most work.
    """
    contenders = {candidate.get("commit") for candidate in candidates}
    earlier = [row for row in evaluations if row.get("commit") not in contenders]
    current = [row for row in evaluations if row.get("commit") == chosen]
    return earlier[-1:] + current[-1:]


def cmd_gate_select(args: argparse.Namespace) -> int:
    """The three steps, run at a gate by a person.

    Exit 1 means no version was selected — either step 2 has not run on every
    candidate, or the chosen one's held-out gap widened, which §12 says "needs
    a human to look at the diff".

    Nothing here prints a held-out number, for §12's fourth bullet: "the loop
    is shown a verdict, not the numbers ... enough to know something went
    wrong and where; not enough to hill-climb." The tuning axes *are* printed,
    because `hj frontier` already shows them to anyone who asks and hiding
    them would only make the choice unreadable.
    """
    phase, config = loop_config(args.loop)
    wanted = args.phase or phase.phase
    if not config.language:
        die(
            f"loop {args.loop} declares no language, so it has no held-out corpus to "
            "select against (design/loops.md section 10)"
        )
    rows = [row for row in read_jsonl(metrics_path(config.owner)) if row.get("phase") == wanted]
    candidates = frontier_points(rows)
    print(
        f"gate-select: {config.language}: step 1 — {len(candidates)} of {len(rows)} "
        f"row(s) in phase {wanted} are on the frontier"
    )
    if not candidates:
        print(
            "gate-select: nothing to select between. No row of this phase carries both "
            f"of {' and '.join(FRONTIER_AXES)}, so there is no frontier to evaluate.",
            file=sys.stderr,
        )
        return 1
    for candidate in candidates:
        axes = candidate["frontier_axes"]
        print(
            f"  {(candidate.get('commit') or '')[:12]}  "
            + "  ".join(f"{axis} {axes[axis]:.4f}" for axis in FRONTIER_AXES)
        )

    evaluations = heldout_rows(config.language)
    evaluated = {row.get("commit"): row for row in evaluations if row.get("commit")}
    chosen, missing = gate_selection(candidates, evaluated)
    if chosen is None:
        print(
            "gate-select: step 2 has not run on "
            + ", ".join(commit[:12] for commit in missing)
            + f". Evaluate those points on the held-out corpus and append to "
            f"state/heldout/{config.language}.jsonl. design/loops.md section 10 "
            "refuses to select without them: selecting on the tuning corpus alone "
            "would be model selection on the training set, and the frontier makes "
            "that worse rather than better because it searches the whole history "
            "for the best-looking point.",
            file=sys.stderr,
        )
        return 1

    commit = chosen["commit"]
    verdict, widened = heldout_verdict(
        gate_verdict_rows(evaluations, candidates, commit), phase.heldout_threshold
    )
    print(f"gate-select: step 3 — {commit[:12]} proceeds; held-out {verdict}")
    if widened:
        print(
            f"gate-select: {', '.join(widened)} widened against the previous gate. "
            "design/loops.md section 12 stops here and escalates: it is the one "
            "signal that means the last several iterations were probably net "
            "negative, and it needs a human to look at the diff.",
            file=sys.stderr,
        )
        return 1
    return 0


# §11's guardrail is on two things: "`measure_<lang>` size and per-query work".
# Both are read out of the metrics row. The second was a reason string for six
# campaigns, on the argument that nothing measured per-query work — which
# stopped being true when `replay_digest` started writing per-stratum latency
# percentiles, and a guardrail that cannot fire is one the table describes and
# the code does not have.
GUARDRAILS = {
    "measure_binary_bytes": "the stripped size of measure_<lang>",
    "query_micros": "per-query work",
}


def last_recorded_size(rows: list[dict]) -> int | None:
    for row in reversed(rows):
        binary = row.get("binary")
        if isinstance(binary, dict) and isinstance(binary.get("stripped"), int):
            return binary["stripped"]
    return None


def worst_stratum_query_micros(row: dict) -> tuple[int, str] | None:
    """The slowest stratum's p99 in one row, and which stratum it was.

    The worst stratum rather than an aggregate over them, and the tail rather
    than the median, for the reason §11 gives for the ceiling existing at all:
    it is set "an order of magnitude above where anything reasonable sits", so
    what it watches for is one stratum having gone pathological. An n-weighted
    mean of the kind `stratum_mean` computes for a frontier axis would hide
    exactly that — `data-collection.md` sizes the strata an order of magnitude
    apart, so the rare stratum is the one an aggregate cannot see, and the rare
    stratum is where an exhaustive fallback search runs.

    A p50 that stays put while the p99 goes to seconds is a search that has
    stopped terminating on some inputs, which is per-query work in the sense
    §11 bounds it.
    """
    worst: tuple[int, str] | None = None
    for name, numbers in sorted((row.get("strata") or {}).items()):
        if not isinstance(numbers, dict):
            continue
        value = numbers.get("latency_p99_us")
        if not isinstance(value, (int, float)) or isinstance(value, bool):
            continue
        if worst is None or round(value) > worst[0]:
            worst = (round(value), name)
    return worst


def last_recorded_query_micros(rows: list[dict]) -> tuple[int, str] | None:
    for row in reversed(rows):
        worst = worst_stratum_query_micros(row)
        if worst is not None:
            return worst
    return None


def guardrail_warning(observed: str, ceiling: int) -> str:
    """The one wording for a crossed ceiling, said in two places.

    §11 asks for it "within a campaign rather than at a gate", so `record`
    says it as the number is taken; the stop happens between campaigns, where
    `harness/loop` says it again. Two sites, and the sentence that keeps a
    guardrail from reading like a ratchet is the whole point of it — so it is
    written once rather than agreed twice.
    """
    return (
        f"guardrail: {observed} against a standing ceiling of {ceiling}. This is not "
        "a verdict on the last change (design/loops.md section 11); it means the loop "
        "has wandered somewhere no legitimate experiment goes. It stops the loop "
        "between campaigns, not this gate."
    )


def guardrail_scopes(phase: Phase, owner: str | None = None) -> list[dict]:
    """One entry per standing ceiling, with what has been observed against it.

    Read out of the metrics history rather than measured here. The guardrail is
    consulted between campaigns and again from `record`, and a fresh release
    build or corpus replay at either point would put minutes on both — where
    the number it would produce is the one the last row already carries.
    """
    rows = read_jsonl(metrics_path(owner)) if owner else []
    scopes = []
    for name, description in GUARDRAILS.items():
        observed: int | None = None
        reason: str | None = None
        note: str | None = None
        if name == "measure_binary_bytes":
            observed = last_recorded_size(rows)
            if observed is None:
                reason = "no row of this loop's carries a binary size yet"
        else:
            worst = last_recorded_query_micros(rows)
            if worst is None:
                reason = "no row of this loop's carries a replayed latency yet"
            else:
                observed, note = worst[0], f"p99 of {worst[1]}, the slowest stratum"
        scopes.append(
            {
                "scope": name,
                "of": description,
                "ceiling": phase.guardrail.get(name),
                "observed": observed,
                "reason": reason,
                "note": note,
            }
        )
    return scopes


def cmd_guardrail(args: argparse.Namespace) -> int:
    """§11's phase-2a ceiling, which is not the phase-3 ratchet and must not
    behave like one.

    Exit 1 means one is crossed, and `harness/loop` treats that the way it
    treats an exhausted budget: stop between campaigns, where the tree is
    committed, and escalate. It is emphatically not a gate step — §11 says
    crossing it "does not mean the last change was wrong", and failing the gate
    would say exactly that to the campaign that happened to be running.
    """
    phase = load_phase()
    if args.loop:
        loop_config(args.loop)
    crossed = []
    for entry in guardrail_scopes(phase, args.loop):
        ceiling, observed = entry["ceiling"], entry["observed"]
        if ceiling is None:
            state = "no ceiling set"
        elif observed is None:
            state = f"ceiling {ceiling}, nothing observed — {entry['reason']}"
        else:
            state = f"{observed} of {ceiling} ({observed / ceiling * 100:.0f}%)"
            if entry["note"]:
                state += f" — {entry['note']}"
            if observed > ceiling:
                state += "  — CROSSED"
                crossed.append(entry["scope"])
        print(f"guardrail: {entry['scope']:<22} {entry['of']:<34} {state}")
    if crossed:
        print(
            "guardrail: crossed at "
            + ", ".join(crossed)
            + ". design/loops.md section 11 sets these an order of magnitude above "
            "anything legitimate, so this is not a verdict on the last change — it "
            "means the loop has wandered somewhere no experiment goes. Stop, look, "
            "and either raise the ceiling in state/phase.toml under [guardrail] as a "
            "logged intervention or answer why the loop went there.",
            file=sys.stderr,
        )
    return 1 if crossed else 0


def waiting_decisions(answers: dict[str, dict] | None = None) -> list[tuple[str, str]]:
    """Records a batch review would consume, as (id, opened), oldest first.

    Status comes from `decision_status`, which derives it from the intervention
    log rather than from the record's own `status:` line: a record whose file
    says `accepted` and whose ruling was never logged is still waiting, because
    the reasoning a batch exists to produce is not there.
    """
    answers = decision_answers() if answers is None else answers
    waiting = []
    for path in sorted((STATE / "decisions").glob("*.md")):
        text = path.read_text()
        recorded = re.search(r"^status:\s*(.+)$", text, re.MULTILINE)
        if decision_status(path.stem, recorded.group(1) if recorded else "", answers) not in (
            "open",
            "provisional",
        ):
            continue
        opened = re.search(r"^opened:\s*(\S+)", text, re.MULTILINE)
        waiting.append((path.stem, opened.group(1) if opened else ""))
    return sorted(waiting, key=lambda entry: (entry[1] or "9999", entry[0]))


def batch_is_due(waiting: int, threshold: int | None) -> tuple[bool, str]:
    """`design/loops.md` section 6's first batch trigger. The second is a phase
    gate, which is a human event and needs no arithmetic.

    **What is counted is records waiting on a human, not tagged sites**, and
    the two differ. Section 6 names "the outstanding `DECISION-` count", having
    two paragraphs earlier defined that as what `grep -r DECISION-` reports —
    but a record can be waiting with no taggable site at all, and that is not a
    corner case. `harness-002`, `harness-003` and `harness-007` each say so in
    their own "Provisional choice in force" section, and for the same reason:
    the choice each is about lives in a file the raising loop may not write —
    `.claude/settings.json`, `state/phase.toml`, another loop's crate — so
    there is nowhere to put the tag. Counting sites would leave exactly the
    escalations a loop could not act on invisible to the trigger. The grep
    count stays
    what section 6 separately calls it, a health metric that rises when the
    loop runs ahead of its decisions (`provisional_decisions`).
    """
    if threshold is None:
        return False, "no threshold set in state/phase.toml; a phase gate is the only trigger"
    if waiting >= threshold:
        return True, f"{waiting} waiting, threshold {threshold}"
    return False, f"{waiting} of {threshold}"


def campaigns_closed_since(timestamp: str) -> int:
    """Campaigns closed across every loop since a decision was raised.

    Section 6: "the loop runs further on provisional choices and reconciliation
    gets more expensive the longer it waits". Campaigns are the unit that
    expense is actually paid in, so this is the number that says whether the
    threshold is too high — wall-clock says nothing when a fleet is idle.
    """
    if not timestamp:
        return 0
    latest: dict[str, dict] = {}
    for row in session_rows():
        latest.setdefault(row["campaign"], {}).update(row)
    return sum(
        1 for row in latest.values() if row.get("outcome") and (row.get("ended") or "") > timestamp
    )


def cmd_escalations(args: argparse.Namespace) -> int:
    """`design/loops.md` section 6: escalations are reviewed in batches, never
    as interrupts, because answering each as it arrives "would make the
    operator the rate limiter for every loop at once".

    Exit 1 means a batch is due. **Nothing in `harness/loop` consults this, and
    nothing should**: section 6 says the loop "never idles waiting for an
    answer", so a due batch is a message to the operator and never a stop. That
    is the difference between this and `hj budget`, which exits 1 for a
    condition the harness is supposed to act on.
    """
    phase = load_phase()
    waiting = waiting_decisions()
    due, reason = batch_is_due(len(waiting), phase.escalation_batch)
    print(
        f"escalations: {len(waiting)} waiting on a human, "
        f"{provisional_decisions()} site(s) running on a provisional choice"
    )
    for identifier, opened in waiting:
        waited = campaigns_closed_since(opened)
        print(f"  {identifier:<16} opened {(opened[:10] or '?'):<12} {waited} campaign(s) ago")
    print(f"escalations: batch {'DUE' if due else 'not due'} — {reason}")
    if due:
        print(
            "escalations: answer them from the dashboard, which logs the ruling and the"
            " reasoning in one action. The loops keep running meanwhile; a due batch"
            " stops nothing.",
            file=sys.stderr,
        )
    return 1 if due else 0


def cmd_gaps(args: argparse.Namespace) -> int:
    _, config = loop_config(args.loop)
    ledger = gap_ledger(config.docs)
    print(
        f"gaps: {ledger['gaps_closed']} closed of {ledger['gaps_found']} found; "
        f"{ledger['gaps_open']} open"
    )
    for row in read_jsonl(GAP_LOG):
        print(
            f"  {row['ts']}  +{len(row.get('opened', []))} opened  "
            f"-{len(row.get('closed', []))} closed  {row.get('persisted', 0)} persisted"
        )
    return 0


def cmd_audit_due(args: argparse.Namespace) -> int:
    """Exit 0 when an audit is due. `audit_every` campaigns since the last one.

    The auditor is a whole session per run (`design/loops.md` section 15 calls
    it a fixed cost), and running it after every campaign spends that on a
    picture that has barely moved.
    """
    phase, config = loop_config(args.loop)
    every = phase.audit_every
    rows = read_jsonl(GAP_LOG)
    since = rows[-1]["ts"] if rows else ""
    # A campaign that died counts if it committed anything. The exclusion is
    # meant for sessions that produced nothing, but it keyed on the outcome
    # rather than on the work: four campaigns recorded `crashed` had between
    # two and five commits each, and a quota ceiling at turn 142 hid a whole
    # campaign's work from the cadence. What the audit measures is the
    # repository, so what should gate it is whether the repository moved.
    closed_since = [
        campaign
        for campaign in campaigns_of(config.owner)
        if campaign.get("ended", "") > since
        and (campaign.get("outcome") not in ("crashed", "budget") or campaign.get("progress"))
    ]
    due = len(closed_since) >= every
    print(
        f"audit: {len(closed_since)} campaign(s) closed since the last audit, every={every}"
        f" — {'due' if due else 'not due'}"
    )
    return 0 if due else 1


def cmd_audit_cost(args: argparse.Namespace) -> int:
    phase, config = loop_config(args.loop)
    measured = subprocess.run(
        [str(HARNESS / "adapter"), "cost", args.transcript], capture_output=True, text=True, check=False
    ).stdout.strip()
    try:
        numbers = json.loads(measured or "{}")
    except json.JSONDecodeError:
        numbers = {}
    if not numbers:
        print("cost: the audit transcript carries no result event")
        return 0
    append_jsonl(
        cost_path(config.owner),
        {"kind": "audit", "loop": config.owner, "phase": phase.phase, "ts": now(), **numbers},
    )
    commit_harness_state([cost_path(config.owner)], f"audit cost ${numbers.get('usd') or 0:.2f}")
    print(f"cost: audit ${numbers.get('usd') or 0:.2f}, {numbers.get('output_tokens') or 0:,} out")
    return 0


HANDOFF = STATE / "handoff.md"

# `design/loops.md` §7 names four things a handoff carries, and they are kept
# here as one list because the file has two authors: the harness assembles the
# first two from the run of campaigns, and the last two are quoted from the
# stalled campaign's own record. A heading that drifts on one side is a
# question that silently stops being answered.
HANDOFF_SECTIONS = {
    "trying": "## What it was trying",
    "tried": "## What it tried",
    "blocking": "## What the last campaign believed was blocking it",
    "question": "## The question",
}


def handoff_text(owner: str, config: LoopConfig) -> str:
    """`design/loops.md` §7: on stall the loop stops and writes
    `state/handoff.md` — what it was trying, what it tried, what it believes is
    blocking, and the specific question that would unblock it.

    Assembled by the loop rather than written by a campaign, because §7 says
    the *loop* writes it and only the loop knows the run of campaigns that
    stalled it; a campaign sees one of them. The campaign's own account is not
    lost — it is quoted from the record it fills at close, which is where the
    only two of §7's four things a campaign knows and the harness does not
    live: what it believes is blocking, and the question.
    """
    closed = judged_campaigns(owner)
    trailing = trailing_without_progress(owner)
    stalled_run = closed[-trailing:] if trailing else []
    counts = audit_counts(config.docs)

    tried = [
        f"| `{row.get('campaign', '?')[:8]}` | {row.get('target') or '(none named)'} "
        f"| {row.get('outcome') or 'open'} | {row.get('commits') if row.get('commits') is not None else '?'} |"
        for row in stalled_run
    ]

    named: list[str] = []
    for row in stalled_run:
        anchors, _, _ = named_targets(row)
        for anchor in sorted(anchors):
            if anchor and anchor not in named:
                named.append(anchor)
    still_open = sorted(
        {f"{key}[{gap_id(key, gap.claim)}]" for key, gap in open_gaps(config.docs) if key in named}
    )

    # This loop's own records only. Another loop's open question is not what
    # stopped this one, and a handoff that lists the fleet's whole queue asks
    # a human to do the filtering the harness could have done.
    waiting = [
        identifier
        for identifier, _ in waiting_decisions()
        if identifier.startswith(f"{owner}-")
    ]

    account = ""
    if stalled_run:
        record = STATE / "campaigns" / owner / f"{stalled_run[-1].get('campaign', '')}.md"
        if record.is_file():
            body = record.read_text()
            outcome = body.split("\n## Outcome", 1)
            if len(outcome) == 2:
                account = outcome[1].strip()

    lines = [
        f"# Stall handoff — `{owner}`",
        "",
        f"- loop: `{owner}`",
        f"- written: {now()}",
        f"- commit: `{head_sha()[:12]}`",
        f"- rule: {trailing} campaign(s) closed in a row with no progress; N is {config.stall_n}",
        f"- number: {counts['sections_clean']}/{counts['sections_total']} sections clean, "
        f"{counts['open_gaps']} open gaps, {counts['sections_unjudged']} unjudged",
        "",
        "The loop has stopped and will not start again until `state/phase.toml`",
        f"sets `{owner}` back to `running`. Unblocking it is a `stall-unblocked`",
        "intervention.",
        "",
        HANDOFF_SECTIONS["trying"],
        "",
    ]
    lines += [f"- `{anchor}`" for anchor in named] or [
        "- Nothing recorded. The stalled campaigns named no target, which is"
        " itself the finding: a loop with nothing to take is not a loop that"
        " failed at something."
    ]
    lines += [
        "",
        HANDOFF_SECTIONS["tried"],
        "",
        "| campaign | target | outcome | commits |",
        "|---|---|---|---|",
    ]
    lines += tried or ["| (none) | | | |"]
    lines += ["", "## What is still open under those targets", ""]
    lines += [f"- `{gap}`" for gap in still_open] or [
        "- None of the named sections has an open gap left, which means the"
        " stall is in the measurement rather than in the work: the campaigns"
        " closed something the audit has not re-judged."
    ]
    if account:
        lines += [
            "",
            HANDOFF_SECTIONS["blocking"],
            "",
            f"From `state/campaigns/{owner}/{stalled_run[-1].get('campaign', '')}.md`:",
            "",
            account,
        ]
    else:
        lines += [
            "",
            HANDOFF_SECTIONS["blocking"],
            "",
            "Its record has no outcome section. That is a gap in the account and"
            " not evidence of anything: read the journal and the diff instead.",
        ]
    lines += ["", HANDOFF_SECTIONS["question"], ""]
    if waiting:
        lines += [
            "These records are open and are this loop's own. The stall and at least",
            "one of them are likely the same blockage:",
            "",
        ]
        lines += [f"- `state/decisions/{identifier}.md`" for identifier in waiting]
        lines += [
            "",
            "If none of them is what stopped the loop, the question is below and",
            "nobody has written it down yet.",
        ]
    else:
        lines += [
            "No decision record is open for this loop, so the loop did not know",
            "what to ask — which is the more serious of the two shapes. Read the",
            "journal entries for the campaigns above: §7 asks a stalled loop for",
            "the one question that would unblock it, and a stall with no question",
            "means the campaigns did not find the edge they were hitting.",
        ]
    lines += [
        "",
        "---",
        "",
        "Delete this file once the stall is answered. It is the dashboard's signal",
        "that a loop is waiting, and one left behind reports a stall that is over.",
        "",
    ]
    return "\n".join(lines)


def cmd_handoff(args: argparse.Namespace) -> int:
    """`design/loops.md` §7's handoff, written by the loop as it stops.

    Always rewritten. The file is the account of *this* stall, and a leftover
    from a previous one that a human forgot to delete is worse than no file —
    the dashboard renders it as a live request.
    """
    _, config = loop_config(args.loop)
    HANDOFF.parent.mkdir(parents=True, exist_ok=True)
    HANDOFF.write_text(handoff_text(config.owner, config))
    commit_harness_state([HANDOFF], f"stall handoff for {config.owner}")
    print(f"handoff: wrote {HANDOFF.relative_to(REPO)}")
    return 0


def cmd_stall(args: argparse.Namespace) -> int:
    """`design/loops.md` section 7: stall is judged per campaign, not per
    experiment. N consecutive closed campaigns with no progress stops the
    loop and asks for a human."""
    _, config = loop_config(args.loop)
    closed = judged_campaigns(config.owner)
    trailing = trailing_without_progress(config.owner)
    empty = sum(1 for c in closed[-config.stall_n :] if c.get("commits") == 0)
    crashed = sum(1 for c in campaigns_of(config.owner) if c.get("outcome") == "crashed")
    print(
        f"stall: {trailing} campaign(s) without progress (N={config.stall_n}); "
        f"{empty} of the last {config.stall_n} produced no commit; {crashed} crashed (not counted)"
    )
    # Section 7's two ralph heuristics. Both report and neither stops: the
    # first the section calls a flag, and the second is a diagnosis of the
    # stall rule above rather than a second rule beside it.
    unsupported = unsupported_claims(config.owner)
    if unsupported:
        print(
            f"stall: {unsupported} of those closed claiming movement the repository does not"
            " show — a loop that has decided it is finished, not one that has hit something hard"
        )
    churn = test_churn(config.owner)
    if churn["ratio"] is None and not churn["commits"]:
        # Distinct from the no-Rust case below, and it was printing as "none of
        # the last 0 commit(s) touched Rust", which is both false and unhelpful.
        print(
            f"stall: test churn not measurable yet — {churn['unsettled']} recent commit(s)"
            " belong to campaigns no audit has settled, and the measure only counts"
            " work the audit has judged"
        )
    elif churn["ratio"] is None:
        print(
            f"stall: test churn not measurable — none of the last {churn['commits']} judged"
            " commit(s) touched Rust, so there is no source/test split to read"
        )
    else:
        print(
            f"stall: {churn['test_only']} of {churn['classifiable']} judged Rust commits were"
            f" test-only ({churn['ratio']:.0%}, flag at {TEST_CHURN_FLAG:.0%})"
            + (
                f"; {churn['conformance']} more closed a gap the audit credited and are not churn"
                if churn["conformance"]
                else ""
            )
            + ("  — FLAGGED" if churn["flagged"] else "")
        )
    return 1 if trailing >= config.stall_n else 0


def cmd_status(args: argparse.Namespace) -> int:
    phase = load_phase()
    print(f"phase {phase.phase}   ({now()})")
    for owner, config in sorted(phase.loops.items()):
        counts = audit_counts(config.docs)
        campaigns = campaigns_of(owner)
        closed = judged_campaigns(owner)
        trailing = trailing_without_progress(owner)
        crashed = sum(1 for c in campaigns if c.get("outcome") == "crashed")
        print()
        print(f"  {owner}  [{config.status}]")
        print(f"    docs        {', '.join(config.docs) or '(none)'}")
        ledger = gap_ledger(config.docs)
        # Gaps closed leads, because sections clean cannot move until every
        # claim in a section lands and the sections are large — so early on it
        # reads as nothing happening while a great deal happens underneath.
        print(
            f"    gaps        {ledger['gaps_closed']} closed of {ledger['gaps_found']} found, "
            f"{ledger['gaps_open']} open"
        )
        print(
            f"    sections    {counts['sections_clean']}/{counts['sections_total']} clean, "
            f"{counts['sections_unjudged']} unjudged, {counts['audit_minors']} minor"
        )
        print(
            f"    campaigns   {len(campaigns)} opened, {len(closed)} judged, {crashed} crashed, "
            f"{trailing} without progress (stall N={config.stall_n})"
        )
        for campaign in campaigns[-5:]:
            flag = "  [spec drift]" if campaign.get("spec_drift") else ""
            flag += "  [prompt drift]" if campaign.get("prompt_drift") else ""
            print(
                f"      {campaign.get('campaign', '?')[:8]}  "
                f"{(campaign.get('target') or '-'):<48.48}  {campaign.get('outcome') or 'open'}{flag}"
            )
        for line in baseline_drift(config.docs):
            print(f"    baseline    {line}")
    print()
    print(f"  provisional DECISION- tags: {provisional_decisions()}")
    decisions = sorted((STATE / "decisions").glob("*.md"))
    waiting = waiting_decisions()
    due, reason = batch_is_due(len(waiting), phase.escalation_batch)
    print(
        f"  decisions: {len(decisions)} recorded, {len(waiting)} waiting on a human; "
        f"batch {'DUE' if due else 'not due'} ({reason})"
    )
    changes = spec_changes()
    unread = [entry for entry in changes if not entry["reviewed"]]
    print(f"  spec changes: {len(changes)} recorded, {len(unread)} not yet read by a human")
    flagged = [
        campaign
        for owner in phase.loops
        for campaign in campaigns_of(owner)
        if campaign.get("spec_drift")
    ]
    # Subtracting the reviewed ones is the whole point: a line that counts
    # every campaign ever flagged says "read them" forever, so it reads as a
    # queue that reading never empties, and a queue nobody can empty stops
    # being read at all. The two lines above it are already written this way.
    drift_reviewed = {
        row.get("target")
        for row in read_jsonl(INTERVENTIONS)
        if row.get("kind") == "spec-drift-reviewed"
    }
    unread = [campaign for campaign in flagged if campaign.get("campaign") not in drift_reviewed]
    if flagged:
        print(
            f"  campaigns that edited design/ and code together: {len(flagged)} recorded, "
            f"{len(unread)} not yet read by a human"
        )
    prompt_flagged = [
        campaign
        for owner in phase.loops
        for campaign in campaigns_of(owner)
        if campaign.get("prompt_drift")
    ]
    prompt_reviewed = {
        row.get("target")
        for row in read_jsonl(INTERVENTIONS)
        if row.get("kind") == "prompt-drift-reviewed"
    }
    prompt_unread = [
        campaign for campaign in prompt_flagged if campaign.get("campaign") not in prompt_reviewed
    ]
    if prompt_flagged:
        print(
            f"  campaigns that edited a prompt: {len(prompt_flagged)} recorded, "
            f"{len(prompt_unread)} not yet read by a human (harness-009)"
        )
    return 0


CHANGELOG_ENTRY = re.compile(r"^##\s+(?P<id>CHANGE-[A-Za-z0-9_-]+)\s+—\s+(?P<rest>.*)$", re.MULTILINE)


def spec_changes() -> list[dict]:
    """Class A spec edits, and whether anyone has read them yet.

    They are provisional until reviewed in exactly the sense a Class B
    provisional choice is: applied immediately so the loop never idles, and
    scheduled for the next batch (`design/loops.md` section 6). An edit nobody
    was scheduled to read is the one that lets the spec drift toward whatever
    was built.
    """
    reviewed = {
        row.get("target")
        for row in read_jsonl(INTERVENTIONS)
        if row.get("kind") == "spec-change-reviewed"
    }
    entries = []
    for path in changelog_paths():
        text = path.read_text()
        matches = list(CHANGELOG_ENTRY.finditer(text))
        for index, match in enumerate(matches):
            end = matches[index + 1].start() if index + 1 < len(matches) else len(text)
            entries.append(
                {
                    "id": match.group("id"),
                    "heading": match.group("rest").strip(),
                    "body": text[match.end() : end].strip(),
                    "reviewed": match.group("id") in reviewed,
                    "owner": (
                        loop_of_worker(path.stem) if path.parent.name == "spec-changelog" else ""
                    ),
                    "worker": path.stem if path.parent.name == "spec-changelog" else "",
                }
            )
    return entries


def loop_of_worker(name: str) -> str:
    """`core-2` is worker 2 of the `core` loop; `core` is the loop itself.

    The changelog is per worker, like the journal and the findings, so the
    filename stopped being the loop's name. Both are kept on the entry: the
    loop is what a reader groups by, and the worker is what says which of three
    campaigns in a round wrote it.

    Only a trailing all-digit segment is a worker number, so a loop that is
    named with a hyphen — `lang-rust` — is left alone.
    """
    head, _, tail = name.rpartition("-")
    return head if head and tail.isdigit() else name


def changelog_paths() -> list[Path]:
    """One changelog per loop, plus the single file that predates the split.

    Two loops on two branches appending to one file conflict on every rebase,
    which is what `design/loops.md` §13 means by partitioning shared state by
    owner — it just did not extend the rule this far. A line-level union merge
    would resolve the conflict and corrupt the result, since these are prose
    blocks and interleaving two of them produces a third entry that neither
    loop wrote.
    """
    directory = STATE / "spec-changelog"
    paths = sorted(directory.glob("*.md")) if directory.is_dir() else []
    legacy = STATE / "spec-changelog.md"
    return ([legacy] if legacy.exists() else []) + paths


def cmd_spec_changes(args: argparse.Namespace) -> int:
    entries = spec_changes()
    waiting = [entry for entry in entries if not entry["reviewed"]]
    for entry in entries:
        print(f"{'   ' if entry['reviewed'] else '-> '}{entry['id']}  {entry['heading']}")
    print(f"spec-changelog: {len(entries)} entry(s), {len(waiting)} not yet read by a human")
    return 0


def tuple_returning_misuse(source: str) -> list[str]:
    """Call sites that treat a `-> tuple[...]` helper as if it returned one value.

    There is no type checker here, and the gate's first three steps run `cargo`
    over crates a Python file is not in — so a signature that gains a second
    return value breaks its callers at *runtime*, in whichever command happens
    to run first. `loc_per_crate` did exactly that: it grew a counter name, one
    of its two call sites was updated, and `hj campaign-close` crashed reading
    a dict method straight off the bare call — for every campaign of a round,
    before anyone saw it. The close row is written after that line, so the cost
    was two campaigns closing with no row at all.

    Deliberately narrow: an attribute read straight off a bare call. That is
    the shape the mistake takes. Unpacking and subscripting are the correct
    uses and must not be flagged, and widening this to "any use" would need a
    parser. The pattern must not appear in this docstring either, or the check
    reports itself.
    """
    returns_tuple = re.findall(r"^def (\w+)\([^)]*\)\s*->\s*tuple\[", source, re.MULTILINE)
    misused = []
    for name in returns_tuple:
        for match in re.finditer(rf"\b{name}\(\)\s*\.", source):
            line = source.count("\n", 0, match.start()) + 1
            misused.append(f"{name} at line {line}")
    return misused


# --------------------------------------------------------------------------
# The self-test
#
# The gate's first three steps are `cargo fmt`, `clippy` and `nextest` over
# the crates a loop owns. A loop that owns no crate — the one building this
# harness — therefore ran a gate that executed not one line of the code it was
# changing, while that code is what computes every loop's number. This is the
# missing step, and it is deliberately hermetic: fixtures in memory, no repo
# state read, nothing that can fail because a campaign is mid-flight. It runs
# for every loop, because `hj` breaking stops all of them.


def selftest_cases() -> list[tuple[str, object]]:
    def merge_deduplicates():
        rows = [
            {"kind": "campaign", "campaign": "a", "usd": 1.0},
            {"kind": "audit", "usd": 0.5, "ts": "t1"},
            {"kind": "campaign", "campaign": "b", "usd": 2.0},
            {"kind": "campaign", "campaign": "a", "usd": 1.0, "gate_seconds": 9.0},
        ]
        merged = merge_cost_rows(rows)
        assert len(merged) == 3, merged
        assert sum(row.get("usd") or 0 for row in merged) == 3.5
        assert merged[0]["gate_seconds"] == 9.0, "a re-measured row updates in place"
        assert [row.get("campaign") for row in merged] == ["a", None, "b"], "file order is kept"

    def merge_keeps_audits_distinct():
        rows = [{"kind": "audit", "usd": 1.0, "ts": "t1"}, {"kind": "audit", "usd": 1.0, "ts": "t2"}]
        assert len(merge_cost_rows(rows)) == 2, "audit rows have no id and never merge"

    def mix_is_the_residual():
        numbers = {"gate_runs": 9, "reverts": 2, "gate_failed": 4, "usd": 1.0}
        mix = experiment_mix({"commits": 3}, numbers)
        assert mix == {"committed": 3, "reverted": 2, "empty": 4, "gate_runs": 9, "gate_failed": 4}, mix
        assert numbers == {"usd": 1.0}, "the raw counters are consumed, not left to land in the row"

    def mix_floors_at_zero():
        mix = experiment_mix({"commits": 5}, {"gate_runs": 2, "reverts": 0})
        assert mix["empty"] == 0, "more commits than gate runs is not negative empties"

    def mix_survives_a_campaign_with_nothing():
        mix = experiment_mix({}, {})
        assert mix == {"committed": 0, "reverted": 0, "empty": 0, "gate_runs": 0, "gate_failed": 0}

    def intervals_are_half_open():
        dated = [("t1", 100), ("t2", 200), ("t3", 400)]
        audits = [{"ts": "t2", "closed": ["x", "y"]}, {"ts": "t3", "closed": ["z"]}]
        series = cost_intervals(dated, audits)
        assert series[0]["tokens"] == 300, "a session ending at the audit belongs to it"
        assert series[0]["per_gap"] == 150
        assert series[1]["tokens"] == 400 and series[1]["per_gap"] == 400

    def intervals_without_a_closure_have_no_ratio():
        series = cost_intervals([("t1", 500)], [{"ts": "t9", "closed": []}])
        assert series[0]["per_gap"] is None, "dividing by no gaps is not a cheap interval"

    def intervals_exclude_the_unobserved_tail():
        series = cost_intervals([("t1", 10), ("t9", 999)], [{"ts": "t2", "closed": ["a"]}])
        assert series[0]["tokens"] == 10, "spend after the last audit is in no interval yet"

    def spend_is_global_across_phases():
        phase = Phase(phase="2a")
        total, _ = attribute_spend(
            phase,
            {"core": [{"kind": "campaign", "campaign": "a", "phase": "1a", "usd": 5.0}]},
        )
        assert total == 5.0, "the backstop does not forget last phase"

    def language_scope_is_this_phase_only():
        phase = Phase(phase="2a")
        rows = [
            {"kind": "campaign", "campaign": "a", "phase": "2a", "language": "rust", "usd": 3.0},
            {"kind": "campaign", "campaign": "b", "phase": "1a", "language": "rust", "usd": 90.0},
            {"kind": "campaign", "campaign": "c", "phase": "2a", "language": "python", "usd": 1.0},
        ]
        _, by_language = attribute_spend(phase, {"lang-rust": rows})
        assert by_language == {"rust": 3.0, "python": 1.0}, by_language

    def audits_are_attributed_through_their_loop():
        phase = Phase(phase="2a", loops={"lang-rust": _selftest_loop("lang-rust", "rust")})
        _, by_language = attribute_spend(
            phase, {"lang-rust": [{"kind": "audit", "usd": 2.0, "ts": "t1"}]}
        )
        assert by_language == {"rust": 2.0}, "an audit row carries no language of its own"

    def undated_audits_fall_to_the_current_phase():
        phase = Phase(phase="2a", loops={"lang-rust": _selftest_loop("lang-rust", "rust")})
        _, by_language = attribute_spend(
            phase, {"lang-rust": [{"kind": "audit", "usd": 2.0, "phase": "1a"}]}
        )
        assert by_language == {}, "an audit that records its phase is held to it"

    def scopes_report_absent_ceilings():
        phase = Phase(phase="1a", loops={"core": _selftest_loop("core", None)})
        scopes = {entry["scope"]: entry for entry in budget_scopes(phase, "core")}
        assert scopes["campaign"]["ceiling"] is None
        assert scopes["global"]["ceiling"] is None, "an unset budget is not a zero budget"
        assert scopes["global"]["spent"] is not None, "spend is reported even with no ceiling"

    def a_loop_without_a_language_has_no_language_scope():
        phase = Phase(phase="1a", loops={"core": _selftest_loop("core", None)})
        assert [entry["scope"] for entry in budget_scopes(phase, "core")] == ["campaign", "global"]

    def exhaustion_is_inclusive():
        assert 5.0 >= 5.0, "spending exactly the ceiling is exhausted, not one more campaign"

    def phase_parsing_reads_the_budget_table():
        raw = """
        phase = "2a"
        [budget]
        global_usd = 900.0
        [budget.language]
        rust = 120.0
        """
        table = tomllib.loads(textwrap.dedent(raw))
        budget = Budget(
            global_usd=table["budget"].get("global_usd"),
            language_usd={k: float(v) for k, v in (table["budget"].get("language") or {}).items()},
        )
        assert budget.global_usd == 900.0 and budget.language_usd == {"rust": 120.0}

    def divergence_is_the_cache_boundary():
        assert first_divergence("abcdef", "abcXef") == 3
        assert first_divergence("abc", "abc") == 3, "identical strings diverge nowhere"
        assert first_divergence("abc", "abcdef") == 3, "a prefix ends where the shorter one does"
        assert first_divergence("", "x") == 0

    def the_culprit_is_the_most_specific_value():
        rendered = "read state/campaigns/core/ID-1234.md now"
        values = {
            "campaign_record": "state/campaigns/core/ID-1234.md",
            "campaign_id": "ID-1234",
            "_claimed": ["not a string"],
        }
        offset = rendered.index("ID-1234")
        assert value_at(rendered, offset, values) == "campaign_id", "the shortest spanning value wins"
        assert value_at(rendered, 0, values) is None, "text outside every value belongs to the template"

    def a_per_campaign_value_in_the_body_is_a_problem():
        # The whole of §15's first token lever, and the state harness-001 was
        # answered out of: the id sat in the body at step 1, which ended the
        # core loop's cacheable prefix at 11.9% of a 40KB prompt.
        template = "body {{campaign_record}} more\n---\n\ntail {{campaign_id}}\n"
        problems = prompt_body_problems("p.md", template)
        assert len(problems) == 1, problems
        assert "campaign_record" in problems[0] and "instructional body" in problems[0]

    def ids_in_the_tail_are_clean():
        template = "body, no ids\n---\n\ntail {{campaign_record}} {{campaign_id}}\n"
        assert prompt_body_problems("p.md", template) == []

    def a_prompt_that_never_names_the_record_is_worse_than_a_slow_one():
        template = "body\n---\n\ntail {{campaign_id}}\n"
        problems = prompt_body_problems("p.md", template)
        assert len(problems) == 1 and "nowhere" in problems[0], problems

    def the_separator_has_to_be_findable():
        for template in ("no separator at all {{campaign_id}}", "a\n---\nb\n---\nc"):
            problems = prompt_body_problems("p.md", template)
            assert len(problems) == 1 and "separator" in problems[0], template
        # A body value under a missing separator is not silently forgiven: the
        # separator failure is reported first and the check still fails.
        assert prompt_body_problems("p.md", "{{campaign_id}} no separator") != []

    def the_denied_paths_are_read_out_of_the_paragraph_that_states_them():
        section = (
            "### Mechanics\n\n"
            "`harness/workers` runs in the integration checkout, and\n"
            "`harness/measure` reports the number.\n\n"
            "Four files stay denied to it: `harness/gate` and `harness/ratchets.toml`.\n\n"
            "That list is a constant in `harness/hj`.\n"
        )
        found, problem = documented_harness_denials(section)
        assert problem == "", problem
        assert found == {"harness/gate", "harness/ratchets.toml"}, found

    def a_paragraph_that_cannot_be_found_is_not_an_empty_list():
        # Scoring a reworded paragraph as "nothing is denied" would pass the
        # comparison against a constant that had also been emptied, which is
        # the one direction this check exists to refuse.
        for text in ("no such sentence here", "stay denied to it\n\nstay denied to it"):
            found, problem = documented_harness_denials(text)
            assert found == set() and problem, text

    def a_one_liner_carries_the_hypothesis_it_was_written_with():
        record = (
            "# Campaign x\n\n## Target\n\nloops.md#one\n\n## Hypothesis\n\n"
            "The gap is open because a decision was answered and nobody came back\nfor it.\n\n"
