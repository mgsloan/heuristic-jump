    def widening_outranks_the_threshold():
        # The two say different things: over threshold has been wrong for a
        # while, widened is §12's "the last several iterations were probably
        # net negative". Only the second stops the loop, so it is the one
        # reported when both hold.
        rows = [
            {"strata": {"A": {"tuning": 1.0, "heldout": 0.4}}},
            {"strata": {"A": {"tuning": 1.0, "heldout": 0.2}}},
