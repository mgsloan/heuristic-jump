        prompts = PINNED_HARNESS / "prompts"
        files = [prompts / Path(name).name for name in sorted(live_prompt_templates(phase))]
        files += sorted((prompts / "fragments").glob("*.md"))
        files += [PINNED_HARNESS / "trailer-format.md", PINNED_HARNESS / "decision-template.md"]
        found = [
            problem
            for path in files
            if path.exists()
            for problem in prompt_gate_leaks(path.name, path.read_text(), steps)
        ]
        assert found == [], found
        assert "check_prompt_leaks" in inspect.getsource(cmd_check_metrics), (
            "a check nothing runs is a comment"
