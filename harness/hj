#!/usr/bin/env python3
"""The harness's structural tool. See harness/readme.md.

Everything here is mechanical: parsing section lists out of the design
documents, merging an auditor's verdict into `state/audit/`, checking a
commit's diff scope against the ownership table, rendering a prompt from
its template, and appending the rows that make `state/` a record rather
than a memory.

Nothing here makes a judgement. The judgements belong to the campaign
(what to work on) and to the auditor (whether a section is clean); this
file only decides what is *true* about files on disk.

Owned by nobody, per `design/loops.md` section 13 — a loop that could edit
this could edit the thing that scores it.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import subprocess
import sys
import tempfile
import textwrap
import tomllib
import uuid
from dataclasses import dataclass, field
from datetime import datetime, timezone
from pathlib import Path

# The tree being operated on, which is not always the tree this script lives
# in. A loop that may write `harness/` has to be judged by a reviewed copy of
# it rather than by its own, so the reviewed copy runs with `HJ_REPO` pointing
# at the loop's worktree (`design/loops.md` §13 — the pinned checkout that
# path ownership made unnecessary, and that giving one loop write access to
# `harness/` makes necessary again).
REPO = Path(os.environ.get("HJ_REPO") or Path(__file__).resolve().parent.parent).resolve()
HARNESS = REPO / "harness"
# Desired state, which is control rather than history and must have one
# answer for the whole fleet. A worker reads `state/phase.toml` from its own
# branch otherwise, so pausing the integration checkout does not stop it and
# the fleet has to be killed instead of asked. `harness/loop` sets this to
# the integration checkout; alone it is the tree itself, which is what a
# single-checkout run has always meant.
CONTROL = Path(os.environ.get("HJ_CONTROL") or REPO).resolve()
STATE = REPO / "state"
DESIGN = REPO / "design"

# Denied to every loop in every phase, and deliberately a constant here
# rather than a row in `state/phase.toml`: the ownership table is data the
# gate reads, and a loop that could widen it could widen its own reach.
# `design/loops.md` section 13 states the prohibition; keeping the deny list
# out of configuration is what makes it unrepresentable rather than merely
# forbidden.
DENIED_ALWAYS = [
    # The protocol a loop implements against must not be editable by that loop,
    # for the same reason `harness/` is not: it is a source of truth rather
    # than a thing being built. Regenerate it with `harness/reference-lsp`.
    "reference/**",
    "state/phase.toml",
    "state/audit/**",
    "state/interventions.jsonl",
    "state/sessions.jsonl",
    "CLAUDE.md",
    "clippy.toml",
    ".claude/**",
]

# The one path whose owner is a function of the phase: shared resolution code
# is writable only during whole-repository phases, when there is one writer and
# nothing running alongside (`design/loops.md` section 13). Resolved against
# `state/phase.toml` so the table has one answer at any moment, rather than
# being granted by one row and denied by another.
WHOLE_REPOSITORY_PHASES = ("3", "7")
PHASE_DEPENDENT_DENIALS = ["crates/similarity/**"]

# `harness/` is denied to every loop except one that declares
# `writes_harness`, which today is the harness loop building the phase-2
# machinery (`design/loops.md` §18).
#
# The prohibition exists for exactly one reason — *a loop must not weaken the
# gate that judges it* — and giving a loop write access does not suspend that
# reason, it moves where the property comes from. It is no longer path
# ownership; it is that the loop is judged by the reviewed harness on the
# integration branch rather than by the copy in its own worktree. §13 records
# that a separate pinned checkout was the earlier draft's answer here and was
# dropped only because path ownership had made it unnecessary. Removing path
# ownership brings it back, and `HJ_REPO` is how it is run.
#
# So this list is not a relaxation of the invariant. If the pinned-gate run
# ever stops happening, this constant is a hole and `harness/` belongs back in
# DENIED_ALWAYS the same day.
HARNESS_PATHS = ["harness/**"]

# What a campaign may report about itself: the first four. The last three are
# the harness's, because each is a way of ending that also stops the campaign
# writing its closing line (`budget` exits non-zero with
# `error_max_budget_usd`, and the other two are the runner's own verdicts).
# How long after opening a campaign is presumed to be starting rather than
# dead. Covers the gap between `campaign-open` returning and the runner
# reaching the process table, which several workers reach routinely.
REAP_GRACE_SECONDS = 120

# Bumped whenever `progress` changes meaning.
#   1 — settled at close: sections clean up, or open gaps down, or tests up.
#   2 — re-settled at the audit, which is the first moment the answer
#       exists under workers, and attributed by named gap rather than by a
#       count delta. Strictly additive: a campaign that scored under 1
#       still scores, and the backtest confirms rule 2 reclassifies none
#       of the 29 historical campaigns.
PROGRESS_RULE = 2

OUTCOMES = ("confirmed", "falsified", "no-movement", "partial", "budget", "crashed", "error")


def now() -> str:
    return datetime.now(timezone.utc).isoformat(timespec="seconds")


def die(message: str) -> None:
    print(f"hj: {message}", file=sys.stderr)
    raise SystemExit(2)


# --------------------------------------------------------------------------
# Paths and globbing


def glob_to_regex(pattern: str) -> re.Pattern[str]:
    """`**` crosses directory separators, `*` and `?` do not."""
    if pattern.endswith("/"):
        pattern = pattern + "**"
    out = []
    index = 0
    while index < len(pattern):
        char = pattern[index]
        if pattern.startswith("**/", index):
            out.append("(?:.*/)?")
            index += 3
        elif pattern.startswith("**", index):
            out.append(".*")
            index += 2
        elif char == "*":
            out.append("[^/]*")
            index += 1
        elif char == "?":
            out.append("[^/]")
            index += 1
        else:
            out.append(re.escape(char))
            index += 1
    return re.compile("".join(out) + r"\Z")


def matches_any(path: str, patterns: list[str]) -> bool:
    return any(glob_to_regex(p).match(path) for p in patterns)


# --------------------------------------------------------------------------
# Desired state


@dataclass
class LoopConfig:
    owner: str
    status: str
    prompt: str
    docs: list[str]
    crates: list[str]
    write: list[str]
    stall_n: int
    rotation: int
    splice_sections: int
    detail_gaps: int
    turn_target: str
    budget_usd: float | None
    model: str | None
    language: str | None
    writes_harness: bool


@dataclass
class Budget:
    """The two scopes above the campaign. `design/loops.md` section 15.

    The per-campaign ceiling is `LoopConfig.budget_usd`, and it is the runner's
    to enforce (`--max-budget-usd`) because only the runner can stop a session
    mid-turn. These two are the harness's, checked between campaigns, which is
    the granularity available to something outside the session.

    Both are optional and both default to absent rather than to a number: an
    invented ceiling would stop a fleet on an arbitrary Tuesday, and the
    section asks for budgets that "stop and report", not for a guess.
    """

    global_usd: float | None = None
    language_usd: dict[str, float] = field(default_factory=dict)


@dataclass
class Phase:
    phase: str
    audit_every: int = 1
    budget: Budget = field(default_factory=Budget)
    loops: dict[str, LoopConfig] = field(default_factory=dict)


def load_phase() -> Phase:
    path = CONTROL / "state" / "phase.toml"
    if not path.exists():
        die(f"{path} does not exist; the harness has no desired state to reconcile against")
    raw = tomllib.loads(path.read_text())
    budget_table = raw.get("budget", {})
    result = Phase(
        phase=raw["phase"],
        audit_every=raw.get("audit_every", 1),
        budget=Budget(
            global_usd=budget_table.get("global_usd"),
            language_usd={
                language: float(ceiling)
                for language, ceiling in (budget_table.get("language") or {}).items()
            },
        ),
    )
    for owner, table in raw.get("loop", {}).items():
        result.loops[owner] = LoopConfig(
            owner=owner,
            status=table.get("status", "paused"),
            prompt=table["prompt"],
            docs=table.get("docs", []),
            crates=table.get("crates", []),
            write=table.get("write", []),
            stall_n=table.get("stall_n", 3),
            rotation=table.get("rotation", 6),
            splice_sections=table.get("splice_sections", 3),
            detail_gaps=table.get("detail_gaps", 8),
            turn_target=table.get("turn_target", "about 150"),
            budget_usd=table.get("budget_usd"),
            model=table.get("model"),
            language=table.get("language"),
            writes_harness=bool(table.get("writes_harness", False)),
        )
    return result


def denied_paths(phase: Phase, owner: str | None = None) -> list[str]:
    """What this loop may not write. `owner` omitted means every loop's denials
    together, which is what a summary wants and never what a check wants."""
    denied = list(DENIED_ALWAYS)
    if phase.phase not in WHOLE_REPOSITORY_PHASES:
        denied += PHASE_DEPENDENT_DENIALS
    config = phase.loops.get(owner) if owner else None
    if not (config and config.writes_harness):
        denied += HARNESS_PATHS
    return denied


def loop_config(owner: str) -> tuple[Phase, LoopConfig]:
    phase = load_phase()
    if owner not in phase.loops:
        die(f"no loop named {owner!r} in state/phase.toml (have: {', '.join(sorted(phase.loops))})")
    return phase, phase.loops[owner]


# --------------------------------------------------------------------------
# Design documents: the section list is parsed, never authored


# Level 2 and 3. The design documents put most of their checkable claims under
# `###`, and a denominator of ten sections for a 1700-line document is one the
# numerator can barely move — "sections clean over sections total" is only a
# useful number at a granularity where a campaign can finish one. Each body
# runs to the next heading of any level, so the sections partition the document
# rather than nesting.
HEADING = re.compile(r"^#{2,3}\s+(?P<text>\S.*?)\s*$")


def anchor_of(heading: str) -> str:
    """GitHub's slug: lowercase, drop everything but word characters, spaces
    and hyphens, then **each** space to a hyphen.

    Runs are not collapsed, which is the part that is easy to get wrong. A
    heading like `pyright, basedpyright — Python` loses the em dash and keeps
    the spaces that surrounded it, so the anchor has a double hyphen.
    Collapsing them produced anchors that did not match the document's own
    cross-references, and reported those references as dangling.
    """
    slug = heading.strip().lower()
    slug = re.sub(r"[^a-z0-9 _-]", "", slug)
    return slug.replace(" ", "-").strip("-")


@dataclass
class Section:
    doc: str
    anchor: str
    heading: str
    start: int  # line index of the heading
    end: int  # line index one past the last line of the body

    @property
    def key(self) -> str:
        return f"{self.doc}#{self.anchor}"


def doc_path(doc: str) -> Path:
    path = DESIGN / doc
    if not path.exists():
        die(f"no such design document: {doc}")
    return path


def sections_of(doc: str) -> list[Section]:
    lines = doc_path(doc).read_text().splitlines()
    found: list[Section] = []
    in_fence = False
    for index, line in enumerate(lines):
        if line.startswith("```"):
            in_fence = not in_fence
            continue
        if in_fence:
            continue
        match = HEADING.match(line)
        if match:
            heading = match.group("text")
            found.append(Section(doc, anchor_of(heading), heading, index, len(lines)))
    for earlier, later in zip(found, found[1:]):
        earlier.end = later.start
    seen: dict[str, int] = {}
    for section in found:
        count = seen.get(section.anchor, 0)
        seen[section.anchor] = count + 1
        if count:
            section.anchor = f"{section.anchor}-{count}"  # GitHub's own tie-break
    return found


def section_index(docs: list[str]) -> dict[str, Section]:
    return {s.key: s for doc in docs for s in sections_of(doc)}


ANY_HEADING = re.compile(r"^#{2,}\s+(?P<text>\S.*?)\s*$")


def anchors_of(doc: str) -> set[str]:
    """Every anchor a link or a gap may legitimately name, at any heading depth.

    Distinct from [`sections_of`], which stops at `###` because that is the
    granularity the *score* is counted at. Anchor validity is a different
    question from what the denominator is: `shim.md` links to two `####`
    headings, and treating those as dangling reported real cross-references as
    spec drift.
    """
    found: set[str] = set()
    in_fence = False
    for line in doc_path(doc).read_text().splitlines():
        if line.startswith("```"):
            in_fence = not in_fence
            continue
        if in_fence:
            continue
        match = ANY_HEADING.match(line)
        if match:
            anchor = anchor_of(match.group("text"))
            while anchor in found:
                anchor += "-1"
            found.add(anchor)
    return found


# --------------------------------------------------------------------------
# The baseline: the denominator, frozen for the phase
#
# It lives in `harness/` and not `state/` for the reason everything else in
# `harness/` does — a loop must not be able to move the thing that scores it,
# and here the score is a fraction whose denominator is parsed out of
# documents the conformance loop is allowed to edit.

BASELINE = HARNESS / "section-baseline.toml"


def read_baseline() -> dict:
    if not BASELINE.exists():
        return {}
    return tomllib.loads(BASELINE.read_text())


def baseline_anchors(doc: str) -> set[str] | None:
    """`None` when no baseline has been taken, which means "fall back to the
    documents and say so" rather than "the denominator is zero"."""
    entry = read_baseline().get("doc", {}).get(doc)
    if entry is None:
        return None
    return {f"{doc}#{anchor}" for anchor in entry.get("anchors", [])}


def baseline_drift(docs: list[str]) -> list[str]:
    lines = []
    for doc in docs:
        expected = baseline_anchors(doc)
        if expected is None:
            lines.append(f"{doc}: no baseline; the denominator is being re-derived each audit")
            continue
        live = {s.key for s in sections_of(doc)}
        for key in sorted(expected - live):
            lines.append(f"{key}: in the baseline, gone from the document — counted, and never clean")
        for key in sorted(live - expected):
            lines.append(f"{key}: added since the baseline — audited, but it does not move the score")
    return lines


def section_text(section: Section) -> str:
    lines = doc_path(section.doc).read_text().splitlines()
    body = "\n".join(lines[section.start : section.end]).rstrip()
    return f"<!-- {section.key} -->\n{body}\n"


# --------------------------------------------------------------------------
# The audit record


@dataclass
class Gap:
    claim: str
    found: str
    where: str


@dataclass
class Minor:
    claim: str
    note: str
    where: str


@dataclass
class SectionVerdict:
    key: str
    state: str  # clean | gaps | unjudged
    last_audited: str | None
    gaps: list[Gap] = field(default_factory=list)
    minors: list[Minor] = field(default_factory=list)


VALID_STATES = ("clean", "gaps", "unjudged")


def audit_path(doc: str) -> Path:
    return STATE / "audit" / f"{doc.removesuffix('.md')}.toml"


def read_audit(doc: str) -> dict[str, SectionVerdict]:
    path = audit_path(doc)
    if not path.exists():
        return {}
    raw = tomllib.loads(path.read_text())
    out: dict[str, SectionVerdict] = {}
    for key, table in raw.get("section", {}).items():
        out[key] = SectionVerdict(
            key=key,
            state=table.get("state", "unjudged"),
            last_audited=table.get("last_audited"),
            gaps=[Gap(g.get("claim", ""), g.get("found", ""), g.get("where", "")) for g in table.get("gap", [])],
            minors=[Minor(m.get("claim", ""), m.get("note", ""), m.get("where", "")) for m in table.get("minor", [])],
        )
    return out


def toml_string(value: str) -> str:
    if "\n" in value:
        escaped = value.replace("\\", "\\\\").replace('"""', '\\"\\"\\"')
        return f'"""\n{escaped}"""'
    return json.dumps(value)


def write_audit(doc: str, verdicts: dict[str, SectionVerdict], order: list[str]) -> None:
    lines = [
        f"# Audit of design/{doc}. Written by harness/audit, never by hand.",
        "# `design/loops.md` section 3. The section list is parsed out of the",
        "# document, so it follows the document rather than drifting from it.",
        "",
    ]
    for key in order:
        verdict = verdicts[key]
        lines.append(f"[section.{toml_string(key)}]")
        lines.append(f"state = {toml_string(verdict.state)}")
        if verdict.last_audited:
            lines.append(f"last_audited = {toml_string(verdict.last_audited)}")
        for gap in verdict.gaps:
            lines.append("")
            lines.append(f"  [[section.{toml_string(key)}.gap]]")
            lines.append(f"  claim = {toml_string(gap.claim)}")
            lines.append(f"  found = {toml_string(gap.found)}")
            lines.append(f"  where = {toml_string(gap.where)}")
        for minor in verdict.minors:
            lines.append("")
            lines.append(f"  [[section.{toml_string(key)}.minor]]")
            lines.append(f"  claim = {toml_string(minor.claim)}")
            lines.append(f"  note = {toml_string(minor.note)}")
            lines.append(f"  where = {toml_string(minor.where)}")
        lines.append("")
    path = audit_path(doc)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text("\n".join(lines))


def gap_id(section_key: str, claim: str) -> str:
    """A gap's identity is its section and its claim.

    Not `found` or `where`, which move as the code moves — the same unmet
    claim reported against a different file is the same gap. `design/loops.md`
    section 5: comparing successive audits by gap identity rather than by
    total is what makes the difference visible, because a list that is the
    previous list minus what was fixed is progress, while a different list of
    the same length is variance.
    """
    normalised = re.sub(r"\s+", " ", claim.strip().lower())
    return hashlib.sha256(f"{section_key}|{normalised}".encode()).hexdigest()[:10]


GAP_LOG = STATE / "audit" / "gap-log.jsonl"


def open_gap_ids(docs: list[str]) -> dict[str, tuple[str, str]]:
    out: dict[str, tuple[str, str]] = {}
    for doc in docs:
        known = {s.key for s in sections_of(doc)}
        for key, verdict in read_audit(doc).items():
            if key in known:
                for gap in verdict.gaps:
                    out[gap_id(key, gap.claim)] = (key, gap.claim)
    return out


def audits_for(docs: list[str]) -> list[dict]:
    """The gap-log rows belonging to a document set.

    Gap ids are opaque — `sha256(section|claim)` — so a closed one cannot be
    traced back to its document. What can is the row: an audit covers one
    loop's documents, so a row whose `sections_audited` names any of these
    documents is that loop's, and no row mixes two loops.
    """
    prefixes = tuple(f"{doc}#" for doc in docs)
    return [
        row
        for row in read_jsonl(GAP_LOG)
        if any(key.startswith(prefixes) for key in row.get("sections_audited", []))
    ]


def gap_ledger(docs: list[str]) -> dict[str, int]:
    """Found, closed, still open — cumulative across every audit so far.

    Scoped to `docs`, which it previously took and used only for the open
    count: found and closed came from every row in the log, so a second loop
    reported the first one's totals as its own.
    """
    found: set[str] = set()
    closed: set[str] = set()
    for row in audits_for(docs):
        found.update(row.get("opened", []))
        # A gap can be closed without ever having been *opened* in this log:
        # the audits before the log existed left no identities behind, so the
        # first time one of their gaps is seen here is when it disappears.
        # Counting only `opened` made "closed of found" report 15 closed of 41
        # found while 41 were still open.
        found.update(row.get("closed", []))
        closed.update(row.get("closed", []))
        closed.difference_update(row.get("opened", []))  # reopened is not closed
    still_open = open_gap_ids(docs)
    found.update(still_open)
    closed.difference_update(still_open)
    return {"gaps_found": len(found), "gaps_closed": len(closed), "gaps_open": len(still_open)}


def audit_counts(docs: list[str]) -> dict[str, int]:
    """The conformance loop's number.

    Counted against the *baseline* rather than the documents as they read
    now, because the section list is parsed from headings in documents the
    loop may edit: re-deriving the denominator each audit would let it merge
    two dirty sections into one clean one and move the score without touching
    a line of code (`design/loops.md` section 7).

    A baseline section that no longer exists is counted and is never clean.
    A section added since the baseline is audited — it is real work — but
    does not move the score this phase.
    """
    clean = total = gaps = minors = unjudged = missing = added = 0
    for doc in docs:
        expected = baseline_anchors(doc)
        live = {s.key for s in sections_of(doc)}
        verdicts = read_audit(doc)
        scored = expected if expected is not None else live
        total += len(scored)
        added += len(live - scored)
        for key in scored:
            if key not in live:
                missing += 1
                continue
            verdict = verdicts.get(key)
            if verdict is None or verdict.state == "unjudged":
                unjudged += 1
                continue
            if verdict.state == "clean":
                clean += 1
        for key, verdict in verdicts.items():
            if key in live:
                gaps += len(verdict.gaps)
                minors += len(verdict.minors)
    return {
        "sections_clean": clean,
        "sections_total": total,
        "sections_unjudged": unjudged,
        "sections_missing": missing,
        "sections_added": added,
        "open_gaps": gaps,
        "audit_minors": minors,
    }


def open_gaps(docs: list[str]) -> list[tuple[str, Gap]]:
    out: list[tuple[str, Gap]] = []
    for doc in docs:
        known = {s.key for s in sections_of(doc)}
        for key, verdict in read_audit(doc).items():
            if key in known:
                out.extend((key, gap) for gap in verdict.gaps)
    return out


# --------------------------------------------------------------------------
# Git


def git(*args: str, check: bool = True) -> str:
    result = subprocess.run(
        ["git", "-C", str(REPO), *args], capture_output=True, text=True, check=False
    )
    if check and result.returncode != 0:
        die(f"git {' '.join(args)} failed: {result.stderr.strip()}")
    return result.stdout


def head_sha() -> str:
    return git("rev-parse", "HEAD").strip()


def trailers_of(rev: str) -> dict[str, str]:
    body = git("log", "-1", "--format=%B", rev)
    parsed = subprocess.run(
        ["git", "interpret-trailers", "--parse"],
        input=body,
        capture_output=True,
        text=True,
        check=False,
    ).stdout
    out: dict[str, str] = {}
    for line in parsed.splitlines():
        if ":" in line:
            name, _, value = line.partition(":")
            out[name.strip().lower()] = value.strip()
    return out


def working_tree_paths() -> list[str]:
    """Everything the next commit could contain: staged, unstaged, untracked."""
    raw = git("status", "--porcelain=v1", "-z", "--untracked-files=all")
    fields = raw.split("\0")
    paths: list[str] = []
    index = 0
    while index < len(fields):
        entry = fields[index]
        index += 1
        if not entry:
            continue
        status, path = entry[:2], entry[3:]
        paths.append(path)
        if "R" in status or "C" in status:
            if index < len(fields):
                paths.append(fields[index])
                index += 1
    return sorted(set(paths))


def commit_paths(rev: str) -> list[str]:
    raw = git("show", "--name-only", "--pretty=format:", "-z", rev)
    return sorted({p for p in raw.split("\0") if p})


def commits_for_campaign(campaign_id: str) -> list[str]:
    raw = git("log", "--format=%H", f"--grep=campaign: {campaign_id}", "HEAD")
    return [line for line in raw.splitlines() if line]


# --------------------------------------------------------------------------
# The append-only records


def append_jsonl(path: Path, row: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a") as handle:
        handle.write(json.dumps(row, sort_keys=True) + "\n")


def commit_in(root: Path, paths: list[Path], message: str) -> None:
    relative = [str(path.relative_to(root)) for path in paths if path.exists()]
    if not relative:
        return
    subprocess.run(["git", "-C", str(root), "add", "--", *relative], capture_output=True, check=False)
    result = subprocess.run(
        ["git", "-C", str(root), "commit", "-m", f"harness: {message}", "--", *relative],
        capture_output=True,
        text=True,
        check=False,
    )
    if result.returncode != 0 and "nothing to commit" not in result.stdout:
        print(f"hj: could not commit in {root}: {result.stdout.strip()}", file=sys.stderr)


def commit_harness_state(paths: list[Path], message: str) -> None:
    """The harness commits the rows it writes, as it writes them.

    Reported by the first campaign as `conformance-001`, and it was right: the
    harness appends to `state/sessions.jsonl` when it opens a campaign, that
    file is denied to every loop, and the pre-commit scope check inspects the
    working tree — so the gate was red before the loop wrote a byte, and
    nothing the loop was permitted to do could make it green.

    Of the three options it laid out, this is the one that keeps the deny list
    absolute. Excluding harness files from the pre-commit check would have put
    a carve-out in the one check whose value is that any appearance of a denied
    path is a violation; taking the verdict only post-hoc would mean a scope
    error costs a history rewrite instead of a `git restore`.

    The commits carry no `loop:` or `campaign:` trailer, so they are invisible
    to `commits_for_campaign`, to `check-metrics`, and to the cost join — the
    history stays one commit per experiment as far as anything that counts is
    concerned. Path-limited, so a campaign's uncommitted work is never swept
    in.
    """
    # A path in the integration checkout is committed there, not here: with
    # workers, `sessions.jsonl` lives outside the worktree so that an open
    # campaign is visible to the fleet.
    outside = [path for path in paths if path.exists() and not path.is_relative_to(REPO)]
    for path in outside:
        commit_in(CONTROL, [path], message)
    relative = [
        str(path.relative_to(REPO))
        for path in paths
        if path.exists() and path.is_relative_to(REPO)
    ]
    if not relative:
        return
    status = git("status", "--porcelain", "--", *relative).strip()
    if not status:
        return
    git("add", "--", *relative)
    result = subprocess.run(
        ["git", "-C", str(REPO), "commit", "-m", f"harness: {message}", "--", *relative],
        capture_output=True,
        text=True,
        check=False,
    )
    if result.returncode != 0:
        print(f"hj: could not commit harness state: {result.stdout.strip()} {result.stderr.strip()}", file=sys.stderr)


def read_jsonl(path: Path) -> list[dict]:
    if not path.exists():
        return []
    rows = []
    for line in path.read_text().splitlines():
        line = line.strip()
        if line:
            rows.append(json.loads(line))
    return rows


def sessions_path() -> Path:
    """One file for the whole fleet, in the integration checkout.

    A campaign's *record* is its own work and belongs on its branch. Its
    session row is not: it is how everything else — the dashboard, the stall
    count, the audit cadence, another worker — knows a campaign exists. Kept
    per branch, three workers each appended to their own copy and none of them
    was visible anywhere until the campaign closed and merged, which is
    exactly the window worth watching.

    Concurrent appends are safe as written: each row is a single `write` of
    well under `PIPE_BUF` to a file opened `O_APPEND`, which Linux does not
    interleave. `.gitattributes` union-merges it for the case where a branch
    carries one anyway.
    """
    return CONTROL / "state" / "sessions.jsonl"


def session_rows() -> list[dict]:
    """Every session row this tree can see.

    The fleet's file, plus a worktree-local one when they differ. The local
    one exists only for campaigns opened before the file moved, and for a
    branch that carried a merged copy; reading both means a campaign that
    opened under the old layout can still close.
    """
    rows = read_jsonl(sessions_path())
    local = STATE / "sessions.jsonl"
    if local.resolve() != sessions_path().resolve():
        rows += read_jsonl(local)
    return sorted(rows, key=lambda row: row.get("started") or row.get("ended") or "")


def campaigns_of(owner: str) -> list[dict]:
    """Latest row per campaign id, oldest campaign first."""
    latest: dict[str, dict] = {}
    for row in session_rows():
        if row.get("loop") == owner:
            merged = latest.setdefault(row["campaign"], {})
            merged.update(row)
    return list(latest.values())


def metrics_path(owner: str) -> Path:
    return STATE / "metrics" / f"{owner}.jsonl"


