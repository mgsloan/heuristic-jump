#!/usr/bin/env bash
# PreToolUse hook: reject an Edit or Write outside the running loop's owned
# paths. `design/loops.md` section 13, layer 2.
#
# It is fast feedback, **not a boundary** — deny rules cover Claude's file
# tools and not bash subprocesses, so anything this blocks is reachable
# through `sh -c`. The gate's diff-scope check is the enforcement, because it
# inspects the result rather than trusting the actor. The value here is that
# the campaign finds out before it has written the file, rather than at the
# gate after it has reasoned about it.
#
# A no-op outside a loop: HJ_LOOP is set by harness/loop and by nothing else,
# so an interactive session in this repository is unaffected.
#
# Exit 2 blocks the call and shows stderr to the model.

set -uo pipefail

[ -n "${HJ_LOOP:-}" ] || exit 0

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
hj="$(dirname "$here")/hj"
adapter="$(dirname "$here")/adapter"

# The reviewed copy when there is one, which is the same argument the gate
# makes one layer up: a loop that may write `harness/` must not be checked by
# the copy of `hj` it is halfway through editing.
#
# It is also the difference between a mistake and a deadlock. `hj` with a
# syntax error in it exits non-zero for *every* call, and this hook reads
# non-zero as "denied" — so a single bad edit to `hj` blocks every subsequent
# Edit and Write in the worktree, including the one that would fix it. That
# happened, and the way out was bash, which the hook does not cover. `HJ_REPO`
# still aims the check at this worktree, so the paths judged are the right
# ones under the right rules.
if [ -n "${HJ_PINNED_HARNESS:-}" ] && [ -x "$HJ_PINNED_HARNESS/hj" ]; then
	hj="$HJ_PINNED_HARNESS/hj"
fi

path="$("$adapter" hook-path)"
[ -n "$path" ] || exit 0

if ! "$hj" check-path "$HJ_LOOP" "$path"; then
	exit 2
fi
