#!/usr/bin/env bash
# The only place a vendor-specific invocation appears. `design/loops.md`
# section 17, "The largest dependency in this project is not a crate".
#
# `--session-id`, `-p`, `--output-format stream-json`, `--tools`, the
# `PreToolUse` payload shape, and the transcript layout are all product
# surfaces of one vendor's CLI. They are not versioned like a crate, cannot be
# pinned in a lockfile, cannot be vendored, and change under you on upgrade.
# The usual mitigation is unavailable, so the mitigation is a different shape:
# **isolate rather than pin**.
#
# So `loop`, `audit`, `gate`, `hooks/` and `dashboard/` talk to this file and
# never to `claude` directly. Replacing the runner means rewriting this and
# nothing else.
#
# Subcommands, in rough order of how much breaks if the surface behind them
# moves:
#
#   campaign <session> <prompt-file> <transcript> <permission-mode> [--model M] [--budget USD]
#       Run one campaign headlessly, teeing the stream to <transcript>.
#       If headless-with-a-fixed-prompt goes away, there is no loop.
#   audit <session> <prompt-file> <out> [--model M]
#       Run one read-only session. The tool restriction is the boundary that
#       makes the auditor a judgement rather than a participant.
#   summary <transcript>
#       The campaign's own TARGET and OUTCOME lines, one per line of output.
#   parse-stream <transcript>
#       Normalise the stream into our own event shape, one JSON object per
#       line: {kind, text?, name?, summary?, input?, diff?}. Everything
#       downstream reads this and not the vendor's records.
#   cost <transcript>
#       What the session cost: usd, tokens, model seconds, turns.
#   progress <transcript>
#       The same numbers for a session still running, which `cost` cannot
#       give because it reads the terminal `result` event.
#   transcript-path <owner> <campaign>
#   hook-path        (reads a PreToolUse payload on stdin)
#   version          the CLI version, recorded per campaign
#   resume-command <campaign>

set -uo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo="$(dirname "$here")"

runner="${HJ_RUNNER:-claude}"

usage() {
	sed -n '2,40p' "${BASH_SOURCE[0]}" >&2
	exit 2
}

command="${1:-}"
[ -n "$command" ] || usage
shift

case "$command" in

version)
	"$runner" --version 2>/dev/null | head -1
	;;

transcript-path)
	owner="${1:?owner}"
	campaign="${2:?campaign}"
	root="${HJ_TRANSCRIPTS:-$repo/../heuristic-jump-transcripts}"
	echo "$root/$owner/$campaign.jsonl"
	;;

resume-command)
	echo "$runner --resume ${1:?campaign}"
	;;

campaign)
	session="${1:?session}"
	prompt="${2:?prompt file}"
	transcript="${3:?transcript}"
	mode="${4:?permission mode}"
	shift 4
	extra=()
	while [ $# -gt 0 ]; do
		case "$1" in
		--model)
			[ -n "${2:-}" ] && extra+=(--model "$2")
			shift 2
			;;
		--budget)
			[ -n "${2:-}" ] && extra+=(--max-budget-usd "$2")
			shift 2
			;;
		*)
			echo "adapter: unknown argument: $1" >&2
			exit 2
			;;
		esac
	done
	mkdir -p "$(dirname "$transcript")"
	# A permission prompt in headless mode is a denial, and a campaign has to
	# run the gate, cargo and git without one. The containment is the design's:
	# the PreToolUse hook for fast feedback, the gate's diff-scope check for
	# enforcement (design/loops.md section 13).
	"$runner" -p \
		--session-id "$session" \
		--output-format stream-json \
		--verbose \
		--permission-mode "$mode" \
		"${extra[@]}" \
		<"$prompt" >"$transcript"
	;;

audit)
	session="${1:?session}"
	prompt="${2:?prompt file}"
	out="${3:?output file}"
	shift 3
	extra=()
	while [ $# -gt 0 ]; do
		case "$1" in
		--model)
			[ -n "${2:-}" ] && extra+=(--model "$2")
			shift 2
			;;
		*)
			echo "adapter: unknown argument: $1" >&2
			exit 2
			;;
		esac
	done
	mkdir -p "$(dirname "$out")"
	# The tool restriction is what makes "it cannot edit anything" true rather
	# than instructed, which is why the verdict comes back as text and the
	# harness writes state/audit/ itself.
	#
	# stream-json rather than text, so the session carries a result event and
	# is therefore measurable. The auditor is a fixed cost of one session per
	# audit (design/loops.md section 15) and it was previously invisible to
	# every cost number on the dashboard. The text is extracted afterwards.
	"$runner" -p \
		--session-id "$session" \
		--output-format stream-json \
		--verbose \
		--tools "Read,Grep,Glob" \
		--permission-mode bypassPermissions \
		"${extra[@]}" \
		<"$prompt" >"$out.jsonl"
	status=$?
	"$0" text "$out.jsonl" >"$out"
	exit "$status"
	;;

text)
	# Everything the assistant said, in order. What the auditor's verdict is
	# read out of, now that it runs as a stream.
	python3 - "${1:?transcript}" <<-'PY'
		import json, sys

		for line in open(sys.argv[1], errors="replace"):
		    line = line.strip()
		    if not line:
		        continue
		    try:
		        event = json.loads(line)
		    except json.JSONDecodeError:
		        continue
		    if event.get("type") == "assistant":
		        for block in event.get("message", {}).get("content", []):
		            if block.get("type") == "text":
		                print(block["text"])
	PY
	;;

summary)
	python3 - "${1:?transcript}" <<-'PY'
		import json, sys

		text = []
		terminal = ""
		for line in open(sys.argv[1], errors="replace"):
		    line = line.strip()
		    if not line:
		        continue
		    try:
		        event = json.loads(line)
		    except json.JSONDecodeError:
		        continue
		    if event.get("type") == "result" and event.get("subtype"):
		        terminal = event["subtype"]
		    if event.get("type") == "result" and isinstance(event.get("result"), str):
		        text.append(event["result"])
		    elif event.get("type") == "assistant":
		        for block in event.get("message", {}).get("content", []):
		            if block.get("type") == "text":
		                text.append(block["text"])
		blob = "\n".join(text)
		outcome = target = ""
		for line in blob.splitlines():
		    if line.startswith("OUTCOME:"):
		        outcome = line.split(":", 1)[1].strip()
		    elif line.startswith("TARGET:"):
		        target = line.split(":", 1)[1].strip()
		print(outcome)
		print(target)
		# Third line: how the session ended, verbatim. The campaign cannot
		# report this — the conditions that end a session abnormally are the
		# same ones that stop it writing its closing line — and the exit code
		# is not a substitute: sessions that finish cleanly have been observed
		# exiting non-zero.
		print(terminal)
	PY
	;;

cost)
	# What the session cost, in the vendor's shape, which is why it lives here.
	# `design/loops.md` section 17: ccusage reads the CLI's own store, but the
	# teed stream already carries the same numbers, so this is a parsing job
	# rather than a dependency.
	python3 - "${1:?transcript}" <<-'PY'
		import json, sys

		last = None
		for line in open(sys.argv[1], errors="replace"):
		    line = line.strip()
		    if not line:
		        continue
		    try:
		        event = json.loads(line)
		    except json.JSONDecodeError:
		        continue
		    if event.get("type") == "result":
		        last = event
		if last is None:
		    print("{}")
		    raise SystemExit(0)
		usage = last.get("usage") or {}
		print(json.dumps({
		    "usd": last.get("total_cost_usd"),
		    "output_tokens": usage.get("output_tokens"),
		    "input_tokens": usage.get("input_tokens"),
		    "cache_read_tokens": usage.get("cache_read_input_tokens"),
		    "cache_creation_tokens": usage.get("cache_creation_input_tokens"),
		    "model_seconds": round((last.get("duration_ms") or 0) / 1000, 1),
		    "api_seconds": round((last.get("duration_api_ms") or 0) / 1000, 1),
		    "turns": last.get("num_turns"),
		    "terminal": last.get("subtype"),
		}, sort_keys=True))
	PY
	;;

progress)
	# What a *running* session has spent so far. `cost` reads the terminal
	# `result` event, which does not exist until the campaign exits, so a live
	# campaign has no numbers at all without this.
	#
	# Two things about the stream make the naive sum wrong, and both were
	# measured against finished campaigns whose recorded totals are known:
	#
	#   * assistant events repeat a `message.id` as the message streams, so
	#     summing every event double-counts. Last write per id wins.
	#   * even then the per-message `output_tokens` do not add up to what the
	#     `result` event reports (2,510 against 106,414 on campaign 0a979e94),
	#     so output is *not* reported here. Cache reads do agree exactly
	#     (17,358,119 on the same campaign), and cache reads are what a
	#     campaign actually costs — about 141:1 against output.
	#
	# `num_turns` likewise only exists at the end, but the count of `user`
	# events is exactly one less than it on every campaign checked, so turns
	# are reported as that plus one rather than left blank.
	python3 - "${1:?transcript}" <<-'PY'
		import json, sys

		usage_by_message = {}
		user_events = 0
		for line in open(sys.argv[1], errors="replace"):
		    line = line.strip()
		    if not line:
		        continue
		    try:
		        event = json.loads(line)
		    except json.JSONDecodeError:
		        continue
		    kind = event.get("type")
		    if kind == "user":
		        user_events += 1
		    elif kind == "assistant":
		        message = event.get("message") or {}
		        if message.get("id"):
		            usage_by_message[message["id"]] = message.get("usage") or {}

		def total(key):
		    return sum(usage.get(key) or 0 for usage in usage_by_message.values())

		print(json.dumps({
		    "turns": user_events + 1 if user_events else 0,
		    "cache_read_tokens": total("cache_read_input_tokens"),
		    "cache_creation_tokens": total("cache_creation_input_tokens"),
		    "input_tokens": total("input_tokens"),
		    "messages": len(usage_by_message),
		}, sort_keys=True))
	PY
	;;

parse-stream)
	python3 - "${1:?transcript}" <<-'PY'
		import json, sys

		# Our shape, not theirs. The vendor's stream carries records that are
		# plainly internal and will drift between versions; everything
		# downstream reads what this emits instead.
		def emit(**row):
		    print(json.dumps(row))

		def summarise(name, args):
		    for key in ("command", "file_path", "pattern", "path", "url"):
		        if args.get(key):
		            return str(args[key])
		    return ""

		for line in open(sys.argv[1], errors="replace"):
		    line = line.strip()
		    if not line:
		        continue
		    try:
		        event = json.loads(line)
		    except json.JSONDecodeError:
		        continue
		    kind = event.get("type")
		    if kind == "assistant":
		        for block in event.get("message", {}).get("content", []):
		            block_kind = block.get("type")
		            if block_kind == "text":
		                emit(kind="text", text=block.get("text", ""))
		            elif block_kind == "thinking":
		                emit(kind="thinking", text=block.get("thinking", ""))
		            elif block_kind == "tool_use":
		                args = block.get("input") or {}
		                row = {
		                    "kind": "tool",
		                    "name": block.get("name", "?"),
		                    "summary": summarise(block.get("name", ""), args),
		                    "input": args,
		                }
		                if "old_string" in args and "new_string" in args:
		                    row["diff"] = {
		                        "old": str(args.get("old_string", "")),
		                        "new": str(args.get("new_string", "")),
		                    }
		                emit(**row)
		    elif kind == "user":
		        content = event.get("message", {}).get("content", [])
		        if isinstance(content, list):
		            for block in content:
		                if block.get("type") != "tool_result":
		                    continue
		                body = block.get("content")
		                if isinstance(body, list):
		                    text = "\n".join(p.get("text", "") for p in body if isinstance(p, dict))
		                else:
		                    text = str(body or "")
		                emit(kind="tool_result", text=text)
		    elif kind == "result":
		        emit(kind="result", text=str(event.get("result", "")))
	PY
	;;

hook-path)
	jq -r '.tool_input.file_path // .tool_input.path // empty'
	;;

*)
	echo "adapter: unknown subcommand: $command" >&2
	usage
	;;
esac
