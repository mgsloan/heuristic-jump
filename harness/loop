#!/usr/bin/env bash
# The loop runner. `design/loops.md` section 14.
#
# Deliberately boring: a bash loop around headless `claude -p` with a fixed
# prompt per loop type. One campaign per session, and the session id is
# assigned rather than discovered, so it is also the campaign id and
# `claude --resume <id>` works without a correlation step.
#
# There is no supervisor here, on purpose: with one loop, one bash loop is
# not a fleet (design/loops.md section 18). What this does do is the part
# that has to survive a fresh context — open the campaign record, run the
# auditor at close, and stop when the loop has stalled.
#
#   harness/loop <loop> [--max <n>] [--once]

set -uo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo="${HJ_REPO:-$(dirname "$here")}"
hj="$here/hj"
adapter="$here/adapter"

loop="${1:-}"
if [ -z "$loop" ]; then
	echo "usage: harness/loop <loop> [--max <n>] [--once] [--worker <n>]" >&2
	exit 2
fi
shift

max=0
worker=""
while [ $# -gt 0 ]; do
	case "$1" in
	--max)
		max="${2:-0}"
		shift 2
		;;
	--once)
		max=1
		shift
		;;
	--worker)
		worker="${2:-}"
		shift 2
		;;
	*)
		echo "loop: unknown argument: $1" >&2
		exit 2
		;;
	esac
done

# The reviewed harness. `harness/loop` is always started from the integration
# checkout, so `$here` is the copy a human has read — and a loop that may write
# `harness/` must be judged by this one rather than by the copy in its own
# worktree. `hj` renders the gate command as an absolute path into here when
# the loop declares `writes_harness`, so the campaign cannot reach its own.
export HJ_PINNED_HARNESS="$here"

# Desired state comes from the integration checkout, never from the
# worker's branch: three workers each read their own copy otherwise, so
# pausing here would not stop any of them.
export HJ_CONTROL="$(dirname "$here")"

integration="$(dirname "$here")"

worktree_of() {
	python3 - "$1" <<-'PY'
		import sys, tomllib, pathlib
		phase = tomllib.loads(pathlib.Path("state/phase.toml").read_text())
		print(phase.get("loop", {}).get(sys.argv[1], {}).get("worktree", "") or "")
	PY
}

branch_of() {
	python3 - "$1" <<-'PY'
		import sys, tomllib, pathlib
		phase = tomllib.loads(pathlib.Path("state/phase.toml").read_text())
		loop = phase.get("loop", {}).get(sys.argv[1], {})
		print(loop.get("branch", "") or f"loop/{sys.argv[1]}")
	PY
}

# A loop with a worktree runs in it; every other loop runs where it always did.
# `design/loops.md` §13: git refuses the same branch in two worktrees, and
# sharing one tree between concurrent loops is worse than the branch it avoids
# — loop B would compile loop A's half-written files, so A's transient
# breakage becomes B's gate failure and green-or-revert stops meaning anything.
cd "$integration" || exit 2
worktree="$(worktree_of "$loop")"
branch="$(branch_of "$loop")"

# `design/loops.md` §13, "Workers": N campaigns of one loop at once, each in
# its own worktree on its own branch, against the same documents and the same
# gap list. The suffix is the whole of a worker's identity — it shares the
# loop's prompt, baseline and number.
identity="$loop"
if [ -n "$worker" ]; then
	identity="$loop-$worker"
	worktree="${worktree:-../heuristic-jump-$loop}-$worker"
	branch="$branch-$worker"
fi
export HJ_WORKER="$identity"

if [ -n "$worktree" ]; then
	case "$worktree" in
	/*) ;;
	*) worktree="$integration/$worktree" ;;
	esac
	if [ ! -d "$worktree/.git" ] && [ ! -f "$worktree/.git" ]; then
		echo "loop: creating worktree $worktree on $branch"
		if git show-ref --verify --quiet "refs/heads/$branch"; then
			git worktree add "$worktree" "$branch" || exit 2
		else
			git worktree add -b "$branch" "$worktree" || exit 2
		fi
	fi
	repo="$worktree"
	export HJ_REPO="$repo"
	echo "loop: $loop runs in $worktree on $branch, judged by $here"
fi

cd "$repo" || exit 2

# Merge after every green campaign rather than at a phase gate, so no long-lived
# branch accumulates (`design/loops.md` §13). Code and state are partitioned by
# owner, so the rebase is conflict-free by construction and the fast-forward
# touches nothing the other loop has open.
# A merge that cannot be made is escalated, never swallowed. `design/loops.md`
# §13 says a rebase that turns the gate red is "escalated as a blocked item
# rather than repaired locally", and until now it was only printed — to a log
# nobody reads, while the branch kept accumulating and the next campaign on
# that worker started from it.
#
# Deliberately not resolved automatically. A conflict here means two workers
# wrote the same file, which is a failure of the plan that divided them, and a
# machine that quietly picks a side hides the evidence that the planner needs.
blocked() {
	local reason="$1" files="$2"
	echo "loop: $reason" >&2
	[ -n "$files" ] && echo "loop:   conflicting: $files" >&2
	echo "loop:   left unmerged on $branch; escalated as a blocked item." >&2
	"$hj" intervene --kind merge-blocked --target "$identity" \
		--answer "$branch left unmerged" \
		--rationale "$reason. Conflicting paths: ${files:-unknown}. Two workers wrote the same file, which is a failure of the plan that divided them rather than of either campaign. The branch is intact and rebases once the other side lands or a human picks. Nothing is discarded automatically: a machine choosing a side here would hide the evidence the planner needs." \
		>/dev/null ||
		echo "loop: could not log the block; it reached this log and nothing else." >&2
}

# Resolve the conflicts whose answer is not a judgement, escalate the rest.
#
# **`--ours` and `--theirs` are inverted during a rebase**, which is the trap
# here: the commits are replayed *onto* main, so `--ours` is main and
# `--theirs` is the worker's. Getting it backwards silently keeps the wrong
# side, which is worse than any conflict.
#
# Only two classes are obvious, and both are obvious for a stated reason
# rather than because they are inconvenient:
#
#   state/audit/**   -> main. Only the round runner audits (§13, "the audit
#                       does not parallelise"), so a worker branch carrying a
#                       verdict is carrying one it should not have written.
#   state/findings/* -> the worker's. It is that worker's digest of its own
#                       campaign; nothing else can have a better copy.
#
# Everything else escalates. A conflict in `crates/`, `vendor/` or `design/`
# means two workers wrote one file, which is a failure of the plan that
# divided them — picking a side there destroys the evidence and loses work.
# The same two mechanical rules as `rebase_resolving`, with `--ours` and
# `--theirs` the other way round: in a merge `--ours` is this branch and
# `--theirs` is what is being merged in. Inverted between the two commands, so
# they cannot share a helper without the inversion becoming a parameter that is
# easy to pass wrongly.
merge_resolving() {
	git -C "$worktree" merge main -m "Merge main into $branch" && return 0
	local unresolved="" resolved="" path
	while IFS= read -r path; do
		[ -n "$path" ] || continue
		case "$path" in
		state/audit/*)
			git -C "$worktree" checkout --theirs -- "$path" 2>/dev/null &&
				git -C "$worktree" add -- "$path" && resolved="$resolved $path(main)"
			;;
		state/findings/*)
			git -C "$worktree" checkout --ours -- "$path" 2>/dev/null &&
				git -C "$worktree" add -- "$path" && resolved="$resolved $path(worker)"
			;;
		*)
			unresolved="$unresolved $path"
			;;
		esac
	done <<-EOF
		$(git -C "$worktree" diff --name-only --diff-filter=U)
	EOF
	if [ -n "$unresolved" ]; then
		git -C "$worktree" merge --abort 2>/dev/null
		blocked "conflict merging main into $branch that is not mechanical" "$unresolved"
		return 1
	fi
	echo "loop: resolved mechanically:$resolved"
	GIT_EDITOR=true git -C "$worktree" commit --no-edit >/dev/null 2>&1
	return 0
}

rebase_resolving() {
	local attempt=0
	git -C "$worktree" rebase main && return 0
	while [ "$attempt" -lt 20 ]; do
		attempt=$((attempt + 1))
		local unresolved="" resolved=""
		local conflicting
		conflicting="$(git -C "$worktree" diff --name-only --diff-filter=U)"
		if [ -z "$conflicting" ]; then
			break
		fi
		local path
		while IFS= read -r path; do
			[ -n "$path" ] || continue
			case "$path" in
			state/audit/*)
				git -C "$worktree" checkout --ours -- "$path" 2>/dev/null &&
					git -C "$worktree" add -- "$path" && resolved="$resolved $path(main)"
				;;
			state/findings/*)
				git -C "$worktree" checkout --theirs -- "$path" 2>/dev/null &&
					git -C "$worktree" add -- "$path" && resolved="$resolved $path(worker)"
				;;
			*)
				unresolved="$unresolved $path"
				;;
			esac
		done <<-EOF
			$conflicting
		EOF
		if [ -n "$unresolved" ]; then
			git -C "$worktree" rebase --abort 2>/dev/null
			blocked "conflict rebasing $branch onto main that is not mechanical" "$unresolved"
			return 1
		fi
		echo "loop: resolved mechanically:$resolved"
		if GIT_EDITOR=true git -C "$worktree" rebase --continue; then
			return 0
		fi
	done
	git -C "$worktree" rebase --abort 2>/dev/null
	blocked "rebase of $branch did not converge after $attempt round(s)" ""
	return 1
}

# Serialised across workers. Three of them close at their own pace, and two
# `git merge --ff-only` into one checkout at the same moment is a race the
# second one loses for no reason — its branch is fine, it just read `main`
# before the first one moved it. `flock` makes the second wait and then
# rebase onto what the first landed, which is the intended sequence rather
# than a retry.
merge_back() {
	[ -n "$worktree" ] || return 0
	local lock="$integration/.git/hj-merge.lock"
	exec 9>"$lock" || return 1
	if ! flock -w 900 9; then
		echo "loop: timed out waiting for the merge lock; left unmerged." >&2
		return 1
	fi
	merge_back_locked
	local status=$?
	flock -u 9
	exec 9>&-
	return $status
}

merge_back_locked() {
	if ! git -C "$worktree" diff --quiet || ! git -C "$worktree" diff --cached --quiet; then
		echo "loop: worktree is dirty at merge time; not merging." >&2
		return 1
	fi
	if [ -z "$(git -C "$worktree" log --oneline "main..$branch" 2>/dev/null)" ]; then
		return 0
	fi
	# Rebase replays every commit and re-resolves the same conflict on each of
	# them; a merge resolves once. That is invisible while a branch is a few
	# commits ahead and dominant once it has diverged — two branches at 26 and
	# 41 commits each cost several rounds of the same hand-resolution before
	# being merged in one.
	#
	# So linear history is kept where it is free and traded where it is not.
	# The threshold is deliberately low: the merge commit is the record that
	# this branch diverged, which is worth having.
	local ahead
	ahead="$(git -C "$worktree" rev-list --count "main..$branch" 2>/dev/null || echo 0)"
	if [ "$ahead" -gt "${HJ_REBASE_LIMIT:-8}" ]; then
		echo "loop: $branch is $ahead commits ahead; merging rather than rebasing."
		if ! merge_resolving; then
			return 1
		fi
	elif ! rebase_resolving; then
		return 1
	fi
	if git -C "$integration" merge --ff-only "$branch"; then
		echo "loop: merged $branch into main."
	else
		blocked "main would not fast-forward from $branch" ""
		return 1
	fi
}

# "The harness logs its own kills" (design/loops.md §16). A loop that stops
# leaves no trace otherwise: the next person sees a fleet that is quiet and
# has to work out whether it finished, stalled or ran out of money. The kind
# is `loop-killed` for all four, with the reason in `answer` — they differ in
# what a human has to do next, and that is what the reason says.
log_stop() {
	"$hj" intervene --kind loop-killed --target "$identity" \
		--answer "$1" --rationale "$2" >/dev/null 2>&1 ||
		echo "loop: could not log the stop; continuing to exit." >&2
}

status_of() {
	python3 - "$1" "$HJ_CONTROL" <<-'PY'
		import sys, tomllib, pathlib
		phase = tomllib.loads((pathlib.Path(sys.argv[2]) / "state/phase.toml").read_text())
		print(phase.get("loop", {}).get(sys.argv[1], {}).get("status", "missing"))
	PY
}

budget_of() {
	python3 - "$1" <<-'PY'
		import sys, tomllib, pathlib
		phase = tomllib.loads(pathlib.Path("state/phase.toml").read_text())
		print(phase.get("loop", {}).get(sys.argv[1], {}).get("budget_usd", "") or "")
	PY
}

model_of() {
	python3 - "$1" <<-'PY'
		import sys, tomllib, pathlib
		phase = tomllib.loads(pathlib.Path("state/phase.toml").read_text())
		print(phase.get("loop", {}).get(sys.argv[1], {}).get("model", "") or "")
	PY
}

permission_mode_of() {
	python3 - "$1" <<-'PY'
		import sys, tomllib, pathlib
		phase = tomllib.loads(pathlib.Path("state/phase.toml").read_text())
		loop = phase.get("loop", {}).get(sys.argv[1], {})
		print(loop.get("permission_mode") or "bypassPermissions")
	PY
}

# The PreToolUse hook reads this and no-ops without it, so an interactive
# session in this repository is unaffected by the ownership rules.
export HJ_LOOP="$loop"

# Crash recovery, which the design puts on the supervisor's tick and which
# there is no supervisor to run (design/loops.md section 14). An abandoned
# open record is invisible to stall detection, so a loop that keeps dying
# looks idle rather than broken.
"$hj" campaign-reap "$loop"

count=0
crashes=0
# Whether the one campaign §7's handoff needs has already been run. See the
# stall branch at the bottom of the loop.
handoff=0
while :; do
	desired="$(status_of "$loop")"
	if [ "$desired" != "running" ]; then
		echo "loop: state/phase.toml says $loop is '$desired'; stopping."
		exit 0
	fi

	# The two budget scopes above the campaign (design/loops.md section 15).
	# Checked here rather than at close, because between campaigns is the only
	# place a stop leaves a committed tree — and because a ceiling that is
	# already exceeded should not buy one more campaign to find that out.
	if ! "$hj" budget "$loop"; then
		echo
		echo "loop: a spending ceiling is reached; stopping rather than continuing quietly." >&2
		echo "      Raise it in state/phase.toml under [budget], and log the change as an" >&2
		echo "      intervention (kind: budget raised)." >&2
		log_stop "a spending ceiling was reached" \
			"harness/loop checks the ceilings between campaigns and stops rather than continuing quietly. Raising one is a budget-raised intervention."
		exit 1
	fi

	# §12's separation, checked before a campaign is launched rather than after
	# it has read something. It is about the configuration a campaign is handed,
	# not about a diff, which is why it is here and not in the gate — and the
	# mistake it guards against is made once, in whichever campaign first writes
	# a tuning prompt, and is invisible from then on.
	if ! "$hj" check-heldout; then
		echo
		echo "loop: the held-out split is reachable or named; stopping before a campaign sees it." >&2
		echo "      design/loops.md section 12: the separation is physical, and a rule the" >&2
		echo "      loop is never told about is one it cannot weigh against its own number." >&2
		log_stop "the held-out split was named in something a campaign is shown" \
			"design/loops.md section 12 makes the separation physical rather than rule-based; once a campaign has seen the held-out corpus, no later rule un-sees it."
		exit 1
	fi

	# §12's last bullet. The file only grows at a phase gate, so this reads the
	# same verdict every campaign until one happens — which is the point: the
	# evaluation is rare and the *consequence* of it is not.
	if ! "$hj" heldout; then
		echo
		echo "loop: the held-out gap widened; stopping." >&2
		echo "      design/loops.md section 12 calls this the one signal that means the" >&2
		echo "      last several iterations were probably net negative. A human has to" >&2
		echo "      look at the diff; the loop is shown where, and not by how much." >&2
		log_stop "the held-out gap widened at the last phase gate" \
			"design/loops.md section 12 stops the loop on a widening held-out gap because it means the last several iterations were probably net negative, and the loop is shown a verdict rather than the numbers so it cannot hill-climb its way out."
		exit 1
	fi

	# §11's standing ceilings, which are not the phase-3 ratchet: crossing one
	# does not mean the last change was wrong, it means the loop has wandered
	# somewhere no legitimate experiment goes. So it stops here rather than
	# failing a gate — the gate would blame whichever campaign was running.
	if ! "$hj" guardrail "$loop"; then
		echo
		echo "loop: a standing guardrail is crossed; stopping rather than continuing quietly." >&2
		echo "      design/loops.md section 11 puts these an order of magnitude above" >&2
		echo "      anything legitimate, so this needs looking at rather than raising." >&2
		log_stop "a standing guardrail was crossed" \
			"design/loops.md section 11 sets the guardrails an order of magnitude above anything legitimate, so crossing one means the loop wandered rather than that the last change was wrong."
		exit 1
	fi

	if ! git diff --quiet || ! git diff --cached --quiet; then
		echo "loop: the working tree is dirty. Green-or-revert means a campaign starts" >&2
		echo "      from a committed tree; the next session cannot tell deliberate" >&2
		echo "      breakage from an accident. Commit or revert, then start again." >&2
		log_stop "the working tree was dirty at the start of a campaign" \
			"Green-or-revert means a campaign starts from a committed tree; the next session cannot tell deliberate breakage from an accident."
		exit 1
	fi

	prompt="$(mktemp)"
	campaign="$("$hj" campaign-open "$loop" --prompt-out "$prompt" --worker "$identity")" || exit 2
	transcript="$("$adapter" transcript-path "$loop" "$campaign")"
	echo
	echo "=== campaign $campaign  ($identity, $(date -u +%FT%TZ))"
	echo "    record:     state/campaigns/$loop/$campaign.md"
	echo "    transcript: $transcript"
	echo "    resume:     $("$adapter" resume-command "$campaign")"

	"$adapter" campaign \
		"$campaign" "$prompt" "$transcript" "$(permission_mode_of "$loop")" \
		--model "$(model_of "$loop")" \
		--budget "$(budget_of "$loop")"
	exit_status=$?
	rm -f "$prompt"

	# The campaign reports its own outcome and target on the last lines it
	# writes; the harness does not infer either. `progress` is computed from
	# the repository, which is the number that actually gates the stall.
	summary="$("$adapter" summary "$transcript")"
	outcome="$(printf '%s\n' "$summary" | sed -n 1p)"
	target="$(printf '%s\n' "$summary" | sed -n 2p)"
	terminal="$(printf '%s\n' "$summary" | sed -n 3p)"
	errored="$(printf '%s\n' "$summary" | sed -n 4p)"

	# The stream's terminal event decides, not the exit code. Two campaigns
	# that finished cleanly — result subtype `success`, both reporting
	# `confirmed` with a target — were recorded as crashes because `claude -p`
	# exited non-zero anyway. That is not cosmetic: crashed campaigns are
	# excluded from the stall count and from the judged count, so a run of
	# successful campaigns was being scored as if it had not happened.
	#
	# The exit code is still the fallback for the case the stream cannot
	# describe: no result event at all, meaning the session was cut before it
	# could say anything.
	case "$terminal" in
	error_max_budget_usd)
		# A ceiling stop also stops the campaign writing its closing line, so
		# `budget` is the harness's to assign and never the campaign's.
		outcome="budget"
		;;
	success)
		# A usage ceiling reports `success` with `is_error` set, and stops the
		# campaign before it can write its closing line — so an empty outcome
		# here is a ceiling, not a crash. One such campaign ran 142 turns and
		# committed five times and was recorded as having died, which then hid
		# it from the audit cadence and the judged count.
		if [ "$outcome" = "" ] && [ "$errored" = "error" ]; then
			echo "loop: session ended at a usage ceiling; recording budget." >&2
			outcome="budget"
		fi
		;;
	"")
		outcome="crashed"
		;;
	*)
		echo "loop: session ended as '$terminal'; recording crashed." >&2
		outcome="crashed"
		;;
	esac
	if [ "$outcome" = "" ] && [ "$exit_status" -ne 0 ]; then
		outcome="crashed"
	fi
	case "$outcome" in
	confirmed | falsified | no-movement | partial | budget | crashed | error) ;;
	*)
		echo "loop: the campaign reported no OUTCOME line; recording 'error'." >&2
		outcome="error"
		;;
	esac

	# An uncommitted experiment is a failed one. Green-or-revert, applied by
	# someone else (design/loops.md section 14, crash recovery).
	if ! git diff --quiet || ! git diff --cached --quiet; then
		echo "loop: uncommitted changes at close; reverting to HEAD."
		git reset --hard HEAD
		git clean -fd -- crates vendor 2>/dev/null
	fi

	# A worker does not audit. Three of them would each audit their own branch,
	# which is not the tree anyone ships: it has that worker's work and neither
	# of the others'. They would also write `state/audit/` and the gap log
	# concurrently, giving one section three verdicts with no rule for which
	# wins. `harness/workers` runs one audit per round instead, against the
	# integration checkout once every worker has merged
	# (`design/loops.md` §13, "The audit does not parallelise").
	if [ -n "$worker" ]; then
		echo "loop: worker $identity does not audit; the round runner does."
	elif "$hj" audit-due "$loop"; then
		"$here/audit" "$loop" || echo "loop: the audit did not complete; state/audit/ is stale." >&2
	else
		echo "loop: audit not due yet; state/audit/ carries over."
	fi
	"$hj" campaign-close "$loop" --id "$campaign" --outcome "$outcome" ${target:+--target "$target"}

	"$hj" cost "$loop"

	merge_back || true

	# Consecutive sessions that ended without the campaign speaking are their
	# own stop condition. They are excluded from the stall count on purpose — a
	# session dying is not evidence the loop cannot make progress — but that
	# exclusion means nothing else would ever halt a loop whose sessions are
	# all failing.
	#
	# `budget` counts here as well as `crashed`. Running out of quota is the
	# common case and it is a ceiling rather than a crash, so counting only
	# crashes would leave the loop spinning against an exhausted quota,
	# starting a campaign every few seconds and recording each as a clean stop.
	case "$outcome" in
	crashed | budget)
		crashes=$((crashes + 1))
		if [ "$crashes" -ge 3 ]; then
			echo
			echo "loop: three sessions in a row ended without the campaign closing." >&2
			echo "      Quota, credentials, or the CLI — not the work. Stopping." >&2
			log_stop "three sessions in a row ended without the campaign closing" \
				"Quota, credentials or the CLI rather than the work. Crashed sessions are excluded from the stall count, so nothing else would halt a loop whose sessions all fail."
			exit 1
		fi
		;;
	*)
		crashes=0
		;;
	esac

	# `design/loops.md` §7: "On stall the loop stops and writes
	# state/handoff.md: what it was trying, what it tried, what it believes is
	# blocking, and the specific question that would unblock it."
	#
	# Two of those four are the campaign's and not the harness's, and the
	# prompt's stall notice asks a campaign for them. But the notice fires on
	# `trailing_without_progress >= stall_n`, which is the same predicate that
	# stops the loop here — so the campaign that would see it never opened, and
	# nothing wrote the file, while this branch and the dashboard's handoff card
	# both assumed something had.
	#
	# So the loop runs exactly one more campaign. That one sees the notice and
	# writes its account into its own campaign record; `hj handoff` then
	# assembles the file from it and from the run of campaigns that stalled,
	# which is the half only the loop can see. Exactly one, tracked here rather
	# than by looking for the file, so a campaign that crashes without recording
	# anything still stops the loop on the next pass.
	if ! "$hj" stall "$loop"; then
		if [ "$handoff" = 0 ]; then
			handoff=1
			echo
			echo "loop: stalled. Running one campaign for its account of why,"
			echo "      then writing state/handoff.md and stopping."
		else
			"$hj" handoff "$loop" ||
				echo "loop: could not write state/handoff.md; stopping anyway." >&2
			echo
			echo "loop: stalled. See state/handoff.md, then answer and set the loop"
			echo "      back to 'running' in state/phase.toml."
			log_stop "stalled: campaigns closed in a row without progress" \
				"The stall rule fired. state/handoff.md is the loop's account, assembled from the campaign record of the last campaign it ran; unblocking it is a stall-unblocked intervention."
			exit 1
		fi
	fi

	count=$((count + 1))
	if [ "$max" -gt 0 ] && [ "$count" -ge "$max" ]; then
		echo "loop: ran $count campaign(s), which was the limit."
		exit 0
	fi
done
