#!/usr/bin/env bash
# Run a loop as N workers, in rounds. `design/loops.md` section 13, "Workers".
#
# A round is: plan, then N campaigns in parallel, then wait for all of them.
# The barrier is the cost of the design and is deliberate — the planner needs
# to see what the last round did before it can divide the next one, and a
# worker that started early would be dividing against a stale picture.
#
# The planner is a session rather than a rule because the split that matters
# is "which of these targets share their reading", which is a judgement about
# the code. A first-come claim gets disjointness and nothing else: it hands
# out the top-ranked gaps in order and cannot notice that two of them are the
# same file.
#
# Run one worker in the foreground when you want to watch it, which skips the
# planner and gives it the whole gap list:
#
#     harness/loop core --worker 1 --once
#
#   harness/workers <loop> [--rounds <n>] [--logs <dir>]

set -uo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo="$(dirname "$here")"
hj="$here/hj"
adapter="$here/adapter"

loop="${1:-}"
if [ -z "$loop" ]; then
	echo "usage: harness/workers <loop> [--rounds <n>] [--logs <dir>]" >&2
	exit 2
fi
shift

rounds=0
logs="$repo/../heuristic-jump-logs"
while [ $# -gt 0 ]; do
	case "$1" in
	--rounds)
		rounds="${2:?count}"
		shift 2
		;;
	--logs)
		logs="${2:?directory}"
		shift 2
		;;
	*)
		echo "workers: unknown argument: $1" >&2
		exit 2
		;;
	esac
done

cd "$repo" || exit 2
export HJ_CONTROL="$repo"

read_key() {
	python3 - "$loop" "$1" "$2" <<-'PY'
		import sys, tomllib, pathlib
		phase = tomllib.loads(pathlib.Path("state/phase.toml").read_text())
		print(phase.get("loop", {}).get(sys.argv[1], {}).get(sys.argv[2], sys.argv[3]))
	PY
}

count="$(read_key workers 1)"
if [ "$count" -le 1 ]; then
	echo "workers: $loop declares $count worker; run harness/loop $loop directly." >&2
	exit 2
fi

mkdir -p "$logs"
echo "workers: $count for $loop, in rounds"

round=0
while :; do
	if [ "$(read_key status missing)" != "running" ]; then
		echo "workers: state/phase.toml says $loop is not running; stopping."
		exit 0
	fi

	round=$((round + 1))
	echo
	echo "=== round $round  ($loop, $(date -u +%FT%TZ))"

	# Plan. A round without a plan is still a round: the workers fall back to
	# the whole gap list, which is what a single worker has always had. That is
	# worse than a plan and much better than not running.
	prompt="$(mktemp)"
	answer="$(mktemp)"
	if "$hj" render-planner "$loop" --workers "$count" --out "$prompt"; then
		session="$(cat /proc/sys/kernel/random/uuid)"
		if "$adapter" audit "$session" "$prompt" "$answer" --model "${HJ_PLAN_MODEL:-}"; then
			"$hj" plan-merge "$loop" "$answer" --workers "$count" ||
				echo "workers: the plan did not parse; workers take the whole list." >&2
		else
			echo "workers: the planning session failed; workers take the whole list." >&2
		fi
	fi
	rm -f "$prompt" "$answer"

	pids=()
	for n in $(seq 1 "$count"); do
		"$here/loop" "$loop" --worker "$n" --once >"$logs/$loop-$n.log" 2>&1 &
		pids+=($!)
		echo "  $loop-$n  pid $!  $logs/$loop-$n.log"
	done

	for pid in "${pids[@]}"; do
		wait "$pid"
	done
	echo "round $round: all $count workers closed"

	# One audit per round, here rather than in any worker: it reads the merged
	# tree, which is the only tree that has all three workers' commits, and it
	# writes `state/audit/` once instead of three times.
	if "$hj" audit-due "$loop"; then
		"$here/audit" "$loop" || echo "workers: the audit did not complete; state/audit/ is stale." >&2
		# Workers rebase at their next merge, but they read the gap list at
		# open — so hand them the new verdicts before the next plan.
		for n in $(seq 1 "$count"); do
			wt="$(python3 - "$loop" <<-'PY'
				import sys, tomllib, pathlib
				phase = tomllib.loads(pathlib.Path("state/phase.toml").read_text())
				print(phase.get("loop", {}).get(sys.argv[1], {}).get("worktree", "") or "")
			PY
			)"
			[ -n "$wt" ] && git -C "$wt-$n" merge --ff-only main -q 2>/dev/null
		done
	else
		echo "workers: audit not due yet."
	fi

	if [ "$rounds" -gt 0 ] && [ "$round" -ge "$rounds" ]; then
		echo "workers: ran $round round(s), which was the limit."
		exit 0
	fi
done
