{
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "filesystem": {
      "allowWrite": [
        ".",
        "/home/mgsloan/proj/heuristic_jump/.git",
        "/home/mgsloan/proj/heuristic_jump/state",
        "/home/mgsloan/proj/heuristic-jump-core-1",
        "/home/mgsloan/proj/heuristic-jump-core-2",
        "/home/mgsloan/proj/heuristic-jump-core-3",
        "/home/mgsloan/proj/heuristic-jump-harness",
        "/home/mgsloan/proj/heuristic-jump-transcripts",
        "/home/mgsloan/proj/heuristic-jump-logs",
        "/home/mgsloan/.cargo"
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/harness/hooks/edit-scope",
            "statusMessage": "edit scope"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_response.filePath // .tool_input.file_path // empty' | { read -r f; case \"$f\" in */vendor/*) exit 0;; *.rs) rustfmt --edition 2024 \"$f\";; esac; } 2>/dev/null || true",
            "statusMessage": "rustfmt"
          }
        ]
      }
    ]
  }
}
