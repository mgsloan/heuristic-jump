target/
__pycache__/

# Target claims. True for the minutes a campaign holds one, released at its
# close, and read by another worker before any merge — so they are shared
# state that is nobody's history. `harness/hj claim` creates them with O_EXCL,
# which is the atomicity; committing them would put a lock in the history and
# make every worker's tree dirty.
state/claims/

# Reserved decision and changelog numbers. A marker exists from the moment
# `hj allocate-id` hands a number out until the record using it is committed,
# which is what stops two workers writing the same id. Ephemeral and shared,
# like state/claims/.
state/reserved/
